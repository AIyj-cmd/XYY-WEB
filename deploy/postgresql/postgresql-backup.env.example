# Install as /etc/xyy/postgresql-backup.env with owner root and mode 600.
# This file is consumed by systemd EnvironmentFile syntax, not sourced as shell code.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=directus
DB_PASSWORD=replace-with-a-strong-password
DB_DATABASE=directus
BACKUP_ROOT=/var/backups/xyy-postgresql
RETENTION_DAYS=14
