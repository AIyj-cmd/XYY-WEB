[Unit]
Description=Backup the XYY Directus PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/xyy/postgresql-backup.env
ExecStart=/usr/local/sbin/xyy-backup-directus-postgresql
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
