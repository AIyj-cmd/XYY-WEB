# Install as /var/www/xyy-web/.env on the application server with mode 600.

DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_CONTENT_TOKEN=replace-with-read-only-content-token
# 仅发布 News 所需的独立最小权限写入令牌；至少 32 UTF-8 bytes，且不得复用其他令牌。
DIRECTUS_NEWS_WRITE_TOKEN=
# 调用方 Bearer Token；仅由受信任服务端保存，至少 32 UTF-8 bytes。
NEWS_PUBLISH_API_TOKEN=
XIANSUO_API_URL=https://xs.tomatopia.top
XIANSUO_INGEST_TOKEN=
PUBLIC_SITE_URL=https://56xyy.com
PUBLIC_DIRECTUS_URL=https://56xyy.com/cms
ENABLE_DOMAIN_REDIRECTS=false
LEGACY_DOMAINS=wz.tomatopia.top
