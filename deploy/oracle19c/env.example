# Copy this file to /etc/xyy/oracle19c.env on the application server.
# Keep the real file mode at 600 and never commit credentials.

# Private address of the standalone Oracle database server.
ORACLE_DB_HOST=10.0.0.20
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=ORCLPDB1
ORACLE_DB_USER=DIRECTUS_APP
ORACLE_DB_PASSWORD=replace-with-a-strong-password

# Directus bootstrap identity for the parallel Oracle instance.
DIRECTUS_ADMIN_EMAIL=admin@56xyy.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DIRECTUS_STATIC_TOKEN=replace-with-the-current-static-token
DIRECTUS_SECRET=replace-with-at-least-32-random-bytes

PUBLIC_URL=https://56xyy.com/cms
CORS_ORIGIN=https://56xyy.com,https://www.56xyy.com

SOURCE_CMS_DIR=/var/www/xyy-cms
TARGET_CMS_DIR=/var/www/xyy-cms-oracle
NODE_BIN=/opt/node-v22/bin
STAGING_PORT=8056
WEB_PROCESS_NAME=xyy-web
