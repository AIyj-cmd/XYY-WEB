# Copy to /etc/xyy/oracle-database.env on the existing Oracle 19c server.
# Set mode 600. Never commit the populated file.

ORACLE_OS_USER=oracle
ORACLE_HOME=/opt/oracle/product/19c/dbhome_1
ORACLE_SID=ORCLCDB
PDB_NAME=ORCLPDB1

DIRECTUS_DB_USER=DIRECTUS_APP
DIRECTUS_DB_PASSWORD=replace-with-a-strong-password
TABLESPACE_NAME=XYY_DIRECTUS
TABLESPACE_SIZE_MB=1024
TABLESPACE_NEXT_MB=256

# Filesystem-managed database example. Leave empty when the existing database
# uses OMF/ASM and DB_CREATE_FILE_DEST is configured.
ORACLE_DATAFILE=/opt/oracle/oradata/ORCLCDB/ORCLPDB1/xyy_directus01.dbf
