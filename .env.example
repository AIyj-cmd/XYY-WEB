# Directus CMS
# 服务器内部建议使用 http://127.0.0.1:8055；本地开发可改成 https://wz.tomatopia.top/cms
DIRECTUS_URL=http://127.0.0.1:8055
# 运行时使用两个不同的最小权限 Token。迁移期可临时保留 DIRECTUS_TOKEN，
# 但完成权限配置后应删除共享 Token。
DIRECTUS_CONTENT_TOKEN=your_read_only_content_token_here
# 仅用于服务端批量发布 News，至少 32 UTF-8 bytes，且不得复用其他运行令牌。
DIRECTUS_NEWS_WRITE_TOKEN=

# 仅允许受信任的服务端调用 POST /api/integrations/news/batch，至少 32 UTF-8 bytes。
NEWS_PUBLISH_API_TOKEN=

# 官网联系线索仅由服务端转发到 XYY-xiansuo，绝不以 PUBLIC_ 变量暴露。
XIANSUO_API_URL=https://xs.tomatopia.top
XIANSUO_INGEST_TOKEN=

# 站点
PUBLIC_SITE_URL=https://wz.tomatopia.top
PUBLIC_DIRECTUS_URL=https://wz.tomatopia.top/cms
