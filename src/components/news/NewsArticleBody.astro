---
import { BRAND } from '@/lib/brand'
import { formatDate, getDirectusAssetUrl, type NewsArticle } from '@/lib/directus'

interface Props {
  article: NewsArticle
  sanitizedContent: string
}

const { article, sanitizedContent } = Astro.props
---

<article class="py-12 bg-white" itemscope itemtype="https://schema.org/NewsArticle">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span
          class="text-xs font-bold text-brand-orange bg-orange-50 px-3 py-1.5 rounded-full"
          itemprop="articleSection">{article.category}</span
        >
        <time
          class="text-sm text-gray-400"
          datetime={article.published_at}
          itemprop="datePublished"
        >
          {formatDate(article.published_at)}
        </time>
      </div>
      <h1
        class="text-3xl lg:text-4xl font-black text-navy-900 leading-tight mb-5"
        itemprop="headline"
      >
        {article.title}
      </h1>
      <p
        class="text-lg text-gray-600 leading-relaxed border-l-4 border-brand-orange pl-5 italic"
        itemprop="description"
      >
        {article.summary}
      </p>
    </header>

    {
      article.cover_image && (
        <figure class="mb-10 rounded-2xl overflow-hidden aspect-video">
          <img
            src={getDirectusAssetUrl(article.cover_image)}
            alt={article.title}
            width="800"
            height="450"
            class="w-full h-full object-cover"
            itemprop="image"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div
      class="prose prose-lg max-w-none prose-headings:text-navy-800 prose-headings:font-bold prose-a:text-navy-700 prose-a:underline prose-strong:text-navy-800 prose-blockquote:border-brand-orange"
      itemprop="articleBody"
      set:html={sanitizedContent}
    />

    <footer class="mt-12 pt-8 border-t border-gray-100">
      <div class="flex items-center gap-3 mb-5">
        <div
          class="w-10 h-10 rounded-lg bg-brand-orange/10 flex items-center justify-center flex-shrink-0"
        >
          <span class="text-brand-orange font-black text-sm">新</span>
        </div>
        <div>
          <p
            class="text-sm font-semibold text-gray-800"
            itemprop="author"
            itemscope
            itemtype="https://schema.org/Organization"
          >
            <span itemprop="name">{BRAND.fullName}</span>
          </p>
          <p class="text-xs text-gray-400">鞋服云仓专业服务商 · 深耕15年</p>
        </div>
      </div>
      <dl
        class="grid sm:grid-cols-3 gap-3 text-xs text-gray-500 bg-gray-50 border border-gray-100 rounded-xl p-4"
      >
        <div>
          <dt class="font-semibold text-gray-700 mb-1">内容审核</dt><dd>新亦源供应链运营团队</dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-700 mb-1">更新时间</dt><dd>
            {formatDate(article.date_updated ?? article.published_at)}
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-700 mb-1">内容来源</dt><dd>
            官网业务资料与仓配运营实践
          </dd>
        </div>
      </dl>
    </footer>
  </div>
</article>
