---
import { formatDate, getDirectusAssetUrl, type NewsArticle } from '@/lib/directus'

interface Props {
  articles: NewsArticle[]
}

const { articles } = Astro.props
---

<section class="bg-gray-50 py-14 lg:py-16" aria-labelledby="news-list-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-brand-orange">最新内容</p>
        <h2 id="news-list-heading" class="text-2xl font-black text-navy-800 sm:text-3xl">
          行业洞察与运营实践
        </h2>
      </div>
      <p class="hidden text-sm text-gray-500 sm:block">共 {articles.length} 篇已发布文章</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <article class="group overflow-hidden rounded-2xl border border-gray-100 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl">
            <a
              href={`/news/${article.slug}`}
              class="block h-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
            >
              <div class="aspect-[16/9] overflow-hidden bg-navy-50">
                {article.cover_image ? (
                  <img
                    src={getDirectusAssetUrl(article.cover_image)}
                    alt={article.title}
                    width="640"
                    height="360"
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center bg-[linear-gradient(135deg,#10284b,#244d7a)] text-sm font-bold tracking-[0.15em] text-blue-100">
                    新亦源行业洞察
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="mb-3 flex items-center justify-between gap-3 text-xs">
                  <span class="font-bold text-brand-orange">{article.category}</span>
                  <time datetime={article.published_at} class="text-gray-400">
                    {formatDate(article.published_at)}
                  </time>
                </div>
                <h3 class="mb-3 text-lg font-black leading-snug text-navy-800 transition-colors group-hover:text-blue-700">
                  {article.title}
                </h3>
                <p class="line-clamp-2 text-sm leading-7 text-gray-500">{article.summary}</p>
                <span class="mt-5 inline-flex text-sm font-bold text-blue-700">阅读全文 →</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
