---
import { formatDate, getDirectusAssetUrl, type NewsArticle } from '@/lib/directus'

interface Props {
  articles: NewsArticle[]
  totalCount?: number
  viewAllHref?: string
}

const { articles, totalCount = articles.length, viewAllHref } = Astro.props
---

<section class="bg-gray-50 py-14 lg:py-16" aria-labelledby="news-list-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-brand-orange">最新内容</p>
        <h2 id="news-list-heading" class="text-2xl font-black text-navy-800 sm:text-3xl">
          行业洞察与运营实践
        </h2>
      </div>
      <p class="hidden text-sm text-gray-500 sm:block">共 {totalCount} 篇已发布文章</p>
    </div>

    <div class="mx-auto flex max-w-6xl flex-col gap-5">
      {
        articles.map((article) => (
          <article class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-xl">
            <a
              href={`/news/${article.slug}`}
              class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 sm:min-h-56 sm:flex-row"
            >
              <div class="relative aspect-[16/9] flex-shrink-0 overflow-hidden bg-navy-50 sm:aspect-auto sm:w-72 lg:w-80">
                {article.cover_image ? (
                  <img
                    src={getDirectusAssetUrl(article.cover_image)}
                    alt={article.title}
                    width="720"
                    height="480"
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <div class="flex h-full min-h-48 flex-col items-center justify-center bg-[linear-gradient(135deg,#10284b,#244d7a)] px-6 text-center text-blue-100">
                    <span class="mb-3 h-px w-10 bg-brand-orange/80" aria-hidden="true" />
                    <span class="text-sm font-bold tracking-[0.15em]">新亦源行业洞察</span>
                    <span class="mt-2 text-xs tracking-wider text-blue-200/70">
                      XINYIYUAN INSIGHTS
                    </span>
                  </div>
                )}
              </div>
              <div class="flex min-w-0 flex-1 flex-col justify-center p-5 sm:p-7 lg:px-9">
                <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
                  <span class="rounded-full bg-orange-50 px-2.5 py-1 font-bold text-brand-orange">
                    {article.category}
                  </span>
                  <time datetime={article.published_at} class="text-gray-400">
                    {formatDate(article.published_at)}
                  </time>
                </div>
                <h3 class="mb-3 text-xl font-black leading-snug text-navy-800 transition-colors group-hover:text-blue-700 lg:text-2xl">
                  {article.title}
                </h3>
                <p class="line-clamp-2 text-sm leading-7 text-gray-500 sm:text-base">
                  {article.summary}
                </p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-blue-700">
                  阅读全文
                  <span
                    class="transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
    {
      viewAllHref && (
        <div class="mt-9 flex justify-center">
          <a
            href={viewAllHref}
            class="group inline-flex min-h-11 items-center justify-center gap-3 rounded-full bg-navy-800 px-6 py-3 text-sm font-bold text-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:bg-blue-800 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
          >
            查看全部
            <span class="text-xs font-medium text-blue-100">共 {totalCount} 篇</span>
            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>
      )
    }
  </div>
</section>
