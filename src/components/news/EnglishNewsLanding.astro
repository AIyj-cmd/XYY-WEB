---
import { ENGLISH_NEWS_CATEGORIES, formatEnglishNewsDate } from '@/lib/news-english'
import { getDirectusAssetUrl, type EnglishNewsArticle } from '@/lib/directus'

interface Props {
  articles: EnglishNewsArticle[]
  category?: keyof typeof ENGLISH_NEWS_CATEGORIES
  totalCount: number
  viewAllHref?: string
}

const { articles, category, totalCount, viewAllHref } = Astro.props
---

<section
  class="relative overflow-hidden bg-navy-900 pb-16 pt-[calc(8rem+var(--language-suggestion-visible-height,0px))] text-white sm:pt-[calc(6rem+var(--language-suggestion-visible-height,0px))]"
  aria-labelledby="insights-heading"
>
  <div class="absolute inset-0 bg-[linear-gradient(115deg,#091b34,#183c65)]" aria-hidden="true">
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-brand-orange">Insights</p>
    <h1 id="insights-heading" class="max-w-3xl text-4xl font-black leading-tight lg:text-5xl">
      Apparel fulfilment insights
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-blue-100">
      Selected, reviewed notes on apparel warehousing, returns inspection and supply-chain
      operations.
    </p>
  </div>
</section>

<nav class="border-b border-gray-100 bg-white" aria-label="Insight categories">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="no-scrollbar flex gap-2 overflow-x-auto py-5">
      <a
        href="/en/news"
        class:list={[
          'shrink-0 rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
          !category
            ? 'bg-navy-800 text-white'
            : 'text-gray-600 hover:bg-gray-100 hover:text-navy-800',
        ]}>All insights</a
      >
      {
        Object.entries(ENGLISH_NEWS_CATEGORIES).map(([key, item]) => (
          <a
            href={`/en/news?category=${encodeURIComponent(key)}`}
            class:list={[
              'shrink-0 rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
              category === key
                ? 'bg-navy-800 text-white'
                : 'text-gray-600 hover:bg-gray-100 hover:text-navy-800',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<aside class="border-b border-gray-100 bg-white" aria-label="Research library">
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-5 sm:px-6 lg:px-8"
  >
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-orange">
        Research library
      </p>
      <p class="mt-1 text-sm text-gray-600">
        Browse English issue summaries and original Chinese whitepapers.
      </p>
    </div>
    <a
      href="/en/supply-chain-whitepapers"
      class="rounded-full border border-navy-800 px-4 py-2 text-sm font-bold text-navy-800 transition-colors hover:bg-navy-800 hover:text-white"
      >Explore whitepapers</a
    >
  </div>
</aside>

<section class="bg-gray-50 py-14 lg:py-16" aria-labelledby="news-list-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-orange">
          Selected articles
        </p>
        <h2 id="news-list-heading" class="mt-2 text-2xl font-black text-navy-800 sm:text-3xl">
          {category ? ENGLISH_NEWS_CATEGORIES[category].label : 'Latest insights'}
        </h2>
      </div>
      <p class="text-sm text-gray-500">
        {totalCount} published {totalCount === 1 ? 'article' : 'articles'}
      </p>
    </div>
    {
      articles.length ? (
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {articles.map((article) => (
            <article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
              <a
                href={`/en/news/${article.slug}`}
                class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
              >
                <div class="aspect-[3/2] overflow-hidden bg-[linear-gradient(135deg,#10284b,#244d7a)]">
                  {article.cover_image ? (
                    <img
                      src={getDirectusAssetUrl(article.cover_image)}
                      alt={article.title}
                      width="720"
                      height="480"
                      loading="lazy"
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center px-6 text-center text-sm font-bold uppercase tracking-[0.16em] text-blue-100">
                      XINYIYUAN insights
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
                    <span class="rounded-full bg-orange-50 px-2.5 py-1 font-bold text-brand-orange">
                      {article.category}
                    </span>
                    <time datetime={article.published_at} class="text-gray-400">
                      {formatEnglishNewsDate(article.published_at)}
                    </time>
                  </div>
                  <h3 class="text-xl font-black leading-snug text-navy-800 transition-colors group-hover:text-blue-700">
                    {article.title}
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-7 text-gray-600">{article.summary}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-blue-700">
                    Read article <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-3xl border border-gray-100 bg-white px-6 py-12 text-center shadow-sm sm:px-12">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-orange">
            Editorial review
          </p>
          <h2 class="mt-3 text-2xl font-black text-navy-800">No published English insights yet</h2>
          <p class="mx-auto mt-4 max-w-xl leading-relaxed text-gray-600">
            New English insights will appear here as they become available.
          </p>
          <a
            href="/en/services"
            class="mt-7 inline-flex rounded-xl bg-navy-800 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-navy-700"
          >
            Explore services
          </a>
        </div>
      )
    }
    {
      viewAllHref && (
        <div class="mt-9 flex justify-center">
          <a
            href={viewAllHref}
            class="rounded-full bg-navy-800 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-blue-800"
          >
            View all {totalCount} articles
          </a>
        </div>
      )
    }
  </div>
</section>
