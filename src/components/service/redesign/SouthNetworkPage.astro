---
import type { FaqItem } from '@/data/service'
import type { ServicePageContent } from '@/lib/directus-content-queries'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import ContactLink from '@/components/conversion/ContactLink.astro'
import type { SiteLocale } from '@/i18n/routes'
import '@/styles/service-redesign.css'
import SouthBusiness from './SouthBusiness.astro'
import { hasRedesignContent } from './content-presence'
import { groupSouthFeatures, groupSouthStats, summarizeSouthHeroDescription } from './south-content'
import SouthNetworkNodes from './SouthNetworkNodes.astro'
import { southUi } from './south-ui-copy'
import SouthFaq from './SouthFaq.astro'

interface Props {
  content: ServicePageContent
  faqs: FaqItem[]
  videoSrc: string
  poster: string
  locale?: SiteLocale
}
const { content, faqs, videoSrc, poster, locale = 'zh-CN' } = Astro.props
const available = hasRedesignContent(content, faqs.length)
const groups = groupSouthFeatures(content.features, locale)
const stats = groupSouthStats(content.stats, locale)
const copy = southUi(locale)
---

<article class:list={['south-page', { 'south-page--empty': !available }]} data-locale={locale}>
  {
    available ? (
      <>
        <header class="south-hero">
          <div class="redesign-shell south-hero__grid">
            <>
              <div>
                <p class="redesign-kicker">{content.h1 || content.breadcrumbLabel}</p>
                <h1 id="lp-h1">
                  <>
                    <span>
                      {locale === 'en' ? 'South China apparel fulfilment' : '华南鞋服云仓'}
                    </span>
                    <span>
                      {locale === 'en'
                        ? 'Place stock and orders in the right warehouse'
                        : '把货源与订单放进合适仓库'}
                    </span>
                  </>
                </h1>
                <p class="south-hero__cities">
                  <>
                    <span>{locale === 'en' ? 'Guangzhou' : '广州'}</span>
                    <span>{locale === 'en' ? 'Dongguan' : '东莞'}</span>
                    <span>{locale === 'en' ? 'Foshan' : '佛山'}</span>
                    <span>{locale === 'en' ? 'Zhaoqing' : '肇庆'}</span>
                  </>
                </p>
                {(content.h1sub || content.heroDesc) && (
                  <div class="south-hero__intro">
                    {content.h1sub && <p class="south-hero__sub">{content.h1sub}</p>}
                    {content.heroDesc && (
                      <p>
                        {locale === 'en'
                          ? content.heroDesc
                          : summarizeSouthHeroDescription(content.heroDesc)}
                      </p>
                    )}
                  </div>
                )}
                <div class="mt-6">
                  <ContactLink
                    sourcePath={Astro.url.pathname}
                    {locale}
                    entry="hero"
                    class="redesign-button"
                  >
                    {locale === 'en' ? 'Discuss South China fulfilment' : '咨询华南仓配服务'}
                  </ContactLink>
                </div>
              </div>
              <video
                class="south-hero__video"
                data-service-hero-media
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                width="1280"
                height="720"
                poster={poster}
                aria-label={`${content.h1}${locale === 'en' ? ' service video' : '服务视频'}`}
              >
                <source src={videoSrc} type="video/mp4" />
              </video>
            </>
          </div>
        </header>
        <SouthNetworkNodes {groups} {stats} {locale} />
        <SouthBusiness {groups} {stats} {locale} />
        <section class="south-reference south-section" aria-labelledby="south-reference-heading">
          <div class="redesign-shell">
            <>
              <header>
                <>
                  <p class="redesign-kicker">
                    {locale === 'en' ? 'Dispatch and delivery' : '发货与配送'}
                  </p>
                  <h2 id="south-reference-heading">
                    {locale === 'en'
                      ? 'When orders dispatch and when they arrive'
                      : '什么时候发出，多久可以送达'}
                  </h2>
                </>
              </header>
              <div>
                {content.contentDesc && <p>{content.contentDesc}</p>}
                {stats.warehouse.concat(stats.other).map(({ stat, label, sub }) => (
                  <p class="south-stat">
                    <b>{stat}</b>
                    <span>
                      {label} · {sub}
                    </span>
                  </p>
                ))}
              </div>
            </>
          </div>
        </section>
        <SouthFaq {faqs} {locale} />
        <ConversionCTA
          className="south-contact"
          headingId="south-contact-heading"
          eyebrow={copy.eyebrow}
          headingLines={[...copy.lines]}
          description={copy.description}
          actionLabel={copy.action}
          preparationAriaLabel={
            locale === 'en' ? 'Information to prepare before consultation' : undefined
          }
          preparationItems={copy.preparationItems}
          secondaryLinks={[
            {
              href: locale === 'en' ? '/en/cases' : '/cases',
              label: locale === 'en' ? 'View cases' : '查看合作案例',
            },
            {
              href: locale === 'en' ? '/en/services' : '/product',
              label: locale === 'en' ? 'Explore services' : '查看全部仓配服务',
            },
          ]}
          reveal="service"
        />
      </>
    ) : (
      <section class="redesign-empty">
        <h1 id="lp-h1">
          {locale === 'en' ? 'Service content is currently unavailable.' : '服务内容暂不可用'}
        </h1>
      </section>
    )
  }
</article>
