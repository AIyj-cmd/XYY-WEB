---
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'
import ContactLink from '@/components/conversion/ContactLink.astro'
interface Props {
  h1: string
  h1sub: string
  heroDesc: string
  videoSrc: string
  poster: string
  locale?: SiteLocale
}
const { h1, h1sub, heroDesc, videoSrc, poster, locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.b2b
---

<header class="b2b-hero">
  <div class="redesign-shell b2b-hero__grid">
    <div class="b2b-hero__copy">
      <h1 id="lp-h1"><span>{h1}</span>{h1sub && <strong>{h1sub}</strong>}</h1>
      {heroDesc && <p>{heroDesc}</p>}
      {
        h1sub && (
          <p class="b2b-hero__scenarios">
            <>
              {(locale === 'en' ? copy.scenarios : ['连锁补货', '批发铺货', '加盟配送']).map(
                (item) => (
                  <span>{item}</span>
                )
              )}
            </>
          </p>
        )
      }
      <ContactLink sourcePath={Astro.url.pathname} {locale} entry="hero" class="redesign-button">
        {locale === 'en' ? copy.contact : '咨询门店仓配'}
      </ContactLink>
    </div>
    <video
      class="b2b-hero__video"
      data-service-hero-media
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      width="1280"
      height="720"
      poster={poster}
      aria-label={`${h1}${locale === 'en' ? ' service video' : '服务视频'}`}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
</header>
