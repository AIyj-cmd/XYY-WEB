---
import type { ServicePageContent } from '@/lib/directus-content-queries'
import ContactLink from '@/components/conversion/ContactLink.astro'
import type { SiteLocale } from '@/i18n/routes'
import { eastUi } from './east-ui-copy'

interface Props {
  content: ServicePageContent
  videoSrc: string
  poster: string
  locale?: SiteLocale
}
const { content, videoSrc, poster, locale = 'zh-CN' } = Astro.props
const copy = eastUi(locale)
---

<header class="east-hero">
  <div class="redesign-shell">
    <div class="east-hero__copy">
      <div class="east-hero__title">
        {content.eyebrow && <p class="redesign-kicker">{content.eyebrow}</p>}
        <h1 id="lp-h1">
          <span class="east-hero__service">{content.h1 || copy.heroFallback}</span>
          <span class="east-hero__claim"
            ><em>{copy.heroClaim[0]}</em><em>{copy.heroClaim[1]}</em></span
          >
        </h1>
        <p class="east-hero__cities">{copy.cities.map((city) => <span>{city}</span>)}</p>
      </div>
      <div class="east-hero__intro">
        {content.h1sub && <p class="east-hero__sub">{content.h1sub}</p>}
        {content.heroDesc && <p class="east-hero__description">{content.heroDesc}</p>}
        <div class="east-hero__actions">
          <ContactLink sourcePath={Astro.url.pathname} {locale} entry="hero" class="redesign-button"
            >{copy.contact}</ContactLink
          >
          <a href="#east-warehouses-heading">{copy.warehouseLink}</a>
        </div>
      </div>
    </div>
    <video
      class="east-hero__video"
      data-service-hero-media
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      width="1280"
      height="720"
      poster={poster}
      aria-label={`${content.h1 || copy.heroFallback} ${copy.serviceVideo}`}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
</header>
