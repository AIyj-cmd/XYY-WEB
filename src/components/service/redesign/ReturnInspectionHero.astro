---
interface Props {
  serviceName: string
  valueTitle: string
  subheading: string
  description: string
  videoSrc: string
  poster: string
  hasGrades: boolean
}

const { serviceName, valueTitle, subheading, description, videoSrc, poster, hasGrades } =
  Astro.props
const [titlePrefix = valueTitle, titleValue = ''] = valueTitle.split('，')
---

<header class="returns-hero">
  <div class="returns-shell returns-hero__copy">
    <p class="returns-kicker">退货质检</p>
    <p class="returns-hero__service-name">{serviceName}</p>
    <h1 id="lp-h1">
      <span>{titleValue ? `${titlePrefix}，` : titlePrefix}</span><span>{titleValue}</span>
    </h1>
    {subheading && <p class="returns-hero__subheading">{subheading}</p>}
    <div class="returns-hero__actions">
      <a class="returns-button" href="/contact">沟通退货质检方案</a>
      {hasGrades && <a href="#returns-grade-heading">查看分级处置</a>}
    </div>
  </div>
  <div class="returns-shell returns-hero__media-wrap">
    <video
      class="returns-hero__media"
      data-service-hero-media
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      width="1280"
      height="720"
      poster={poster}
      aria-label={`${serviceName}服务视频`}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
    <aside class="returns-hero__note" aria-label="质检说明">
      <strong>订单核对</strong><span>异常记录</span><span>等级判定</span>
      {description && <p>{description}</p>}
    </aside>
  </div>
</header>
