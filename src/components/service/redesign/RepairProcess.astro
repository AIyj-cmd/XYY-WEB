---
import { REPAIR_WORK_ORDER_FLOW } from '@/data/service/repair-workshop'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'
interface Props {
  locale?: SiteLocale
}
const { locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.repair
const flow =
  locale === 'en'
    ? copy.flow.map(([num, title, desc]) => ({ num, title, desc }))
    : REPAIR_WORK_ORDER_FLOW
---

<section class="repair-process repair-section" aria-labelledby="repair-process-heading">
  <div class="redesign-shell">
    <header class="repair-section__heading">
      <p class="redesign-kicker">{locale === 'en' ? copy.process : '从评估到交付'}</p>
      <h2 id="repair-process-heading">
        {locale === 'en' ? copy.processHeading : '修复完成之后，还要通过品牌标准。'}
      </h2>
    </header>
    <ol class="repair-process__steps">
      {
        flow.map(({ num, title, desc }) => (
          <li>
            <p>{num}</p>
            <h3>{title}</h3>
            <span>{desc}</span>
          </li>
        ))
      }
    </ol>
    <div
      class="repair-process__outcomes"
      aria-label={locale === 'en' ? copy.outcomes : '二次质检后的两种处理结果'}
    >
      <div>
        <strong>{locale === 'en' ? copy.pass : '达到品牌确认标准'}</strong>
        <p>{locale === 'en' ? copy.passDesc : '进入约定的上架或后续授权流程。'}</p>
      </div>
      <div>
        <strong>{locale === 'en' ? copy.fail : '未达到确认标准'}</strong>
        <p>{locale === 'en' ? copy.failDesc : '按约定继续处理或分流。'}</p>
      </div>
    </div>
  </div>
</section>
