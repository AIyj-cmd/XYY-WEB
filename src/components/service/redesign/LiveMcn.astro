---
import type { LiveFeatureGroups, LiveStatGroups } from './live-content'
import type { SiteLocale } from '@/i18n/routes'
import { liveUi } from './live-ui-copy'

interface Props {
  features: LiveFeatureGroups['mcn']
  support: LiveFeatureGroups['support']
  stats: LiveStatGroups['support']
  locale?: SiteLocale
}
const { features, support, stats, locale = 'zh-CN' } = Astro.props
const copy = liveUi(locale)
const mcn = copy.mcn
---

{
  (features.length > 0 || support.length > 0 || stats.length > 0) && (
    <section class="live-mcn live-section" aria-labelledby="live-mcn-heading">
      <div class="redesign-shell">
        <div>
          <>
            <p class="redesign-kicker">{mcn[0]}</p>
            <h2 id="live-mcn-heading">
              {mcn[1]}
              <br />
              {mcn[2]}
            </h2>
            <p>{mcn[3]}</p>
          </>
        </div>
        <div>
          {features.concat(support).map(({ title, desc }) => (
            <p data-redesign-feature>
              <b data-feature-title>{title}</b>
              <span data-feature-description>{desc}</span>
            </p>
          ))}
          <div class="live-mcn__groups">
            {features.length > 0 && (
              <>
                <p>
                  <b>{mcn[4]}</b>
                  <span>{mcn[5]}</span>
                </p>
                <p>
                  <b>{mcn[6]}</b>
                  <span>{mcn[7]}</span>
                </p>
                <p>
                  <b>{mcn[8]}</b>
                  <span>{mcn[9]}</span>
                </p>
                <p>
                  <b>{mcn[10]}</b>
                  <span>{mcn[11]}</span>
                </p>
              </>
            )}
          </div>
          {features.length > 0 && <p class="live-mcn__settlement">{mcn[12]}</p>}
          {stats.map(({ stat, label, sub }) => (
            <p class="live-stat">
              <b>{stat}</b>
              <span>
                {label} · {sub}
              </span>
            </p>
          ))}
        </div>
      </div>
    </section>
  )
}
