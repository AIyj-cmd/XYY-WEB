---
import type { FaqItem } from '@/data/service'
import type { ServicePageContent } from '@/lib/directus-content-queries'
import '@/styles/service-redesign.css'
import { hasRedesignContent } from './content-presence'
import RepairDirectory from './RepairDirectory.astro'
import RepairFaq from './RepairFaq.astro'
import RepairHero from './RepairHero.astro'
import RepairProcess from './RepairProcess.astro'
import RepairVerification from './RepairVerification.astro'
import RepairWorkshop from './RepairWorkshop.astro'
import { repairFeaturesInSourceOrder } from './repair-content'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  content: ServicePageContent
  faqs: FaqItem[]
  videoSrc: string
  poster: string
  locale?: SiteLocale
}

const { content, faqs, videoSrc, poster, locale = 'zh-CN' } = Astro.props
const available = hasRedesignContent(content, faqs.length)
const hasProcess = Boolean(content.features.length || content.contentDesc || content.stats.length)
const repairFeatures = repairFeaturesInSourceOrder(content.features)
---

<article class:list={['repair-page', { 'repair-page--empty': !available }]}>
  {
    available ? (
      <>
        <RepairHero
          serviceName={content.h1 || content.breadcrumbLabel}
          subheading={content.h1sub}
          description={content.heroDesc}
          {videoSrc}
          {poster}
          {locale}
        />
        <RepairDirectory features={repairFeatures} {locale} />
        {repairFeatures.length > 0 && <RepairWorkshop {locale} />}
        {hasProcess && <RepairProcess {locale} />}
        {(content.contentDesc || content.stats.length > 0) && (
          <RepairVerification contentDesc={content.contentDesc} stats={content.stats} {locale} />
        )}
        <RepairFaq {faqs} {locale} />
      </>
    ) : (
      <section class="redesign-empty">
        <h1 id="lp-h1">
          {locale === 'en' ? 'Service content is currently unavailable.' : '服务内容暂不可用'}
        </h1>
      </section>
    )
  }
</article>
