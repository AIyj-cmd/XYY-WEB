---
import type { SiteLocale } from '@/i18n/routes'
import ContactLink from '@/components/conversion/ContactLink.astro'
interface Props {
  serviceName: string
  subheading: string
  description: string
  videoSrc: string
  poster: string
  locale?: SiteLocale
}

const { serviceName, subheading, description, videoSrc, poster, locale = 'zh-CN' } = Astro.props
---

<header class="repair-hero">
  <div class="redesign-shell">
    <div class="repair-hero__grid">
      <div class="repair-hero__title">
        <p class="redesign-kicker">{locale === 'en' ? 'Garment care and repair' : '后整修复'}</p>
        <h1 id="lp-h1">{serviceName}</h1>
      </div>
      <div class="repair-hero__copy">
        {subheading && <p class="repair-hero__subheading">{subheading}</p>}
        {description && <p>{description}</p>}
        <ContactLink sourcePath={Astro.url.pathname} {locale} entry="hero" class="redesign-button">
          {locale === 'en' ? 'Assess repair requirements' : '评估修复需求'}
        </ContactLink>
      </div>
    </div>
    <video
      class="repair-hero__video"
      data-service-hero-media
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      width="1280"
      height="720"
      poster={poster}
      aria-label={`${serviceName}${locale === 'en' ? ' service video' : '服务视频'}`}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
</header>
