---
import type { FeatureItem, StatItem } from '@/data/service'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'

interface Props {
  apparel: FeatureItem[]
  footwear: FeatureItem[]
  rules: FeatureItem[]
  evidence: FeatureItem[]
  repair: FeatureItem[]
  other: FeatureItem[]
  stats: readonly StatItem[]
  locale?: SiteLocale
}

const { apparel, footwear, rules, evidence, repair, other, stats, locale = 'zh-CN' } = Astro.props

const sections: [string, FeatureItem[]][] = [
  ['服装检查', apparel],
  ['鞋类检查', footwear],
  ['规则与判定', rules],
]
const copy = REDESIGN_ENGLISH_UI.returns
const displaySections: [string, FeatureItem[]][] =
  locale === 'en'
    ? [
        ['Apparel inspection', apparel],
        ['Footwear inspection', footwear],
        ['Rules and decisions', rules],
      ]
    : sections
---

{
  sections.some(([, features]) => features.length > 0) && (
    <section class="returns-section returns-checks" aria-labelledby="returns-checks-heading">
      <div class="returns-shell">
        <header class="returns-section__heading">
          <>
            <p class="returns-kicker">{locale === 'en' ? copy.checks : '检查重点'}</p>
            <h2 id="returns-checks-heading">
              {locale === 'en' ? copy.checksHeading : '服装和鞋类，按不同重点检查'}
            </h2>
          </>
        </header>
        <div class="returns-checks__grid">
          {displaySections
            .filter(([, features]) => features.length > 0)
            .map(([heading, features]) => (
              <article>
                <h3>{heading}</h3>
                {features.map(({ title, desc }) => (
                  <p data-redesign-feature>
                    <strong data-feature-title>{title}</strong>
                    <span data-feature-description>{desc}</span>
                  </p>
                ))}
              </article>
            ))}
        </div>
      </div>
    </section>
  )
}

<section class="returns-section returns-evidence" aria-labelledby="returns-evidence-heading">
  <div class="returns-shell returns-evidence__layout">
    <div>
      <p class="returns-kicker">{locale === 'en' ? copy.evidence : '可复核依据'}</p><h2
        id="returns-evidence-heading"
      >
        {locale === 'en' ? copy.evidenceHeading : '留下拆包、检查与判定的依据'}
      </h2>
      {
        (evidence.length || repair.length || other.length) > 0 && (
          <ol>
            <>
              {(locale === 'en' ? copy.evidenceSteps : ['拆包记录', '检查照片', '判定结果']).map(
                (item) => (
                  <li>{item}</li>
                )
              )}
            </>
          </ol>
        )
      }
      {
        [...evidence, ...repair, ...other].map(({ title, desc }) => (
          <p data-redesign-feature>
            <>
              <strong data-feature-title>{title}</strong>
              <span data-feature-description>{desc}</span>
            </>
          </p>
        ))
      }
    </div>
    {
      stats.length > 0 && (
        <dl>
          {stats.map(({ stat, label, sub }) => (
            <div>
              <dt>{stat}</dt>
              <dd>
                <strong>{label}</strong>
                <span>{sub}</span>
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
