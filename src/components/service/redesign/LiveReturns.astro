---
import type { FeatureItem, StatItem } from '@/data/service'
import type { SiteLocale } from '@/i18n/routes'
import { liveUi } from './live-ui-copy'

interface Props {
  features: FeatureItem[]
  stats: StatItem[]
  locale?: SiteLocale
}

const { features, stats, locale = 'zh-CN' } = Astro.props
const copy = liveUi(locale)
const returns = copy.returns
---

{
  (features.length > 0 || stats.length > 0) && (
    <section class="live-returns live-section" aria-labelledby="live-returns-heading">
      <div class="redesign-shell">
        <header class="live-section-heading">
          <p class="redesign-kicker">{returns[0]}</p>
          <h2 id="live-returns-heading">{returns[1]}</h2>
          <p>{returns[2]}</p>
        </header>
        <div class="live-returns__directions">
          <article>
            <>
              <b>{returns[3]}</b>
              <p>{returns[4]}</p>
            </>
          </article>
          <article>
            <>
              <b>{returns[5]}</b>
              <p>{returns[6]}</p>
            </>
          </article>
          <article>
            <>
              <b>{returns[7]}</b>
              <p>{returns[8]}</p>
            </>
          </article>
        </div>
        {features.map(({ title, desc }) => (
          <p class="live-returns__feature" data-redesign-feature>
            <b data-feature-title>{title}</b>
            <span data-feature-description>{desc}</span>
          </p>
        ))}
        {stats.map(({ stat, label, sub }) => (
          <p class="live-stat">
            <b>{stat}</b>
            <span>
              {label} · {sub}
            </span>
          </p>
        ))}
        <p class="live-returns__links">
          <>
            <a href={locale === 'en' ? '/en/returns-inspection' : '/tuihuo-zhijian'}>
              {returns[9]}
            </a>
            <a href={locale === 'en' ? '/en/garment-care' : '/houzheng-xiufu'}>{returns[10]}</a>
          </>
        </p>
      </div>
    </section>
  )
}
