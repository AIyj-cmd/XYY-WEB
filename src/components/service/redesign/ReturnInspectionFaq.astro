---
import type { FaqItem } from '@/data/service'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'

interface Props {
  faqs: FaqItem[]
  locale?: SiteLocale
}

const { faqs, locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.returns
---

<section
  class="returns-section returns-faq"
  aria-labelledby={faqs.length > 0 ? 'returns-faq-heading' : undefined}
>
  <div class="returns-shell">
    {
      faqs.length > 0 && (
        <>
          <header class="returns-section__heading">
            <>
              <p class="returns-kicker">{locale === 'en' ? copy.faq : '常见问题'}</p>
              <h2 id="returns-faq-heading">
                {locale === 'en' ? copy.faqHeading : '标准确认前，先把问题说清楚'}
              </h2>
            </>
          </header>
          <div>
            {faqs.map(({ q, a }) => (
              <details data-redesign-faq>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>
<ConversionCTA
  className="returns-section returns-contact"
  headingId="returns-contact-heading"
  eyebrow={locale === 'en' ? 'Discuss a plan' : '沟通方案'}
  headingLines={locale === 'en'
    ? ['Clarify returned items', 'and decision rules.']
    : ['把退件和判定规则，', '一起梳理']}
  description={locale === 'en'
    ? 'Prepare item types, return volume and brand decision rules.'
    : '可先准备商品类型、退件规模和品牌判定规则。'}
  actionLabel={locale === 'en' ? 'Discuss a returns-inspection plan' : '沟通退货质检方案'}
  preparationAriaLabel={locale === 'en' ? 'Information to prepare before consultation' : undefined}
  preparationItems={locale === 'en'
    ? [
        { label: 'Item types', detail: 'Product categories and return condition' },
        { label: 'Return volume', detail: 'Routine volume and concentrated return plans' },
        { label: 'Brand decision rules', detail: 'Decision basis and handling requirements' },
      ]
    : [
        { label: '商品类型', detail: '商品品类与退件状态' },
        { label: '退件规模', detail: '日常数量与集中退件安排' },
        { label: '品牌判定规则', detail: '判定口径与处理要求' },
      ]}
  secondaryLinks={[
    {
      href: locale === 'en' ? '/en/cases' : '/cases',
      label: locale === 'en' ? 'View cases' : '查看合作案例',
    },
    {
      href: locale === 'en' ? '/en/services' : '/product',
      label: locale === 'en' ? 'Explore services' : '查看全部仓配服务',
    },
  ]}
  reveal="service"
/>
