---
import type { FaqItem } from '@/data/service'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import type { EastFeatureGroups } from './east-content'
import type { SiteLocale } from '@/i18n/routes'
import { eastUi } from './east-ui-copy'

interface Props {
  faqs: FaqItem[]
  groups: EastFeatureGroups
  locale?: SiteLocale
}
const { faqs, groups, locale = 'zh-CN' } = Astro.props
const copy = eastUi(locale)
---

{
  faqs.length > 0 && (
    <section class="east-faq east-section" aria-labelledby="east-faq-heading">
      <div class="redesign-shell">
        {faqs.length > 0 && (
          <div>
            <h2 id="east-faq-heading">{copy.faqHeading}</h2>
            {faqs.map(({ q, a }) => (
              <details data-redesign-faq>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
<ConversionCTA
  className="east-contact east-section"
  headingId="east-contact-heading"
  eyebrow={copy.ctaEyebrow}
  headingLines={[...copy.ctaLines]}
  description={copy.ctaDesc}
  actionLabel={copy.contact}
  preparationAriaLabel={locale === 'en' ? 'Information to prepare before consultation' : undefined}
  preparationItems={[
    ...copy.prep.map(([label, detail]) => ({ label, detail })),
    ...groups.support.map(({ title, desc }) => ({ label: title, detail: desc, isFeature: true })),
  ]}
  secondaryLinks={[
    { href: locale === 'en' ? '/en/cases' : '/cases', label: copy.cases },
    { href: locale === 'en' ? '/en/services' : '/product', label: copy.services },
  ]}
  reveal="service"
/>
