---
import type { FaqItem } from '@/data/service'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'

interface Props {
  faqs: FaqItem[]
  locale?: SiteLocale
}

const { faqs, locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.repair
---

<section class="repair-faq" aria-labelledby="repair-faq-heading">
  <div class="redesign-shell">
    <header class="repair-faq__heading">
      <p class="redesign-kicker">{locale === 'en' ? copy.faq : 'FAQ 与咨询'}</p>
      <h2 id="repair-faq-heading">
        {locale === 'en' ? copy.faqHeading : '评估之前，先把这些信息准备好。'}
      </h2>
    </header>
    <div class="repair-faq__layout">
      <div class="repair-faq__questions">
        {
          faqs.map(({ q, a }) => (
            <details data-redesign-faq>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
<ConversionCTA
  className="repair-cta"
  headingId="repair-contact-heading"
  eyebrow={locale === 'en' ? 'Repair assessment' : '修复评估'}
  headingLines={locale === 'en'
    ? ['Start with the material and issue', 'on one item.']
    : ['从一件商品的材质和瑕疵，', '开始评估']}
  actionLabel={locale === 'en' ? 'Assess repair requirements' : '评估修复需求'}
  preparationAriaLabel={locale === 'en' ? 'Information to prepare before consultation' : undefined}
  preparationItems={locale === 'en'
    ? [
        { label: 'Item material', detail: 'Fabric, material and product category' },
        { label: 'Issue photographs', detail: 'Location and close-up details' },
        { label: 'Accessories', detail: 'Missing accessories and replacement need' },
        { label: 'Brand acceptance rules', detail: 'Finishing and acceptance standard' },
      ]
    : [
        { label: '商品材质', detail: '面料、材质与商品品类' },
        { label: '瑕疵照片', detail: '异常位置与细节图片' },
        { label: '配件情况', detail: '配件缺损与补配需求' },
        { label: '品牌验收规则', detail: '整理要求与验收标准' },
      ]}
  secondaryLinks={[
    {
      href: locale === 'en' ? '/en/returns-inspection' : '/tuihuo-zhijian',
      label: locale === 'en' ? 'Explore returns inspection' : '了解退货质检',
    },
    {
      href: locale === 'en' ? '/en/cases' : '/cases',
      label: locale === 'en' ? 'View cases' : '查看合作案例',
    },
    {
      href: locale === 'en' ? '/en/services' : '/product',
      label: locale === 'en' ? 'Explore services' : '查看全部仓配服务',
    },
  ]}
  reveal="service"
/>
