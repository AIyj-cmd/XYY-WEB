---
import type { FaqItem } from '@/data/service'
import type { SiteLocale } from '@/i18n/routes'
import { liveUi } from './live-ui-copy'

interface Props {
  faqs: FaqItem[]
  locale?: SiteLocale
}
const { faqs, locale = 'zh-CN' } = Astro.props
const copy = liveUi(locale)
---

{
  faqs.length > 0 && (
    <section class="live-faq live-section" aria-labelledby="live-faq-heading">
      <div class="redesign-shell live-faq__grid">
        <header>
          <>
            <p class="redesign-kicker">{copy.faqKicker}</p>
            <h2 id="live-faq-heading">{copy.faqHeading}</h2>
          </>
        </header>
        <div>
          {faqs.map(({ q, a }) => (
            <details data-redesign-faq>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
