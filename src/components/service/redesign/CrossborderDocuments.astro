---
import type { CrossborderFeatureGroups, CrossborderStatGroups } from './crossborder-content'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  features: CrossborderFeatureGroups
  stats: CrossborderStatGroups
  locale?: SiteLocale
}

const { features, stats, locale = 'zh-CN' } = Astro.props
---

<section
  class="crossborder-documents crossborder-section"
  aria-labelledby="crossborder-documents-heading"
>
  <div class="redesign-shell">
    <header>
      <p class="redesign-kicker">
        {locale === 'en' ? 'Three pre-dispatch structures' : '出仓前的三种结构示意'}
      </p>
      <h2 id="crossborder-documents-heading">
        {locale === 'en' ? 'Labels, packaging and inspection records' : '标签、包装与质检记录'}
      </h2>
      <p>
        {
          locale === 'en'
            ? 'These field structures are illustrative only, not customs documents or live barcodes.'
            : '以下为字段结构示意，不是报关资料或真实条码。'
        }
      </p>
    </header>
    <div class="crossborder-documents__grid">
      <article class="crossborder-documents__label">
        <strong>{locale === 'en' ? 'Label template' : '标签模板'}</strong>
        <dl>
          <dt>{locale === 'en' ? 'Template confirmation' : '模板确认'}</dt><dd>
            {locale === 'en' ? 'Confirmed by brand' : '品牌确认'}
          </dd><dt>{locale === 'en' ? 'Target platform' : '目标平台'}</dt><dd>
            {locale === 'en' ? 'Project requirements' : '项目要求'}
          </dd><dt>{locale === 'en' ? 'Label fields' : '标签项'}</dt><dd>
            {locale === 'en' ? 'Checked against template' : '按模板核对'}
          </dd>
        </dl>
        {
          features.labeling.map(({ title, desc }) => (
            <p data-redesign-feature>
              <>
                <b data-feature-title>{title}</b>
                <span data-feature-description>{desc}</span>
              </>
            </p>
          ))
        }
      </article>
      <article class="crossborder-documents__packaging">
        <strong>{locale === 'en' ? 'Packaging requirements' : '包装要求'}</strong>
        <dl>
          <dt>{locale === 'en' ? 'Materials' : '包材'}</dt><dd>
            {locale === 'en' ? 'Confirmed by project' : '按项目确认'}
          </dd><dt>{locale === 'en' ? 'Packaging requirements' : '包装要求'}</dt><dd>
            {locale === 'en' ? 'Applied to specification' : '按规范执行'}
          </dd><dt>{locale === 'en' ? 'Handover requirements' : '交接要求'}</dt><dd>
            {locale === 'en' ? 'Reviewed before dispatch' : '出仓前复核'}
          </dd>
        </dl>
      </article>
      <article class="crossborder-documents__quality">
        <strong>{locale === 'en' ? 'Inspection record' : '质检记录'}</strong>
        <dl>
          <dt>{locale === 'en' ? 'Sampling standard' : '抽检标准'}</dt><dd>
            {locale === 'en' ? 'Project agreement' : '项目约定'}
          </dd><dt>{locale === 'en' ? 'Result record' : '结果记录'}</dt><dd>
            {locale === 'en' ? 'Retained by project' : '按项目留存'}
          </dd><dt>{locale === 'en' ? 'Review point' : '复核节点'}</dt><dd>
            {locale === 'en' ? 'Confirmed before dispatch' : '出仓前确认'}
          </dd>
        </dl>
        {
          features.quality.map(({ title, desc }) => (
            <p data-redesign-feature>
              <>
                <b data-feature-title>{title}</b>
                <span data-feature-description>{desc}</span>
              </>
            </p>
          ))
        }
        {
          stats.quality.map(({ stat, label, sub }) => (
            <p class="crossborder-stat">
              <>
                <b>{stat}</b>
                <span>
                  {label} · {sub}
                </span>
              </>
            </p>
          ))
        }
      </article>
    </div>
  </div>
</section>
