---
import type { EastStatGroups } from './east-content'
import type { SiteLocale } from '@/i18n/routes'
import { eastUi } from './east-ui-copy'

interface Props {
  stats: EastStatGroups
  contentDesc: string
  locale?: SiteLocale
}
const { stats, contentDesc, locale = 'zh-CN' } = Astro.props
const copy = eastUi(locale)
const sections = [
  {
    title: copy.serviceSections[0][0],
    stats: stats.warehouse.concat(stats.other),
    desc: copy.serviceSections[0][1],
  },
  {
    title: copy.serviceSections[1][0],
    stats: stats.fees,
    desc: copy.serviceSections[1][1],
  },
].filter(({ stats }) => stats.length > 0)
---

<section class="east-service-info east-section" aria-labelledby="east-service-info-heading">
  <div class="redesign-shell">
    <header>
      <p class="redesign-kicker">{copy.serviceKicker}</p><h2 id="east-service-info-heading">
        {copy.serviceHeading}
      </h2>{contentDesc && <p>{contentDesc}</p>}
    </header>
    {
      sections.length > 0 && (
        <div class="east-service-info__grid">
          {sections.map(({ title, stats: sectionStats, desc }) => (
            <article>
              <h3>{title}</h3>
              {sectionStats.map(({ stat, label, sub }) => (
                <p class="east-stat">
                  <b>{stat}</b>
                  <span>
                    {label} · {sub}
                  </span>
                </p>
              ))}
              <p>{desc}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
