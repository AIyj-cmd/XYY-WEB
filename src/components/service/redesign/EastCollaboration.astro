---
import type { EastFeatureGroups } from './east-content'
import type { SiteLocale } from '@/i18n/routes'
import { eastUi } from './east-ui-copy'

interface Props {
  groups: EastFeatureGroups
  locale?: SiteLocale
}
const { groups, locale = 'zh-CN' } = Astro.props
const copy = eastUi(locale)
const [primary, ...other] = groups.collaboration
const items = copy.collaborationItems
---

<section class="east-collaboration east-section" aria-labelledby="east-collaboration-heading">
  <div class="redesign-shell east-collaboration__layout">
    <header>
      {
        primary ? (
          <div data-redesign-feature>
            <h2 id="east-collaboration-heading" data-feature-title>
              {primary.title}
            </h2>
            <p data-feature-description>{primary.desc}</p>
          </div>
        ) : (
          <>
            <>
              <h2 id="east-collaboration-heading">{copy.collaborationFallbackHeading}</h2>
              <p>{copy.collaborationFallbackDesc}</p>
            </>
          </>
        )
      }
      {
        other.map(({ title, desc }) => (
          <p class="east-feature" data-redesign-feature>
            <>
              <b data-feature-title>{title}</b>
              <span data-feature-description>{desc}</span>
            </>
          </p>
        ))
      }
    </header>
    <div class="east-collaboration__items">
      {
        items.map(([title, desc], index) => (
          <article>
            <>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{desc}</p>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
