---
import type { FeatureItem } from '@/data/service'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'
interface Props {
  features: FeatureItem[]
  locale?: SiteLocale
}

const { features, locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.repair
---

{
  features.length > 0 && (
    <section class="repair-directory repair-section" aria-labelledby="repair-directory-heading">
      <div class="redesign-shell">
        <header class="repair-section__heading">
          <p class="redesign-kicker">{locale === 'en' ? copy.directory : '异常目录'}</p>
          <h2 id="repair-directory-heading">
            {locale === 'en' ? copy.directoryHeading : '这批商品，需要处理哪些问题？'}
          </h2>
          <p>
            {locale === 'en'
              ? copy.directoryDesc
              : '处理方式需结合商品材质、品牌要求和复检规则确认。'}
          </p>
        </header>
        <div class="repair-directory__items">
          {features.map(({ title, desc }, index) => (
            <article data-redesign-feature>
              <p class="repair-directory__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 data-feature-title>{title}</h3>
              <p data-feature-description>{desc}</p>
            </article>
          ))}
        </div>
        <a class="repair-directory__anchor" href="#repair-workshop-heading">
          {locale === 'en' ? copy.workshopLink : '查看实际工位'}
        </a>
      </div>
    </section>
  )
}
