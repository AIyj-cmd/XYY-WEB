---
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'
interface Props {
  locale?: SiteLocale
}
const { locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.b2b
const headingLines =
  locale === 'en' ? ['Plan your next', 'store restock.'] : ['把下一次门店补货，', '提前安排好。']
---

<ConversionCTA
  className="b2b-cta b2b-section"
  headingId="b2b-cta-heading"
  eyebrow={locale === 'en' ? copy.ctaEyebrow : '门店仓配'}
  headingLines={headingLines}
  description={locale === 'en'
    ? copy.ctaDesc
    : '告诉我们门店分布和补货安排，一起梳理分货与发运需求。'}
  actionLabel={locale === 'en' ? copy.contact : '咨询门店仓配'}
  preparationAriaLabel={locale === 'en' ? 'Information to prepare before consultation' : undefined}
  preparationItems={locale === 'en'
    ? copy.prep.map(([label, detail]) => ({ label, detail }))
    : [
        { label: '门店分布', detail: '门店位置与收货要求' },
        { label: '补货安排', detail: '补货时间与每店需求' },
        { label: '分货与发运需求', detail: '分货方式与发运安排' },
      ]}
  secondaryLinks={[
    {
      href: locale === 'en' ? '/en/cases' : '/cases',
      label: locale === 'en' ? 'View cases' : '查看合作案例',
    },
    {
      href: locale === 'en' ? '/en/services' : '/product',
      label: locale === 'en' ? 'Explore services' : '查看全部仓配服务',
    },
  ]}
  reveal="service"
/>
