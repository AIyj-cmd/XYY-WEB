---
import { SOUTH_COLLABORATION_BANDS } from '@/data/service/south-network'
import type { SouthFeatureGroups, SouthStatGroups } from './south-content'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  groups: SouthFeatureGroups
  stats: SouthStatGroups
  locale?: SiteLocale
}
const { groups, stats, locale = 'zh-CN' } = Astro.props
const englishBands = [
  {
    title: 'Inventory storage',
    desc: 'Storage space is arranged around stock volumes and changes to support receiving, management and dispatch.',
    signal: 'Inventory management',
  },
  {
    title: 'Order processing',
    desc: 'Teams are arranged for everyday orders and promotions, connecting receiving, picking and packing.',
    signal: 'Operations planning',
  },
  {
    title: 'Dispatch and delivery',
    desc: 'Delivery is arranged around destinations and dispatch channels, with dispatch and estimated arrival times confirmed.',
    signal: 'Delivery planning',
  },
  {
    title: 'Orders and inventory',
    desc: 'Orders, inventory, warehouse operations and returns status are connected so product progress can be followed.',
    signal: 'Status tracking',
  },
] as const
---

<section class="south-business south-section" aria-labelledby="south-business-heading">
  <div class="redesign-shell">
    <header>
      <p class="redesign-kicker">
        {locale === 'en' ? 'Around your fulfilment requirements' : '围绕你的仓配需求'}
      </p><h2 id="south-business-heading">
        {
          locale === 'en'
            ? 'Receiving, fulfilment and returns, each with a clear route'
            : '货源、履约与退货，各有入口'
        }
      </h2>
    </header>
    <div class="south-business__lanes">
      <article>
        <span>01</span><h3>
          {locale === 'en' ? 'Factory and brand stock receiving' : '工厂与品牌货源入仓'}
        </h3><p>
          {
            locale === 'en'
              ? 'Connect factory-to-warehouse receiving and inventory management to prepare for later dispatch.'
              : '从工厂到仓库，衔接货品入库与库存管理，为后续发货做好准备。'
          }
        </p>{
          groups.industry.map(({ title, desc }) => (
            <p data-redesign-feature>
              <>
                <b data-feature-title>{title}</b>
                <span data-feature-description>{desc}</span>
              </>
            </p>
          ))
        }
      </article><article>
        <span>02</span><h3>{locale === 'en' ? 'Channel order fulfilment' : '渠道订单履约'}</h3><p>
          {
            locale === 'en'
              ? 'Support e-commerce dispatch and store replenishment, with outbound delivery arranged for the requirement.'
              : '支持电商发货与门店补货，按需求安排出库配送。'
          }
        </p>{
          stats.channels.map(({ stat, label, sub }) => (
            <p class="south-stat">
              <>
                <b>{stat}</b>
                <span>
                  {label} · {sub}
                </span>
              </>
            </p>
          ))
        }
      </article><article>
        <span>03</span><h3>{locale === 'en' ? 'Nearby returns handling' : '就近退货处理'}</h3><p>
          {
            locale === 'en'
              ? 'Returns can be checked at a nearby warehouse, sorted by item condition, and connected to care, repair and restocking.'
              : '退货就近回仓检查，按商品状态分类，衔接后整修复与重新上架。'
          }
        </p>{
          groups.returns.map(({ title, desc }) => (
            <p data-redesign-feature>
              <>
                <b data-feature-title>{title}</b>
                <span data-feature-description>{desc}</span>
              </>
            </p>
          ))
        }
      </article>
    </div>
    {
      groups.other.length > 0 && (
        <div class="south-business__support">
          {groups.other.map(({ title, desc }) => (
            <p data-redesign-feature>
              <b data-feature-title>{title}</b>
              <span data-feature-description>{desc}</span>
            </p>
          ))}
        </div>
      )
    }
    <div class="south-confirm">
      <header>
        <p class="redesign-kicker">
          {locale === 'en' ? 'For everyday operations' : '配合你的日常经营'}
        </p><h2>
          {
            locale === 'en'
              ? 'From receiving to dispatch, arranged around your business'
              : '从入仓到发货，配合你的业务'
          }
        </h2>
      </header><div class="south-confirm__rows">
        {
          SOUTH_COLLABORATION_BANDS.map(({ num, title, desc, signal }, index) => (
            <article>
              <>
                <span>{num}</span>
                <h3>{locale === 'en' ? englishBands[index].title : title}</h3>
                <p>{locale === 'en' ? englishBands[index].desc : desc}</p>
                <small>{locale === 'en' ? englishBands[index].signal : signal}</small>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
