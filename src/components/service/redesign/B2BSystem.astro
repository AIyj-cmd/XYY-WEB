---
import type { FeatureItem } from '@/data/service'
import type { SiteLocale } from '@/i18n/routes'
import { REDESIGN_ENGLISH_UI } from '@/i18n/redesign-ui'
interface Props {
  inventory: FeatureItem[]
  erp: FeatureItem[]
  contentDesc: string
  locale?: SiteLocale
}
const { inventory, erp, contentDesc, locale = 'zh-CN' } = Astro.props
const copy = REDESIGN_ENGLISH_UI.b2b
---

<section class="b2b-system b2b-section" aria-labelledby="b2b-system-heading">
  <div class="redesign-shell">
    <header class="b2b-section-heading">
      <p class="redesign-kicker">{locale === 'en' ? copy.system : '库存与系统'}</p><h2
        id="b2b-system-heading"
      >
        {locale === 'en' ? copy.systemHeading : '线上卖货，线下补货，库存一起管理。'}
      </h2>
    </header>
    <div class="b2b-system__inventory">
      <strong>{locale === 'en' ? copy.inventory : '统一库存'}</strong><span
        >{locale === 'en' ? copy.b2c : '线上 B2C 订单'}</span
      ><span>{locale === 'en' ? copy.store : '线下 B2B 门店补货'}</span>
    </div>
    <p class="b2b-system__lead">
      {locale === 'en' ? copy.lead : '接收补货指令、组织门店出库、回传物流信息。'}
    </p>
    {contentDesc && <p class="b2b-system__description">{contentDesc}</p>}
    <div class="b2b-system__features">
      {
        inventory.concat(erp).map(({ title, desc }) => (
          <p data-redesign-feature>
            <b>{title}</b>
            {desc}
          </p>
        ))
      }
    </div>
  </div>
</section>
