---
import type { ServicePageContent } from '@/lib/directus-content-queries'
import ContactLink from '@/components/conversion/ContactLink.astro'
import type { SiteLocale } from '@/i18n/routes'
import { liveUi } from './live-ui-copy'

interface Props {
  content: ServicePageContent
  videoSrc: string
  poster: string
  locale?: SiteLocale
}

const { content, videoSrc, poster, locale = 'zh-CN' } = Astro.props
const copy = liveUi(locale)
const hasCopy = content.h1 || content.h1sub || content.heroDesc
---

<header class="live-hero">
  <div class="redesign-shell live-hero__grid">
    {
      hasCopy && (
        <div class="live-hero__copy">
          {content.h1 && (
            <h1 id="lp-h1">
              <span>{content.h1}</span>
              {content.h1sub && <em>{content.h1sub}</em>}
            </h1>
          )}
          {!content.h1 && content.h1sub && <p class="live-hero__statement">{content.h1sub}</p>}
          {content.heroDesc && <p class="live-hero__description">{content.heroDesc}</p>}
          <p class="live-hero__scenes" aria-label={copy.scenesLabel}>
            <>
              {copy.scenes.map((scene) => (
                <span>{scene}</span>
              ))}
            </>
          </p>
          <ContactLink
            sourcePath={Astro.url.pathname}
            {locale}
            entry="hero"
            class="redesign-button"
          >
            {copy.contact}
          </ContactLink>
        </div>
      )
    }
    <video
      class="live-hero__video"
      data-service-hero-media
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      width="1280"
      height="720"
      poster={poster}
      aria-label={`${content.h1 || content.breadcrumbLabel} ${copy.serviceVideo}`}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
</header>
