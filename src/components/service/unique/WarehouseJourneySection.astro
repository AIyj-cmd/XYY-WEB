---
import { CLAIM_TEXT } from '@/lib/claims'

const FLOW_STEPS = [
  { num: '01', title: '收货入库', desc: '验收商品\n核对数量·SKU·规格' },
  { num: '02', title: '入库质检', desc: '按项目约定进行新货抽检或全检\n问题及时反馈品牌方' },
  { num: '03', title: 'RFID上架', desc: '绑码建档\n智能定位存储' },
  { num: '04', title: '订单下发', desc: '多平台实时同步\n波次智能拆分' },
  { num: '05', title: '拣货复核', desc: '电子标签引导\nRFID防错复核' },
  { num: '06', title: '质检打包', desc: '称重验货\n按标准包材打包' },
  { num: '07', title: '发货出库', desc: CLAIM_TEXT.shippingSla.replace('，', '\n') },
]
---

<section class="py-14 bg-white border-b border-gray-100" aria-labelledby="flow-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id="flow-heading" class="text-xl font-black text-navy-800 mb-1 text-center">
      鞋服云仓标准服务流程
    </h2>
    <p class="text-xs text-gray-400 text-center mb-10">
      从货物到仓到发货出库，每步标准化操作，全程1080P监控可追溯
    </p>
    <div class="journey-scroll overflow-x-auto -mx-4 px-4 pb-2">
      <div class="journey-track">
        <div class="journey-rail" aria-hidden="true"><span></span></div>
        {
          FLOW_STEPS.map(({ num, title, desc }, i) => (
            <div class="journey-group" style={`--journey-index: ${i}`}>
              <div class="flex flex-col items-center text-center w-32 px-1">
                <div class="journey-badge w-11 h-11 rounded-2xl bg-white border border-brand-orange/25 flex items-center justify-center mb-3 flex-shrink-0">
                  <span class="text-[11px] font-black text-brand-orange tracking-widest">
                    {num}
                  </span>
                </div>
                <p class="text-sm font-bold text-navy-800 mb-1">{title}</p>
                <p class="text-xs text-gray-400 leading-snug whitespace-pre-line">{desc}</p>
              </div>
              {i < FLOW_STEPS.length - 1 && (
                <div class="journey-connector" aria-hidden="true">
                  <span>›</span>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <div class="mt-8 flex items-center justify-center gap-2">
      <div class="h-px w-8 bg-brand-orange/20"></div>
      <p class="text-xs text-gray-400">
        退货逆向：退件进入质检中心后完成四级评定、修复分流与二次上架，全流程时效为{
          CLAIM_TEXT.returnTurnaround
        }；具体分级条件和处置方式按客户确认标准执行
      </p>
      <div class="h-px w-8 bg-brand-orange/20"></div>
    </div>
  </div>
</section>

<style>
  .journey-track {
    position: relative;
    display: flex;
    align-items: flex-start;
    width: max-content;
  }

  .journey-group {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    animation: journey-enter 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--journey-index) * 90ms);
  }

  .journey-badge {
    box-shadow: 0 0 0 5px rgb(255 255 255 / 85%);
    animation: journey-breathe 3.2s ease-in-out infinite;
    animation-delay: calc(var(--journey-index) * 180ms);
  }

  .journey-connector {
    display: flex;
    flex-shrink: 0;
    align-items: flex-start;
    padding: 0.8rem 0.25rem 0;
    color: rgb(244 82 24 / 40%);
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1;
  }

  .journey-connector span {
    animation: journey-arrow 1.8s ease-in-out infinite;
    animation-delay: calc(var(--journey-index) * 120ms);
  }

  .journey-rail {
    position: absolute;
    top: 1.34rem;
    right: 4rem;
    left: 4rem;
    height: 1px;
    overflow: hidden;
    background: rgb(244 82 24 / 12%);
  }

  .journey-rail span {
    position: absolute;
    inset-block: 0;
    left: -22%;
    width: 22%;
    background: linear-gradient(90deg, transparent, rgb(244 82 24 / 65%), transparent);
    animation: journey-sweep 4.2s linear infinite;
  }

  @media (min-width: 1024px) {
    .journey-track {
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-group,
    .journey-badge,
    .journey-connector span,
    .journey-rail span {
      animation: none;
    }
  }

  @keyframes journey-enter {
    from {
      opacity: 0.35;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes journey-breathe {
    0%,
    100% {
      border-color: rgb(244 82 24 / 25%);
      box-shadow: 0 0 0 5px rgb(255 255 255 / 85%);
    }
    50% {
      border-color: rgb(244 82 24 / 55%);
      box-shadow:
        0 0 0 5px rgb(255 255 255 / 0.9),
        0 0 0 9px rgb(244 82 24 / 6%);
    }
  }

  @keyframes journey-arrow {
    0%,
    100% {
      opacity: 0.35;
      transform: translateX(-2px);
    }
    50% {
      opacity: 0.9;
      transform: translateX(3px);
    }
  }

  @keyframes journey-sweep {
    to {
      left: 100%;
    }
  }
</style>
