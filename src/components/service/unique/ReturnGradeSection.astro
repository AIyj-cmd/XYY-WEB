---
import { CLAIM_TEXT } from '@/lib/claims'

const GRADE_TABLE = [
  {
    grade: 'A 级',
    label: '良品',
    color: 'bg-green-50 text-green-700 border-green-200',
    dotColor: 'bg-green-500',
    def: '符合品牌确认的良品判定规则',
    cases: '包装完好 · 无折痕 · 吊牌齐全 · 无污损',
    action: '按品牌授权进入可售库存',
    sla: `纳入${CLAIM_TEXT.returnTurnaround}整体流程`,
  },
  {
    grade: 'B+ 级',
    label: '轻微可售',
    color: 'bg-yellow-50 text-yellow-700 border-yellow-200',
    dotColor: 'bg-yellow-400',
    def: '存在品牌规则允许的轻微异常，需整理或确认',
    cases: '轻微折痕 · 包装轻损 · 轻微皱褶',
    action: '整理后按品牌授权上架或等待确认',
    sla: `纳入${CLAIM_TEXT.returnTurnaround}整体流程`,
  },
  {
    grade: 'B- 级',
    label: '修复可售',
    color: 'bg-orange-50 text-orange-700 border-orange-200',
    dotColor: 'bg-brand-orange',
    def: '存在需处理的异常，可按品牌规则进入修复流程',
    cases: '开线 / 缝补 · 油污清洗 · 配件缺失 · 印绣脱落',
    action: '流转修复车间，修复后二次质检通过再上架',
    sla: `纳入${CLAIM_TEXT.returnTurnaround}整体流程`,
  },
  {
    grade: 'C 级',
    label: '待处置',
    color: 'bg-red-50 text-red-700 border-red-200',
    dotColor: 'bg-red-500',
    def: '不符合当前可售或修复规则，等待品牌授权处置',
    cases: '破损严重 · 结构性损坏 · 严重污损 · 异味不可去除',
    action: '按品牌方确认方案进行隔离、退回或其他处置',
    sla: '按约定通知',
  },
]
---

<section class="py-14 bg-white border-b border-gray-100" aria-labelledby="grade-table-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id="grade-table-heading" class="text-xl font-black text-navy-800 mb-1 text-center">
      A / B+ / B- / C 四级质检处置示例
    </h2>
    <p class="text-xs text-gray-400 text-center mb-8">
      以下为分流示例，具体判定条件和处置方式按客户确认标准执行
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        GRADE_TABLE.map(({ grade, label, color, dotColor, def, cases, action, sla }) => (
          <div class={`rounded-xl border p-5 ${color}`}>
            <div class="flex items-center gap-2 mb-3">
              <div class={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${dotColor}`} />
              <span class="font-black text-base">{grade}</span>
              <span class="text-xs font-semibold opacity-70">{label}</span>
            </div>
            <p class="text-xs leading-relaxed mb-3 opacity-80">{def}</p>
            <div class="space-y-2 text-xs">
              <div>
                <span class="font-bold opacity-60 tracking-wider text-[10px] uppercase block mb-0.5">
                  典型情况
                </span>
                <p class="opacity-75 leading-snug">{cases}</p>
              </div>
              <div>
                <span class="font-bold opacity-60 tracking-wider text-[10px] uppercase block mb-0.5">
                  处置方案
                </span>
                <p class="font-semibold leading-snug">{action}</p>
              </div>
              <div class="flex items-center gap-1.5 pt-1 border-t border-current/10">
                <span class="font-bold opacity-50 text-[10px] uppercase">时效目标</span>
                <span class="font-bold">{sla}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-xs text-gray-400 text-center mt-5">
      品牌方可按需自定义各级处置规则，新亦源按约定执行并输出质检报告
    </p>
  </div>
</section>
