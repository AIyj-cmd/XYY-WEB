---
import { SOUTH_NETWORK_NODES } from '@/data/service/south-network'
---

<div
  class="relative mt-12 overflow-hidden border-y border-blue-200/80 bg-white/85 px-5 py-8 shadow-[0_28px_70px_rgba(30,64,120,.08)] sm:px-8 lg:px-10"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-1/2 hidden h-px bg-gradient-to-r from-transparent via-blue-300 to-transparent lg:block"
  >
  </div>
  <div class="relative grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0">
    {
      SOUTH_NETWORK_NODES.map(({ city, code, role, note }, index) => (
        <article
          class={`relative min-w-0 lg:px-7 ${index > 0 ? 'lg:border-l lg:border-slate-200' : ''}`}
        >
          <div class="mb-6 flex items-center gap-3">
            <span
              class={`relative z-10 block rounded-full border-[5px] border-white shadow-[0_0_0_1px_rgba(37,99,235,.25)] ${index === 0 ? 'h-5 w-5 bg-brand-orange' : 'h-4 w-4 bg-blue-600'}`}
            />
            <span class="font-mono text-[10px] font-bold tracking-[0.18em] text-blue-600">
              {code}
            </span>
          </div>
          <h3 class="text-2xl font-black text-navy-800">{city}</h3>
          <p class="mt-3 text-sm font-bold leading-6 text-slate-700">{role}</p>
          <p class="mt-2 text-xs leading-5 text-slate-500">{note}</p>
        </article>
      ))
    }
  </div>
</div>
