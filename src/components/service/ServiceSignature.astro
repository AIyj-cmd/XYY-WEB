---
type ServiceVariant =
  | 'journey'
  | 'showroom'
  | 'guangzhou-hub'
  | 'south-network'
  | 'east-radius'
  | 'store-rhythm'
  | 'global-tower'
  | 'live-command'
  | 'jit-radar'
  | 'evidence-lab'
  | 'repair-workshop'
  | 'delivery-desk'

interface StatItem {
  stat: string
  label: string
  sub: string
}

interface FeatureItem {
  title: string
  desc: string
}

interface Props {
  variant: ServiceVariant
  h1: string
  contentDesc: string
  stats: [StatItem, StatItem, StatItem, StatItem]
  features: FeatureItem[]
}

const { variant, h1, contentDesc, stats, features } = Astro.props

const CONFIG: Record<
  ServiceVariant,
  { code: string; kicker: string; heading: string; summary: string }
> = {
  journey: {
    code: 'FLOW / 01',
    kicker: '一件货的仓内旅程',
    heading: '让每一次入仓、流转与出库都有明确下一站',
    summary:
      '以货物流为页面主轴，把高 SKU 管理、RFID 识别、全渠道履约和峰值产能串成一条连续作业线。',
  },
  showroom: {
    code: 'SPACE / 02',
    kicker: '面料友好型仓储展厅',
    heading: '不同服装，不应被放进同一种仓储逻辑',
    summary: '挂装、叠装、鞋类和特殊面料采用不同空间与作业方式，页面以仓内展厅呈现品类差异。',
  },
  'guangzhou-hub': {
    code: 'HUB / GZ',
    kicker: '广州核心枢纽',
    heading: '从广州仓点出发，连接珠三角订单与货源',
    summary: '用本地仓点、订单区域和协同线路组织服务，而不是把广州方案缩写成一组通用能力。',
  },
  'south-network': {
    code: 'NETWORK / S',
    kicker: '华南多仓协同网络',
    heading: '仓容、人力、物流与系统在区域内一起调度',
    summary: '广州、东莞、佛山与肇庆节点按项目组合，通过四类资源协同承接日常履约与货量波动。',
  },
  'east-radius': {
    code: 'RADIUS / E',
    kicker: '华东时效覆盖面板',
    heading: '库存前置到区域节点，再由时效圈组织履约',
    summary: '以华东节点和订单覆盖为中心，呈现区域仓配、签收监控与华南华东协同关系。',
  },
  'store-rhythm': {
    code: 'STORE / B2B',
    kicker: '门店补货节奏轴',
    heading: '不是一次发完，而是让每家门店按节奏收到正确货品',
    summary: '把铺货、补货、调拨和退仓放进同一张作业单，清楚呈现门店仓配与普通电商小包的差异。',
  },
  'global-tower': {
    code: 'ROUTE / GLOBAL',
    kicker: '世界航线控制塔',
    heading: '正向出海与逆向回流，共用一套可追踪节点',
    summary:
      '围绕跨境仓、质检、包装、上架、发货与退货回流组织双向链路，业务边界在每个节点清晰可见。',
  },
  'live-command': {
    code: 'LIVE / NOW',
    kicker: '直播履约战情中心',
    heading: '围绕开播时间组织库存、波次、人力与异常处理',
    summary: '订单波峰不是事后统计，而是在直播前、直播中和直播后被连续监控和调度。',
  },
  'jit-radar': {
    code: 'SLA / JIT',
    kicker: 'JIT / JITX 时限与风险雷达',
    heading: '两种模式并行运行，每个风险点提前进入视野',
    summary: '将库存同步、订单响应、复核出库和异常工单放到双轨时钟上，突出平台履约的过程控制。',
  },
  'evidence-lab': {
    code: 'EVIDENCE / QC',
    kicker: '订单证据实验室',
    heading: '从拆包到分级，每个判断都能回到操作证据',
    summary: '录像、订单核验、缺陷图片、质检分级和系统报表组成一条可追溯的退货处理证据链。',
  },
  'repair-workshop': {
    code: 'WORKSHOP / 09',
    kicker: '蓝色修复工坊',
    heading: '让不同瑕疵进入对应工位，再以二次质检结束',
    summary: '洗护、清污、缝补、配饰、鞋类、整烫与标识处理采用不同工艺，不以一套模板概括全部修复。',
  },
  'delivery-desk': {
    code: 'DELIVERY / 11',
    kicker: '智能寄件协同台',
    heading: '从寄件入口一直管到签收与异常闭环',
    summary: '承运商、运单、轨迹、签收、异常和报表统一在一个业务入口内协同，不再分散到多个查询后台。',
  },
}

const config = CONFIG[variant]
---

<section
  class:list={['signature', `signature--${variant}`]}
  aria-labelledby={`signature-heading-${variant}`}
>
  <div class="signature__inner">
    <header class="signature__header">
      <div>
        <p class="signature__code">{config.code}</p>
        <p class="signature__kicker">{config.kicker}</p>
      </div>
      <div class="signature__heading-wrap">
        <h2 id={`signature-heading-${variant}`}>{config.heading}</h2>
        <p>{config.summary}</p>
      </div>
    </header>

    {
      variant === 'journey' && (
        <div class="journey">
          <figure class="journey__scene">
            <img
              src="/images/services/warehouse-panorama.webp"
              alt={`${h1}仓内作业实景`}
              loading="lazy"
            />
            <figcaption>
              <span>WAREHOUSE JOURNEY</span>
              <strong>从到仓开始建立可追踪货品档案</strong>
            </figcaption>
          </figure>
          <ol class="journey__rail">
            {features.slice(0, 5).map(({ title, desc }, index) => (
              <li>
                <span class="journey__index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="journey__instruments">
            {stats.map(({ stat, label, sub }) => (
              <div>
                <strong>{stat}</strong>
                <span>{label}</span>
                <small>{sub}</small>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'showroom' && (
        <div class="showroom">
          <div class="showroom__gallery">
            <figure class="showroom__hero">
              <img
                src="/images/services/warehouse-hanging.webp"
                alt="挂装服饰仓储实景"
                loading="lazy"
              />
              <figcaption>挂装空间 / 保持版型</figcaption>
            </figure>
            <figure>
              <img
                src="/images/services/storage-environment.webp"
                alt="服装分类存储环境"
                loading="lazy"
              />
              <figcaption>环境分区</figcaption>
            </figure>
            <figure>
              <img src="/images/services/storage-shoes.webp" alt="鞋类分区存储" loading="lazy" />
              <figcaption>鞋类货位</figcaption>
            </figure>
          </div>
          <div class="showroom__catalogue">
            <p class="showroom__lead">{contentDesc}</p>
            <ol>
              {features.slice(0, 4).map(({ title, desc }, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </li>
              ))}
            </ol>
            <div class="showroom__labels">
              {stats.map(({ stat, label }) => (
                <div>
                  <strong>{stat}</strong>
                  <span>{label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {
      variant === 'guangzhou-hub' && (
        <div class="hub">
          <div class="hub__map" aria-label="广州及珠三角协同示意">
            <div class="hub__rings" aria-hidden="true" />
            <span class="hub__node hub__node--gz">
              <b>广州</b>
              <small>核心枢纽</small>
            </span>
            <span class="hub__node hub__node--dg">东莞</span>
            <span class="hub__node hub__node--fs">佛山</span>
            <span class="hub__node hub__node--zq">肇庆</span>
            <span class="hub__route hub__route--one" aria-hidden="true" />
            <span class="hub__route hub__route--two" aria-hidden="true" />
            <span class="hub__route hub__route--three" aria-hidden="true" />
            <p>PRD · LOCAL FULFILMENT</p>
          </div>
          <div class="hub__ledger">
            {stats.map(({ stat, label, sub }, index) => (
              <div>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{stat}</strong>
                <div>
                  <b>{label}</b>
                  <small>{sub}</small>
                </div>
              </div>
            ))}
          </div>
          <div class="hub__capabilities">
            {features.slice(0, 4).map(({ title, desc }) => (
              <article>
                <h3>{title}</h3>
                <p>{desc}</p>
              </article>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'south-network' && (
        <div class="south">
          <figure class="south__scene">
            <img
              src="/images/services/warehouse-shelves.webp"
              alt="华南鞋服仓储货架实景"
              loading="lazy"
            />
            <figcaption>
              <span>REGIONAL ORCHESTRATION</span>
              <strong>区域资源按项目组合</strong>
            </figcaption>
          </figure>
          <div class="south__orchestra">
            {features.slice(0, 4).map(({ title, desc }, index) => (
              <article>
                <span>{['仓容', '人力', '物流', '系统'][index]}</span>
                <h3>{title}</h3>
                <p>{desc}</p>
              </article>
            ))}
          </div>
          <div class="south__pulse">
            {stats.map(({ stat, label, sub }) => (
              <div>
                <strong>{stat}</strong>
                <span>{label}</span>
                <small>{sub}</small>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'east-radius' && (
        <div class="east">
          <div class="east__coverage">
            <div class="east__orbit east__orbit--one" aria-hidden="true" />
            <div class="east__orbit east__orbit--two" aria-hidden="true" />
            <div class="east__orbit east__orbit--three" aria-hidden="true" />
            <span class="east__city east__city--ks">昆山</span>
            <span class="east__city east__city--sh">上海</span>
            <span class="east__city east__city--hf">合肥</span>
            <div class="east__core">
              <small>FULFILMENT CORE</small>
              <strong>华东</strong>
              <span>库存前置 · 区域履约</span>
            </div>
          </div>
          <div class="east__screen">
            <div class="east__screen-bar">
              <span />
              <span />
              <span />
              <b>签收与时效面板</b>
            </div>
            <img
              src="/images/services/delivery-dashboard.webp"
              alt="物流签收与时效监控界面"
              loading="lazy"
            />
          </div>
          <div class="east__metrics">
            {stats.map(({ stat, label, sub }) => (
              <div>
                <strong>{stat}</strong>
                <span>{label}</span>
                <small>{sub}</small>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'store-rhythm' && (
        <div class="stores">
          <div class="stores__manifest">
            <div class="stores__manifest-head">
              <span>STORE REPLENISHMENT MANIFEST</span>
              <b>门店补货作业单</b>
            </div>
            <ol>
              {features.slice(0, 5).map(({ title, desc }, index) => (
                <li>
                  <time>{['MON', 'WED', 'FRI', 'WAVE', 'RETURN'][index]}</time>
                  <span class="stores__dot" aria-hidden="true" />
                  <div>
                    <h3>{title}</h3>
                    <p>{desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <aside class="stores__summary">
            <p>{contentDesc}</p>
            <div>
              {stats.map(({ stat, label, sub }) => (
                <article>
                  <strong>{stat}</strong>
                  <span>{label}</span>
                  <small>{sub}</small>
                </article>
              ))}
            </div>
          </aside>
        </div>
      )
    }

    {
      variant === 'delivery-desk' && (
        <div class="delivery">
          <figure class="delivery__console">
            <div class="delivery__console-bar">
              <span>YUNDAO DELIVERY DESK</span>
              <b>运单管理 / 实际系统界面</b>
            </div>
            <img
              src="/yundao-logistics-list.png"
              alt="运到智能寄件平台运单管理界面"
              loading="lazy"
              width="926"
              height="490"
            />
            <figcaption>承运商、来源平台、运输状态和最后跟踪时间集中查询</figcaption>
          </figure>
          <aside class="delivery__summary">
            <p>{contentDesc}</p>
            <div>
              {stats.map(({ stat, label, sub }) => (
                <article>
                  <strong>{stat}</strong>
                  <span>{label}</span>
                  <small>{sub}</small>
                </article>
              ))}
            </div>
          </aside>
          <ol class="delivery__capabilities">
            {features.slice(0, 6).map(({ title, desc }, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{desc}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      variant === 'global-tower' && (
        <div class="global">
          <div class="global__map">
            <img src="/images/services/global-map.webp" alt="跨境仓配世界航线示意" loading="lazy" />
            <span class="global__point global__point--one">中国仓</span>
            <span class="global__point global__point--two">海外仓</span>
            <span class="global__point global__point--three">消费市场</span>
            <span class="global__flight global__flight--out">正向履约</span>
            <span class="global__flight global__flight--back">逆向回流</span>
          </div>
          <div class="global__tower">
            <p>{contentDesc}</p>
            <ol>
              {features.slice(0, 4).map(({ title, desc }, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{title}</h3>
                    <p>{desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="global__metrics">
            {stats.map(({ stat, label, sub }) => (
              <div>
                <strong>{stat}</strong>
                <span>{label}</span>
                <small>{sub}</small>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'live-command' && (
        <div class="live">
          <div class="live__console">
            <div class="live__console-top">
              <span>LIVE FULFILMENT</span>
              <b>
                <i /> 直播履约监控中
              </b>
            </div>
            <img
              src="/images/services/operations-dashboard.webp"
              alt="直播仓配运营驾驶舱"
              loading="lazy"
            />
            <div class="live__signals">
              {stats.map(({ stat, label }) => (
                <div>
                  <strong>{stat}</strong>
                  <span>{label}</span>
                </div>
              ))}
            </div>
          </div>
          <ol class="live__timeline">
            {features.slice(0, 5).map(({ title, desc }, index) => (
              <li>
                <time>{['开播前', '开播', '订单波峰', '持续履约', '复盘'][index]}</time>
                <div>
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      variant === 'jit-radar' && (
        <div class="jit">
          <div class="jit__radar">
            <div class="jit__sweep" aria-hidden="true" />
            <div class="jit__center">
              <small>RISK CONTROL</small>
              <strong>JIT / JITX</strong>
              <span>库存 · 时效 · 异常</span>
            </div>
            {stats.map(({ stat, label }, index) => (
              <span class={`jit__blip jit__blip--${index + 1}`}>
                <b>{stat}</b>
                <small>{label}</small>
              </span>
            ))}
          </div>
          <div class="jit__rails">
            <div class="jit__rail-head">
              <span>JIT</span>
              <span>JITX</span>
            </div>
            {features.slice(0, 5).map(({ title, desc }, index) => (
              <article>
                <span class="jit__time">{String(index + 1).padStart(2, '0')}</span>
                <div class="jit__line" aria-hidden="true">
                  <i />
                  <i />
                </div>
                <div>
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      )
    }

    {
      variant === 'evidence-lab' && (
        <div class="evidence">
          <div class="evidence__strip">
            {[
              {
                src: '/images/services/inspection-unpack.webp',
                title: '01 拆包',
                alt: '退货拆包操作',
              },
              {
                src: '/images/services/inspection-scan.webp',
                title: '02 核验',
                alt: '退货订单扫码核验',
              },
              {
                src: '/images/services/inspection-workbench.webp',
                title: '03 质检',
                alt: '服装质检工作台',
              },
              {
                src: '/images/services/inspection-sort.webp',
                title: '04 分流',
                alt: '质检完成后的商品分流',
              },
            ].map(({ src, title, alt }) => (
              <figure>
                <img src={src} alt={alt} loading="lazy" />
                <figcaption>{title}</figcaption>
              </figure>
            ))}
          </div>
          <div class="evidence__bench">
            <div class="evidence__screen">
              <div>
                <>
                  <span />
                  <span />
                  <span />
                  <b>QC EVIDENCE SYSTEM</b>
                </>
              </div>
              <img
                src="/images/services/inspection-system.webp"
                alt="质检图片与报表系统界面"
                loading="lazy"
              />
            </div>
            <div class="evidence__findings">
              {stats.map(({ stat, label, sub }, index) => (
                <article>
                  <span>0{index + 1}</span>
                  <strong>{stat}</strong>
                  <div>
                    <b>{label}</b>
                    <small>{sub}</small>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {
      variant === 'repair-workshop' && (
        <div class="workshop">
          <div class="workshop__gallery">
            <figure class="workshop__wide">
              <img
                src="/images/services/repair-handwash.webp"
                alt="服装手工洗护工位"
                loading="lazy"
              />
              <figcaption>洗护 / WASH</figcaption>
            </figure>
            <figure>
              <img
                src="/images/services/repair-stitch.webp"
                alt="服装精细缝补工位"
                loading="lazy"
              />
              <figcaption>缝补 / STITCH</figcaption>
            </figure>
            <figure>
              <img
                src="/images/services/repair-ironing.webp"
                alt="服装整烫定型工位"
                loading="lazy"
              />
              <figcaption>整烫 / FINISH</figcaption>
            </figure>
          </div>
          <div class="workshop__board">
            <p>{contentDesc}</p>
            <ol>
              {features.map(({ title, desc }, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{title}</h3>
                    <p>{desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="workshop__results">
            {stats.map(({ stat, label, sub }) => (
              <div>
                <strong>{stat}</strong>
                <span>{label}</span>
                <small>{sub}</small>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .signature {
    --ink: #132b50;
    --blue: #144297;
    --signal: #e85d26;
    --line: #dce5f1;
    padding: clamp(4rem, 8vw, 7.5rem) 0;
    overflow: hidden;
    background: #fff;
    color: var(--ink);
  }

  .signature__inner {
    width: min(80rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .signature__header {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .signature__code {
    margin: 0 0 0.35rem;
    color: var(--signal);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.24em;
  }

  .signature__kicker {
    margin: 0;
    color: #5e6f87;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .signature__heading-wrap h2 {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(2rem, 4.2vw, 4rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .signature__heading-wrap p {
    max-width: 46rem;
    margin: 1rem 0 0;
    color: #607087;
