---
import {
  SERVICE_SIGNATURE_CONFIG,
  type FeatureItem,
  type ServiceVariant,
  type StatItem,
} from '@/data/service'
import ServiceSignatureWarehouse from './ServiceSignatureWarehouse.astro'
import ServiceSignatureDigital from './ServiceSignatureDigital.astro'
import ServiceSignatureQuality from './ServiceSignatureQuality.astro'
import '@/styles/service-signature.css'

interface Props {
  variant: ServiceVariant
  h1: string
  contentDesc: string
  stats: readonly StatItem[]
  features: FeatureItem[]
}

const { variant, h1, contentDesc, stats, features } = Astro.props

const config = SERVICE_SIGNATURE_CONFIG[variant]
---

<section
  class:list={['signature', `signature--${variant}`]}
  aria-labelledby={`signature-heading-${variant}`}
>
  <div class="signature__inner">
    <header class="signature__header" data-service-reveal="copy">
      <div>
        <p class="signature__code">{config.code}</p>
        <p class="signature__kicker">{config.kicker}</p>
      </div>
      <div class="signature__heading-wrap">
        <h2 id={`signature-heading-${variant}`}>{config.heading}</h2>
        <p>{config.summary}</p>
      </div>
    </header>

    <div class="signature__body" data-service-reveal="visual">
      <ServiceSignatureWarehouse
        variant={variant}
        h1={h1}
        contentDesc={contentDesc}
        stats={stats}
        features={features}
      />
      <ServiceSignatureDigital
        variant={variant}
        contentDesc={contentDesc}
        stats={stats}
        features={features}
      />
      <ServiceSignatureQuality
        variant={variant}
        contentDesc={contentDesc}
        stats={stats}
        features={features}
      />
    </div>
  </div>
</section>
