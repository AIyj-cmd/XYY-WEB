---
import {
  SERVICE_SIGNATURE_CONFIG,
  type FeatureItem,
  type ServiceVariant,
  type StatItem,
} from '@/data/service'
import DeliveryDeskSignature from './signature/DeliveryDeskSignature.astro'
import { smartShippingCopy } from '@/i18n/smart-shipping'
import type { SiteLocale } from '@/i18n/routes'
import '@/styles/service-signature.css'

interface Props {
  variant: ServiceVariant
  contentDesc: string
  stats: readonly StatItem[]
  features: FeatureItem[]
  locale?: SiteLocale
}

const { variant, contentDesc, stats, features, locale = 'zh-CN' } = Astro.props

const config =
  locale === 'en' && variant === 'delivery-desk'
    ? smartShippingCopy(locale)!.signature
    : SERVICE_SIGNATURE_CONFIG[variant]
---

<section
  class:list={['signature', `signature--${variant}`]}
  aria-labelledby={`signature-heading-${variant}`}
>
  <div class="signature__inner">
    <header class="signature__header" data-service-reveal="copy">
      <div>
        <p class="signature__code">{config.code}</p>
        <p class="signature__kicker">{config.kicker}</p>
      </div>
      <div class="signature__heading-wrap">
        <h2 id={`signature-heading-${variant}`}>{config.heading}</h2>
        <p>{config.summary}</p>
      </div>
    </header>

    <div class="signature__body" data-service-reveal="visual">
      {
        variant === 'delivery-desk' && (
          <DeliveryDeskSignature {contentDesc} {stats} {features} {locale} />
        )
      }
    </div>
  </div>
</section>
