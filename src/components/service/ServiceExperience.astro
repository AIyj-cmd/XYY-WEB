---
import {
  SERVICE_EXPERIENCE_COPY,
  type FaqItem,
  type FeatureItem,
  type ServiceVariant,
} from '@/data/service'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import { smartShippingCopy } from '@/i18n/smart-shipping'
import type { SiteLocale } from '@/i18n/routes'
import '@/styles/service-experience.css'

interface Props {
  variant: ServiceVariant
  h1: string
  breadcrumbLabel: string
  contentDesc: string
  featuresLabel: string
  features: FeatureItem[]
  faqs: FaqItem[]
  useConversionCta: boolean
  locale?: SiteLocale
}

const {
  variant,
  h1,
  breadcrumbLabel,
  contentDesc,
  featuresLabel,
  features,
  faqs,
  useConversionCta,
  locale = 'zh-CN',
} = Astro.props
const copy = SERVICE_EXPERIENCE_COPY[variant]
const english =
  locale === 'en' && variant === 'delivery-desk' ? smartShippingCopy(locale) : undefined
---

<section
  class:list={['service-detail', `service-detail--${variant}`]}
  aria-labelledby="lp-detail-heading"
>
  <div class="service-detail__inner">
    <header class="service-detail__header" data-service-reveal="copy">
      <div>
        <p>{copy.detailCode}</p>
        <span>{featuresLabel}</span>
      </div>
      <h2 id="lp-detail-heading">{english?.experience.detailTitle ?? copy.detailTitle}</h2>
    </header>

    <div class="service-detail__layout">
      <aside class="service-detail__brief" data-service-reveal="copy">
        <p>{contentDesc}</p>
        <nav aria-label={english?.experience.linksAria ?? '产品服务相关页面'}>
          <span>{english?.experience.linksHeading ?? '继续了解'}</span>
          {
            english ? (
              english.experience.links.map(({ href, label }) => <a {href}>{label}</a>)
            ) : (
              <>
                <a href="/product">产品服务总览</a>
                <a href="/cases">合作案例</a>
                <a href="/contact">联系商务</a>
              </>
            )
          }
        </nav>
      </aside>

      <ol class="service-detail__features">
        {
          features.map(({ title, desc }, index) => (
            <li data-service-reveal="copy">
              <span class="service-detail__index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p>{desc}</p>
              </div>
              <span class="service-detail__marker" aria-hidden="true">
                ↗
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section class:list={['service-faq', `service-faq--${variant}`]} aria-labelledby="lp-faq-heading">
  <div class="service-faq__inner">
    <header class="service-faq__header" data-service-reveal="copy">
      <p>{copy.faqCode}</p>
      <h2 id="lp-faq-heading">{english?.experience.faqHeading ?? `${breadcrumbLabel}常见问题`}</h2>
    </header>
    <dl class="service-faq__list">
      {
        faqs.map(({ q, a }, index) => (
          <div data-service-reveal="copy">
            <dt>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{q}</strong>
            </dt>
            <dd>{a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

{
  english ? (
    <ConversionCTA
      headingId="service-conversion-cta-heading"
      eyebrow={english.experience.useConversion.eyebrow}
      headingLines={[...english.experience.useConversion.heading]}
      description={english.experience.useConversion.description}
      actionLabel={english.experience.useConversion.action}
      actionHref="/en/contact"
      preparationTitle={english.experience.useConversion.preparationTitle}
      preparationAriaLabel={english.experience.useConversion.preparationAria}
      preparationItems={[...english.experience.useConversion.preparation]}
      reveal="service"
    />
  ) : useConversionCta ? (
    <ConversionCTA
      headingId="service-conversion-cta-heading"
      eyebrow="START A CONVERSATION"
      headingLines={[`把${h1}变成`, '可执行方案']}
      description={copy.ctaPrompt}
      actionLabel="获取专属方案"
      preparationTitle="沟通前可准备这 3 类信息"
      preparationItems={[
        { label: '业务现状', detail: '当前仓配流程 · 主要问题' },
        { label: '商品与订单', detail: 'SKU · 销售渠道 · 日均单量' },
        { label: '目标与节奏', detail: '服务重点 · 计划上线时间' },
      ]}
      reveal="service"
    />
  ) : (
    <ConversionCTA
      headingId="lp-cta-heading"
      eyebrow={`NEXT STEP · ${copy.detailCode}`}
      headingLines={[`把${h1}变成`, '可执行方案']}
      description={copy.ctaPrompt}
      actionLabel="免费获取方案"
      preparationTitle="服务重点"
      preparationItems={features
        .slice(0, 3)
        .map(({ title, desc }) => ({ label: title, detail: desc }))}
      secondaryLinks={[{ href: '/cases', label: '查看合作案例' }]}
      reveal="service"
    />
  )
}
