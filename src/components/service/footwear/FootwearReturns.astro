---
import { FOOTWEAR_ENGLISH_UI } from '@/i18n/footwear-ui'
import type { SiteLocale } from '@/i18n/routes'
interface Props {
  locale?: SiteLocale
}
const { locale = 'zh-CN' } = Astro.props
const copy = FOOTWEAR_ENGLISH_UI.returns
---

<section class="footwear-section footwear-returns" aria-labelledby="footwear-returns-heading">
  <div>
    <p class="footwear-section__label">{locale === 'en' ? copy.label : '退货处理'}</p>
    <h2 id="footwear-returns-heading">
      {locale === 'en' ? copy.heading : '退回来的商品，分清状态再处理。'}
    </h2>
    <p>
      {
        locale === 'en'
          ? copy.description
          : '退回商品经过核对与质检，按结果安排再次上架、整理或修复，让可售商品重新进入库存。'
      }
    </p>
  </div>
  <div class="footwear-returns__links">
    <a href={locale === 'en' ? '/en/returns-inspection' : '/tuihuo-zhijian'}
      ><span>{locale === 'en' ? copy.inspection : '退货质检'}</span><b
        >{locale === 'en' ? copy.inspectionDetail : '核对、质检与处理去向'}</b
      ></a
    >
    <a href={locale === 'en' ? '/en/garment-care' : '/houzheng-xiufu'}
      ><span>{locale === 'en' ? copy.care : '商品整理与修复'}</span><b
        >{locale === 'en' ? copy.careDetail : '按商品实际情况另行安排'}</b
      ></a
    >
  </div>
</section>
