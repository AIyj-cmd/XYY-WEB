---
import type { FeatureItem, StatItem } from '@/data/service'
import {
  FOOTWEAR_ENGLISH_FEATURE_TITLES,
  FOOTWEAR_ENGLISH_STAT_LABELS,
  FOOTWEAR_ENGLISH_UI,
} from '@/i18n/footwear-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  stats: readonly StatItem[]
  features: FeatureItem[]
  locale?: SiteLocale
}

const { stats, features, locale = 'zh-CN' } = Astro.props
const labels =
  locale === 'en'
    ? FOOTWEAR_ENGLISH_STAT_LABELS
    : { 发货准确率: '发货准确率', 截单时间: '截单时间', 单仓峰值: '单仓峰值' }
const titles =
  locale === 'en'
    ? FOOTWEAR_ENGLISH_FEATURE_TITLES
    : { 全程监控追溯: '全程监控追溯', 弹性产能机制: '弹性产能机制' }
const dailyStats = stats.filter(
  ({ label }) => label === labels.发货准确率 || label === labels.截单时间
)
const peakStats = stats.filter(({ label }) => label === labels.单仓峰值)
const dailyFeatures = features.filter(({ title }) => title === titles.全程监控追溯)
const peakFeatures = features.filter(({ title }) => title === titles.弹性产能机制)
const hasDaily = Boolean(dailyStats.length || dailyFeatures.length)
const hasPeak = Boolean(peakStats.length || peakFeatures.length)
---

<section class="footwear-section footwear-assurance" aria-labelledby="footwear-assurance-heading">
  <header class="footwear-assurance__heading">
    <p class="footwear-section__label">
      {locale === 'en' ? FOOTWEAR_ENGLISH_UI.assurance.label : '保障'}
    </p>
    <h2 id="footwear-assurance-heading">
      {locale === 'en' ? FOOTWEAR_ENGLISH_UI.assurance.heading : '日常发得准，旺季有安排。'}
    </h2>
  </header>
  <div class="footwear-assurance__blocks">
    {
      hasDaily && (
        <article>
          <p class="footwear-assurance__eyebrow">
            {locale === 'en' ? FOOTWEAR_ENGLISH_UI.assurance.daily : '日常作业'}
          </p>
          <h3>
            {locale === 'en' ? FOOTWEAR_ENGLISH_UI.assurance.dailyHeading : '扫码复核与发货安排'}
          </h3>
          {dailyStats.map(({ stat, label, sub }) => (
            <p>
              <strong>{stat}</strong>
              {label}
              {locale === 'en' ? ', ' : '，'}
              {sub}
            </p>
          ))}
          {dailyFeatures.map(({ title, desc }) => (
            <>
              <h3>{title}</h3>
              <p>{desc}</p>
            </>
          ))}
          <p>
            {locale === 'en'
              ? FOOTWEAR_ENGLISH_UI.assurance.dailyNote
              : '时效受项目方案、仓容、承运商线路和双方确认的服务范围影响。'}
          </p>
        </article>
      )
    }
    {
      hasPeak && (
        <article>
          <p class="footwear-assurance__eyebrow">
            {locale === 'en' ? FOOTWEAR_ENGLISH_UI.assurance.peak : '旺季准备'}
          </p>
          <h3>
            {locale === 'en'
              ? FOOTWEAR_ENGLISH_UI.assurance.peakHeading
              : '货量、人力和包材提前安排'}
          </h3>
          {peakStats.map(({ stat, label, sub }) => (
            <p>
              <strong>{stat}</strong>
              {label}
              {locale === 'en' ? ', ' : '，'}
              {sub}
            </p>
          ))}
          {peakFeatures.map(({ title, desc }) => (
            <>
              <h3>{title}</h3>
              <p>{desc}</p>
            </>
          ))}
        </article>
      )
    }
  </div>
</section>
