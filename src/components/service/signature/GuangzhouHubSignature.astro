---
import type { FeatureItem, StatItem } from '@/data/service'

interface Props {
  stats: [StatItem, StatItem, StatItem, StatItem]
  features: FeatureItem[]
}

const { stats, features } = Astro.props
---

<div class="hub">
  <div class="hub__map" aria-label="广州及珠三角协同示意">
    <div class="hub__rings" aria-hidden="true"></div>
    <span class="hub__node hub__node--gz"><b>广州</b><small>核心枢纽</small></span>
    <span class="hub__node hub__node--dg">东莞</span>
    <span class="hub__node hub__node--fs">佛山</span>
    <span class="hub__node hub__node--zq">肇庆</span>
    <span class="hub__route hub__route--one" aria-hidden="true"></span>
    <span class="hub__route hub__route--two" aria-hidden="true"></span>
    <span class="hub__route hub__route--three" aria-hidden="true"></span>
    <p>PRD · LOCAL FULFILMENT</p>
  </div>
  <div class="hub__ledger">
    {
      stats.map(({ stat, label, sub }, index) => (
        <div>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{stat}</strong>
          <div>
            <>
              <b>{label}</b>
              <small>{sub}</small>
            </>
          </div>
        </div>
      ))
    }
  </div>
  <div class="hub__capabilities">
    {
      features.slice(0, 4).map(({ title, desc }) => (
        <article>
          <>
            <h3>{title}</h3>
            <p>{desc}</p>
          </>
        </article>
      ))
    }
  </div>
</div>
