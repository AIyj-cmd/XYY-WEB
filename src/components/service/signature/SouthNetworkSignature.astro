---
import type { FeatureItem, StatItem } from '@/data/service'

interface Props {
  stats: readonly StatItem[]
  features: FeatureItem[]
}

const { stats, features } = Astro.props
const capabilityLabels = ['仓容', '人力', '物流', '系统']
---

<div class="south">
  <figure class="south__scene">
    <img src="/images/services/warehouse-shelves.webp" alt="华南鞋服仓储货架实景" loading="lazy" />
    <figcaption><span>REGIONAL ORCHESTRATION</span><strong>区域资源按项目组合</strong></figcaption>
  </figure>
  <div class="south__orchestra">
    {
      features.slice(0, 4).map(({ title, desc }, index) => (
        <article>
          <>
            <span>{capabilityLabels[index]}</span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </>
        </article>
      ))
    }
  </div>
  <div class="south__pulse">
    {
      stats.map(({ stat, label, sub }) => (
        <div>
          <>
            <strong>{stat}</strong>
            <span>{label}</span>
            <small>{sub}</small>
          </>
        </div>
      ))
    }
  </div>
</div>
