---
import type { StatItem } from '@/data/service'

interface Props {
  stats: [StatItem, StatItem, StatItem, StatItem]
}

const { stats } = Astro.props
---

<div class="east">
  <div class="east__coverage">
    <div class="east__orbit east__orbit--one" aria-hidden="true"></div>
    <div class="east__orbit east__orbit--two" aria-hidden="true"></div>
    <div class="east__orbit east__orbit--three" aria-hidden="true"></div>
    <span class="east__city east__city--ks">昆山</span>
    <span class="east__city east__city--sh">上海</span>
    <span class="east__city east__city--hf">合肥</span>
    <div class="east__core">
      <small>FULFILMENT CORE</small><strong>华东</strong><span>库存前置 · 区域履约</span>
    </div>
  </div>
  <div class="east__screen">
    <div class="east__screen-bar"><span></span><span></span><span></span><b>签收与时效面板</b></div>
    <img
      src="/images/services/delivery-dashboard.webp"
      alt="物流签收与时效监控界面"
      loading="lazy"
    />
  </div>
  <div class="east__metrics">
    {
      stats.map(({ stat, label, sub }) => (
        <div>
          <>
            <strong>{stat}</strong>
            <span>{label}</span>
            <small>{sub}</small>
          </>
        </div>
      ))
    }
  </div>
</div>
