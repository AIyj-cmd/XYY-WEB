---
import type { WhitepaperListing } from '@/data/whitepapers/types'
import '@/styles/publications-hero.css'

interface Props {
  latest?: WhitepaperListing
}

const { latest } = Astro.props
---

<section class="publications-hero" aria-labelledby="whitepapers-hero-heading">
  <img
    src="/whitepapers-research-hero.webp"
    alt=""
    aria-hidden="true"
    width="2400"
    height="1589"
    class="publications-hero__image"
    fetchpriority="high"
  />
  <div class="publications-hero__shade" aria-hidden="true"></div>
  <div class="publications-hero__content">
    <p class="publications-hero__eyebrow font-bold uppercase tracking-[0.4em] text-brand-orange">
      XINYIYUAN SUPPLY CHAIN · RESEARCH LIBRARY
    </p>
    <h1 id="whitepapers-hero-heading" class="publications-hero__title font-black text-white">
      Supply-chain whitepapers
    </h1>
    <p class="publications-hero__lead max-w-2xl font-bold text-white">
      Operational reference material for apparel supply-chain decisions.
    </p>
    <p class="publications-hero__description max-w-3xl text-navy-100">
      Browse translated issue summaries from Forest Journal. The article pages and PDFs remain in
      their original Chinese so that source material can be checked in context.
    </p>
    <div class="publications-hero__actions flex flex-wrap">
      {
        latest && (
          <a
            href={`/supply-chain-whitepapers/${latest.issue}/`}
            class="inline-flex items-center gap-2 rounded-xl bg-brand-orange px-6 py-3 font-bold text-white transition-colors hover:bg-brand-orange-dark"
          >
            Read Issue {latest.issue} in Chinese
          </a>
        )
      }
      {
        latest && (
          <a
            href={latest.sourcePdf}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-xl border border-white/30 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
          >
            Open Chinese PDF
          </a>
        )
      }
      <a
        href="#issues"
        class="inline-flex items-center gap-2 rounded-xl border border-white/30 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10"
      >
        Browse all issues
      </a>
    </div>
  </div>
</section>
