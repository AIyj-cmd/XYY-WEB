---
interface Props {
  latest?: { cover: string; pdf: string; readingHref: string }
}
const { latest } = Astro.props
---

<section class="relative py-20 overflow-hidden" aria-labelledby="slj-hero-heading">
  {
    latest && (
      <img
        src={latest.cover}
        alt="森林期刊封面"
        class="absolute inset-0 w-full h-full object-cover object-center"
        fetchpriority="high"
      />
    )
  }
  <div
    class="absolute inset-0"
    style="background: linear-gradient(105deg, rgba(8,20,42,0.97) 0%, rgba(8,20,42,0.85) 50%, rgba(8,20,42,0.55) 100%);"
    aria-hidden="true"
  >
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-brand-orange font-bold text-[11px] tracking-[0.4em] uppercase mb-4">
      新亦源供应链 · 鞋服仓配知识库
    </p>
    <h1 id="slj-hero-heading" class="text-5xl lg:text-6xl font-black text-white leading-tight mb-5">
      供应链白皮书
    </h1>
    <p class="text-xl font-bold text-white max-w-2xl leading-relaxed mb-3">
      把仓配经验，转化为供应链决策参考。
    </p>
    <p class="text-base text-navy-100 max-w-3xl leading-relaxed mb-8">
      新亦源供应链白皮书聚焦鞋服行业，分享云仓运营、退货质检、直播仓配与数字化管理的一线经验，为品牌、电商及供应链团队提供仓配选型、流程优化和团队培训的实用参考。
    </p>
    <div class="flex flex-wrap gap-4">
      {
        latest && (
          <a
            href={latest.readingHref}
            class="inline-flex items-center gap-2 px-6 py-3 bg-brand-orange text-white font-bold rounded-xl hover:bg-brand-orange-dark transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"
              />
            </svg>
            阅读白皮书
          </a>
        )
      }
      {
        latest && (
          <a
            href={latest.pdf}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white font-medium rounded-xl hover:bg-white/10 transition-colors"
          >
            阅读最新资料 PDF
          </a>
        )
      }
      <a
        href="#issues"
        class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white font-medium rounded-xl hover:bg-white/10 transition-colors"
        >浏览全部资料</a
      >
    </div>
  </div>
</section>
