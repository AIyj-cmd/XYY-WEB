---
import '@/styles/about-minimal-footer.css'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'
import FooterSocialLinks from '@/components/FooterSocialLinks.astro'

interface Props {
  icp: string
  phone: string
  headquartersLabel: string
  headquartersAddress: string
  locale?: SiteLocale
}

const { icp, phone, headquartersLabel, headquartersAddress, locale = 'zh-CN' } = Astro.props
const currentYear = new Date().getFullYear()
const copy = aboutUi(locale)
---

<div class="about-minimal-ending">
  <footer
    class="about-minimal-footer"
    role="contentinfo"
    aria-label={copy.footer.label}
    data-locale={locale}
  >
    <div class="about-minimal-footer__inner">
      <div class="about-minimal-footer__row">
        <div class="about-minimal-footer__meta">
          <p>{copy.footer.copyright(currentYear)}</p>
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
            {icp}
          </a>
        </div>
        <aside class="about-minimal-footer__contact" aria-label={copy.footer.contact}>
          <div class="about-minimal-footer__address">
            <strong>{headquartersLabel}</strong>
            <span>{headquartersAddress}</span>
          </div>
          <a class="about-minimal-footer__phone" href={`tel:${phone}`}>
            <svg
              viewBox="0 0 24 24"
              width="15"
              height="15"
              style="width: 0.95rem; height: 0.95rem; flex: 0 0 0.95rem"
              aria-hidden="true"
            >
              <path
                d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .948.684l1.498 4.493a1 1 0 0 1-.502 1.21l-2.257 1.13a11.04 11.04 0 0 0 5.516 5.516l1.13-2.257a1 1 0 0 1 1.21-.502l4.493 1.498A1 1 0 0 1 21 15.72V19a2 2 0 0 1-2 2h-1C9.716 21 3 14.284 3 6V5Z"
              ></path>
            </svg>
            <span>{phone}</span>
          </a>
          <FooterSocialLinks {locale} />
        </aside>
        <a class="about-minimal-footer__top" href="#about-hero">
          {copy.footer.backToTop}
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </footer>
</div>
