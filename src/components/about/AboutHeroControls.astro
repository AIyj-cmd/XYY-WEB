<div class="flex items-center gap-3">
  <button
    id="hero-video-btn"
    class="group inline-flex items-center gap-3 text-sm text-white/60 transition-colors hover:text-white"
    aria-label="暂停视频"
  >
    <span
      class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 transition-colors group-hover:border-white/60"
    >
      <svg
        id="icon-pause"
        class="h-4 w-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
      </svg>
      <svg
        id="icon-play"
        class="hidden h-4 w-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </span>
    <span id="btn-label">暂停视频</span>
  </button>

  <button
    id="hero-mute-btn"
    class="group flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white/60 transition-colors hover:border-white/60 hover:text-white"
    aria-label="开启声音"
  >
    <svg id="icon-muted" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-3-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06A8.99 8.99 0 0 0 17.73 18l2 2L21 18.73l-9-9L4.27 3zM12 4 9.91 6.09 12 8.18V4z"
      ></path>
    </svg>
    <svg
      id="icon-unmuted"
      class="hidden h-4 w-4"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
      ></path>
    </svg>
  </button>
</div>
