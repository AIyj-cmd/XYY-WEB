---
import '@/styles/about-gallery.css'
import '@/styles/about-gallery-responsive.css'
import '@/styles/about-gallery-preview.css'
import { aboutGalleryImages } from '@/data/about/gallery-images'
import { aboutGallery } from '@/i18n/about-gallery'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  locale?: SiteLocale
}

const { locale = 'zh-CN' }: Props = Astro.props
const copy = aboutGallery[locale]
---

<section
  class="about-gallery"
  aria-labelledby="about-gallery-heading"
  data-about-gallery
  data-locale={locale}
>
  <div class="about-gallery__shell">
    <header class="about-gallery__intro">
      <p class="about-gallery__eyebrow">{copy.eyebrow}</p>
      <h2 id="about-gallery-heading">{copy.heading}</h2>
      <p>{copy.introduction}</p>
      <p class="about-gallery__hint">{copy.hint}</p>
    </header>

    <div class="about-gallery__layout" data-gallery-grid>
      {
        aboutGalleryImages.map((image) => (
          <figure class="about-gallery__figure" style={image.positionStyle}>
            <a class="about-gallery__thumbnail" href={image.src} data-gallery-thumbnail>
              <img
                src={image.thumbnailSrc}
                alt={copy.images[image.scene]}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </a>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<div class="about-gallery__preview" data-gallery-preview popover="manual" aria-hidden="true">
  <img alt="" data-gallery-preview-image />
</div>

<dialog class="about-gallery__dialog" data-gallery-dialog aria-label={copy.dialogTitle}>
  <button type="button" class="about-gallery__close" data-gallery-close>
    {copy.close}<span aria-hidden="true">×</span>
  </button>
  <img alt="" data-gallery-dialog-image />
</dialog>

<script>
  import '@/scripts/about/gallery-preview'
</script>
