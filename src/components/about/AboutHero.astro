---
import AboutHeroControls from './AboutHeroControls.astro'
import AboutHeroMedia from './AboutHeroMedia.astro'
import '@/styles/about-stage.css'
import '@/styles/about-stage-responsive.css'

interface Props {
  overview: string
}

const { overview } = Astro.props
---

<section id="about-hero" class="about-stage" aria-labelledby="about-hero-heading">
  <AboutHeroMedia />

  <div class="about-stage__video-controls">
    <AboutHeroControls />
  </div>

  <div class="about-stage__shell">
    <div class="about-stage__intro">
      <p class="about-stage__eyebrow">关于我们</p>
      <h1 id="about-hero-heading" class="about-stage__title">
        <span class="about-stage__brand">新亦源供应链</span>
        让每个品牌<br />
        都有专业的<br />
        <span class="about-stage__accent">出货能力</span>
      </h1>

      <div class="about-overview" aria-labelledby="about-overview-heading">
        <div class="about-overview__heading">
          <a class="about-overview__logo" href="/" aria-label="新亦源供应链首页">
            <img src="/logo.png" alt="新亦源供应链" width="2362" height="905" />
          </a>
          <h2 id="about-overview-heading">关于新亦源</h2>
        </div>
        <p>{overview}</p>
      </div>
    </div>

    <slot />
  </div>
</section>
