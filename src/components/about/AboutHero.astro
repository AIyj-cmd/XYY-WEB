---
import AboutHeroControls from './AboutHeroControls.astro'
import AboutHeroMedia from './AboutHeroMedia.astro'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'
import '@/styles/about-stage.css'
import '@/styles/about-stage-responsive.css'

interface Props {
  overview: string
  locale?: SiteLocale
}

const { overview, locale = 'zh-CN' } = Astro.props
const copy = aboutUi(locale)
---

<section
  id="about-hero"
  class="about-stage"
  aria-label={copy.hero.eyebrow}
  data-locale={locale}
  data-about-hero-reveal
>
  <div class="about-stage__frame">
    <AboutHeroMedia {locale} />
    <p id="hero-caption" class="about-stage__caption opacity-0"></p>

    <div class="about-stage__video-controls">
      <AboutHeroControls {locale} />
    </div>
  </div>
</section>

<section class="about-introduction" aria-labelledby="about-hero-heading" data-locale={locale}>
  <div class="about-introduction__shell">
    <div class="about-introduction__header">
      <div class="about-introduction__content">
        <p class="about-introduction__eyebrow">{copy.hero.eyebrow}</p>
        <h1 id="about-hero-heading" class="about-introduction__title">
          <span class="about-introduction__brand">{copy.hero.brand}</span>
          {
            copy.hero.titleLines.map((line, index) => (
              <>
                <span
                  class:list={{
                    'about-introduction__accent': index === copy.hero.titleLines.length - 1,
                  }}
                >
                  {line}
                </span>
                {index < copy.hero.titleLines.length - 1 && <br />}
              </>
            ))
          }
        </h1>
      </div>
      <div
        class="about-introduction__overview about-overview"
        aria-labelledby="about-overview-heading"
      >
        <div class="about-introduction__overview-heading">
          <a
            class="about-introduction__logo"
            href={locale === 'en' ? '/en' : '/'}
            aria-label={copy.hero.homeAria}
          >
            <img src="/logo.png" alt={copy.hero.logoAlt} width="2362" height="905" />
          </a>
          <h2 id="about-overview-heading">{copy.hero.overviewHeading}</h2>
        </div>
        <p>{overview}</p>
      </div>
    </div>

    <div class="about-introduction__explorer">
      <slot />
    </div>
  </div>
</section>
