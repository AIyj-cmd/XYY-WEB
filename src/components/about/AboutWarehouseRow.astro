---
import type { Warehouse } from '@/lib/directus'

interface Props {
  warehouse: Warehouse
}

const { warehouse } = Astro.props
---

<div class="py-5 flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-0">
  <div class="lg:w-36 flex-shrink-0">
    <div class="text-base font-black text-navy-800 leading-tight">{warehouse.name}</div>
    {warehouse.since && <div class="text-[11px] text-gray-400 mt-0.5">自 {warehouse.since}</div>}
  </div>
  <div class="flex-1 text-xs text-gray-500 leading-snug lg:px-5 lg:border-l lg:border-gray-100">
    {warehouse.address ? warehouse.address : <span class="text-gray-300 italic">地址待公布</span>}
  </div>
  <div class="flex-1 text-xs text-gray-500 leading-relaxed lg:px-5 lg:border-l lg:border-gray-100">
    {warehouse.highlight}
  </div>
</div>
