---
import type { Warehouse } from '@/lib/directus'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  warehouse: Warehouse
  locale?: SiteLocale
}

const { warehouse, locale = 'zh-CN' } = Astro.props
const copy = aboutUi(locale)
const pendingAddress = /^具体地址/.test(warehouse.address.trim())
---

<div class="py-3.5">
  <div class="text-sm font-bold text-navy-800 leading-tight">{warehouse.name}</div>
  <p
    class:list={[
      'mt-1.5 text-xs leading-relaxed',
      pendingAddress ? 'text-gray-400' : 'text-gray-600',
    ]}
  >
    {
      pendingAddress
        ? copy.warehouseRegions.addressPending
        : warehouse.address || copy.warehouseRegions.addressUnavailable
    }
  </p>
</div>
