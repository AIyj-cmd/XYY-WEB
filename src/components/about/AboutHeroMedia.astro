---
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  locale?: SiteLocale
}

const { locale = 'zh-CN' } = Astro.props
---

<video
  id="hero-bg-video"
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  poster="/introduce-poster.jpg"
  class="about-stage__media absolute inset-0 h-full w-full"
  aria-hidden="true"
  data-about-locale={locale}
>
  <source src="/introduce-desktop.mp4" media="(min-width: 768px)" type="video/mp4" />
  <source src="/introduce-540p.mp4" type="video/mp4" />
</video>

<div
  class="pointer-events-none absolute inset-0"
  style="background: linear-gradient(0deg, rgba(8,20,42,0.42) 0%, rgba(8,20,42,0.12) 38%, rgba(8,20,42,0.04) 100%);"
>
</div>
