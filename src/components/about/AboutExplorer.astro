---
import '@/styles/about-explorer.css'
import '@/styles/about-dialog.css'
import '@/styles/about-explorer-responsive.css'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  locale?: SiteLocale
}

const { locale = 'zh-CN' } = Astro.props
const copy = aboutUi(locale)
const entries = copy.explorer.entries
---

<section class="about-explorer" aria-label={copy.explorer.label} data-locale={locale}>
  <div class="about-explorer__viewport">
    <div class="about-explorer__track">
      {
        entries.map(({ id, number, title, eyebrow }) => (
          <button
            type="button"
            class="about-explorer__trigger"
            data-about-explorer-open={id}
            data-about-explorer-title={title}
            aria-controls="about-explorer-dialog"
            aria-haspopup="dialog"
            aria-label={title}
          >
            <span class="about-explorer__copy">
              <span class="about-explorer__meta">
                <span class="about-explorer__number" aria-hidden="true">
                  {number}
                </span>
                <small>{eyebrow}</small>
              </span>
              <strong>{title}</strong>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<dialog
  id="about-explorer-dialog"
  class="about-explorer-dialog"
  aria-labelledby="about-explorer-dialog-title"
>
  <div class="about-explorer-dialog__shell">
    <header class="about-explorer-dialog__header">
      <div>
        <p>ABOUT XYY</p>
        <h2 id="about-explorer-dialog-title" class="m-0 text-2xl font-black text-navy-800">
          {copy.explorer.dialogTitle}
        </h2>
      </div>
      <button
        type="button"
        class="about-explorer-dialog__close grid h-11 w-11 cursor-pointer place-items-center rounded-full border border-slate-200 bg-white text-[1.7rem] leading-none text-navy-800 focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-blue-300"
        data-about-explorer-close
        aria-label={copy.explorer.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="about-explorer-dialog__body">
      <div class="about-explorer__panel" data-about-explorer-panel="history" hidden>
        <slot name="history" />
      </div>
      <div class="about-explorer__panel" data-about-explorer-panel="warehouse" hidden>
        <slot name="warehouse" />
      </div>
      <div class="about-explorer__panel" data-about-explorer-panel="honors" hidden>
        <slot name="honors" />
      </div>
      <div class="about-explorer__panel" data-about-explorer-panel="faq" hidden>
        <slot name="faq" />
      </div>
    </div>
  </div>
</dialog>
