---
import type { WarehouseGroup } from '@/data/about'
import AboutWarehouseRow from './AboutWarehouseRow.astro'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  southGroups: WarehouseGroup[]
  eastGroups: WarehouseGroup[]
  locale?: SiteLocale
}

const { southGroups, eastGroups, locale = 'zh-CN' } = Astro.props
const copy = aboutUi(locale)

const regions = [
  {
    id: 'southwh-heading',
    ...copy.warehouseRegions.regions.south,
    accent: '#B94718',
    groups: southGroups,
  },
  {
    id: 'eastwh-heading',
    ...copy.warehouseRegions.regions.east,
    accent: '#0E7490',
    groups: eastGroups,
  },
]
---

<section class="py-14 bg-gray-50" aria-labelledby="warehouse-regions-heading" data-locale={locale}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id="warehouse-regions-heading" class="sr-only">{copy.warehouseRegions.heading}</h2>

    <div class="lg:grid lg:grid-cols-2 lg:divide-x lg:divide-slate-200">
      {
        regions.map((region, regionIndex) => {
          const warehouseCount = region.groups.reduce(
            (total, group) => total + group.items.length,
            0
          )

          return (
            <section
              class:list={[
                'px-5 py-7 sm:px-8 sm:py-9 lg:px-10',
                regionIndex > 0 && 'border-t border-slate-200 lg:border-t-0',
              ]}
              aria-labelledby={region.id}
            >
              <header class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <div class="mb-2.5 flex items-center gap-2.5">
                    <span
                      class="block h-2 w-2 rounded-full"
                      style={`background:${region.accent}`}
                      aria-hidden="true"
                    />
                    <p
                      class="font-bold text-[11px] tracking-[0.3em] uppercase"
                      style={`color:${region.accent}`}
                    >
                      {region.label}
                    </p>
                  </div>
                  <h3 id={region.id} class="text-xl font-black text-navy-800 leading-snug">
                    {region.cities}
                  </h3>
                  <p class="mt-2 text-xs text-gray-500 leading-relaxed">{region.note}</p>
                </div>
                <div class="w-fit text-xs font-bold text-navy-800/50">
                  {copy.warehouseRegions.warehouseCount(warehouseCount)}
                </div>
              </header>

              <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
                {region.groups.map(({ city, cfg, items }) => (
                  <article>
                    <div class="mb-2 flex items-center gap-2.5 border-b border-slate-200 pb-3">
                      <span
                        class="h-2.5 w-2.5 rounded-full"
                        style={`background:${cfg.color}`}
                        aria-hidden="true"
                      />
                      <span class="text-sm font-black text-navy-800">
                        {copy.warehouseRegions.cityLabels[
                          city as keyof typeof copy.warehouseRegions.cityLabels
                        ] ?? city}
                      </span>
                      <span class="ml-auto text-[11px] text-gray-400">
                        {copy.warehouseRegions.groupCount(items.length)}
                      </span>
                    </div>
                    <div class="divide-y divide-slate-100">
                      {items.map((warehouse) => (
                        <AboutWarehouseRow warehouse={warehouse} {locale} />
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )
        })
      }
    </div>
  </div>
</section>
