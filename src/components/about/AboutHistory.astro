---
import type { AboutHistoryItem } from '@/data/about'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  items: AboutHistoryItem[]
  locale?: SiteLocale
}

const { items, locale = 'zh-CN' } = Astro.props
const copy = aboutUi(locale)
---

<section
  class="scroll-mt-24 bg-[#f8fafc] py-16"
  aria-labelledby="history-heading"
  data-locale={locale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <h2 id="history-heading" class="text-3xl font-black text-navy-800 text-center">
      {copy.history.heading}
    </h2>
    <p class="mt-4 text-sm text-gray-500 text-center max-w-2xl mx-auto leading-relaxed">
      {
        copy.history.introduction.map((line, index) => (
          <>
            {line}
            {index < copy.history.introduction.length - 1 && <br />}
          </>
        ))
      }
    </p>
  </div>

  <div class="relative mx-auto flex max-w-5xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <button
      id="history-prev"
      class="absolute left-2 top-[72%] z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-400 shadow-md transition-colors hover:border-navy-300 hover:text-navy-700 md:static md:flex-shrink-0 md:translate-y-0"
      aria-label={copy.history.previous}
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
        ></path></svg
      >
    </button>

    <div class="min-w-0 flex-1 overflow-hidden">
      <div
        id="history-track"
        class="flex transition-transform duration-500 ease-out"
        style="will-change: transform;"
      >
        {
          items.map(({ year, subtitle, text, img }) => (
            <div class="w-full flex-shrink-0">
              <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12 py-2">
                <div class="flex-shrink-0 w-full md:w-64">
                  <div class="flex items-center gap-4 mb-5">
                    <span class="text-[3.5rem] font-black text-navy-800 leading-none">{year}</span>
                    <div class="border-l-2 border-brand-orange pl-3">
                      <div class="text-sm font-bold text-navy-700 leading-snug whitespace-pre-line">
                        {subtitle.replace('·', '\n')}
                      </div>
                    </div>
                  </div>
                  <p class="text-gray-500 text-sm leading-relaxed">{text}</p>
                </div>
                <div class="w-full max-w-[371px] flex-shrink-0">
                  <div class="aspect-[371/209] w-full overflow-hidden rounded-xl shadow-md">
                    {img ? (
                      <img
                        src={img}
                        alt={copy.history.imageAlt(year)}
                        loading="lazy"
                        decoding="async"
                        width="371"
                        height="209"
                        class:list={[
                          'w-full h-full transition-transform duration-300 hover:scale-105',
                          img === '/logo.png'
                            ? 'bg-navy-900 object-contain px-12 py-10'
                            : 'object-cover',
                        ]}
                      />
                    ) : (
                      <div class="w-full h-full bg-orange-50 border border-orange-100 flex flex-col items-center justify-center gap-2">
                        <span class="text-brand-orange text-4xl font-black leading-none">
                          {year}
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <button
      id="history-next"
      class="absolute right-2 top-[72%] z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-400 shadow-md transition-colors hover:border-navy-300 hover:text-navy-700 md:static md:flex-shrink-0 md:translate-y-0"
      aria-label={copy.history.next}
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path></svg
      >
    </button>
  </div>

  <div class="mt-10 px-8 lg:px-16 max-w-7xl mx-auto">
    <div class="relative flex items-center">
      <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-gray-300"></div>
      <div class="relative flex justify-between w-full">
        {
          items.map(({ year }, index) => (
            <button
              class="history-dot group flex flex-col items-center gap-1.5 relative z-10"
              data-index={index}
              aria-label={copy.history.jumpToYear(year)}
            >
              <div class="w-3 h-3 rounded-full border-2 border-gray-300 bg-[#f8fafc] group-hover:border-brand-orange transition-colors history-dot-circle" />
              <span class="text-xs text-gray-400 group-hover:text-navy-700 transition-colors history-dot-label">
                {year}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>
