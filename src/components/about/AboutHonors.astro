---
import '@/styles/about-honors.css'

interface Props {
  honors: readonly string[]
}

const { honors } = Astro.props
---

<section class="honors-section" aria-labelledby="honors-heading">
  <div class="honors-inner">
    <div class="honors-heading">
      <p>资质与荣誉</p>
      <h2 id="honors-heading">资质与荣誉</h2>
    </div>
    <div class="honors-grid">
      {
        honors.map((honor, index) => (
          <button
            class="honor-card"
            type="button"
            data-img={`/about/honor/${index + 1}.jpg`}
            data-alt={honor}
          >
            {honor}
          </button>
        ))
      }
    </div>
  </div>
</section>

<div id="hlb" class="honors-lightbox" role="dialog" aria-modal="true" aria-label="证书大图" hidden>
  <button type="button" class="honors-lightbox__close" aria-label="关闭证书大图">×</button>
  <img id="hlb-img" alt="" hidden />
</div>

<script>
  import '@/scripts/about-honors'
</script>
