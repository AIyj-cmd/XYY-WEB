---
import '@/styles/about-honors.css'
import { aboutUi } from '@/i18n/about-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  honors: { title: string; image: string }[]
  locale?: SiteLocale
}

const { honors, locale = 'zh-CN' } = Astro.props
const copy = aboutUi(locale)
---

<section class="honors-section" aria-labelledby="honors-heading" data-locale={locale}>
  <div class="honors-inner">
    <div class="honors-heading">
      <p>{copy.honors.eyebrow}</p>
      <h2 id="honors-heading">{copy.honors.heading}</h2>
    </div>
    <div class="honors-grid">
      {
        honors.map((honor) => (
          <button class="honor-card" type="button" data-img={honor.image} data-alt={honor.title}>
            {honor.title}
          </button>
        ))
      }
    </div>
  </div>
</section>

<div
  id="hlb"
  class="honors-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label={copy.honors.lightbox}
  hidden
>
  <button type="button" class="honors-lightbox__close" aria-label={copy.honors.closeLightbox}
    >×</button
  >
  <img id="hlb-img" alt="" hidden />
</div>

<script>
  import '@/scripts/about-honors'
</script>
