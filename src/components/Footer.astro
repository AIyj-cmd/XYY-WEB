---
import { BRAND, FOOTER_SERVICE_LINKS, NAV_LINKS } from '@/lib/brand'
import type { SiteSettingsRecord } from '@/lib/directus'

interface Props {
  settings: Omit<SiteSettingsRecord, 'id' | 'status' | 'key'>
}

const { settings } = Astro.props
---

<footer class="bg-navy-900 text-navy-100 pt-14 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-5" aria-label="新亦源供应链首页">
          <img src="/logo.png" alt="新亦源供应链" class="h-12 w-auto" loading="lazy" />
        </a>
        <p class="text-sm text-navy-200 leading-relaxed mb-5">{settings.footer_description}</p>
        <div class="space-y-1.5">
          <a
            href={`tel:${settings.phone}`}
            class="flex items-center gap-2 text-sm text-navy-100 hover:text-white transition-colors"
          >
            <svg
              class="w-4 h-4 text-brand-orange flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            {settings.phone}
          </a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">仓配服务</h3>
        <ul class="space-y-2.5">
          {
            FOOTER_SERVICE_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm text-navy-200 hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">快速入口</h3>
        <ul class="space-y-2.5">
          {
            NAV_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm text-navy-200 hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">联系与地址</h3>
        <ul class="space-y-3.5">
          <li class="text-sm">
            <span class="text-brand-orange font-medium">{settings.headquarters_label}</span>
            <p class="text-navy-200 mt-0.5 leading-relaxed">{settings.headquarters_address}</p>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-xs text-navy-300">
        © {new Date().getFullYear()}
        {BRAND.fullName}. 保留所有权利.
      </p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="text-xs text-navy-300 hover:text-navy-100 transition-colors">
          个人信息保护说明
        </a>
        <a
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-navy-300 hover:text-navy-100 transition-colors"
        >
          {settings.icp}
        </a>
      </div>
    </div>
  </div>
</footer>
