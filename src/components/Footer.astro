---
import { BRAND, FOOTER_SERVICE_LINKS, NAV_LINKS } from '@/lib/brand'
import type { SiteSettingsRecord } from '@/lib/directus'
import { ENGLISH_NAVIGATION, ENGLISH_SERVICE_LINKS, type SiteLocale } from '@/i18n/routes'
import { shellCopy } from '@/i18n/shell'

interface Props {
  settings: Omit<SiteSettingsRecord, 'id' | 'status' | 'key'>
  locale?: SiteLocale
}

const { settings, locale = 'zh-CN' } = Astro.props
const copy = shellCopy(locale)
const navLinks = locale === 'en' ? ENGLISH_NAVIGATION : NAV_LINKS
const serviceLinks = locale === 'en' ? ENGLISH_SERVICE_LINKS : FOOTER_SERVICE_LINKS
const homePath = locale === 'en' ? '/en' : '/'
const privacyPath = locale === 'en' ? '/en/privacy' : '/privacy'
---

<footer class="border-t border-slate-200 bg-slate-50 pt-10 pb-6 text-navy-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main grid -->
    <div class="mb-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href={homePath} class="inline-block mb-5" aria-label={copy.home}>
          <img
            src="/logo.png"
            alt={copy.brand}
            class="h-12 w-auto brightness-0 opacity-80"
            loading="lazy"
          />
        </a>
        <p class="mb-5 text-sm leading-relaxed text-slate-600">{settings.footer_description}</p>
        <div class="space-y-1.5">
          <a
            href={`tel:${settings.phone}`}
            class="flex items-center gap-2 text-sm text-navy-800 transition-colors hover:text-brand-orange"
          >
            <svg
              class="w-4 h-4 text-brand-orange flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            {settings.phone}
          </a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-navy-900">
          {copy.services}
        </h3>
        <ul class="space-y-2.5">
          {
            serviceLinks.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm text-slate-600 transition-colors hover:text-navy-900">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-navy-900">
          {copy.quick}
        </h3>
        <ul class="space-y-2.5">
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm text-slate-600 transition-colors hover:text-navy-900">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-navy-900">
          {copy.contact}
        </h3>
        <ul class="space-y-3.5">
          <li class="text-sm">
            <span class="text-brand-orange font-medium">{settings.headquarters_label}</span>
            <p class="mt-0.5 leading-relaxed text-slate-600">{settings.headquarters_address}</p>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col items-center justify-between gap-3 border-t border-slate-200 pt-5 sm:flex-row"
    >
      <p class="text-xs text-slate-500">
        © {new Date().getFullYear()}{locale === 'en' && ' '}
        {
          locale === 'en' ? (
            <>Guangzhou XINYIYUAN Supply Chain Management Co., Ltd. {copy.rights}</>
          ) : (
            <>
              {BRAND.fullName}. {copy.rights}
            </>
          )
        }
      </p>
      <div class="flex items-center gap-4">
        <a href={privacyPath} class="text-xs text-slate-500 transition-colors hover:text-navy-900">
          {copy.privacy}
        </a>
        <a
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-slate-500 transition-colors hover:text-navy-900"
        >
          {settings.icp}
        </a>
      </div>
    </div>
  </div>
</footer>
