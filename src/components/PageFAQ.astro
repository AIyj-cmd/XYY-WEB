---
import '@/styles/page-faq.css'

interface FaqItem {
  q: string
  a: string
}

interface Props {
  heading?: string
  tag?: string
  items: FaqItem[]
  layout?: 'accordion' | 'stacked'
  openFirst?: boolean
}

const {
  heading = '常见问题',
  tag = 'FAQ',
  items,
  layout = 'accordion',
  openFirst = false,
} = Astro.props
---

<section class="py-16 bg-white" aria-labelledby="page-faq-heading">
  <div
    class:list={[layout === 'stacked' ? 'max-w-5xl' : 'max-w-3xl', 'mx-auto px-4 sm:px-6 lg:px-8']}
  >
    <header class="mb-10 text-left">
      <p class="text-[#B94718] font-bold text-[11px] tracking-[0.35em] uppercase mb-2">{tag}</p>
      <h2
        id="page-faq-heading"
        class="text-[2rem] lg:text-[2.5rem] leading-tight font-black text-navy-800"
      >
        {heading}
      </h2>
    </header>

    {
      layout === 'stacked' ? (
        <dl class="faq-stacked">
          {items.map(({ q, a }, index) => (
            <div class="faq-stacked__item">
              <dt>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{q}</strong>
              </dt>
              <dd>{a}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <div class="divide-y divide-gray-100 border-t border-gray-100">
          {items.map(({ q, a }, index) => (
            <details class="group py-5" open={openFirst && index === 0}>
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <span class="text-base font-bold text-navy-800 leading-snug flex-1">{q}</span>
                <span
                  class="flex-shrink-0 mt-0.5 w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform duration-200"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-sm text-gray-500 leading-relaxed">{a}</p>
            </details>
          ))}
        </div>
      )
    }
  </div>
</section>
