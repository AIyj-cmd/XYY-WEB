---
import Layout from '@/layouts/Layout.astro'
import type { SiteSettingsRecord } from '@/lib/directus'
import { getEnglishSiteSettings } from '@/i18n/site-settings'
import type { LocalePair } from '@/i18n/case-routes'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noIndex?: boolean
  siteSettings?: Omit<SiteSettingsRecord, 'id' | 'status' | 'key'>
  showFooter?: boolean
  showFloatingContact?: boolean
  localePair?: LocalePair
}

const {
  title,
  description,
  canonical,
  ogImage,
  jsonLd,
  noIndex,
  siteSettings,
  showFooter,
  showFloatingContact,
  localePair,
} = Astro.props
const resolvedSettings = siteSettings ?? (await getEnglishSiteSettings())
---

<Layout
  {title}
  {description}
  {canonical}
  {ogImage}
  {jsonLd}
  {noIndex}
  siteSettings={resolvedSettings}
  {showFooter}
  {showFloatingContact}
  {localePair}
  locale="en"><slot /></Layout
>
