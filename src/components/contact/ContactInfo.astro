---
import type { SiteSettingsRecord } from '@/lib/directus'

interface Props {
  settings: Omit<SiteSettingsRecord, 'id' | 'status' | 'key'>
}

const { settings } = Astro.props
---

<div class="lg:col-span-2 mb-12 lg:mb-0">
  <h2 class="text-2xl font-black text-navy-800 mb-8">联系方式</h2>
  <div class="mb-8">
    <h3 class="text-xs font-bold text-navy-500 uppercase tracking-wider mb-4">电话咨询</h3>
    <a
      href={`tel:${settings.phone}`}
      class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-navy-300 hover:bg-navy-50 transition-all group"
    >
      <div
        class="w-10 h-10 rounded-lg bg-brand-orange/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand-orange/20 transition-colors"
      >
        <svg
          class="w-5 h-5 text-brand-orange"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
      </div>
      <div>
        <div class="font-bold text-navy-800">{settings.phone}</div>
        <div class="text-xs text-gray-500">全国服务热线，具体接听时间以实际服务安排为准</div>
      </div>
    </a>
  </div>

  <div>
    <h3 class="text-xs font-bold text-navy-500 uppercase tracking-wider mb-4">仓库地址</h3>
    <div class="space-y-4">
      {
        [
          {
            label: settings.headquarters_label,
            address: settings.headquarters_address,
          },
        ].map(({ label, address }) => (
          <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100">
            <svg
              class="w-5 h-5 text-brand-orange flex-shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            <div>
              <div class="text-xs font-bold text-navy-700 mb-0.5">{label}</div>
              <address class="text-sm text-gray-600 not-italic leading-relaxed">{address}</address>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
