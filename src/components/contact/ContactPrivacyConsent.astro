---
import type { SiteLocale } from '@/i18n/routes'

const { locale = 'zh-CN' } = Astro.props as { locale?: SiteLocale }
const english = locale === 'en'
---

<label class="flex items-start gap-3 text-xs leading-relaxed text-gray-500">
  <input
    type="checkbox"
    name="privacyConsent"
    required
    class="mt-0.5 h-4 w-4 rounded border-gray-300 text-brand-orange focus:ring-brand-orange"
  />
  <span>
    {english ? 'I have read and agree to the ' : '我已阅读并同意 '}<a
      href={english ? '/en/privacy' : '/privacy'}
      target="_blank"
      class="underline underline-offset-2 transition-colors hover:text-gray-600"
      >{english ? 'Privacy Notice' : '《个人信息保护说明》'}</a
    >{
      english
        ? ' and consent to Guangzhou XINYIYUAN Supply Chain Management Co., Ltd. collecting and using this information to respond to this business enquiry and prepare a service discussion. It is retained only for as long as necessary for that purpose. You may email '
        : '，同意广州新亦源供应链管理有限公司为业务咨询回复和方案对接收集并使用上述信息，并仅在实现该目的所需期限内保存。可发送邮件至'
    }
    <a
      href="mailto:yufengzhen@56xyy.com"
      class="underline underline-offset-2 transition-colors hover:text-gray-600"
      >yufengzhen@56xyy.com</a
    >{
      english
        ? ' to request access, correction or deletion of personal information, or to withdraw consent.'
        : ' 申请查阅、更正、删除个人信息或撤回同意。'
    }
  </span>
</label>
