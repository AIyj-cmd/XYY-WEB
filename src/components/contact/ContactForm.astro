---
import ContactIdentityFields from './ContactIdentityFields.astro'
import ContactInquiryFields from './ContactInquiryFields.astro'
import ContactPrivacyConsent from './ContactPrivacyConsent.astro'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  locale?: SiteLocale
  contactPhone?: string
}

const { locale = 'zh-CN' } = Astro.props
const english = locale === 'en'
---

<div class="lg:col-span-3">
  <h2 class="text-2xl font-black text-navy-800 mb-8">{english ? 'Send an enquiry' : '在线留言'}</h2>
  <form
    id="contact-form"
    action="/api/contact"
    method="POST"
    class:list={['space-y-5', english && 'scroll-mt-28']}
    novalidate
    data-locale={english ? 'en' : undefined}
  >
    <div class="hidden" aria-hidden="true">
      <input
        id="website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
        aria-label={english ? 'Leave this field empty' : 'Leave this field empty'}
      />
      {english && <input name="locale" type="hidden" value="en" />}
    </div>

    <ContactIdentityFields {locale} />
    <ContactInquiryFields {locale} />
    <ContactPrivacyConsent {locale} />

    <button
      type="submit"
      id="submit-btn"
      class="w-full sm:w-auto px-8 py-3.5 bg-brand-orange hover:bg-brand-orange-dark text-white font-bold rounded-xl text-base transition-colors shadow-lg shadow-orange-900/20 disabled:opacity-60 disabled:cursor-not-allowed"
      >{english ? 'Submit enquiry' : '提交咨询'}</button
    >
    <div id="form-result" class="hidden" role="status" aria-live="polite" aria-atomic="true"></div>
  </form>
</div>
