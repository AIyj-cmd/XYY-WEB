---
import type { AssuranceIcon } from '@/data/product'

interface Props {
  icon: AssuranceIcon
}

const { icon } = Astro.props
---

<span class="assurance-mechanism__icon" aria-hidden="true">
  {
    icon === 'standard' && (
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="10" y="5" width="24" height="34" rx="3" stroke="currentColor" stroke-width="2" />
        <path
          d="M16 15h12M16 22h12M16 29h7"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
        <circle cx="35" cy="34" r="8" fill="var(--paper)" stroke="currentColor" stroke-width="2" />
        <path
          d="m31.5 34 2.2 2.2 4.3-4.8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {
    icon === 'check' && (
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="10" y="6" width="28" height="36" rx="3" stroke="currentColor" stroke-width="2" />
        <rect
          x="17"
          y="3"
          width="14"
          height="7"
          rx="3"
          fill="var(--paper)"
          stroke="currentColor"
          stroke-width="2"
        />
        <path
          d="m17 25 6 6 11-12"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {
    icon === 'record' && (
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="7" y="7" width="34" height="25" rx="2" stroke="currentColor" stroke-width="2" />
        <path
          d="M17 41h14M24 32v9M13 26l7-7 5 4 9-10"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {
    icon === 'alert' && (
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M24 7c-9.4 0-17 6.8-17 15.2 0 4.8 2.5 9.1 6.4 11.9L11 41l8.1-4.4c1.6.5 3.2.8 4.9.8 9.4 0 17-6.8 17-15.2S33.4 7 24 7Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <circle cx="17" cy="22" r="1.5" fill="currentColor" />
        <circle cx="24" cy="22" r="1.5" fill="currentColor" />
        <circle cx="31" cy="22" r="1.5" fill="currentColor" />
      </svg>
    )
  }
  {
    icon === 'improve' && (
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M39 17V7l-4.5 4.5A16 16 0 1 0 40 29"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M39 7h-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    )
  }
</span>
