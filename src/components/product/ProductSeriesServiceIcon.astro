---
interface Props {
  index: number
}

const { index } = Astro.props
---

<span class="series-spread__service-icon" aria-hidden="true">
  {
    index === 0 && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m5 8 7-4 7 4v10l-7 4-7-4V8Z" stroke="currentColor" stroke-width="1.5" />
        <path d="m5 8 7 4 7-4M12 12v10" stroke="currentColor" stroke-width="1.5" />
      </svg>
    )
  }
  {
    index === 1 && (
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M4 7.5h16M4 12h16M4 16.5h16"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path d="M6 4.5h12v15H6z" stroke="currentColor" stroke-width="1.5" />
      </svg>
    )
  }
  {
    index === 2 && (
      <svg viewBox="0 0 24 24" fill="none">
        <rect
          x="5"
          y="3.5"
          width="14"
          height="17"
          rx="1.5"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path
          d="M8 8h8M8 12h8M8 16h5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    )
  }
  {
    index === 3 && (
      <svg viewBox="0 0 24 24" fill="none">
        <rect
          x="3.5"
          y="5"
          width="17"
          height="12"
          rx="1.5"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    )
  }
</span>
