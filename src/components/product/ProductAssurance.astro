---
import { ASSURANCE_MECHANISMS, ASSURANCE_POINTS } from '@/data/product'
import { ENGLISH_ASSURANCE_COPY } from '@/i18n/product'
import type { SiteLocale } from '@/i18n/routes'
import ProductAssuranceIcon from './ProductAssuranceIcon.astro'

interface Props {
  locale?: SiteLocale
}

const { locale = 'zh-CN' } = Astro.props
const isEnglish = locale === 'en'
const points = isEnglish ? ENGLISH_ASSURANCE_COPY.points : ASSURANCE_POINTS
const mechanisms = isEnglish ? ENGLISH_ASSURANCE_COPY.mechanisms : ASSURANCE_MECHANISMS
---

<section id="assurance" class="assurance-section" aria-labelledby="assurance-heading">
  <div class="warehouse-shell">
    <header class="assurance-heading" data-reveal="copy">
      {
        isEnglish ? (
          <h2 id="assurance-heading">{ENGLISH_ASSURANCE_COPY.heading}</h2>
        ) : (
          <h2 id="assurance-heading">
            让服务可以被看见、
            <br />
            被复核，也被持续改进。
          </h2>
        )
      }
      <div class="assurance-heading__intro">
        {
          isEnglish ? (
            ENGLISH_ASSURANCE_COPY.introduction.map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <>
              <p>从货品入仓到出库交付，每个环节都有标准、有记录、有反馈。</p>
              <p>让服务过程透明可视，结果可复核，持续优化，始终如一。</p>
            </>
          )
        }
      </div>
    </header>
    <div class="assurance-grid">
      {
        points.map(({ value, label, note }) => (
          <article data-reveal="copy">
            <strong>{value}</strong>
            <h3>{label}</h3>
            <p>{note}</p>
          </article>
        ))
      }
    </div>
    <div class="assurance-mechanisms">
      <h3 data-reveal="copy">
        {isEnglish ? ENGLISH_ASSURANCE_COPY.mechanismsHeading : '服务保障机制'}
      </h3>
      <div class="assurance-mechanisms__list">
        {
          mechanisms.map(({ title, note, icon }) => (
            <article data-reveal="copy">
              <ProductAssuranceIcon icon={icon} />
              <div>
                <h4>{title}</h4>
                <p>{note}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
