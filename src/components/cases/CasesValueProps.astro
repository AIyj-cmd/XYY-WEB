---
import { CASE_VALUE_PROPS } from '@/data/cases'
---

<section class="case-values" aria-labelledby="value-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="case-values__heading">
      <p>WHY XYY</p>
      <h2 id="value-heading">为什么品牌选择新亦源</h2>
    </div>
    <div class="case-values__list">
      {
        CASE_VALUE_PROPS.map(({ title, desc }, index) => (
          <article class="case-value-item">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
