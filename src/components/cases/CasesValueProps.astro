---
import { CASE_VALUE_PROPS } from '@/data/cases'
---

<section class="py-16 bg-gray-50" aria-labelledby="value-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id="value-heading" class="text-3xl font-black text-navy-800 text-center mb-12">
      为什么品牌选择新亦源
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        CASE_VALUE_PROPS.map(({ title, desc }) => (
          <div class="value-card">
            <div class="p-7">
              <h3 class="text-lg font-bold text-navy-800 mb-3">{title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
