---
import { CASE_LOGO_BRANDS, CASE_LOGO_ROWS } from '@/data/cases'

const logos = CASE_LOGO_ROWS.flat()
const visibleLogos = logos.slice(0, 12)
const remainingLogos = logos.slice(12)
---

<section class="cases-logo-wall" aria-labelledby="cases-logo-wall-heading">
  <div class="cases-logo-wall__inner">
    <header>
      <p class="cases-kicker">PARTNER BRANDS</p>
      <h2 id="cases-logo-wall-heading">与品牌一起，把履约做好</h2>
    </header>
    <div class="cases-logo-wall__grid">
      {
        visibleLogos.map((number) => (
          <div class="cases-logo-wall__item">
            <img
              src={`/logos/imgi_${number}_default.png`}
              alt={`${CASE_LOGO_BRANDS[number]} 合作品牌 logo`}
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
    <details class="cases-logo-wall__more">
      <summary>展开更多合作品牌 <span aria-hidden="true">+</span></summary>
      <div class="cases-logo-wall__grid">
        {
          remainingLogos.map((number) => (
            <div class="cases-logo-wall__item">
              <img
                src={`/logos/imgi_${number}_default.png`}
                alt={`${CASE_LOGO_BRANDS[number]} 合作品牌 logo`}
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </details>
  </div>
</section>
