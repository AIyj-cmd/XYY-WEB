---
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
---

<ConversionCTA
  className="case-detail-contact"
  headingId="case-contact-heading"
  eyebrow="合作案例"
  headingLines={['想了解与您业务相近的', '仓配方案？']}
  description="提交SKU规模、订单渠道与退货情况，获取针对性的仓配建议。"
  actionLabel="获取仓配方案"
  preparationItems={[
    { label: 'SKU规模', detail: 'SKU数量与商品品类' },
    { label: '订单渠道', detail: '主要销售渠道与订单来源' },
    { label: '退货情况', detail: '退货规模与处理需求' },
  ]}
  secondaryLinks={[{ href: '/cases', label: '返回案例列表' }]}
  reveal="service"
/>
