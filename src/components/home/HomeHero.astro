---
import '@/styles/home-hero.css'

interface Props {
  image: string
  warehouseArea: string
  partnerBrands: string
  servedStores: string
  coveredCities: string
}

const { image, warehouseArea, partnerBrands, servedStores, coveredCities } = Astro.props
---

<section id="s-hero" class="s-hero" aria-labelledby="hero-heading">
  <img src={image} alt="新亦源现代化仓储中心" class="hero-img" fetchpriority="high" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-body">
    <p class="hero-eyebrow">专注鞋服供应链 · 深耕15年</p>
    <p class="hero-brand-kw hl">新亦源鞋服云仓</p>
    <h1 id="hero-heading" class="hero-title" aria-label="从入库质检到退货上架，鞋服仓配一次解决">
      <strong class="hl">从入库质检到退货上架<span class="hero-punctuation">，</span></strong>
      <strong class="hl">鞋服仓配一次解决</strong>
    </h1>
    <p class="hero-sub hl">
      为鞋服品牌提供入库质检、库存管理、订单履约、退货处理与二次上架服务，支持多平台、多仓协同。
    </p>
    <p class="hero-data hl">
      {warehouseArea}直营仓储 ｜ {partnerBrands}服务品牌 ｜ {servedStores}覆盖门店 ｜ {
        coveredCities
      }覆盖城市
    </p>
    <div class="hero-actions hl">
      <a href="/contact" class="btn-solid">获取仓配方案</a>
      <a href="/product" class="btn-ghost">了解服务 →</a>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</section>
