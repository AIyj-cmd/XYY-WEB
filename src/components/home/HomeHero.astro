---
import '@/styles/home-hero.css'
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  image: string
  warehouseArea: string
  partnerBrands: string
  servedStores: string
  coveredCities: string
  locale?: SiteLocale
}

const {
  image,
  warehouseArea,
  partnerBrands,
  servedStores,
  coveredCities,
  locale = 'zh-CN',
} = Astro.props
const copy = homeUi(locale)
const dataGap = locale === 'en' ? ' ' : ''
---

<section id="s-hero" class="s-hero" aria-labelledby="hero-heading" data-locale={locale}>
  <img src={image} alt={copy.hero.imageAlt} class="hero-img" fetchpriority="high" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-body">
    <p class="hero-eyebrow">{copy.hero.eyebrow}</p>
    <p class="hero-brand-kw hl">{copy.hero.brand}</p>
    <h1 id="hero-heading" class="hero-title" aria-label={copy.hero.titleAria}>
      {copy.hero.title.map((line) => <strong class="hl">{line}</strong>)}
    </h1>
    <p class="hero-sub hl">{copy.hero.subtitle}</p>
    <p class="hero-data hl">
      {warehouseArea}
      {dataGap}{copy.hero.data[0]} ｜ {partnerBrands}
      {dataGap}{copy.hero.data[1]} ｜ {servedStores}{dataGap}
      {copy.hero.data[2]} ｜ {coveredCities}{dataGap}
      {copy.hero.data[3]}
    </p>
    <div class="hero-actions hl">
      <a href={locale === 'en' ? '/en/contact' : '/contact'} class="btn-solid"
        >{copy.hero.contact}</a
      >
      <a href={locale === 'en' ? '/en/services' : '/product'} class="btn-ghost"
        >{copy.hero.services}</a
      >
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</section>
