---
import type { HomepageStat } from '@/lib/directus'
import HomeStatsAccuracy from './stats/HomeStatsAccuracy.astro'
import HomeStatsInspection from './stats/HomeStatsInspection.astro'
import HomeStatsLifecycle from './stats/HomeStatsLifecycle.astro'
import HomeStatsNetwork from './stats/HomeStatsNetwork.astro'
import HomeStatsTenure from './stats/HomeStatsTenure.astro'
import HomeStatsWarehouse from './stats/HomeStatsWarehouse.astro'
import '@/styles/home-capability-stats.css'
import { homeStatGroup, homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  stats: HomepageStat[]
  locale?: SiteLocale
}

const { stats, locale = 'zh-CN' } = Astro.props
const copy = homeUi(locale)

const pickStats = (...positions: number[]) =>
  positions
    .map((position) => stats.find((stat) => stat.sort === position))
    .filter((stat): stat is HomepageStat => Boolean(stat))
const statsFor = (
  group: 'warehouse' | 'network' | 'inspection' | 'accuracy',
  ...positions: number[]
) =>
  locale === 'en'
    ? stats.filter((stat) => homeStatGroup(stat.claimKey) === group)
    : pickStats(...positions)
---

<section id="s-stats" class="s-stats" aria-labelledby="stats-heading" data-locale={locale}>
  <div class="stats-deco" aria-hidden="true"><div class="deco-watermark">15Y</div></div>
  <div class="stats-inner">
    <header class="stats-heading">
      <div>
        <p class="section-tag">{copy.stats.tag}</p>
        <h2 id="stats-heading" class="stats-headline">
          {copy.stats.heading[0]}<br />{copy.stats.heading[1]}
        </h2>
      </div>
      <p class="stats-intro">
        {copy.stats.intro}
      </p>
    </header>

    <div class="stats-bento">
      <HomeStatsTenure {locale} />
      <HomeStatsWarehouse stats={statsFor('warehouse', 2, 4)} {locale} />
      <HomeStatsNetwork stats={statsFor('network', 1, 8, 3)} {locale} />
      <HomeStatsInspection stats={statsFor('inspection', 5, 6)} {locale} />
      <HomeStatsAccuracy stats={statsFor('accuracy', 7)} {locale} />
    </div>

    <HomeStatsLifecycle {locale} />

    <details class="stats-notes">
      <summary>{copy.stats.notes}</summary>
      <div class="stats-notes-body">
        <p class="stats-footnote">
          <span>{copy.stats.basis}</span>
          {copy.stats.footnote}
        </p>
        <p class="stats-disclaimer">
          {copy.stats.disclaimer}
        </p>
      </div>
    </details>
  </div>
</section>
