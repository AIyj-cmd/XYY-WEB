---
import { YUNDAO_FEATURES } from '@/data/home'
import HomeServiceFeatures from './HomeServiceFeatures.astro'
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'

interface DigitalProduct {
  id: string
  tag: string
  name: string
  subtitle: string
  description: string
  features: readonly string[]
  href: string
}

interface Props {
  product: DigitalProduct
  index: number
  sequence: number
  locale?: SiteLocale
}

const { product, index, sequence, locale = 'zh-CN' } = Astro.props
const isYundao = product.id === 'yundao-platform'
const copy = homeUi(locale)
const isEnglishYundao = locale === 'en' && isYundao
const displayName = isEnglishYundao ? copy.digital.name : product.name
const displaySubtitle = isEnglishYundao ? copy.digital.subtitle : product.subtitle
const displayFeatures = isEnglishYundao ? copy.digital.features : product.features.slice(0, 4)
---

<section
  class:list={['s-service', { reverse: sequence % 2 === 1 }]}
  id={`dp-${product.id}`}
  aria-labelledby={`dp-title-${index}`}
  data-locale={locale}
>
  <div class="svc-media">
    {
      isYundao ? (
        <div class="yundao-visual" aria-label={copy.digital.visual}>
          <div class="yundao-interface-grid" aria-label={copy.digital.visual}>
            <img
              class="yundao-interface-main"
              src="/yundao-logistics-list.png"
              alt={copy.digital.interfaces[0]}
              loading="lazy"
            />
            <img
              class="yundao-interface-side-1"
              src="/yundao-order-list.png"
              alt={copy.digital.interfaces[1]}
              loading="lazy"
            />
            <img
              class="yundao-interface-side-2"
              src="/yundao-alerts.png"
              alt={copy.digital.interfaces[2]}
              loading="lazy"
            />
            <img
              class="yundao-interface-detail"
              src="/yundao-report.png"
              alt={copy.digital.interfaces[3]}
              loading="lazy"
            />
          </div>
        </div>
      ) : null
    }
    {isYundao && <p class="svc-media-caption">{copy.digital.flow}</p>}
    <div class:list={['svc-num-badge', { 'svc-num-badge--solution': isYundao }]}>
      <span>0{sequence + 1}</span>{isYundao && <small>{copy.digital.badge}</small>}
    </div>
  </div>
  <div class="svc-body">
    <p class="section-tag">{isYundao ? copy.solutions.tag : product.tag}</p>
    {isYundao && <p class="svc-problem">{copy.digital.problem}</p>}
    <h2 id={`dp-title-${index}`} class="svc-title">{displayName}</h2>
    <p class="svc-sub">{displaySubtitle}</p>
    <p class="svc-desc">
      {isYundao ? copy.digital.description : product.description}
    </p>
    <HomeServiceFeatures features={locale === 'en' ? displayFeatures : YUNDAO_FEATURES} />
    {
      isYundao && (
        <p class="svc-fee-note">
          <strong>{copy.digital.fee[0]}</strong>
          {copy.digital.fee[1]}
        </p>
      )
    }
    <a href={isYundao ? copy.digital.href : product.href} class="svc-link">
      {isYundao ? copy.digital.link : locale === 'en' ? 'View details →' : '查看详情 →'}
    </a>
  </div>
</section>
