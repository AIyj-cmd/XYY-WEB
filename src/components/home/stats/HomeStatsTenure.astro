---
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'
interface Props {
  locale?: SiteLocale
}
const { locale = 'zh-CN' } = Astro.props
const copy = homeUi(locale).stats.tenure
---

<article class="stats-tenure">
  <div class="tenure-topline">
    <span>{copy.label}</span>
    <span class="tenure-status"><i></i>{copy.status}</span>
  </div>
  <div class="tenure-value" aria-label={copy.aria}>
    <strong data-raw="15">15</strong>
    <span>YEARS</span>
  </div>
  <p class="tenure-label">{copy.experience}</p>
  <div class="tenure-coverage">
    <ul>
      {copy.coverage.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="tenure-range" aria-label={copy.range}>
    <span>2011</span>
    <i aria-hidden="true"></i>
    <span>2026</span>
  </div>
  <svg
    class="tenure-route"
    viewBox="0 0 320 180"
    fill="none"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path class="tenure-route-track" d="M-12 145C54 145 50 65 119 65s70 63 125 28 82-58 104-47"
    ></path>
    <path
      class="tenure-route-progress"
      pathLength="1"
      d="M-12 145C54 145 50 65 119 65s70 63 125 28 82-58 104-47"></path>
    <circle class="tenure-route-node" cx="52" cy="111" r="5"></circle>
    <circle class="tenure-route-node" cx="119" cy="65" r="5"></circle>
    <circle class="tenure-route-node" cx="244" cy="93" r="5"></circle>
    <circle class="tenure-route-node tenure-route-node--accent" cx="313" cy="53" r="6"></circle>
  </svg>
</article>
