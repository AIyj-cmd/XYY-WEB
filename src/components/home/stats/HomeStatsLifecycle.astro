---
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'
interface Props {
  locale?: SiteLocale
}
const { locale = 'zh-CN' } = Astro.props
const copy = homeUi(locale).stats.lifecycle
const steps = copy.steps
---

<div class="stats-flow" aria-label={copy.aria}>
  <div class="stats-flow-heading">
    <span>{copy.label}</span>
    <strong>{copy.heading}</strong>
  </div>
  <div class="stats-flow-rail" aria-hidden="true">
    <span class="stats-flow-progress"></span>
  </div>
  <ol class="stats-flow-list">
    {
      steps.map((step, index) => (
        <li class="stats-flow-step">
          <span class="flow-index">{String(index + 1).padStart(2, '0')}</span>
          <i aria-hidden="true" />
          <strong>{step}</strong>
        </li>
      ))
    }
  </ol>
</div>
