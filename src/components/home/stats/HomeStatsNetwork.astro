---
import type { HomepageStat } from '@/lib/directus'

interface Props {
  stats: HomepageStat[]
}

const { stats } = Astro.props
---

<article class="stat-card stats-network" data-flow="network">
  <header class="stat-card-heading">
    <span class="stat-card-kicker">服务网络</span>
    <span class="stat-card-index">02</span>
  </header>
  <div class="stat-metrics stat-metrics--network">
    {
      stats.map(({ value, label, unit, detail }) => (
        <div class="stat-metric">
          <div class="stat-val">
            <span class="stat-num" data-raw={value}>
              {value}
            </span>
            <span class="stat-unit">{unit}</span>
          </div>
          <h3 class="stat-label">{label}</h3>
          <p class="stat-detail">{detail}</p>
        </div>
      ))
    }
  </div>
  <div class="network-orbit" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
</article>
