---
import '@/styles/home-faq.css'
import '@/styles/home-conversion-cta.css'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'

interface FaqItem {
  contentKey?: string
  q: string
  a: string
}

interface Props {
  items: FaqItem[]
  phone: string
}

const { items } = Astro.props
---

<section id="s-faq" class="s-faq" aria-labelledby="faq-heading">
  <div class="faq-inner">
    <aside class="faq-intro">
      <p class="section-tag">常见问题</p>
      <h2 id="faq-heading" class="faq-title">关于鞋服仓配<br />你可能还想了解这些</h2>
      <p class="faq-intro-copy">合作前，品牌通常会从服务范围、履约能力和合作方式开始了解。</p>
    </aside>
    <div class="faq-content">
      <div class="faq-list">
        {
          items.map(({ q, a }, index) => (
            <details class="faq-item" open={index === 0}>
              <summary class="faq-q">
                <span class="faq-index">{String(index + 1).padStart(2, '0')}</span>
                <span>{q}</span>
                <span class="faq-toggle" aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p class="faq-a">{a}</p>
              </div>
            </details>
          ))
        }
      </div>
      <p class="faq-authority">
        数据说明：本页涉及的新亦源服务与运营数据来源于新亦源内部运营统计，具体以对应统计周期和经营记录为准。
      </p>
    </div>
  </div>
</section>

<ConversionCTA
  headingId="home-conversion-cta-heading"
  eyebrow="咨询仓配"
  headingLines={['让仓配方案', '贴合你的业务']}
  description="无论是新业务入仓、现有仓配调整，还是退货处理优化，都可以从你的货品、订单和渠道需求开始沟通。"
  actionLabel="获取仓配方案"
  preparationTitle="我们可以一起梳理"
  preparationItems={[
    {
      label: '仓储与订单履约',
      detail: '结合 SKU 规模、日均订单与大促波峰，沟通库存管理、拣货复核和发货安排。',
    },
    {
      label: '销售渠道与仓网配置',
      detail: '从电商发货、门店补货到跨境业务，结合销售渠道与发货区域讨论仓配需求。',
    },
    {
      label: '退货处理与配套服务',
      detail: '按业务流程梳理退货质检、后整修复、二次上架及系统对接需求。',
    },
  ]}
  condition="已有大致需求即可开始沟通，具体服务内容与费用结合项目情况确认。"
  reveal="product"
  className="home-conversion-cta"
/>

<script>
  import '@/scripts/home-faq'
</script>
