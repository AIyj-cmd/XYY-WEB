---
import '@/styles/home-faq.css'
import '@/styles/home-conversion-cta.css'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'

interface FaqItem {
  contentKey?: string
  q: string
  a: string
}

interface Props {
  items: FaqItem[]
  phone: string
  locale?: SiteLocale
}

const { items, locale = 'zh-CN' } = Astro.props
const copy = homeUi(locale).faq
---

<section id="s-faq" class="s-faq" aria-labelledby="faq-heading" data-locale={locale}>
  <div class="faq-inner">
    <aside class="faq-intro">
      <p class="section-tag">{copy.tag}</p>
      <h2 id="faq-heading" class="faq-title">{copy.heading[0]}<br />{copy.heading[1]}</h2>
      <p class="faq-intro-copy">{copy.intro}</p>
    </aside>
    <div class="faq-content">
      <div class="faq-list">
        {
          items.map(({ q, a }, index) => (
            <details class="faq-item" open={index === 0}>
              <summary class="faq-q">
                <span class="faq-index">{String(index + 1).padStart(2, '0')}</span>
                <span>{q}</span>
                <span class="faq-toggle" aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p class="faq-a">{a}</p>
              </div>
            </details>
          ))
        }
      </div>
      <p class="faq-authority">
        {copy.authority}
      </p>
    </div>
  </div>
</section>

<ConversionCTA
  headingId="home-conversion-cta-heading"
  eyebrow={copy.cta.eyebrow}
  headingLines={[...copy.cta.heading]}
  description={copy.cta.description}
  actionLabel={copy.cta.action}
  actionHref={locale === 'en' ? '/en/contact' : '/contact'}
  preparationTitle={copy.cta.preparationTitle}
  preparationItems={copy.cta.preparation.map(([label, detail]) => ({ label, detail }))}
  condition={copy.cta.condition}
  reveal="product"
  className="home-conversion-cta"
/>

<script>
  import '@/scripts/home-faq'
</script>
