---
import {
  CLOUD_WAREHOUSE_FEATURES,
  DIGITAL_LOGISTICS_FEATURES,
  HOME_IMAGES,
  HOME_SOLUTION_COPY,
  RETURN_QUALITY_FEATURES,
  resolveHomeServiceHref,
} from '@/data/home'
import type { Service } from '@/lib/directus'
import HomeServiceFeatures from './HomeServiceFeatures.astro'
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  service: Service
  index: number
  locale?: SiteLocale
}

const { service, index, locale = 'zh-CN' } = Astro.props
const copy = homeUi(locale)
const current = HOME_SOLUTION_COPY[index] ?? HOME_SOLUTION_COPY[0]
const english =
  locale === 'en'
    ? copy.solutions.bySlug[service.slug as keyof typeof copy.solutions.bySlug]
    : undefined
const display = locale === 'en' ? english : current
const serviceHref =
  locale === 'en' ? (english?.href ?? '/en/contact') : resolveHomeServiceHref(service, index)
const serviceLink = locale === 'en' ? (english?.link ?? 'Discuss your operation →') : current.cta
const features =
  locale === 'en'
    ? service.features.slice(0, 4)
    : ([CLOUD_WAREHOUSE_FEATURES, RETURN_QUALITY_FEATURES, DIGITAL_LOGISTICS_FEATURES][index] ??
      service.features.slice(0, 4))
---

<section
  class:list={['s-service', { reverse: index % 2 === 1 }]}
  id={`svc-${service.slug}`}
  aria-labelledby={`svc-title-${index}`}
  data-locale={locale}
>
  <div class="svc-media">
    {
      index === 2 ? (
        <div class="svc-dashboard-frame">
          <p class="svc-dashboard-heading">{copy.solutions.dashboard}</p>
          <div class="svc-dashboard-viewport">
            <img
              src={HOME_IMAGES.svc2}
              alt={copy.solutions.dashboardAlt}
              class="svc-img"
              loading="lazy"
            />
          </div>
        </div>
      ) : (
        <img
          src={HOME_IMAGES[`svc${index}` as 'svc0' | 'svc1']}
          alt={service.name}
          class="svc-img"
          loading="lazy"
        />
      )
    }
    <div class="svc-num-badge svc-num-badge--solution">
      <span>0{index + 1}</span><small>{display?.badge}</small>
    </div>
    <p class="svc-media-caption">
      {
        (display?.caption ?? []).map((item, itemIndex, captions) => (
          <>
            {item}
            {itemIndex < captions.length - 1 && <i>｜</i>}
          </>
        ))
      }
    </p>
  </div>
  <div class="svc-body">
    <p class="section-tag">{copy.solutions.tag}</p>
    <p class="svc-problem">{display?.problem}</p>
    <h2 id={`svc-title-${index}`} class="svc-title">{service.name}</h2>
    <p class="svc-sub">{service.subtitle}</p>
    {
      index === 1 && (
        <div class="svc-quality-assurance" aria-label={copy.solutions.qualityAria}>
          <>
            <p>{copy.solutions.quality[0]}</p>
            <span>{copy.solutions.quality[1]}</span>
          </>
        </div>
      )
    }
    <p class="svc-desc">{service.description}</p>
    <HomeServiceFeatures features={features} />
    <div class="svc-scenarios" aria-label={copy.solutions.scenarios}>
      <span>{copy.solutions.scenarios}</span><div>
        {(display?.scenarios ?? []).map((scenario) => <b>{scenario}</b>)}
      </div>
    </div>
    {
      index === 2 && (
        <p class="svc-fee-note">
          <strong>{copy.solutions.fee[0]}</strong>
          {copy.solutions.fee[1]}
        </p>
      )
    }
    <a href={serviceHref} class="svc-link">
      {serviceLink}
    </a>
  </div>
</section>
