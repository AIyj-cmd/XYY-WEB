---
import { FULFILLMENT_STEPS } from '@/data/home'
import '@/styles/home-fulfillment.css'
import { homeUi } from '@/i18n/home-ui'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  locale?: SiteLocale
}
const { locale = 'zh-CN' } = Astro.props
const copy = homeUi(locale).fulfillment
---

<section
  id="s-fulfillment"
  class="s-fulfillment"
  aria-labelledby="fulfillment-heading"
  data-locale={locale}
>
  <div class="fulfillment-header">
    <p class="section-tag">{copy.tag}</p>
    <h2 id="fulfillment-heading" class="fulfillment-title">
      {copy.heading}
    </h2>
    <p class="fulfillment-sub">
      {copy.intro}
    </p>
  </div>
  <div class="fulfillment-track" role="list">
    {
      FULFILLMENT_STEPS.map(({ num }, index) => (
        <div
          class:list={[
            'fulfillment-step',
            { 'is-terminal': index === 0 || index === FULFILLMENT_STEPS.length - 1 },
          ]}
          role="listitem"
          style={`--i:${index}`}
        >
          <div class="fulfillment-connector" aria-hidden="true" />
          <div class="fulfillment-num-wrap">
            <div class="fulfillment-num">{num}</div>
            <div class="fulfillment-num-ring" aria-hidden="true" />
          </div>
          <p class="fulfillment-step-title">{copy.steps[index]?.[0]}</p>
          <p class="fulfillment-step-desc">{copy.steps[index]?.[1]}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  import '@/scripts/home-fulfillment'
</script>
