---
import {
  getServiceFinderContext,
  type ServiceFinderNeed,
  type ServiceFinderRegion,
} from '@/lib/conversion/contact-source'
import type { SiteLocale } from '@/i18n/routes'
import '@/styles/service-finder.css'

interface Props {
  locale?: SiteLocale
}

const { locale = 'zh-CN' } = Astro.props
const english = locale === 'en'
const context = getServiceFinderContext(Astro.url)
const contactPath = english ? '/en/contact' : '/contact'
const finderAction = `${contactPath}#service-finder`

const needs: Record<ServiceFinderNeed, string> = english
  ? {
      'ecommerce-fulfilment': 'E-commerce fulfilment',
      'store-replenishment': 'Store replenishment',
      'returns-inspection': 'Returns inspection',
      'garment-care': 'Garment care and finishing',
      'livestream-fulfilment': 'Livestream fulfilment',
    }
  : {
      'ecommerce-fulfilment': '电商发货',
      'store-replenishment': '门店补货',
      'returns-inspection': '退货质检',
      'garment-care': '商品整理',
      'livestream-fulfilment': '直播履约',
    }
const regions: Record<ServiceFinderRegion, string> = english
  ? { any: 'No regional preference', 'east-china': 'East China', 'south-china': 'South China' }
  : { any: '区域不限', 'east-china': '华东', 'south-china': '华南' }

const result = context && {
  service: context.service,
  serviceLabel:
    context.service === 'quality-inspection'
      ? english
        ? 'Inspection and garment care'
        : '后整质检修复'
      : english
        ? 'Apparel fulfilment'
        : '鞋服云仓',
  detailHref: english
    ? {
        'ecommerce-fulfilment': '/en/apparel-fulfillment',
        'store-replenishment': '/en/retail-distribution',
        'returns-inspection': '/en/returns-inspection',
        'garment-care': '/en/garment-care',
        'livestream-fulfilment': '/en/services#07-live-commerce',
      }[context.need]
    : context.need === 'ecommerce-fulfilment'
      ? context.region === 'east-china'
        ? '/huadong-xiefu-yuncang'
        : context.region === 'south-china'
          ? '/huanan-xiefu-yuncang'
          : '/xiefu-yuncang'
      : {
          'store-replenishment': '/b2b-mendian-cangpei',
          'returns-inspection': '/tuihuo-zhijian',
          'garment-care': '/houzheng-xiufu',
          'livestream-fulfilment': '/zhibo-cangpei',
        }[context.need],
  preparation:
    context.need === 'returns-inspection'
      ? english
        ? 'Prepare return volumes, inspection points and disposition rules.'
        : '建议准备退货规模、质检要点与处理规则。'
      : context.need === 'store-replenishment'
        ? english
          ? 'Prepare store count, replenishment cadence and delivery windows.'
          : '建议准备门店数量、补货频次与到店时段。'
        : context.need === 'livestream-fulfilment'
          ? english
            ? 'Prepare livestream schedule, peak order estimates and packing requirements.'
            : '建议准备直播排期、峰值订单预估与包装要求。'
          : english
            ? 'Prepare category, SKU count, sales channels and expected timeline.'
            : '建议准备品类、SKU数量、销售渠道与计划时间。',
}
---

<section class="service-finder" aria-labelledby="service-finder-heading" id="service-finder">
  <details open={Boolean(result)}>
    <summary id="service-finder-heading">
      <span>{english ? 'Find a service for your requirements' : '按需求选择服务'}</span>
      <span aria-hidden="true" class="service-finder__summary-icon"></span>
    </summary>
    <div class="service-finder__content">
      <p>
        {
          english
            ? 'Choose an operating need and region to view a relevant service discussion path.'
            : '选择业务需求和区域，查看适合进一步沟通的服务方向。'
        }
      </p>
      <form method="GET" action={finderAction} class="service-finder__form">
        <label>
          <span>{english ? 'Operating need' : '业务需求'}</span>
          <select name="need" required>
            <option value="" selected={!context}>{english ? 'Select a need' : '请选择需求'}</option>
            {
              Object.entries(needs).map(([value, label]) => (
                <option value={value} selected={context?.need === value}>
                  {label}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          <span>{english ? 'Region' : '区域'}</span>
          <select name="region">
            {
              Object.entries(regions).map(([value, label]) => (
                <option value={value} selected={(context?.region ?? 'any') === value}>
                  {label}
                </option>
              ))
            }
          </select>
        </label>
        <button type="submit">{english ? 'View service path' : '查看服务建议'}</button>
      </form>
      {
        result && (
          <aside class="service-finder__result" aria-live="polite">
            <p class="service-finder__eyebrow">
              {english ? 'Suggested discussion' : '建议沟通方向'}
            </p>
            <h2>{result.serviceLabel}</h2>
            <p>{result.preparation}</p>
            <div class="service-finder__actions">
              <a href={result.detailHref}>{english ? 'View service details' : '查看服务详情'}</a>
              <a href={english ? '/en/cases' : '/cases'}>
                {english ? 'Explore cases' : '查看合作案例'}
              </a>
              <a href="#contact-form">{english ? 'Continue to enquiry' : '继续咨询'}</a>
            </div>
            <a class="service-finder__reset" href={contactPath}>
              {english ? 'Choose again' : '重新选择'}
            </a>
          </aside>
        )
      }
    </div>
  </details>
</section>
