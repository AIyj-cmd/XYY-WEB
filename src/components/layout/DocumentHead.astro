---
import { BRAND } from '@/lib/brand'
import { serializeJsonForScript } from '@/lib/safe-json'
import { ENGLISH_ROUTES, type SiteLocale } from '@/i18n/routes'
import type { LocalePair } from '@/i18n/case-routes'

interface Props {
  title: string
  description: string
  canonical: string
  ogImage: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noIndex?: boolean
  locale?: SiteLocale
  localePair?: LocalePair
}

const {
  title,
  description,
  canonical,
  ogImage,
  jsonLd,
  noIndex = false,
  locale = 'zh-CN',
  localePair,
} = Astro.props
const fullTitle =
  locale === 'en'
    ? `${title} | XINYIYUAN Supply Chain`
    : title.includes('新亦源')
      ? title
      : `${title} - ${BRAND.name}`
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
const pathname = new URL(canonical).pathname.replace(/\/$/, '') || '/'
const routePair =
  localePair && (locale === 'en' ? localePair[1] : localePair[0]) === pathname
    ? localePair
    : ENGLISH_ROUTES.find(([zh, en]) => (locale === 'en' ? en : zh) === pathname)
const alternate = routePair && (locale === 'en' ? routePair[0] : routePair[1])
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noIndex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonical} />
{alternate && <link rel="alternate" hreflang={locale === 'en' ? 'en' : 'zh-CN'} href={canonical} />}
{
  alternate && (
    <link
      rel="alternate"
      hreflang={locale === 'en' ? 'zh-CN' : 'en'}
      href={new URL(alternate, BRAND.url).href}
    />
  )
}
{
  alternate && (
    <link rel="alternate" hreflang="x-default" href={new URL(routePair[0], BRAND.url).href} />
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={locale === 'en' ? 'XINYIYUAN Supply Chain' : BRAND.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link
  rel="stylesheet"
  href="/fonts/puhuiti-400/result.css"
  media="print"
  onload="if(matchMedia('(min-width:768px)').matches)this.setAttribute('media','all')"
/>
<link
  rel="stylesheet"
  href="/fonts/puhuiti-900/result.css"
  media="print"
  onload="if(matchMedia('(min-width:768px)').matches)this.setAttribute('media','all')"
/>
<noscript>
  <link rel="stylesheet" href="/fonts/puhuiti-400/result.css" media="(min-width:768px)" />
  <link rel="stylesheet" href="/fonts/puhuiti-900/result.css" media="(min-width:768px)" />
</noscript>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{
  schemas.map((schema) => (
    <script is:inline type="application/ld+json" set:html={serializeJsonForScript(schema)} />
  ))
}
