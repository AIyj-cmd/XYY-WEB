---
import { NAV_LINKS } from '@/lib/brand'
import { ENGLISH_NAVIGATION, isNavigationActive, type SiteLocale } from '@/i18n/routes'
import { shellCopy } from '@/i18n/shell'

interface Props {
  pathname: string
  isProductActive: boolean
  locale?: SiteLocale
}

const { pathname, isProductActive, locale = 'zh-CN' } = Astro.props
const links = locale === 'en' ? ENGLISH_NAVIGATION : NAV_LINKS
---

<nav
  class="site-header__desktop-navigation hidden items-center gap-0.5"
  aria-label={shellCopy(locale).nav}
>
  {
    links.map(({ href, label }) => {
      if (locale === 'zh-CN' && href === '/product') {
        return (
          <a
            href="/product"
            class:list={[
              'flex items-center rounded-full px-3 py-2 text-[15px] font-medium leading-none tracking-[-0.15px] transition-colors',
              isProductActive
                ? 'bg-white/15 text-white'
                : 'text-slate-200 hover:bg-white/10 hover:text-white',
            ]}
            aria-current={isProductActive ? 'page' : undefined}
          >
            {label}
          </a>
        )
      }

      const isActive = isNavigationActive(href, pathname, locale)
      return (
        <a
          href={href}
          class:list={[
            'rounded-full px-3 py-2 text-[15px] font-medium leading-none tracking-[-0.15px] transition-colors',
            isActive
              ? 'bg-white/15 text-white'
              : 'text-slate-200 hover:bg-white/10 hover:text-white',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {label}
        </a>
      )
    })
  }
</nav>
