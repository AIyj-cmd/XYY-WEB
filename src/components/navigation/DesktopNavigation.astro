---
import { NAV_LINKS } from '@/lib/brand'

interface Props {
  pathname: string
  isProductActive: boolean
}

const { pathname, isProductActive } = Astro.props
---

<nav class="site-header__desktop-navigation hidden items-center gap-0.5" aria-label="主导航">
  {
    NAV_LINKS.map(({ href, label }) => {
      if (href === '/product') {
        return (
          <a
            href="/product"
            class:list={[
              'flex items-center rounded-full px-3 py-2 text-[15px] font-medium leading-none tracking-[-0.15px] transition-colors',
              isProductActive
                ? 'bg-white/15 text-white'
                : 'text-slate-200 hover:bg-white/10 hover:text-white',
            ]}
            aria-current={isProductActive ? 'page' : undefined}
          >
            {label}
          </a>
        )
      }

      const isActive = href === '/' ? pathname === '/' : pathname.startsWith(href)
      return (
        <a
          href={href}
          class:list={[
            'rounded-full px-3 py-2 text-[15px] font-medium leading-none tracking-[-0.15px] transition-colors',
            isActive
              ? 'bg-white/15 text-white'
              : 'text-slate-200 hover:bg-white/10 hover:text-white',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {label}
        </a>
      )
    })
  }
</nav>
