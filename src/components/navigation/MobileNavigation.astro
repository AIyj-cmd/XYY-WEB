---
import { NAV_LINKS } from '@/lib/brand'

interface Props {
  pathname: string
  isProductActive: boolean
}

const { pathname, isProductActive } = Astro.props
const navGroups = [NAV_LINKS.slice(0, 3), NAV_LINKS.slice(3)]
---

<nav class="site-header__mobile-navigation" aria-label="移动端导航">
  {
    navGroups.map((links, index) => (
      <div
        class:list={[
          'site-header__mobile-row',
          index === 0 ? 'site-header__mobile-row--primary' : 'site-header__mobile-row--secondary',
        ]}
      >
        {links.map(({ href, label }) => {
          const isActive =
            href === '/product'
              ? isProductActive
              : href === '/'
                ? pathname === '/'
                : pathname.startsWith(href)
          return (
            <a
              href={href}
              class:list={[
                'site-header__mobile-link rounded-md text-sm font-medium transition-colors',
                isActive
                  ? 'bg-white/15 text-white'
                  : 'text-navy-100 hover:bg-white/10 hover:text-white',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          )
        })}
      </div>
    ))
  }
</nav>
