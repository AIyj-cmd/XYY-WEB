---
import { SPECIALTY_LINKS } from '@/data/navigation'
import { NAV_LINKS } from '@/lib/brand'

interface Props {
  pathname: string
  isProductActive: boolean
}

const { pathname, isProductActive } = Astro.props
---

<div
  id="mobile-menu"
  class="absolute top-[calc(100%+0.75rem)] left-0 right-0 hidden rounded-2xl border border-white/15 bg-navy-900/95 shadow-lg backdrop-blur-xl lg:hidden"
  role="navigation"
  aria-label="移动端导航"
>
  <div class="space-y-1 px-4 py-3">
    {
      NAV_LINKS.map(({ href, label }) => {
        if (href === '/product') {
          return (
            <div>
              <a
                href="/product"
                class:list={[
                  'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
                  isProductActive
                    ? 'bg-white/15 text-white'
                    : 'text-navy-100 hover:bg-white/10 hover:text-white',
                ]}
              >
                {label}
              </a>
              <div class="ml-4 mt-1 grid grid-cols-2 gap-1">
                {SPECIALTY_LINKS.map(({ href: specialtyHref, label: specialtyLabel }) => (
                  <a
                    href={specialtyHref}
                    class:list={[
                      'px-3 py-1.5 rounded-md text-xs font-medium transition-colors',
                      pathname.startsWith(specialtyHref)
                        ? 'bg-white/15 text-white'
                        : 'text-navy-300 hover:bg-white/10 hover:text-white',
                    ]}
                  >
                    {specialtyLabel}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        const isActive = href === '/' ? pathname === '/' : pathname.startsWith(href)
        return (
          <a
            href={href}
            class:list={[
              'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
              isActive
                ? 'bg-white/15 text-white'
                : 'text-navy-100 hover:bg-white/10 hover:text-white',
            ]}
          >
            {label}
          </a>
        )
      })
    }
  </div>
</div>
