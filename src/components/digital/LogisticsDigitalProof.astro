---
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import { DIGITAL_OPERATIONS_ENGLISH } from '@/i18n/digital-operations'
import type { SiteLocale } from '@/i18n/routes'

interface Props {
  locale?: SiteLocale
}

const { locale = 'zh-CN' } = Astro.props
const english = locale === 'en' ? DIGITAL_OPERATIONS_ENGLISH : undefined
---

<ConversionCTA
  headingId="digital-conversion-cta-heading"
  eyebrow={english?.proof.eyebrow ?? '物流数字化'}
  headingLines={english ? [...english.proof.heading] : ['提交系统', '对接需求']}
  description={english?.proof.description ??
    '系统对接方式、数据字段、权限范围及实施节奏，均以实际业务流程与项目方案为准。'}
  actionLabel={english?.proof.action ?? '提交系统对接需求'}
  actionHref={english ? '/en/contact' : undefined}
  preparationAriaLabel={english?.proof.preparationAria}
  preparationItems={english
    ? [...english.proof.preparation]
    : [
        { label: '系统对接方式', detail: '现有系统与接口安排' },
        { label: '数据字段', detail: '需要对接的数据内容' },
        { label: '权限范围及实施节奏', detail: '权限要求与项目安排' },
      ]}
  reveal="service"
/>
