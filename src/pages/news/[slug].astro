---
import NewsArticleContent from '@/components/news/NewsArticleContent.astro'
import Layout from '@/layouts/Layout.astro'
import { BRAND } from '@/lib/brand'
import { getNewsArticle, getPublishedNews, getDirectusAssetUrl } from '@/lib/directus'
import { sanitizeRichText } from '@/lib/sanitize'
import '@/styles/news.css'

const { slug } = Astro.params as { slug: string }
const article = await getNewsArticle(slug)
if (!article) return Astro.redirect('/news', 302)

const relatedArticles = await getPublishedNews(3, 1)
const related = relatedArticles.filter((item) => item.slug !== slug).slice(0, 3)
const sanitizedContent = sanitizeRichText(article.content ?? '')

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  '@id': `${BRAND.url}/news/${article.slug}`,
  headline: article.title,
  description: article.summary,
  datePublished: article.published_at,
  dateModified: article.date_updated ?? article.published_at,
  author: { '@type': 'Organization', name: BRAND.fullName, url: BRAND.url },
  publisher: {
    '@type': 'Organization',
    name: BRAND.name,
    logo: { '@type': 'ImageObject', url: `${BRAND.url}/logo.png` },
  },
  url: `${BRAND.url}/news/${article.slug}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${BRAND.url}/news/${article.slug}` },
  ...(article.cover_image && { image: getDirectusAssetUrl(article.cover_image) }),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '行业动态', item: `${BRAND.url}/news` },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.title,
      item: `${BRAND.url}/news/${article.slug}`,
    },
  ],
}
---

<Layout
  title={article.title}
  description={article.summary}
  canonical={`${BRAND.url}/news/${article.slug}`}
  ogImage={article.cover_image ? getDirectusAssetUrl(article.cover_image) : undefined}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <NewsArticleContent article={article} related={related} sanitizedContent={sanitizedContent} />
</Layout>
