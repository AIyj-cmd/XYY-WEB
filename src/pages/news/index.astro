---
import Layout from '@/layouts/Layout.astro'
import PageFAQ from '@/components/PageFAQ.astro'
import NewsEmptyState from '@/components/news/NewsEmptyState.astro'
import NewsGrid from '@/components/news/NewsGrid.astro'
import NewsLandingIntro from '@/components/news/NewsLandingIntro.astro'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import { BRAND } from '@/lib/brand'
import { getFaqs, getNewsByCategory, getPublishedNews, NEWS_CATEGORIES } from '@/lib/directus'
import { createFaqSchema } from '@/lib/seo'
import { NEWS_FAQS } from '@/data/news'
import '@/styles/news.css'

const requestedCategory = Astro.url.searchParams.get('cat') ?? ''
const category = NEWS_CATEGORIES.includes(requestedCategory as (typeof NEWS_CATEGORIES)[number])
  ? requestedCategory
  : ''
const showAll = Astro.url.searchParams.get('all') === '1'
const allArticles = category
  ? await getNewsByCategory(category, 100)
  : await getPublishedNews(100, 1)
const hasMore = allArticles.length > 10
const articles = showAll ? allArticles : allArticles.slice(0, 10)
const viewAllHref =
  !showAll && hasMore
    ? category
      ? `/news?cat=${encodeURIComponent(category)}&all=1`
      : '/news?all=1'
    : undefined
const faqs = await getFaqs('news', NEWS_FAQS)

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '行业动态', item: `${BRAND.url}/news` },
  ],
}

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${BRAND.url}/news`,
  name: '新亦源行业动态',
  description: '新亦源行业内容中心，发布鞋服仓配、退货质检与供应链运营实践。',
  url: `${BRAND.url}/news`,
}

const faqSchema = createFaqSchema(faqs)
---

<Layout
  title="行业动态 | 新亦源供应链"
  description="新亦源行业内容中心，持续发布鞋服仓配、退货质检、物流数字化与供应链运营实践。"
  jsonLd={[breadcrumbSchema, pageSchema, faqSchema]}
>
  <NewsLandingIntro {category} />
  {
    articles.length ? (
      <NewsGrid {articles} totalCount={allArticles.length} {viewAllHref} />
    ) : (
      <NewsEmptyState {category} />
    )
  }

  <!-- FAQ -->
  <PageFAQ heading="行业内容使用与更新说明" items={faqs} />

  <ConversionCTA
    headingId="news-conversion-cta-heading"
    eyebrow="START A CONVERSATION"
    headingLines={['想了解适合您品类的', '物流方案？']}
    description="告诉我们商品类型、销售渠道和当前履约问题，物流顾问将为您提供针对性的分析与建议。"
    actionLabel="获取物流方案"
    preparationTitle="沟通前可准备这 3 类信息"
    preparationItems={[
      { label: '商品与渠道', detail: '商品类型 · 主要销售平台' },
      { label: '业务规模', detail: '订单量 · SKU 与库存规模' },
      { label: '关注方向', detail: '仓配运营 · 退货处理 · 行业趋势' },
    ]}
  />
</Layout>
