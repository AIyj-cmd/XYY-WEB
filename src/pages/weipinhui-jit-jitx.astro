---
import ServiceLanding from '@/layouts/ServiceLanding.astro'
import JitComparisonSection from '@/components/service/unique/JitComparisonSection.astro'
import { CLAIM_TEXT } from '@/lib/claims'
---

<ServiceLanding
  title="唯品会JIT/JITX仓配服务商 — 60+品牌专属经验，肇庆唯品会物流园内 | 新亦源"
  description={`新亦源是唯品会JIT/JITX深度合作仓配服务商，合作品牌${CLAIM_TEXT.partnerBrands}中60+涉及唯品会运营，肇庆四会仓位于唯品会物流园内，JIT+JITX双模式对接，${CLAIM_TEXT.shippingSla}。`}
  slug="weipinhui-jit-jitx"
  variant="jit-radar"
  breadcrumbLabel="唯品会JIT/JITX"
  eyebrow="唯品会JIT/JITX · 专业仓配对接服务商"
  h1="唯品会JIT/JITX仓配"
  h1sub="60+品牌专属运营经验，肇庆唯品会物流园内直发"
  heroDesc={`新亦源是唯品会深度合作仓配服务商，合作品牌${CLAIM_TEXT.partnerBrands}中60+涉及唯品会运营，肇庆四会仓位于唯品会物流园内，JIT/JITX标准化对接经验丰富，SLA合同保障。`}
  imgSrc="/w-fulfill.webp"
  imgAlt="唯品会JIT/JITX仓配 — 专业快速发货"
  stats={[
    { stat: '60+', label: '涉及唯品会运营的合作品牌', sub: '占合作品牌总数40%+' },
    { stat: '仓内', label: '唯品会物流园', sub: '肇庆四会专属园区' },
    { stat: 'JIT+JITX', label: '双模式支持', sub: '完整对接标准' },
    { stat: '18:00前', label: '截单时间', sub: '当日24:00前发出' },
  ]}
  contentDesc={`适合唯品会平台鞋服品牌商家，尤其申请或已在运营JIT/JITX模式的场景。唯品会JIT对仓配服务商的系统、时效、质量要求极高，普通仓难以达标。新亦源在唯品会物流园内设专属仓，OMS/WMS与唯品会平台深度打通，${CLAIM_TEXT.partnerBrands}合作品牌中60+涉及唯品会运营，积累完善的大促应急预案。`}
  featuresLabel="核心能力"
  features={[
    {
      title: '唯品会园区内直发',
      desc: '肇庆四会仓位于唯品会物流园内，减少转运环节，JIT订单响应速度更快，降低因转运造成的时效风险。',
    },
    {
      title: 'JIT/JITX双模式',
      desc: '同时支持JIT（按需生产发货）和JITX（极速供应链）两种唯品会模式，根据品牌和商品类型灵活切换。',
    },
    {
      title: '系统深度对接',
      desc: '自研WMS/OMS与唯品会ERP、订单系统深度打通，库存同步实时精准，订单处理自动化，无需人工二次操作。',
    },
    {
      title: 'SLA合同保障',
      desc: `${CLAIM_TEXT.shippingSla}，发货准确率${CLAIM_TEXT.shippingAccuracy}；平台适用范围按项目核验。`,
    },
    {
      title: '退货质检联动',
      desc: `唯品会退货回流直接在仓内完成质检、分级、修复、二次上架，${CLAIM_TEXT.returnTurnaround}内完成质检与二次上架，快速补充JIT可售库存。`,
    },
    {
      title: '大促专项保障',
      desc: '唯品会特卖节等大促期间，启动弹性人力机制并提前预排班，保障大促发货时效稳定。',
    },
  ]}
  faqs={[
    {
      contentKey: 'faq-weipinhui-jit-jitx-01',
      q: '唯品会JIT和JITX模式有什么区别？',
      a: 'JIT（Just-In-Time）是唯品会的按需采购模式，品牌按活动计划备货，活动开始后按单快速发货，降低积压；JITX是JIT的升级版，要求更快速的备货响应和更严格的发货时效，适合爆款和高频复购商品。两种模式都要求仓配服务商具备实时库存同步和极速发货能力，新亦源均支持。',
    },
    {
      contentKey: 'faq-weipinhui-jit-jitx-02',
      q: '新亦源唯品会仓配有什么核心优势？',
      a: '三大核心优势：①肇庆四会仓在唯品会物流园内，物流节点最近，时效优势明显；②合作品牌60+涉及唯品会运营，有大量真实案例和应急预案；③WMS与唯品会系统深度对接，库存+订单+发货全链路自动化，人工干预少、出错率低。',
    },
    {
      contentKey: 'faq-weipinhui-jit-jitx-03',
      q: '新亦源肇庆唯品会物流园仓规模如何？',
      a: '肇庆四会仓：总园区面积100,000㎡，新亦源使用面积50,000㎡；12米超高仓，多条自动打包线，快递资源发达（位于物流园内，多家快递公司驻仓）。',
    },
    {
      contentKey: 'faq-weipinhui-jit-jitx-04',
      q: 'JIT模式对发货时效有什么要求，新亦源能达到吗？',
      a: `唯品会JIT/JITX的平台时效以当前规则和具体活动要求为准。新亦源仓内履约口径为${CLAIM_TEXT.shippingSla}，大促期间的仓容、人力与物流资源按项目计划配置。`,
    },
    {
      contentKey: 'faq-weipinhui-jit-jitx-05',
      q: '开始唯品会JIT/JITX合作需要什么条件？',
      a: '通常需要：①商品已在唯品会平台上线并开通JIT/JITX资格；②与新亦源签署仓配服务协议（含SLA条款）；③完成系统对接测试（通常1-2周）；④首批货物入库验收。新亦源提供全程对接支持，商务团队协助办理平台对接手续。',
    },
  ]}
>
  <JitComparisonSection slot="unique" />
</ServiceLanding>
