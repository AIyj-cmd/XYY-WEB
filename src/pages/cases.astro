---
import Layout from '@/layouts/Layout.astro'
import PageFAQ from '@/components/PageFAQ.astro'
import CasesHero from '@/components/cases/CasesHero.astro'
import CasesGrid from '@/components/cases/CasesGrid.astro'
import CasesValueProps from '@/components/cases/CasesValueProps.astro'
import { CASE_FAQS, CASE_FALLBACKS } from '@/data/cases'
import { BRAND, CASE_DETAILS } from '@/lib/brand'
import { getClaimText } from '@/lib/claims'
import { getCases, getFaqs } from '@/lib/directus'
import { createFaqSchema } from '@/lib/seo'
import '@/styles/cases-orbit.css'
import '@/styles/cases-orbit-content.css'
import '@/styles/cases-orbit-data.css'
import '@/styles/cases-orbit-responsive.css'
import '@/styles/cases-values.css'

const [displayCases, faqs] = await Promise.all([
  getCases(CASE_FALLBACKS),
  getFaqs('cases', CASE_FAQS),
])
const partnerBrands = getClaimText('partnerBrands', 'cases')
const getCasePath = (label: string) => {
  const slug =
    displayCases.find((item) => item.label === label)?.slug ??
    (CASE_DETAILS as Record<string, { slug: string }>)[label]?.slug
  return slug ? `/cases/${slug}` : null
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '合作案例', item: `${BRAND.url}/cases` },
  ],
}

const caseListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '新亦源供应链合作案例',
  description: `新亦源供应链服务${partnerBrands}知名鞋服品牌合作案例`,
  numberOfItems: displayCases.length,
  itemListElement: displayCases.slice(0, 10).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    description: item.metrics,
    url: getCasePath(item.label) ? `${BRAND.url}${getCasePath(item.label)}` : undefined,
  })),
}
const faqSchema = createFaqSchema(faqs)
---

<Layout
  title="鞋服云仓合作案例｜仓配、质检与退货处理实践｜新亦源"
  description={`新亦源供应链合作案例展示，服务鞋服、潮玩等品类${partnerBrands}知名品牌。包含头部快时尚女装、国际运动品牌、商务男装、内衣家居、跨境出海等多种类型案例。`}
  jsonLd={[breadcrumbSchema, caseListSchema, faqSchema]}
>
  <CasesHero />
  <CasesGrid cases={displayCases} />
  <CasesValueProps />
  <PageFAQ heading="合作案例常见问题" items={faqs} />

  <section class="py-14 bg-[#EFF4FF]" aria-labelledby="cases-cta-heading">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="cases-cta-heading" class="text-2xl lg:text-3xl font-black text-navy-800 mb-4">
        想看与您品类相近的案例详情？
      </h2>
      <p class="text-gray-600 mb-6">联系我们，我们会为您推荐最匹配的成功案例，并提供定制报价</p>
      <a
        href="/contact"
        class="inline-flex items-center px-7 py-3.5 bg-brand-orange text-white font-bold rounded-xl hover:bg-brand-orange-dark transition-colors"
      >
        预约案例分享
      </a>
    </div>
  </section>
</Layout>
