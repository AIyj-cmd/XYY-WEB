---
import Layout from '@/layouts/Layout.astro'
import PageFAQ from '@/components/PageFAQ.astro'
import PublicationsHero from '@/components/publications/PublicationsHero.astro'
import PublicationsDirectory from '@/components/publications/PublicationsDirectory.astro'
import ConversionCTA from '@/components/conversion/ConversionCTA.astro'
import { PUBLICATION_FAQS, PUBLICATION_ISSUES, PUBLICATION_STATS } from '@/data/publications'
import { BRAND } from '@/lib/brand'
import { getFaqs, getPublications } from '@/lib/directus'
import { createFaqSchema } from '@/lib/seo'

const faqs = await getFaqs('senlinqikan', PUBLICATION_FAQS)
const issues = await getPublications(PUBLICATION_ISSUES)

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '森林期刊', item: `${BRAND.url}/senlinqikan` },
  ],
}

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '新亦源森林期刊',
  description: '新亦源供应链出品的鞋服物流行业内刊，聚焦云仓运营、质检修复、行业趋势与品牌动态。',
  numberOfItems: issues.length,
  itemListElement: issues.map((issue, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: issue.title,
    url: `${BRAND.url}${issue.pdf}`,
  })),
}
const faqSchema = createFaqSchema(faqs)
---

<Layout
  title="森林期刊 — 新亦源鞋服供应链行业内刊"
  description="《森林期刊》是广州新亦源供应链出品的品牌内刊，聚焦鞋服云仓运营实战、退货质检、直播仓配及行业趋势，持续输出鞋服供应链专业知识。"
  jsonLd={[breadcrumbSchema, collectionSchema, faqSchema]}
>
  <PublicationsHero latest={issues[0]} />

  <section class="py-12 bg-white border-b border-gray-100" aria-label="森林期刊出版概况">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        {
          PUBLICATION_STATS.map(({ num, label }) => (
            <div>
              <>
                <div class="text-3xl font-black text-navy-800 mb-1">{num}</div>
                <div class="text-xs text-gray-400 font-medium">{label}</div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <PublicationsDirectory issues={issues} />
  <PageFAQ heading="森林期刊常见问题" items={faqs} />

  <ConversionCTA
    headingId="publications-conversion-cta-heading"
    eyebrow="START A CONVERSATION"
    headingLines={['想合作 · 想投稿', '想收到期刊？']}
    description="森林期刊面向合作品牌与行业读者分享仓配实践。如需纸质版、了解合作方式或提交选题，欢迎联系我们。"
    actionLabel="立即联系"
    preparationTitle="沟通前可准备这 3 类信息"
    preparationItems={[
      { label: '联系目的', detail: '合作 · 投稿 · 纸质期刊申请' },
      { label: '品牌与身份', detail: '所属品牌 · 所在行业 · 联系方式' },
      { label: '关注内容', detail: '感兴趣的专题 · 希望探讨的方向' },
    ]}
  />
</Layout>
