---
import ServiceLanding from '@/layouts/ServiceLanding.astro'

const WAREHOUSE_LIST = [
  {
    name: '黄埔仓',
    tag: '华南节点',
    tagColor: 'bg-brand-orange text-white',
    address: '广东省广州市黄埔区果园一路2号',
    area: '与兴泰仓合计1.8万㎡',
    traffic: '根据入仓来源和订单区域配置',
    coverage: '线路与时效按项目确认',
    bestFor: 'B2C 全渠道高频出库 / 退货质检中心 / 唯品会联动运营',
  },
  {
    name: '兴泰仓',
    tag: '广州节点',
    tagColor: 'bg-navy-700 text-white',
    address: '具体地址以双方确认信息为准',
    area: '与黄埔仓合计1.8万㎡',
    traffic: '服务广州及珠三角项目',
    coverage: '广州同城最快4小时',
    bestFor: '鞋服库存管理 / 区域发货 / 退货处理',
  },
  {
    name: '新塘仓',
    tag: '广州节点',
    tagColor: 'bg-navy-600 text-white',
    address: '具体地址以双方确认信息为准',
    area: '按项目确认',
    traffic: '服务广州及珠三角项目',
    coverage: '全国主要城市参考次日至三日达',
    bestFor: '区域仓配 / 门店补货 / 全渠道发货',
  },
  {
    name: '华南协同仓网',
    tag: '区域协同',
    tagColor: 'bg-green-600 text-white',
    address: '覆盖东莞、佛山、肇庆',
    area: '按项目确认',
    traffic: '结合品牌供应商与订单分布协同',
    coverage: '具体以线路SLA为准',
    bestFor: '跨区域库存协同 / 大促弹性产能 / 规模化仓储',
  },
]
---

<ServiceLanding
  title="广州鞋服云仓｜鞋服仓储、发货与退货质检｜新亦源"
  description="新亦源广州鞋服云仓现有黄埔、兴泰、新塘3个仓点，其中黄埔仓与兴泰仓合计1.8万㎡，支持B2C、B2B、O2O、退货质检和瑕疵修复。广州同城最快4小时，全国主要城市参考次日至三日达。"
  slug="guangzhou-xiefu-yuncang"
  variant="guangzhou-hub"
  breadcrumbLabel="广州鞋服云仓"
  eyebrow="广州鞋服云仓 · 珠三角区域仓配"
  h1="广州鞋服云仓：服务广州及珠三角鞋服品牌"
  h1sub="广州同城最快4小时，全国主要城市参考次日至三日达"
  heroDesc="广州现有黄埔、兴泰、新塘3个仓点，其中黄埔仓与兴泰仓合计1.8万㎡。支持B2C、B2B、O2O全渠道仓配和退货质检；18:00前截单，当日24:00前发出。"
  imgSrc="/index.webp"
  imgAlt="广州鞋服云仓 — 广州本地仓储配送"
  stats={[
    { stat: '3个', label: '广州仓点', sub: '黄埔、兴泰、新塘' },
    { stat: '全渠道', label: '仓配模式', sub: 'B2C+B2B+O2O' },
    { stat: '18:00前', label: '截单时间', sub: '当日24:00前发出' },
    { stat: '不收', label: '系统使用费', sub: '实施、联调周期和费用按项目确认' },
  ]}
  contentDesc="适合供应商、库存或主要消费市场位于广州及珠三角的鞋服品牌。广州现有黄埔、兴泰、新塘3个仓点，其中黄埔仓与兴泰仓合计1.8万㎡，可提供B2C电商发货、B2B门店补货、O2O库存协同、退货质检和瑕疵修复。广州同城最快4小时，全国主要城市参考次日至三日达；具体仓点、仓容、承运商和线路SLA由双方确认。"
  featuresLabel="核心能力"
  features={[
    {
      title: '广州区域仓配',
      desc: '广州现有黄埔、兴泰、新塘3个仓点，其中黄埔仓与兴泰仓合计1.8万㎡。',
    },
    {
      title: '运输线路规划',
      desc: '广州同城最快4小时，全国主要城市参考次日至三日达；具体以线路SLA为准。',
    },
    {
      title: '全渠道广州仓配',
      desc: '广州仓支持B2C（天猫/京东/拼多多等）+B2B（批发/连锁门店补货）+O2O（广州本地门店库存融合），全渠道一盘货管理。',
    },
    {
      title: '广州退货质检',
      desc: '广州及广东区域退货可按项目进入质检与后整修复流程，退货质检和二次上架24小时完成。',
    },
    { title: '系统接口协同', desc: '不收系统使用费；实施、联调周期和费用按项目确认。' },
    {
      title: '广州本地服务支持',
      desc: '专属广州BD经理，可上门洽谈方案，方便广州本地品牌和制造商快速开始合作。',
    },
  ]}
  faqs={[
    {
      q: '新亦源广州仓位置在哪里，交通方便吗？',
      a: '广州现有黄埔、兴泰、新塘3个仓点。黄埔仓地址为广东省广州市黄埔区果园一路2号；其他仓点的实际启用地址、仓容和车辆要求在项目启动前确认。',
    },
    {
      q: '广州仓的发货和运输时效如何确认？',
      a: '18:00前截单，当日24:00前发出。广州同城最快4小时，全国主要城市参考次日至三日达；具体以线路SLA为准。',
    },
    {
      q: '广州仓适合什么类型的鞋服品牌？',
      a: '特别适合：①广州本地品牌/工厂，减少货物入库运输成本；②主要消费市场在华南的品牌，利用广州仓的时效优势；③有大量唯品会运营的品牌，广州仓联动肇庆唯品会园区仓运营；④O2O运营有广州门店需求的品牌；⑤跨境出海品牌，利用广州港/白云机场的国际物流优势。',
    },
    {
      q: '广州仓的规模是多少？能支持大促爆单吗？',
      a: '广州现有黄埔、兴泰、新塘3个仓点，其中黄埔仓与兴泰仓合计1.8万㎡。公司华南地区单日运营峰值为100万单，具体项目保障方案在大促前根据预测货量确认。',
    },
    {
      q: '新亦源广州仓收费模式是什么？',
      a: '费用通常由仓储、入出库操作以及退货质检或修复等增值服务组成。不收系统使用费；实施、联调周期和费用按项目确认。',
    },
  ]}
>
  <section
    slot="unique"
    class="py-14 bg-gray-50 border-b border-gray-100"
    aria-labelledby="warehouse-map-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="warehouse-map-heading" class="text-xl font-black text-navy-800 mb-1 text-center">
        广州及华南仓网协同
      </h2>
      <p class="text-xs text-gray-400 text-center mb-8">
        广州现有黄埔、兴泰、新塘3个仓点，并与东莞、佛山、肇庆仓网协同
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          WAREHOUSE_LIST.map(
            ({ name, tag, tagColor, address, area, traffic, coverage, bestFor }) => (
              <div class="bg-white rounded-xl border border-gray-200 p-5 flex flex-col gap-3">
                <div>
                  <span
                    class={`inline-block text-[10px] font-black px-2 py-0.5 rounded-full mb-2 ${tagColor}`}
                  >
                    {tag}
                  </span>
                  <h3 class="font-black text-navy-800 text-base">{name}</h3>
                  <p class="text-xs text-gray-400 mt-0.5">{address}</p>
                </div>
                <div class="space-y-2 text-xs">
                  <div class="flex gap-2">
                    <span class="text-gray-400 shrink-0 w-12">面积</span>
                    <span class="font-bold text-navy-800">{area}</span>
                  </div>
                  <div class="flex gap-2">
                    <span class="text-gray-400 shrink-0 w-12">交通</span>
                    <span class="text-gray-600 leading-snug">{traffic}</span>
                  </div>
                  <div class="flex gap-2">
                    <span class="text-gray-400 shrink-0 w-12">时效</span>
                    <span class="text-gray-600 leading-snug">{coverage}</span>
                  </div>
                </div>
                <div class="pt-2 border-t border-gray-100">
                  <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">
                    最适合
                  </p>
                  <p class="text-xs text-navy-700 font-medium leading-snug">{bestFor}</p>
                </div>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>
</ServiceLanding>
