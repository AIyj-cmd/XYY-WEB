    }
    .faq-a {
      padding-left: 2.6rem;
      padding-right: 0;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import Lenis from 'lenis'

  gsap.registerPlugin(ScrollTrigger)

  // ── Lenis smooth scroll ──────────────────────────────────────
  const lenis = new Lenis({ lerp: 0.08, smoothWheel: true })
  lenis.on('scroll', ScrollTrigger.update)
  gsap.ticker.add((t) => lenis.raf(t * 1000))
  gsap.ticker.lagSmoothing(0)

  // ── Hero reveal on load ──────────────────────────────────────
  const heroTl = gsap.timeline({ delay: 0.3 })
  heroTl
    .to('.hero-eyebrow', { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, 0)
    .to(
      '.hero-brand-kw, .hero-title .hl',
      {
        opacity: 1,
        y: 0,
        stagger: 0.15,
        duration: 0.75,
        ease: 'power3.out',
      },
      0.25
    )
    .to('.hero-sub, .hero-data', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 0.6)
    .to('.hero-actions', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 0.8)

  // Set initial y for hero elements
  gsap.set('.hero-eyebrow, .hero-brand-kw, .hero-title .hl, .hero-sub, .hero-data, .hero-actions', { y: 30 })

  // ── Stats counter ────────────────────────────────────────────
  const parseVal = (raw: string) => {
    const m = raw.match(/^(\d+(?:\.\d+)?)(.*)$/)
    if (!m) return { n: 0, suf: '', dec: 0 }
    const dec = m[1].includes('.') ? m[1].split('.')[1].length : 0
    return { n: parseFloat(m[1]), suf: m[2], dec }
  }

  const statsSection = document.querySelector<HTMLElement>('.s-stats')

  if (statsSection) {
    const tenureCard = statsSection.querySelector<HTMLElement>('.stats-tenure')
    const statCards = Array.from(statsSection.querySelectorAll<HTMLElement>('.stat-card'))
    const tenurePath = statsSection.querySelector<SVGPathElement>('.tenure-route-progress')
    const tenureNodes = Array.from(
      statsSection.querySelectorAll<SVGCircleElement>('.tenure-route-node')
    )
    const tenureNumber = statsSection.querySelector<HTMLElement>('.tenure-value')
    const tenureNumberValue = statsSection.querySelector<HTMLElement>(
      '.tenure-value strong[data-raw]'
    )
    const tenureStatus = statsSection.querySelector<HTMLElement>('.tenure-status i')
    const tenureRange = statsSection.querySelector<HTMLElement>('.tenure-range i')
    const statsFlow = statsSection.querySelector<HTMLElement>('.stats-flow')
    const flowProgress = statsSection.querySelector<HTMLElement>('.stats-flow-progress')
    const flowSteps = Array.from(statsSection.querySelectorAll<HTMLElement>('.stats-flow-step'))
    const flowNodes = Array.from(statsSection.querySelectorAll<HTMLElement>('.stats-flow-step > i'))
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const numberCounters = new WeakMap<HTMLElement, { val: number }>()
    const moduleTimelines = new WeakMap<Element, gsap.core.Timeline>()

    const createModuleTimeline = (element: Element) => {
      moduleTimelines.get(element)?.kill()
      const timeline = gsap.timeline()
      moduleTimelines.set(element, timeline)
      return timeline
    }

    const animateStatNumber = (numEl: HTMLElement) => {
      const raw = numEl.dataset.raw || ''
      const { n, suf, dec } = parseVal(raw)
      if (!n) {
        numEl.textContent = raw
        return
      }

      const previousCounter = numberCounters.get(numEl)
      if (previousCounter) gsap.killTweensOf(previousCounter)

      const counter = { val: 0 }
      numberCounters.set(numEl, counter)
      numEl.textContent = `0${suf}`

      gsap.to(counter, {
        val: n,
        duration: 1.35,
        ease: 'power2.out',
        overwrite: true,
        onUpdate: () => {
          numEl.textContent =
            (dec > 0 ? counter.val.toFixed(dec) : Math.floor(counter.val).toString()) + suf
        },
        onComplete: () => {
          numEl.textContent = raw
          numberCounters.delete(numEl)
        },
      })
    }

    if (!reduceMotion) {
      const playTenure = (direction: 1 | -1) => {
        if (!tenureCard) return
        const targets = [
          tenureCard,
          tenurePath,
          tenureNumber,
          tenureNumberValue,
          tenureStatus,
          tenureRange,
          ...tenureNodes,
        ].filter(Boolean)
        gsap.killTweensOf(targets)

        gsap.set(tenureCard, { opacity: 0, y: 24 * direction })
        gsap.set(tenurePath, { strokeDashoffset: direction > 0 ? 1 : -1 })
        gsap.set(tenureNodes, { opacity: 0.2, scale: 0.55 })
        gsap.set(tenureNumber, { opacity: 0, scale: 0.82, y: 10 * direction })
        gsap.set(tenureStatus, { opacity: 0, scale: 0 })
        gsap.set(tenureRange, { scaleX: 0, transformOrigin: direction > 0 ? 'left' : 'right' })

        createModuleTimeline(tenureCard)
          .to(tenureCard, {
            opacity: 1,
            y: 0,
            duration: 0.62,
            ease: 'power3.out',
          })
          .to(
            tenureNumber,
            {
              opacity: 1,
              scale: 1,
              y: 0,
              duration: 0.52,
              ease: 'back.out(1.45)',
            },
            0.08
          )
          .call(
            () => {
              if (tenureNumberValue) animateStatNumber(tenureNumberValue)
            },
            [],
            0.08
          )
          .to(
            tenureStatus,
            {
              opacity: 1,
              scale: 1,
              duration: 0.3,
              ease: 'back.out(2)',
            },
            0.16
          )
          .to(
            tenurePath,
            {
              strokeDashoffset: 0,
              duration: 1.05,
              ease: 'power2.inOut',
            },
            0.14
          )
          .to(
            tenureNodes,
            {
              opacity: 1,
              scale: 1,
              duration: 0.3,
              stagger: { each: 0.14, from: direction > 0 ? 'start' : 'end' },
              ease: 'back.out(1.8)',
            },
            0.26
          )
          .to(
            tenureRange,
            {
              scaleX: 1,
              duration: 0.65,
              ease: 'power2.inOut',
            },
            0.4
          )
          .set(tenureCard, { clearProps: 'opacity,transform' })
          .set(tenureNumber, { clearProps: 'opacity,transform' })
          .set(tenureStatus, { clearProps: 'opacity,transform' })
          .set(tenureRange, { clearProps: 'transform,transformOrigin' })
          .set(tenureNodes, { clearProps: 'opacity,transform' })
      }

      const playStatCard = (card: HTMLElement, direction: 1 | -1) => {
        const numbers = Array.from(card.querySelectorAll<HTMLElement>('.stat-num'))
        const warehouseBars = Array.from(
          card.querySelectorAll<HTMLElement>('.warehouse-schematic span')
        )
        const networkOrbit = card.querySelector<HTMLElement>('.network-orbit')
        const networkNodes = Array.from(card.querySelectorAll<HTMLElement>('.network-orbit i'))
        const inspectionDirections = Array.from(
          card.querySelectorAll<HTMLElement>('.inspection-direction')
        )
        const accuracyRing = card.querySelector<HTMLElement>('.accuracy-ring')
        const decorTargets = [
          ...warehouseBars,
          networkOrbit,
          ...networkNodes,
          ...inspectionDirections,
          accuracyRing,
        ].filter(Boolean)

        gsap.killTweensOf([card, ...decorTargets])
        gsap.set(card, { opacity: 0, y: 26 * direction })

        const timeline = createModuleTimeline(card)
        timeline
          .to(card, {
            opacity: 1,
            y: 0,
            duration: 0.58,
            ease: 'power3.out',
          })
          .call(
            () => {
              numbers.forEach(animateStatNumber)
            },
            [],
            0.08
          )

        if (warehouseBars.length) {
          timeline.fromTo(
            warehouseBars,
            { opacity: 0.15, scaleY: 0.18, transformOrigin: 'center bottom' },
            {
              opacity: 1,
              scaleY: 1,
              duration: 0.46,
              stagger: { each: 0.08, from: direction > 0 ? 'start' : 'end' },
              ease: 'back.out(1.65)',
              clearProps: 'opacity,transform,transformOrigin',
            },
            0.16
          )
        }

        if (networkOrbit) {
          timeline
            .fromTo(
              networkOrbit,
              { opacity: 0, rotation: -32 * direction, scale: 0.72 },
              {
                opacity: 1,
                rotation: 0,
                scale: 1,
                duration: 0.7,
                ease: 'power2.out',
                clearProps: 'opacity,transform',
              },
              0.1
            )
            .fromTo(
              networkNodes,
              { opacity: 0, scale: 0 },
              {
                opacity: 1,
                scale: 1,
                duration: 0.28,
                stagger: { each: 0.07, from: direction > 0 ? 'start' : 'end' },
                ease: 'back.out(2)',
                clearProps: 'opacity,transform',
              },
              0.26
            )
        }

        if (inspectionDirections.length) {
          timeline.fromTo(
            inspectionDirections,
            { opacity: 0, x: 10 * -direction },
            {
              opacity: 1,
              x: 0,
              duration: 0.38,
              stagger: { each: 0.11, from: direction > 0 ? 'start' : 'end' },
              ease: 'power2.out',
              clearProps: 'opacity,transform',
            },
            0.16
          )
        }

        if (accuracyRing) {
          timeline.fromTo(
            accuracyRing,
            { opacity: 0, rotation: -105 * direction, scale: 0.76 },
            {
              opacity: 0.24,
              rotation: 0,
              scale: 1,
              duration: 0.85,
              ease: 'power3.out',
              clearProps: 'opacity,transform',
            },
            0.1
          )
        }

        timeline.set(card, { clearProps: 'opacity,transform' })
      }

      const playFlow = (direction: 1 | -1) => {
        if (!statsFlow) return
        const mobileFlow = window.matchMedia('(max-width: 700px)').matches
        gsap.killTweensOf([flowProgress, ...flowSteps, ...flowNodes])
        gsap.set(flowProgress, {
          scaleX: mobileFlow ? 1 : 0,
          scaleY: mobileFlow ? 0 : 1,
          transformOrigin: mobileFlow
            ? direction > 0
              ? 'center top'
              : 'center bottom'
            : direction > 0
              ? 'left center'
              : 'right center',
        })
        gsap.set(flowSteps, {
          opacity: 0.35,
          x: mobileFlow ? 7 * -direction : 0,
          y: mobileFlow ? 0 : 7 * direction,
        })
        gsap.set(flowNodes, { scale: 0.5 })

        createModuleTimeline(statsFlow)
          .to(flowProgress, {
            scaleX: 1,
            scaleY: 1,
            duration: 0.95,
            ease: 'power2.inOut',
            onComplete: () => {
              gsap.set(flowProgress, { clearProps: 'transform,transformOrigin' })
            },
          })
          .to(
            flowSteps,
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.32,
              stagger: { each: 0.1, from: direction > 0 ? 'start' : 'end' },
              ease: 'power2.out',
            },
            0.08
          )
          .to(
            flowNodes,
            {
              scale: 1,
              duration: 0.25,
              stagger: { each: 0.1, from: direction > 0 ? 'start' : 'end' },
              ease: 'back.out(2)',
            },
            0.12
          )
          .set(flowSteps, { clearProps: 'opacity,transform' })
          .set(flowNodes, { clearProps: 'transform' })
      }

      if (tenureCard) {
        ScrollTrigger.create({
          trigger: tenureCard,
          start: 'top 86%',
          end: 'bottom 14%',
          onEnter: () => playTenure(1),
          onEnterBack: () => playTenure(-1),
        })
      }

      statCards.forEach((card) => {
        ScrollTrigger.create({
          trigger: card,
          start: 'top 86%',
          end: 'bottom 14%',
          onEnter: () => playStatCard(card, 1),
          onEnterBack: () => playStatCard(card, -1),
        })
      })

      if (statsFlow) {
        ScrollTrigger.create({
          trigger: statsFlow,
          start: 'top 90%',
          end: 'bottom 10%',
          onEnter: () => playFlow(1),
          onEnterBack: () => playFlow(-1),
        })
      }
    }
  }

  // ── Service panels ───────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.s-service').forEach((panel) => {
    const img = panel.querySelector('.svc-img')
    const toAnimate = panel.querySelectorAll(
      '.svc-problem, .svc-title, .svc-sub, .svc-desc, .svc-features, .svc-scenarios, .svc-link'
    )

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: panel,
        start: 'top 60%',
        once: true,
      },
    })

    if (img) {
      tl.to(img, { scale: 1, duration: 1.2, ease: 'power2.out' }, 0)
    }
    tl.to(
      toAnimate,
      {
        opacity: 1,
        x: 0,
        stagger: 0.1,
        duration: 0.65,
        ease: 'power3.out',
      },
      0.15
    )
  })

  // ── Case cards ───────────────────────────────────────────────
  // Keep this independent from ScrollTrigger: the homepage does not always
  // render product cards, and an empty batch would prevent later animations.
  const caseCards = document.querySelectorAll<HTMLElement>('.case-card')
  if (caseCards.length) {
    const caseObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const card = entry.target as HTMLElement
          const index = Number(card.dataset.i ?? 0)
          gsap.to(card, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            delay: index * 0.08,
            ease: 'power3.out',
          })
          observer.unobserve(card)
        })
      },
      { threshold: 0.15 }
    )
    caseCards.forEach((card) => caseObserver.observe(card))
  }

  // ── Order Fulfillment steps ──────────────────────────────────
  // Use the browser observer rather than ScrollTrigger so the core process
  // remains visible even if another optional scroll animation fails.
  const fulfillment = document.querySelector<HTMLElement>('.s-fulfillment')
  if (fulfillment) {
    const fulfillmentObserver = new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        fulfillment.classList.add('is-visible')
        observer.unobserve(fulfillment)
      },
      { threshold: 0.16 }
    )
    fulfillmentObserver.observe(fulfillment)
  }

  // ── FAQ accordion ────────────────────────────────────────────
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq-item'))
  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return
      faqItems.forEach((other) => {
        if (other !== item) other.open = false
      })
    })
  })

  // ── Case modal ────────────────────────────────────────────────
  const caseData = JSON.parse(document.getElementById('case-data')!.textContent!)
  const modal = document.getElementById('case-modal')!
  const panel = modal.querySelector('.modal-panel') as HTMLElement

  function openModal(id: string, detailUrl: string) {
    const d = caseData[id]
    if (!d) return

    // accent color + hero image
    panel.style.setProperty('--modal-accent', d.accent || '#2563EB')
    const heroImg = modal.querySelector('#modal-hero-img') as HTMLImageElement
    heroImg.src = d.image || ''
    heroImg.alt = d.fullName

    // header
    ;(modal.querySelector('#modal-category') as HTMLElement).textContent = d.category
    ;(modal.querySelector('#modal-title') as HTMLElement).textContent = d.fullName
    ;(modal.querySelector('#modal-desc') as HTMLElement).textContent = d.description

    // stats grid
    const statsEl = modal.querySelector('#modal-stats') as HTMLElement
    statsEl.innerHTML = d.stats
      .map(
        (s: { label: string; value: string; unit: string }) => `
    <div class="modal-stat-card">
      <div class="modal-stat-val">${s.value}</div>
      ${s.unit ? `<div class="modal-stat-unit">${s.unit}</div>` : ''}
      <div class="modal-stat-label">${s.label}</div>
    </div>
  `
      )
      .join('')
    ;(modal.querySelector('#modal-detail-link') as HTMLAnchorElement).href = detailUrl

    ;(modal.querySelector('.modal-body') as HTMLElement).scrollTop = 0
    modal.hidden = false
    document.body.style.overflow = 'hidden'
    history.pushState({ caseModal: id }, '', detailUrl)
    requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('visible')))
  }

  function hideModal() {
    panel.classList.remove('visible')
    setTimeout(() => {
      modal.hidden = true
      document.body.style.overflow = ''
    }, 250)
  }

  document.querySelectorAll('.case-card').forEach((card) => {
    card.addEventListener('click', (event) => {
      if (
        !(event instanceof MouseEvent) ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return

      const id = (card as HTMLElement).dataset.case
      const detailUrl = (card as HTMLAnchorElement).getAttribute('href')
      if (!id || !detailUrl) return

      event.preventDefault()
      openModal(id, detailUrl)
    })
  })

  function closeModal() {
    const shouldRestoreHistory = Boolean(history.state?.caseModal)
    hideModal()
    if (shouldRestoreHistory) history.back()
  }

  modal.querySelector('.modal-close')!.addEventListener('click', closeModal)
  modal.querySelector('.modal-backdrop')!.addEventListener('click', closeModal)
  window.addEventListener('popstate', () => {
    if (!modal.hidden) hideModal()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal()
  })
</script>
