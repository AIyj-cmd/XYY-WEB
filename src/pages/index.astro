---
import Layout from '@/layouts/Layout.astro'
import HomeFAQ from '@/components/home/HomeFAQ.astro'
import HomeFulfillment from '@/components/home/HomeFulfillment.astro'
import HomeCases from '@/components/home/HomeCases.astro'
import HomeHero from '@/components/home/HomeHero.astro'
import HomeCapabilityStats from '@/components/home/HomeCapabilityStats.astro'
import HomeCoreSolutions from '@/components/home/HomeCoreSolutions.astro'
import { HOME_FAQS, HOME_IMAGES } from '@/data/home'
import { BRAND, CASE_DETAILS } from '@/lib/brand'
import { CLAIM_TEXT } from '@/lib/claims'
import { getHomepageStats, getServices, getCases } from '@/lib/directus'
import { ORGANIZATION_ID, createBreadcrumbSchema, createFaqSchema } from '@/lib/seo'

const [STATS, SERVICES, allCases] = await Promise.all([
  getHomepageStats(),
  getServices(),
  getCases(),
])
const approvedCaseFallbacks = Object.entries(CASE_DETAILS).map(([label, detail], index) => ({
  id: index + 1,
  sort: index + 1,
  category: detail.category,
  label,
  metrics: `${detail.stats[0].label} ${detail.stats[0].value}${detail.stats[0].unit}`,
  details: detail.description,
  tags: [detail.category],
  img: detail.image,
}))
const CASES = (allCases.length ? allCases : approvedCaseFallbacks).slice(0, 6)

// Parse "库存 260万件+ · ..." → { value: '260万件+', label: '库存' } for card display
function parseFirstMetric(metrics: string) {
  const first = metrics.split('·')[0].trim()
  const spaceIdx = first.indexOf(' ')
  return {
    value: spaceIdx > 0 ? first.slice(spaceIdx + 1) : first,
    label: spaceIdx > 0 ? first.slice(0, spaceIdx) : '',
  }
}
const caseCardMeta = CASES.map((c) => ({
  shortName: (CASE_DETAILS as Record<string, { name: string }>)[c.label]?.name ?? c.label,
  slug: (CASE_DETAILS as Record<string, { slug: string }>)[c.label]?.slug,
  metric: parseFirstMetric(c.metrics),
  metricContext: c.metrics.split('·')[0].includes('年发货') ? '年度发货规模' : '库存管理规模',
}))
const caseDetailsWithDisplayImages = Object.fromEntries(
  Object.entries(CASE_DETAILS).map(([label, detail]) => [
    label,
    { ...detail, image: CASES.find((item) => item.label === label)?.img ?? detail.image },
  ])
)

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: BRAND.fullName,
  alternateName: ['新亦源', '新亦源供应链'],
  url: BRAND.url,
  logo: `${BRAND.url}/logo.png`,
  description: BRAND.description,
  foundingDate: String(BRAND.founded),
  telephone: [BRAND.phone.toll],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '果园一路2号',
    addressLocality: '广州市黄埔区',
    addressRegion: '广东省',
    addressCountry: 'CN',
  },
  areaServed: { '@type': 'Country', name: '中国' },
}

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${BRAND.url}/#website`,
  url: BRAND.url,
  name: BRAND.name,
  description: BRAND.description,
  inLanguage: 'zh-Hans',
}

const breadcrumbSchema = createBreadcrumbSchema([{ name: '首页', path: '/' }])

const faqSchema = createFaqSchema(HOME_FAQS)
---

<Layout
  title="新亦源鞋服云仓｜鞋服仓储、质检、发货一体化服务"
  description={`新亦源2011年成立，提供鞋服仓配、退货质检、瑕疵修复及全渠道库存管理。直营仓储${CLAIM_TEXT.warehouseArea}，服务${CLAIM_TEXT.partnerBrands}品牌，发货准确率与库存准确率${CLAIM_TEXT.shippingAccuracy}。`}
  jsonLd={[orgSchema, webSiteSchema, breadcrumbSchema, faqSchema]}
  services={SERVICES}
>
  <HomeHero
    image={HOME_IMAGES.hero}
    warehouseArea={CLAIM_TEXT.warehouseArea}
    partnerBrands={CLAIM_TEXT.partnerBrands}
    servedStores={CLAIM_TEXT.servedStores}
    coveredCities={CLAIM_TEXT.coveredCities}
  />
  <HomeCapabilityStats stats={STATS} />
  <HomeCoreSolutions services={SERVICES} />
  <HomeCases
    cases={CASES}
    cardMeta={caseCardMeta}
    caseDetails={caseDetailsWithDisplayImages}
    partnerBrands={CLAIM_TEXT.partnerBrands}
  />

  <HomeFulfillment />

  <HomeFAQ items={HOME_FAQS} phone={BRAND.phone.toll} />
</Layout>

<style>
  :global(html) {
    scroll-behavior: auto;
  }
</style>

<script>
  import '@/scripts/home-page'
</script>
