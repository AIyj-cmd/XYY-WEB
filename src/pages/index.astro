  /* ── ⑥ Order Fulfillment ─────────────────────────────────────── */
  .s-fulfillment {
    background: #f8fafc;
    padding: 6rem 2rem;
    overflow: hidden;
    position: relative;
  }
  .fulfillment-header {
    max-width: 820px;
    margin: 0 auto 3.25rem;
    text-align: center;
  }
  .fulfillment-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    color: #0a1a33;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .fulfillment-sub {
    font-size: 1rem;
    color: #475569;
    line-height: 1.8;
  }
  .fulfillment-track {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 0;
    max-width: 1400px;
    margin: 0 auto;
    row-gap: 3rem;
    position: relative;
  }
  .fulfillment-track::before,
  .fulfillment-track::after {
    content: '';
    position: absolute;
    top: 2rem;
    left: 2rem;
    height: 2px;
    border-radius: 999px;
    pointer-events: none;
  }
  .fulfillment-track::before {
    right: calc(14.2857143% - 2rem);
    background: #3b82f6;
  }
  .fulfillment-track::after {
    width: 0;
    background: #e85d26;
    box-shadow: 0 0 12px rgba(232, 93, 38, 0.28);
    transition: width 1.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .s-fulfillment.is-visible .fulfillment-track::after {
    width: 85.7142857%;
  }
  .fulfillment-step {
    flex: 1 1 0;
    min-width: 0;
    max-width: 220px;
    position: relative;
    padding: 0 0.75rem 0 0;
    z-index: 1;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 0.13s + 0.2s);
  }
  .s-fulfillment.is-visible .fulfillment-step {
    opacity: 1;
    transform: translateY(0);
  }
  /* horizontal connecting line */
  .fulfillment-connector {
    display: none;
  }
  .fulfillment-connector::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #93c5fd 0%, #60a5fa 72%, #e85d26 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(var(--i) * 0.12s + 0.3s);
  }
  .s-fulfillment.is-visible .fulfillment-connector::after {
    transform: scaleX(1);
  }
  .fulfillment-step:last-child .fulfillment-connector {
    display: none;
  }

  /* number badge */
  .fulfillment-num-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .fulfillment-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 2px solid #e85d26;
    border-radius: 50%;
    color: #e85d26;
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    position: relative;
    z-index: 1;
    background: #fff;
    transition:
      background 0.3s,
      color 0.3s,
      box-shadow 0.3s;
  }
  .fulfillment-step.is-terminal .fulfillment-num {
    background: #fff1e9;
    box-shadow: 0 0 0 5px rgba(232, 93, 38, 0.08);
  }
  /* pulsing ring */
  .fulfillment-num-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid rgba(232, 93, 38, 0.3);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .fulfillment-step:hover .fulfillment-num {
    background: #e85d26;
    color: #fff;
    box-shadow:
      0 0 0 6px rgba(232, 93, 38, 0.15),
      0 8px 24px rgba(232, 93, 38, 0.3);
  }
  .fulfillment-step:hover .fulfillment-num-ring {
    opacity: 1;
    transform: scale(1);
  }
  .fulfillment-step-title {
    font-size: 1rem;
    font-weight: 800;
    color: #0a1a33;
    margin-bottom: 0.6rem;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .fulfillment-step:hover .fulfillment-step-title {
    color: #e85d26;
  }
  .fulfillment-step-desc {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.65;
    max-width: none;
  }
  @media (max-width: 1024px) {
    .fulfillment-track {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
    .fulfillment-track::before,
    .fulfillment-track::after {
      display: none;
    }
    .fulfillment-step {
      flex: 0 0 30%;
      max-width: none;
    }
  }
  @media (max-width: 768px) {
    .s-fulfillment {
      padding: 4rem 1.5rem;
    }
    .fulfillment-step {
      flex: 0 0 45%;
    }
    .fulfillment-connector {
      display: none;
    }
  }

  /* ── ⑦ CTA ───────────────────────────────────────────────────── */
  /* ── FAQ ─────────────────────────────────────────────────── */
  .s-faq {
    padding: 7rem 2rem;
    background: #fff;
  }
  .faq-inner {
    display: grid;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 10rem);
    max-width: 1280px;
    margin: 0 auto;
  }
  .faq-intro {
    align-self: start;
    position: sticky;
    top: 7rem;
  }
  .faq-title {
    max-width: 22rem;
    margin: 0;
    color: #0a1a33;
    font-size: clamp(2rem, 3.2vw, 3.1rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .faq-intro-copy {
    max-width: 20rem;
    margin: 1.35rem 0 2rem;
    color: #475569;
    font-size: 1rem;
    line-height: 1.8;
  }
  .faq-contact-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .faq-side-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    background: #e85d26;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(232, 93, 38, 0.2);
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .faq-side-cta:hover {
    background: #d94e1b;
    transform: translateY(-2px);
  }
  .faq-phone {
    color: #475569;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .faq-phone:hover {
    color: #2563eb;
  }
  .faq-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid #dbe4ef;
  }
  .faq-item {
    border-bottom: 1px solid #dbe4ef;
  }
  .faq-q {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1.5rem;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.45rem 0;
    cursor: pointer;
    color: #0a1a33;
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.45;
    list-style: none;
  }
  .faq-q::-webkit-details-marker {
