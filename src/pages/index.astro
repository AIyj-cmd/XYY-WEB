      linear-gradient(145deg, rgba(37, 99, 235, 0.22), transparent 48%),
      linear-gradient(160deg, #07162c 0%, #102d55 100%);
    border: 1px solid rgba(147, 197, 253, 0.2);
    box-shadow: 0 24px 60px rgba(10, 26, 51, 0.16);
  }
  .stats-tenure::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(147, 197, 253, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(147, 197, 253, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, #000, transparent 84%);
    pointer-events: none;
  }
  .tenure-topline {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: #bfdbfe;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.11em;
  }
  .tenure-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #dbeafe;
    letter-spacing: 0.03em;
  }
  .tenure-status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #fb923c;
    box-shadow: 0 0 0 4px rgba(251, 146, 60, 0.12);
  }
  .tenure-value {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    margin-top: 1.3rem;
  }
  .tenure-value strong {
    font-size: clamp(4.6rem, 7vw, 6.5rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.08em;
    color: #fff;
  }
  .tenure-value span {
    color: #60a5fa;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    padding-bottom: 0.35rem;
  }
  .tenure-label {
    position: relative;
    z-index: 2;
    margin: 0.85rem 0 0;
    color: #fff;
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .tenure-coverage {
    position: relative;
    z-index: 2;
    margin-top: 1.25rem;
  }
  .tenure-coverage ul {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.55rem 0.95rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tenure-coverage li {
    color: #dbeafe;
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .tenure-coverage li::before {
    content: '•';
    margin-right: 0.35rem;
    color: #fb923c;
  }
  .tenure-range {
    position: absolute;
    z-index: 3;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.3rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: #bfdbfe;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .tenure-range i {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, #3b82f6, #fb923c);
  }
  .tenure-route {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 2.4rem;
    width: 100%;
    height: 12rem;
    pointer-events: none;
  }
  .tenure-route-track,
  .tenure-route-progress {
    vector-effect: non-scaling-stroke;
    fill: none;
    stroke-linecap: round;
  }
  .tenure-route-track {
    stroke: rgba(147, 197, 253, 0.16);
    stroke-width: 2;
  }
  .tenure-route-progress {
    stroke: #60a5fa;
    stroke-width: 2.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .tenure-route-node {
    fill: #dbeafe;
    stroke: rgba(96, 165, 250, 0.35);
    stroke-width: 8;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
  }
  .tenure-route-node--accent {
    fill: #fb923c;
    stroke: rgba(251, 146, 60, 0.22);
  }
  .stat-card {
    padding: 1.45rem 1.5rem;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(203, 213, 225, 0.72);
    box-shadow: 0 12px 34px rgba(30, 58, 95, 0.07);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .stats-warehouse {
    grid-area: 1 / 4 / 2 / 8;
    background:
      linear-gradient(135deg, rgba(219, 234, 254, 0.72), rgba(255, 255, 255, 0.96) 62%), #fff;
  }
  .stats-network {
    grid-area: 1 / 8 / 2 / 13;
    background:
      radial-gradient(circle at 87% 24%, rgba(37, 99, 235, 0.12), transparent 9rem), #eef4ff;
  }
  .stats-inspection {
    grid-area: 2 / 4 / 3 / 10;
    background:
      radial-gradient(circle at 0 100%, rgba(251, 146, 60, 0.12), transparent 13rem),
      linear-gradient(135deg, #fffaf7, #fff);
  }
  .stats-accuracy {
    grid-area: 2 / 10 / 3 / 13;
    color: #fff;
    background:
      radial-gradient(circle at 100% 0, rgba(96, 165, 250, 0.38), transparent 12rem),
      linear-gradient(145deg, #123d75, #0a1a33 72%);
    border-color: rgba(147, 197, 253, 0.22);
    box-shadow: 0 18px 42px rgba(10, 26, 51, 0.18);
  }
  .stat-card-heading {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .stat-card-kicker {
    color: #2563eb;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }
  .stat-card-index {
    color: #334155;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .stats-accuracy .stat-card-kicker {
    color: #93c5fd;
  }
  .stats-accuracy .stat-card-index {
    color: rgba(219, 234, 254, 0.55);
  }
  .stat-metrics {
    position: relative;
    z-index: 2;
    display: grid;
    min-width: 0;
  }
  .stat-metrics--warehouse {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 1rem;
    align-items: end;
  }
  .stat-metrics--network {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .stat-metrics--network .stat-metric {
    padding: 0 1rem;
    border-left: 1px solid rgba(148, 163, 184, 0.25);
  }
  .stat-metrics--network .stat-metric:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stat-metrics--inspection {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .stat-metrics--inspection .stat-metric + .stat-metric {
    padding-left: 1.5rem;
    border-left: 1px solid rgba(232, 93, 38, 0.15);
  }
  .stat-metric {
    min-width: 0;
  }
  .stat-val {
    display: flex;
    align-items: baseline;
    gap: 0.22rem;
    margin-bottom: 0.65rem;
    min-width: 0;
  }
  .stat-num {
    font-size: clamp(2rem, 3.4vw, 3.35rem);
    font-weight: 900;
    color: #e85d26;
    font-variant-numeric: tabular-nums;
    line-height: 0.92;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .stat-unit {
    font-size: 0.9rem;
    font-weight: 800;
    color: #2563eb;
    white-space: nowrap;
  }
  .stat-label {
    font-size: 0.82rem;
    font-weight: 800;
    color: #0a1a33;
    line-height: 1.4;
    margin: 0 0 0.32rem;
  }
  .stat-detail {
    font-size: 0.68rem;
    color: #334155;
    line-height: 1.55;
    margin: 0;
  }
  .stats-warehouse .stat-metric:first-child .stat-num {
    font-size: clamp(2.7rem, 4.3vw, 4.15rem);
  }
  .stats-warehouse .stat-metric:last-child .stat-num {
    font-size: clamp(2.25rem, 3.3vw, 3.2rem);
    text-shadow: 0 8px 20px rgba(232, 93, 38, 0.14);
  }
  .stats-network .stat-num {
    font-size: clamp(1.65rem, 2.4vw, 2.45rem);
  }
  .stats-network .stat-unit {
    font-size: 0.72rem;
  }
  .inspection-direction {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.7rem;
    color: #c2410c;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .inspection-direction::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #fb923c;
  }
  .stat-metric--accuracy {
    position: relative;
    z-index: 2;
  }
  .stats-accuracy .stat-num {
    color: #fff;
    font-size: clamp(2.65rem, 3.7vw, 3.8rem);
  }
  .stats-accuracy .stat-unit {
    color: #fb923c;
  }
  .stats-accuracy .stat-label {
    color: #fff;
  }
  .stats-accuracy .stat-detail {
    color: #bfdbfe;
  }
  .accuracy-ring {
    position: absolute;
    right: -4.6rem;
    bottom: -4.8rem;
    width: 11rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(#fb923c 0 76%, rgba(147, 197, 253, 0.12) 76% 100%);
    opacity: 0.24;
    pointer-events: none;
  }
  .accuracy-ring span {
    position: absolute;
    inset: 0.75rem;
    border-radius: inherit;
    background: #0d2546;
  }
  .warehouse-schematic {
    position: absolute;
    right: 0.9rem;
    bottom: 0.8rem;
    display: flex;
    align-items: flex-end;
    gap: 0.22rem;
    height: 3.8rem;
    opacity: 0.11;
    transform: skewY(-8deg);
  }
  .warehouse-schematic span {
    display: block;
    width: 1rem;
    border: 2px solid #2563eb;
    border-bottom-width: 5px;
  }
  .warehouse-schematic span:nth-child(1) {
    height: 46%;
  }
  .warehouse-schematic span:nth-child(2) {
    height: 72%;
  }
  .warehouse-schematic span:nth-child(3) {
    height: 100%;
  }
  .warehouse-schematic span:nth-child(4) {
    height: 62%;
  }
  .network-orbit {
    position: absolute;
    right: 0.7rem;
    top: 0.75rem;
    width: 5.5rem;
    height: 5.5rem;
    border: 1px solid rgba(37, 99, 235, 0.09);
    border-radius: 50%;
    pointer-events: none;
  }
  .network-orbit::before,
  .network-orbit::after {
    content: '';
    position: absolute;
    border: 1px solid rgba(37, 99, 235, 0.08);
    border-radius: 50%;
  }
  .network-orbit::before {
    inset: 0.8rem;
  }
  .network-orbit::after {
    inset: 1.7rem;
  }
  .network-orbit i {
    position: absolute;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: #f97316;
  }
  .network-orbit i:nth-child(1) {
    top: 0.4rem;
    left: 2.7rem;
  }
  .network-orbit i:nth-child(2) {
    top: 2.4rem;
    right: 0.1rem;
  }
  .network-orbit i:nth-child(3) {
    bottom: 0.5rem;
    left: 1rem;
  }
  .network-orbit i:nth-child(4) {
    top: 2.2rem;
    left: 2.5rem;
    background: #fb923c;
  }
  .stats-flow {
    position: relative;
    margin-top: 1rem;
    padding: 1.2rem 1.75rem 1.3rem;
    color: #fff;
    background: linear-gradient(100deg, rgba(37, 99, 235, 0.13), transparent 45%), #0a1a33;
    border: 1px solid rgba(147, 197, 253, 0.16);
    border-radius: 1.4rem;
    overflow: hidden;
    box-shadow: 0 16px 42px rgba(10, 26, 51, 0.12);
  }
  .stats-flow::after {
    content: 'CYCLE  /  07';
    position: absolute;
    right: 1.5rem;
    top: 1.2rem;
    color: rgba(191, 219, 254, 0.3);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .stats-flow-heading {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.75rem;
  }
  .stats-flow-heading span {
    color: #60a5fa;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .stats-flow-heading strong {
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }
  .stats-flow-rail {
    position: absolute;
    z-index: 1;
    left: 8.4%;
    right: 8.4%;
    top: 4.33rem;
    height: 2px;
    background: rgba(147, 197, 253, 0.2);
  }
  .stats-flow-progress {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #60a5fa 62%, #fb923c);
    box-shadow: 0 0 18px rgba(96, 165, 250, 0.45);
    transform-origin: left center;
  }
  .stats-flow-list {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stats-flow-step {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.38rem;
    min-width: 0;
    text-align: center;
  }
  .flow-index {
    color: #334155;
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .stats-flow-step > i {
    display: block;
    width: 0.78rem;
    height: 0.78rem;
    border: 3px solid #0a1a33;
    border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 0 1px rgba(147, 197, 253, 0.42);
    transform-box: fill-box;
    transform-origin: center;
  }
  .stats-flow-step:last-child > i {
    background: #fb923c;
    box-shadow: 0 0 0 1px rgba(251, 146, 60, 0.5);
  }
  .stats-flow-step strong {
    color: #dbeafe;
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .stats-notes {
    margin-top: 1.15rem;
    padding: 0 0.2rem;
  }
  .stats-notes summary {
    width: max-content;
    cursor: pointer;
    color: #64748b;
    font-size: 0.68rem;
    font-weight: 600;
    list-style: none;
  }
  .stats-notes summary::-webkit-details-marker {
    display: none;
  }
  .stats-notes summary::after {
    content: '＋';
    margin-left: 0.35rem;
    color: #94a3b8;
  }
  .stats-notes[open] summary::after {
    content: '−';
  }
  .stats-notes-body {
    margin-top: 0.65rem;
    max-width: 62rem;
  }
  .stats-footnote {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin: 0;
    font-size: 0.75rem;
    color: #334155;
    line-height: 1.6;
  }
  .stats-footnote span {
    flex: 0 0 auto;
    color: #2563eb;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .stats-disclaimer {
    margin: 0.38rem 0 0;
    font-size: 0.66rem;
    color: #334155;
    line-height: 1.7;
  }
  @media (hover: hover) and (pointer: fine) {
    .stat-card:hover {
      transform: translateY(-4px);
      border-color: rgba(37, 99, 235, 0.35);
      box-shadow: 0 20px 48px rgba(30, 58, 95, 0.13);
    }
    .stats-accuracy:hover {
      border-color: rgba(147, 197, 253, 0.45);
      box-shadow: 0 24px 52px rgba(10, 26, 51, 0.24);
    }
  }

  @media (max-width: 1100px) {
    .stats-bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(190px, auto));
    }
    .stats-tenure {
      grid-area: 1 / 1 / 2 / 7;
      min-height: 280px;
    }
    .stats-warehouse {
      grid-area: 2 / 1 / 3 / 4;
    }
    .stats-network {
      grid-area: 2 / 4 / 3 / 7;
    }
    .stats-inspection {
      grid-area: 3 / 1 / 4 / 5;
    }
    .stats-accuracy {
      grid-area: 3 / 5 / 4 / 7;
    }
    .tenure-route {
      width: 52%;
      left: auto;
    }
    .tenure-range {
      max-width: 18rem;
    }
    .stat-metrics--network {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1rem;
    }
    .stat-metrics--network .stat-metric:nth-child(3) {
      grid-column: 1 / -1;
      padding: 0.85rem 0 0;
      border-top: 1px solid rgba(148, 163, 184, 0.25);
      border-left: 0;
    }
  }

  @media (max-width: 700px) {
    .s-stats {
      padding: 4.5rem 1.25rem;
    }
    .stats-heading {
      display: block;
      margin-bottom: 1.5rem;
    }
    .stats-intro {
      margin-top: 0.8rem;
      font-size: 0.86rem;
    }
    .stats-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: 0.75rem;
    }
    .stats-tenure,
    .stats-warehouse,
    .stats-network,
    .stats-inspection,
    .stats-accuracy {
      grid-area: auto;
      grid-column: 1 / -1;
    }
    .stats-tenure {
      min-height: 310px;
    }
    .stat-card {
      padding: 1.35rem;
    }
    .stats-network .stat-num {
      font-size: clamp(1.75rem, 8vw, 2.3rem);
    }
    .stats-flow {
      padding: 1.25rem 1.1rem 1.35rem;
    }
    .stats-flow::after {
      right: 1.1rem;
    }
    .stats-flow-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
      margin-bottom: 1rem;
    }
    .stats-flow-rail {
      left: 3.76rem;
      right: auto;
      top: 5.75rem;
      bottom: 2.3rem;
      width: 2px;
      height: auto;
    }
    .stats-flow-progress {
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, #3b82f6, #60a5fa 62%, #fb923c);
      transform-origin: center top;
    }
    .stats-flow-list {
      grid-template-columns: 1fr;
      gap: 0.95rem;
    }
    .stats-flow-step {
      grid-template-columns: 1.7rem 0.8rem 1fr auto;
      justify-items: start;
      align-items: center;
      gap: 0.65rem;
      text-align: left;
    }
    .stats-flow-step strong {
      font-size: 0.72rem;
    }
    .stats-footnote {
      align-items: flex-start;
    }
    .deco-watermark {
      opacity: 0.5;
    }
  }

  @media (max-width: 420px) {
    .stat-metrics--warehouse,
    .stat-metrics--inspection {
      gap: 0.85rem;
    }
    .stat-metrics--inspection .stat-metric + .stat-metric {
      padding-left: 0.85rem;
    }
    .stat-num {
      font-size: 2rem;
    }
    .stats-warehouse .stat-metric:first-child .stat-num {
      font-size: 2.65rem;
    }
    .stats-warehouse .stat-metric:last-child .stat-num {
      font-size: 2rem;
    }
    .stats-network .stat-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats-network .stat-metric {
      padding: 0 0 0 0.7rem;
    }
    .stats-network .stat-metric:nth-child(3) {
      grid-column: 1 / -1;
    }
    .stats-accuracy .stat-num {
      font-size: 3rem;
    }
    .stats-footnote {
      display: block;
    }
    .stats-footnote span {
      display: block;
      margin-bottom: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-tenure,
    .stat-card,
    .stats-flow-step {
      opacity: 1 !important;
      transform: none !important;
    }
    .tenure-route-progress {
      stroke-dashoffset: 0 !important;
    }
    .stats-flow-progress {
      transform: none !important;
    }
    .tenure-route-node,
    .stats-flow-step > i {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* ── ③ Services ──────────────────────────────────────────────── */
  .s-service {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }
  .s-service.reverse {
    direction: rtl;
  }
  .s-service.reverse > * {
    direction: ltr;
  }
  @media (max-width: 768px) {
    .s-service {
      grid-template-columns: 1fr;
      direction: ltr !important;
    }
    .s-service > * {
      direction: ltr !important;
    }
  }
  .svc-media {
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }
  .svc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
  }
  #svc-quality-inspection .svc-img {
    object-position: center 65%;
  }
  #svc-logistics-cloud .svc-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 85% 12%, rgba(37, 99, 235, 0.12), transparent 18rem),
      linear-gradient(rgba(37, 99, 235, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.055) 1px, transparent 1px), #f4f7fc;
    background-size: auto, 30px 30px, 30px 30px, auto;
  }
  .svc-dashboard-frame {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 2.35rem minmax(0, 1fr);
    width: 92%;
    aspect-ratio: 1.65 / 1;
    overflow: hidden;
    background: #0a1220;
    border: 1px solid rgba(96, 165, 250, 0.45);
    border-radius: 1.1rem;
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.38);
  }
  .svc-dashboard-heading {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0 0.9rem;
    color: #dbeafe;
    background: rgba(20, 36, 62, 0.94);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .svc-dashboard-heading {
    border-bottom: 1px solid rgba(96, 165, 250, 0.2);
  }
  .svc-dashboard-viewport {
    position: relative;
    overflow: hidden;
    background: #060b12;
  }
  #svc-logistics-cloud .svc-dashboard-viewport .svc-img {
    position: absolute;
    top: -9%;
    left: 0;
    width: 100%;
    height: auto;
    object-fit: initial;
    transform: none;
    padding: 0;
  }
  .svc-system-overlay {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    max-width: calc(100% - 3rem);
    padding: 0.55rem 0.8rem;
    color: #fff;
    background: rgba(10, 26, 51, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }
  .svc-system-overlay span {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .svc-system-overlay span + span::before {
    content: '｜';
    margin: 0 0.28rem;
    color: #93c5fd;
  }
  .svc-system-overlay b,
  .svc-system-overlay i {
    font-style: normal;
  }
  .svc-system-overlay b {
    color: #fff;
    font-size: 0.74rem;
  }
  .svc-system-overlay i {
    display: none;
  }
  /* 运到图（白底）contain 显示 */
  #dp-yundao-platform .svc-media {
    background: #fff;
  }
  .svc-img--contain {
    object-fit: contain !important;
    transform: none !important;
    padding: 1.5rem;
  }
  #dp-yundao-platform .svc-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 85% 12%, rgba(37, 99, 235, 0.12), transparent 18rem),
      linear-gradient(rgba(37, 99, 235, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.05) 1px, transparent 1px), #f4f7fc;
    background-size: auto, 30px 30px, 30px 30px, auto;
  }
  .yundao-visual {
    display: flex;
    flex-direction: column;
    width: 90%;
    padding: 0;
  }
  .yundao-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-content: center;
    gap: 0.8rem;
    min-height: 9.5rem;
    padding: 0.85rem;
    background: #f8fbff;
    border: 1px solid #dbeafe;
    border-radius: 0.9rem;
    align-items: center;
    text-align: center;
  }
  .yundao-flow span,
  .yundao-flow strong {
    padding: 0.8rem 0.5rem;
    color: #1e3a5f;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .yundao-flow strong {
    color: #fff;
    background: #2563eb;
    border-color: #2563eb;
    font-size: 0.8rem;
  }
  .yundao-flow i {
    display: none;
  }
  .yundao-interface-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.85fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    min-height: 25rem;
    padding-bottom: 3.4rem;
  }
  .yundao-interface-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0.42rem;
    box-shadow: 0 5px 14px rgba(30, 58, 95, 0.1);
  }
  .yundao-interface-main {
    grid-row: 1 / 3;
    grid-column: 1;
  }
  .yundao-interface-side-1 {
    grid-row: 1;
    grid-column: 2;
  }
  .yundao-interface-side-2 {
    grid-row: 2;
    grid-column: 2;
  }
  .yundao-interface-detail {
    position: absolute;
    z-index: 1;
    bottom: 0;
    left: 14%;
    width: 45% !important;
    height: 34% !important;
    border: 4px solid #f4f7fc !important;
    box-shadow: 0 14px 28px rgba(30, 58, 95, 0.18) !important;
  }
  .svc-num-badge {
    position: absolute;
    top: 2rem;
    left: 2rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: #fff;
    color: #2563eb;
    font-size: 1.1rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }
  .svc-num-badge--solution {
    top: 5rem;
    width: auto;
    min-width: 3.5rem;
    min-height: 3.5rem;
    gap: 0.55rem;
    padding: 0.25rem 1.15rem;
    border-radius: 999px;
  }
  .svc-num-badge--solution > span {
    font-size: 1.25rem;
  }
  .svc-num-badge--solution small {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .svc-media-caption {
    position: absolute;
    z-index: 1;
    right: 5.5rem;
    bottom: 1.5rem;
    margin: 0;
    padding: 0.55rem 0.8rem;
    color: #fff;
    background: rgba(10, 26, 51, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .svc-media-caption i {
    margin: 0 0.2rem;
    color: #93c5fd;
    font-style: normal;
  }
  .svc-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 3.5rem;
    background: #fff;
  }
  .s-service:nth-child(odd) .svc-body {
    background: #fff;
  }
  .svc-title {
    font-size: clamp(2.25rem, 3.5vw, 4rem);
    font-weight: 900;
    color: #0a1a33;
    margin-bottom: 0.75rem;
    opacity: 0;
    transform: translateX(30px);
  }
  .s-service.reverse .svc-title {
    transform: translateX(-30px);
  }
  .svc-problem {
    max-width: 34rem;
    margin: 0 0 1.1rem;
    color: #475569;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.7;
  }
  .svc-sub {
    font-size: 1.375rem;
    color: #2563eb;
    font-weight: 600;
    margin-bottom: 1.5rem;
    opacity: 0;
  }
  .svc-desc {
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.85;
    margin-bottom: 1.75rem;
    opacity: 0;
  }
  .svc-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    opacity: 0;
  }
  .svc-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.075rem;
    color: #334155;
    line-height: 1.6;
  }
  .svc-feature-solution {
    display: grid;
    gap: 0.12rem;
  }
  .svc-feature-solution strong {
    color: #0a1a33;
    font-size: 1.02rem;
    font-weight: 800;
  }
  .svc-feature-solution small {
    color: #475569;
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .svc-scenarios {
    margin: -0.25rem 0 1.75rem;
  }
  .svc-scenarios > span {
    display: block;
    margin-bottom: 0.55rem;
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .svc-scenarios > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .svc-scenarios b {
    padding: 0.38rem 0.7rem;
    color: #1e3a5f;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .svc-fee-note {
    margin: -0.25rem 0 1.5rem;
    color: #64748b;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .svc-fee-note strong {
    color: #334155;
  }
  @media (max-width: 420px) {
    .svc-system-overlay {
      right: 0.75rem;
      bottom: 0.75rem;
      padding: 0.48rem 0.6rem;
    }
    .svc-system-overlay b {
      font-size: 0.66rem;
    }
    .svc-system-overlay span + span::before {
      margin: 0 0.18rem;
    }
  }
  .svc-features svg {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .svc-link {
    align-self: flex-start;
    font-size: 1.05rem;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
    border-bottom: 2px solid #bfdbfe;
    padding-bottom: 2px;
    transition:
      border-color 0.2s,
      color 0.2s;
    opacity: 0;
  }
  .svc-link:hover {
    color: #1d4ed8;
    border-color: #1d4ed8;
  }

  /* ── ④ Products ──────────────────────────────────────────────── */
  .s-products {
    background: #f8fafc;
    padding: 6rem 2rem;
  }
  .products-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .products-head {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .products-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
  }
  .prod-card {
    background: #fff;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 24px rgba(10, 26, 51, 0.07);
    opacity: 0;
    transform: translateY(40px);
    transition:
      box-shadow 0.25s,
      transform 0.25s;
  }
  .prod-card:hover {
    box-shadow: 0 8px 40px rgba(37, 99, 235, 0.14);
    transform: translateY(-3px);
  }
  .prod-media {
    position: relative;
    height: 220px;
    overflow: hidden;
  }
  .prod-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }
  .prod-card:hover .prod-img {
    transform: scale(1.04);
  }
  .prod-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 26, 51, 0.1) 0%, rgba(10, 26, 51, 0.55) 100%);
  }
  .prod-tag {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.88);
    color: #fff;
    backdrop-filter: blur(4px);
  }
  .prod-body {
    padding: 2rem 1.75rem 2.25rem;
  }
  .prod-name {
    font-size: 1.375rem;
    font-weight: 900;
    color: #0a1a33;
    margin-bottom: 0.35rem;
  }
  .prod-sub {
    font-size: 0.875rem;
    color: #2563eb;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .prod-desc {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .prod-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prod-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #334155;
    line-height: 1.5;
  }
  .prod-features svg {
    flex-shrink: 0;
    margin-top: 1px;
  }
  .prod-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
    border-bottom: 2px solid #bfdbfe;
    padding-bottom: 2px;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .prod-link:hover {
    color: #1d4ed8;
    border-color: #1d4ed8;
  }
  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── ⑤ Cases ─────────────────────────────────────────────────── */
  .s-cases {
    background: #fff;
    padding: 6rem 2rem 4.5rem;
  }
  .cases-head {
    max-width: 1200px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  /* List container */
  .cases-list {
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid #e8e8e4;
  }

  /* Per-brand color tokens — keys match Directus cases.label */
  .cl-row[data-case='UR（Urban Revivo）'] {
    --cr: #2563eb;
    --cr-tint: rgba(37, 99, 235, 0.04);
  }
  .cl-row[data-case='玛克茜妮（MAXRIENY）'] {
    --cr: #be123c;
    --cr-tint: rgba(190, 18, 60, 0.04);
  }
  .cl-row[data-case='幸棉'] {
    --cr: #15803d;
    --cr-tint: rgba(21, 128, 61, 0.04);
  }
  .cl-row[data-case='美一(MEIYI)'] {
    --cr: #b45309;
    --cr-tint: rgba(180, 83, 9, 0.04);
  }

  /* Row */
  .cl-row {
    display: grid;
    grid-template-columns: 3rem 1fr 18rem 1fr 1.5rem;
    align-items: center;
    column-gap: 2.5rem;
    padding: 2.75rem 1.5rem;
    width: 100%;
    border: none;
    border-bottom: 1px solid #e8e8e4;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translateY(20px);
    transition: background 0.2s;
    border-radius: 0;
  }
  .cl-row:hover {
    background: var(--cr-tint);
  }

  /* Index number */
  .cl-idx {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #c8c8c2;
    font-variant-numeric: tabular-nums;
  }

  /* Brand info */
  .cl-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .cl-name {
    font-size: 1.4rem;
    font-weight: 900;
    color: #0a1a33;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .cl-cat {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a3a39c;
  }

  /* Metric — big number, small unit baseline-aligned */
  .cl-metric {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  .cl-metric-context {
    color: #64748b;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }
  .cl-val {
    font-size: clamp(2.5rem, 3.5vw, 3.5rem);
    font-weight: 900;
    color: var(--cr);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  /* Tags */
  .cl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-content: center;
  }
  .cl-tags span {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #334155;
    background: #f1f5f9;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* Arrow */
  .cl-arrow {
    font-size: 1rem;
    color: #c8c8c2;
    transition:
      color 0.2s,
      transform 0.2s;
  }
  .cl-row:hover .cl-arrow {
    color: var(--cr);
    transform: translateX(4px);
  }

  /* "查看全部" button */
  .cases-more {
    text-align: center;
    margin-top: 3.5rem;
  }
  .btn-outline-dark {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #0a1a33;
    color: #0a1a33;
    padding: 0.75rem 2rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.03em;
    transition:
      background 0.22s,
      color 0.22s;
  }
  .btn-outline-dark:hover {
    background: #0a1a33;
    color: #fff;
  }

  @media (max-width: 900px) {
    .cl-row {
      grid-template-columns: 2.5rem 1fr 1fr;
      grid-template-rows: auto auto;
      column-gap: 1.5rem;
      row-gap: 1rem;
    }
    .cl-metric {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }
    .cl-tags {
      grid-column: 2 / 4;
      grid-row: 2;
    }
    .cl-arrow {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .cl-row {
      grid-template-columns: 2.5rem 1fr;
      grid-template-rows: auto auto auto;
    }
    .cl-metric {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }
    .cl-tags {
      grid-column: 2;
      grid-row: 3;
    }
  }

  /* ── Case Modal ─────────────────────────────────────────────── */
  .case-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .case-modal[hidden] {
    display: none;
  }
  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 15, 35, 0.75);
    backdrop-filter: blur(8px);
  }
  .modal-panel {
    position: relative;
    z-index: 1;
    background: #fff;
    border-radius: 1.75rem;
    max-width: 760px;
    width: 100%;
    max-height: 92vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(28px) scale(0.96);
    transition:
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .modal-panel.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Hero image */
  .modal-hero {
    position: relative;
    height: 200px;
    overflow: hidden;
    border-radius: 1.75rem 1.75rem 0 0;
    flex-shrink: 0;
  }
  .modal-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .modal-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      165deg,
      rgba(5, 15, 35, 0.25) 0%,
      rgba(5, 15, 35, 0.65) 60%,
      rgba(5, 15, 35, 0.88) 100%
    );
  }
  .modal-hero-content {
    position: absolute;
    bottom: 1.75rem;
    left: 2rem;
    right: 4rem;
  }
  .modal-category-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--modal-accent, #2563eb);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.625rem;
    opacity: 0.95;
  }
  .modal-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  .modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.15s;
    z-index: 2;
  }
  .modal-close:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  /* Body */
  .modal-body {
    padding: 1.5rem 2rem 1.75rem;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  .modal-desc {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #f1f5f9;
  }

  /* Stats */
  .modal-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 520px) {
    .modal-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    :global(.modal-stat-card:nth-child(2n)) {
      border-right: none;
    }
  }
  :global(.modal-stat-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0 0.5rem;
    border-right: 1px solid #f1f5f9;
