---
import Layout from '@/layouts/Layout.astro'
import { BRAND, DIGITAL_PRODUCTS, CASE_DETAILS } from '@/lib/brand'
import { CLAIM_TEXT } from '@/lib/claims'
import { getHomepageStats, getServices, getCases } from '@/lib/directus'
import { ORGANIZATION_ID, createBreadcrumbSchema, createFaqSchema } from '@/lib/seo'

const [STATS, SERVICES, allCases] = await Promise.all([
  getHomepageStats(),
  getServices(),
  getCases(),
])
const CASES = allCases.slice(0, 4)

// Parse "库存 260万件+ · ..." → { value: '260万件+', label: '库存' } for card display
function parseFirstMetric(metrics: string) {
  const first = metrics.split('·')[0].trim()
  const spaceIdx = first.indexOf(' ')
  return {
    value: spaceIdx > 0 ? first.slice(spaceIdx + 1) : first,
    label: spaceIdx > 0 ? first.slice(0, spaceIdx) : '',
  }
}
const caseCardMeta = CASES.map((c) => ({
  shortName: (CASE_DETAILS as Record<string, { name: string }>)[c.label]?.name ?? c.label,
  slug: (CASE_DETAILS as Record<string, { slug: string }>)[c.label]?.slug,
  metric: parseFirstMetric(c.metrics),
  metricContext: c.metrics.split('·')[0].includes('年发货') ? '年度发货规模' : '库存管理规模',
}))

const pickStats = (...ids: number[]) =>
  ids
    .map((id) => STATS.find((stat) => stat.id === id))
    .filter((stat): stat is (typeof STATS)[number] => Boolean(stat))

const STAT_GROUPS = {
  warehouse: pickStats(2, 4),
  network: pickStats(1, 8, 3),
  inspection: pickStats(5, 6),
  accuracy: pickStats(7),
}

const CLOUD_WAREHOUSE_FEATURES = [
  { title: '多渠道订单履约', detail: '电商平台、门店订单、批发订单统一协同' },
  { title: '鞋服库存管理', detail: '支持多SKU、多尺码、多颜色与批次管理' },
  { title: '快速订单处理', detail: '18:00前截单，当日24:00前发出；单仓日峰值50万单' },
  { title: '智能仓储管理', detail: 'RFID、电子标签与系统流程协同管理' },
]

const RETURN_QUALITY_FEATURES = [
  { title: '标准化质检', detail: '按AQL标准执行，可识别7大类135+种鞋服异常' },
  { title: '分级处置', detail: '根据质检结果进入可售、修复、退供或报废流程' },
  { title: '瑕疵修复', detail: '设置九大修复专区，完成后按照品牌标准重新复检' },
  { title: '快速二次上架', detail: '退货质检+二次上架24h，平均拆包4小时、质检12小时' },
]

const DIGITAL_LOGISTICS_FEATURES = [
  { title: '多系统协同', detail: '物流网关、WMS、LMS、人效管理及履约监控模块统一协作' },
  { title: '全链路可视', detail: '订单、库存、仓内作业、物流轨迹与签收状态实时查看' },
  { title: '灵活系统对接', detail: '支持奇门、EDI、API及客户定制接口，适配不同业务系统' },
  { title: '物流履约管理', detail: '对接顺丰、京东、EMS等主流承运商，支持路由匹配、轨迹查询与异常处理' },
]

const YUNDAO_FEATURES = [
  { title: '多承运商统一接入', detail: '已对接顺丰、京东、EMS等11家主流承运商' },
  { title: '智能路由匹配', detail: '根据线路、货量、价格和时效要求匹配寄件方案' },
  { title: '正逆向寄件协同', detail: '支持门店寄件、门店调拨、退仓及企业寄件场景' },
  { title: '全程服务管理', detail: '支持轨迹查询、异常处理、在线工单和数据报表' },
]

const IMGS = {
  hero: '/index.webp',
  svc0: '/w-apparel.webp',
  svc1: '/w-inspect2.webp',
  svc2: '/w-fulfill-system-dashboard.png',
  prod0: '/w-yundao.webp',
}

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: BRAND.fullName,
  alternateName: ['新亦源', '新亦源供应链'],
  url: BRAND.url,
  logo: `${BRAND.url}/logo.png`,
  description: BRAND.description,
  foundingDate: String(BRAND.founded),
  telephone: [BRAND.phone.toll],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '果园一路2号',
    addressLocality: '广州市黄埔区',
    addressRegion: '广东省',
    addressCountry: 'CN',
  },
  areaServed: { '@type': 'Country', name: '中国' },
}

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${BRAND.url}/#website`,
  url: BRAND.url,
  name: BRAND.name,
  description: BRAND.description,
  inLanguage: 'zh-Hans',
}

const breadcrumbSchema = createBreadcrumbSchema([{ name: '首页', path: '/' }])

const HOME_FAQS = [
  {
    q: '新亦源主要提供哪些鞋服仓配服务？',
    a: '新亦源提供鞋服云仓、入库质检、退货质检、瑕疵修复、订单履约、门店补货和物流数字化服务。支持B2C、B2B、O2O多渠道订单协同，并可按品牌业务配置仓网、系统接口与退货处理流程。',
  },
  {
    q: '新亦源适合哪些类型的鞋服品牌？',
    a: '适合有多平台订单、多尺码SKU、门店补货、大促波峰或退货处理需求的鞋服品牌。无论是品牌直营、电商零售、批发铺货，还是线上线下协同，都可按实际货量与渠道配置服务方案。',
  },
  {
    q: '与普通云仓和普通仓配公司有什么区别？',
    a: '新亦源围绕鞋服高SKU、高退货和季节性订单特点配置仓内流程。除仓储发货外，还提供款色码管理、质检分级、修复、二次上架与库存协同，让商品在正向履约和逆向处理之间形成闭环。',
  },
  {
    q: '能否处理退货质检、瑕疵修复和二次上架？',
    a: `可以。退货商品可完成拆包、质检分级、清洁修复与二次上架；按AQL标准可识别7大类${CLAIM_TEXT.recognizableAnomalies}鞋服异常。退货质检与二次上架时效为${CLAIM_TEXT.returnTurnaround}，具体处置规则可按品牌要求配置。`,
  },
  {
    q: '是否支持抖音、天猫、唯品会和线下门店订单？',
    a: '支持。平台订单、品牌ERP、门店订单及批发订单可统一进入履约队列，按库存、时效和仓网匹配发货。可支持主流平台接口及客户定制系统对接，减少多渠道库存和订单的重复操作。',
  },
  {
    q: '是否支持一件代发和跨境仓配？',
    a: `支持一件代发。货物完成入仓与系统对接后，订单可按单完成拣货、复核、包装、发货和物流回传，${CLAIM_TEXT.shippingSla}。跨境项目可提供国内端仓储、项目质检、换标换包装与物流协同。`,
  },
  {
    q: '有哪些可以验证的案例和运营数据？',
    a: `目前服务${CLAIM_TEXT.partnerBrands}鞋服及相关品牌、${CLAIM_TEXT.servedStores}门店，直营仓储${CLAIM_TEXT.warehouseArea}。网站案例页展示不同业务场景；发货、库存和退货处理等数据均以对应统计周期、项目范围及经营记录为准。`,
  },
  {
    q: '如何获取仓配方案和报价？',
    a: '提交SKU数量、日均订单量、发货渠道、仓储区域和退货情况后，我们会结合业务流程评估仓网、履约与系统对接需求，并提供对应的仓配建议与报价方案。',
  },
]

const faqSchema = createFaqSchema(HOME_FAQS)
---

<Layout
  title="新亦源鞋服云仓｜鞋服仓储、质检、发货一体化服务"
  description={`新亦源2011年成立，提供鞋服仓配、退货质检、瑕疵修复及全渠道库存管理。直营仓储${CLAIM_TEXT.warehouseArea}，服务${CLAIM_TEXT.partnerBrands}品牌，发货准确率与库存准确率${CLAIM_TEXT.shippingAccuracy}。`}
  jsonLd={[orgSchema, webSiteSchema, breadcrumbSchema, faqSchema]}
  services={SERVICES}
>
  <!-- ①  HERO -->
  <section id="s-hero" class="s-hero" aria-labelledby="hero-heading">
    <img src={IMGS.hero} alt="新亦源现代化仓储中心" class="hero-img" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-body">
      <p class="hero-eyebrow">专注鞋服供应链 · 深耕15年</p>
      <p class="hero-brand-kw hl">新亦源鞋服云仓</p>
      <h1
        id="hero-heading"
        class="hero-title"
        aria-label="从入库质检到退货上架，鞋服仓配一次解决"
      >
        <strong class="hl">从入库质检到退货上架<span class="hero-punctuation">，</span></strong>
        <strong class="hl">鞋服仓配一次解决</strong>
      </h1>
      <p class="hero-sub hl">
        为鞋服品牌提供入库质检、库存管理、订单履约、退货处理与二次上架服务，支持多平台、多仓协同。
      </p>
      <p class="hero-data hl">50万㎡+直营仓储 ｜ 140+服务品牌 ｜ 10000+覆盖门店 ｜ 6000+覆盖城市</p>
      <div class="hero-actions hl">
        <a href="/contact" class="btn-solid">获取仓配方案</a>
        <a href="/product" class="btn-ghost">了解服务 →</a>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </section>

  <!-- ②  STATS -->
  <section id="s-stats" class="s-stats" aria-labelledby="stats-heading">
    <div class="stats-deco" aria-hidden="true">
      <div class="deco-watermark">15Y</div>
    </div>

    <div class="stats-inner">
      <header class="stats-heading">
        <div>
          <p class="section-tag">数字说话</p>
          <h2 id="stats-heading" class="stats-headline">不只是仓库<br />更是一套鞋服供应链能力体系</h2>
        </div>
        <p class="stats-intro">
          覆盖仓储管理、商品质检、订单履约与逆向处理，为鞋服品牌提供稳定、高效的供应链支持。
        </p>
      </header>

      <div class="stats-bento">
        <article class="stats-tenure">
          <div class="tenure-topline">
            <span>运营年限</span>
            <span class="tenure-status"><i></i>仓网协同中</span>
          </div>
          <div class="tenure-value" aria-label="十五年">
            <strong data-raw="15">15</strong>
            <span>YEARS</span>
          </div>
          <p class="tenure-label">鞋服供应链经验</p>
          <div class="tenure-coverage">
            <ul>
              <li>仓储管理</li>
              <li>订单履约</li>
              <li>退货处理</li>
              <li>库存协同</li>
            </ul>
          </div>
          <div class="tenure-range" aria-label="2011年至2026年">
            <span>2011</span>
            <i aria-hidden="true"></i>
            <span>2026</span>
          </div>
          <svg
            class="tenure-route"
            viewBox="0 0 320 180"
            fill="none"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="tenure-route-track"
              d="M-12 145C54 145 50 65 119 65s70 63 125 28 82-58 104-47"></path>
            <path
              class="tenure-route-progress"
              pathLength="1"
              d="M-12 145C54 145 50 65 119 65s70 63 125 28 82-58 104-47"></path>
            <circle class="tenure-route-node" cx="52" cy="111" r="5"></circle>
            <circle class="tenure-route-node" cx="119" cy="65" r="5"></circle>
            <circle class="tenure-route-node" cx="244" cy="93" r="5"></circle>
            <circle class="tenure-route-node tenure-route-node--accent" cx="313" cy="53" r="6"
            ></circle>
          </svg>
        </article>

        <article class="stat-card stats-warehouse" data-flow="warehouse">
          <header class="stat-card-heading">
            <span class="stat-card-kicker">仓储规模</span>
            <span class="stat-card-index">01</span>
          </header>
          <div class="stat-metrics stat-metrics--warehouse">
            {
              STAT_GROUPS.warehouse.map(({ value, label, unit, detail }) => (
                <div class="stat-metric">
                  <div class="stat-val">
                    <span class="stat-num" data-raw={value}>
                      {value}
                    </span>
                    <span class="stat-unit">{unit}</span>
                  </div>
                  <h3 class="stat-label">{label}</h3>
                  <p class="stat-detail">
                    {label === '管理SKU' ? '覆盖多品类、多款式、多尺码商品管理' : detail}
                  </p>
                </div>
              ))
            }
          </div>
          <div class="warehouse-schematic" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
        </article>

        <article class="stat-card stats-network" data-flow="network">
          <header class="stat-card-heading">
            <span class="stat-card-kicker">服务网络</span>
            <span class="stat-card-index">02</span>
          </header>
          <div class="stat-metrics stat-metrics--network">
            {
              STAT_GROUPS.network.map(({ value, label, unit, detail }) => (
                <div class="stat-metric">
                  <div class="stat-val">
                    <span class="stat-num" data-raw={value}>
                      {value}
                    </span>
                    <span class="stat-unit">{unit}</span>
                  </div>
                  <h3 class="stat-label">{label}</h3>
                  <p class="stat-detail">{detail}</p>
                </div>
              ))
            }
          </div>
          <div class="network-orbit" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
          </div>
        </article>

        <article class="stat-card stats-inspection" data-flow="inspection">
          <header class="stat-card-heading">
            <span class="stat-card-kicker">质检履约</span>
            <span class="stat-card-index">03</span>
          </header>
          <div class="stat-metrics stat-metrics--inspection">
            {
              STAT_GROUPS.inspection.map(({ value, label, unit, detail }, index) => (
                <div class="stat-metric">
                  <span class="inspection-direction">{index === 0 ? '正向入仓' : '逆向回流'}</span>
                  <div class="stat-val">
                    <span class="stat-num" data-raw={value}>
                      {value}
                    </span>
                    <span class="stat-unit">{unit}</span>
                  </div>
                  <h3 class="stat-label">{label}</h3>
                  <p class="stat-detail">{detail}</p>
                </div>
              ))
            }
          </div>
        </article>

        <article class="stat-card stats-accuracy" data-flow="accuracy">
          <header class="stat-card-heading">
            <span class="stat-card-kicker">库存协同</span>
            <span class="stat-card-index">04</span>
          </header>
          {
            STAT_GROUPS.accuracy.map(({ value, label, unit, detail }) => (
              <div class="stat-metric stat-metric--accuracy">
                <div class="accuracy-ring" aria-hidden="true">
                  <span />
                </div>
                <div class="stat-val">
                  <span class="stat-num" data-raw={value}>
                    {value}
                  </span>
                  <span class="stat-unit">{unit}</span>
                </div>
                <h3 class="stat-label">{label}</h3>
                <p class="stat-detail">
                  {label === '库存准确率' ? '条码化管理 + 系统流程协同' : detail}
                </p>
              </div>
            ))
          }
        </article>
      </div>

      <div class="stats-flow" aria-label="商品全生命周期闭环">
        <div class="stats-flow-heading">
          <span>全生命周期闭环</span>
          <strong>一套仓配体系，覆盖商品全生命周期</strong>
        </div>
        <div class="stats-flow-rail" aria-hidden="true">
          <span class="stats-flow-progress"></span>
        </div>
        <ol class="stats-flow-list">
          <li class="stats-flow-step">
            <span class="flow-index">01</span><i aria-hidden="true"></i><strong>品牌接入</strong>
          </li>
          <li class="stats-flow-step">
            <span class="flow-index">02</span><i aria-hidden="true"></i><strong>商品入仓</strong>
          </li>
          <li class="stats-flow-step">
            <span class="flow-index">03</span><i aria-hidden="true"></i><strong>质检分流</strong>
          </li>
          <li class="stats-flow-step">
            <span class="flow-index">04</span><i aria-hidden="true"></i><strong>库存管理</strong>
          </li>
          <li class="stats-flow-step">
            <span class="flow-index">05</span><i aria-hidden="true"></i><strong>订单履约</strong>
          </li>
          <li class="stats-flow-step">
            <span class="flow-index">06</span><i aria-hidden="true"></i><strong>退货处理</strong>
          </li>
          <li class="stats-flow-step">
            <span class="flow-index">07</span><i aria-hidden="true"></i><strong>再次销售</strong>
          </li>
        </ol>
      </div>

      <details class="stats-notes">
        <summary>数据说明</summary>
        <div class="stats-notes-body">
        <p class="stats-footnote">
          <span>数据口径</span>
          以上为截至公司运营统计的公开核心数据，具体统计周期与项目范围以对应经营记录为准。
        </p>
        <p class="stats-disclaimer">
          注：页面所涉仓储面积、质检量、库存准确率、修复成功率等数据来源于新亦源内部运营统计及企业公开资料，具体服务效果会因品类、订单规模、系统接入程度和合作模式不同而有所差异。
        </p>
        </div>
      </details>
    </div>
  </section>

  <!-- ③  SERVICES  (3 full-screen panels) -->
  {
    SERVICES.map((svc, i) => (
      <section
        class={`s-service ${i % 2 === 1 ? 'reverse' : ''}`}
        id={`svc-${svc.slug}`}
        aria-labelledby={`svc-title-${i}`}
      >
        <div class="svc-media">
          {i === 2 ? (
            <div class="svc-dashboard-frame">
              <p class="svc-dashboard-heading">OTD物流服务中台 · 实际系统界面</p>
              <div class="svc-dashboard-viewport">
                <img
                  src={IMGS[`svc${i}` as keyof typeof IMGS]}
                  alt="OTD物流服务中台订单与履约数据看板"
                  class="svc-img"
                  loading="lazy"
                />
              </div>
            </div>
          ) : (
            <img
              src={IMGS[`svc${i}` as keyof typeof IMGS]}
              alt={svc.name}
              class="svc-img"
              loading="lazy"
            />
          )}
          <div class:list={['svc-num-badge', { 'svc-num-badge--solution': i < 3 }]}>
            <span>0{i + 1}</span>
            {i === 0 && <small>鞋服仓储挂装区</small>}
            {i === 1 && <small>退货质检作业区</small>}
            {i === 2 && <small>数字化运营中心</small>}
          </div>
          {i === 0 && <p class="svc-media-caption">恒温仓储 <i>｜</i> 分类存储 <i>｜</i> 条码管理</p>}
          {i === 1 && <p class="svc-media-caption">外观检查 <i>｜</i> 内里检查 <i>｜</i> 配饰检查 <i>｜</i> 分级修复</p>}
          {i === 2 && <p class="svc-media-caption">订单履约 <i>｜</i> 库存同步 <i>｜</i> 物流监控 <i>｜</i> 异常预警 <i>｜</i> 签收回传</p>}
        </div>
        <div class="svc-body">
          <p class="section-tag">{i < 3 ? '核心解决方案' : '物流优化'}</p>
          {i === 0 && <p class="svc-problem">订单越来越复杂，品牌需要更懂鞋服的仓配体系</p>}
          {i === 1 && <p class="svc-problem">退货真正难的，不是收回来，而是判断还能不能再次销售</p>}
          {i === 2 && <p class="svc-problem">平台、仓库和物流数据分散，品牌很难及时掌握真实履约状态</p>}
          <h2 id={`svc-title-${i}`} class="svc-title">
            {svc.name}
          </h2>
          <p class="svc-sub">
            {i === 0
              ? '全渠道一盘货，让库存和订单高效协同'
              : i === 1
                ? '135+种异常识别，退货质检+二次上架24h'
                : i === 2
                  ? '六大系统模块协同，订单履约全程可视'
                : svc.subtitle}
          </p>
