  /* ── Mobile adjustments ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero-body {
      padding: 0 1.25rem;
    }
    .hero-title {
      font-size: clamp(1.65rem, 8.2vw, 2.6rem);
