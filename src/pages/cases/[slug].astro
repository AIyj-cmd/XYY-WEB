---
import Layout from '@/layouts/Layout.astro'
import { BRAND, CASE_DETAILS } from '@/lib/brand'
import { getCases, getServices } from '@/lib/directus'
import { ORGANIZATION_ID, createBreadcrumbSchema } from '@/lib/seo'

const slug = Astro.params.slug
const caseEntry = Object.entries(CASE_DETAILS).find(([, detail]) => detail.slug === slug)

if (!caseEntry) {
  return Astro.redirect('/cases', 302)
}

const [caseLabel, detail] = caseEntry
const [cases, services] = await Promise.all([getCases(), getServices()])
const caseSummary = cases.find((item) => item.label === caseLabel)
const casePath = `/cases/${detail.slug}`
const imageUrl = detail.image.startsWith('http') ? detail.image : `${BRAND.url}${detail.image}`
const pageTitle = `${detail.fullName}鞋服仓配合作案例｜新亦源`
const pageDescription = `${detail.fullName}与新亦源鞋服云仓合作案例，展示仓储、库存、质检和订单履约等经脱敏的项目运营数据与服务场景。`

const breadcrumbSchema = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '合作案例', path: '/cases' },
  { name: detail.fullName, path: casePath },
])

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${BRAND.url}${casePath}#article`,
  mainEntityOfPage: `${BRAND.url}${casePath}`,
  headline: `${detail.fullName}鞋服仓配合作案例`,
  description: pageDescription,
  image: imageUrl,
  inLanguage: 'zh-Hans',
  about: caseSummary?.tags ?? [],
  author: { '@id': ORGANIZATION_ID },
  publisher: { '@id': ORGANIZATION_ID },
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={imageUrl}
  jsonLd={[breadcrumbSchema, articleSchema]}
  services={services}
>
  <article>
    <header class="relative isolate overflow-hidden bg-[#0a1a33] py-20 lg:py-28">
      <img
        src={detail.image}
        alt={`${detail.fullName}合作案例业务场景`}
        class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(100deg,rgba(8,20,42,0.98)_0%,rgba(8,20,42,0.88)_48%,rgba(8,20,42,0.45)_100%)]"
      >
      </div>
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <nav aria-label="面包屑" class="mb-8 flex items-center gap-2 text-sm text-slate-300">
          <a href="/" class="hover:text-white">首页</a>
          <span aria-hidden="true">/</span>
          <a href="/cases" class="hover:text-white">合作案例</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{detail.name}</span>
        </nav>
        <p class="mb-3 text-sm font-bold tracking-[0.14em] text-orange-400">鞋服仓配合作案例</p>
        <h1 class="max-w-4xl text-4xl font-black leading-tight text-white lg:text-6xl">
          {detail.fullName}
        </h1>
        <p class="mt-5 text-lg font-bold text-blue-200">{detail.category}</p>
      </div>
    </header>

    <section class="bg-white py-16 lg:py-20" aria-labelledby="case-overview-heading">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
        <div>
          <p class="mb-3 text-xs font-bold tracking-[0.14em] text-blue-600">案例概况</p>
          <h2 id="case-overview-heading" class="text-3xl font-black text-[#0a1a33]">品牌背景与服务场景</h2>
          <p class="mt-6 leading-8 text-slate-600">{detail.description}</p>
          {caseSummary && (
            <div class="mt-8">
              <h3 class="text-sm font-black text-[#0a1a33]">主要服务范围</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {caseSummary.tags.map((tag) => (
                  <span class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700">{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <div>
          <p class="mb-4 text-xs font-bold tracking-[0.14em] text-blue-600">项目运营数据</p>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {detail.stats.map((stat) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <p class="text-2xl font-black text-[#0a1a33]">
                  {stat.value}<span class="ml-1 text-xs font-bold text-slate-500">{stat.unit}</span>
                </p>
                <p class="mt-2 text-xs font-bold text-slate-600">{stat.label}</p>
              </div>
            ))}
          </div>
          <p class="mt-5 text-xs leading-6 text-slate-500">
            数据来源于新亦源内部项目运营统计，部分业务细节已脱敏；具体以对应统计周期、项目范围和经营记录为准。
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#eff4ff] py-14" aria-labelledby="case-contact-heading">
      <div class="mx-auto max-w-4xl px-5 text-center">
        <h2 id="case-contact-heading" class="text-2xl font-black text-[#0a1a33] lg:text-3xl">
          想了解与您业务相近的仓配方案？
        </h2>
        <p class="mt-4 text-slate-600">提交SKU规模、订单渠道与退货情况，获取针对性的仓配建议。</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/contact" class="rounded-xl bg-orange-600 px-7 py-3.5 font-bold text-white hover:bg-orange-700">
            获取仓配方案
          </a>
          <a href="/cases" class="rounded-xl border border-slate-300 bg-white px-7 py-3.5 font-bold text-[#0a1a33] hover:border-slate-500">
            返回案例列表
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>
