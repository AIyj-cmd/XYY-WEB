---
import EnglishLayout from '@/components/en/EnglishLayout.astro'
import Footer from '@/components/Footer.astro'
import ProductVideoSequence from '@/components/product/ProductVideoSequence.astro'
import { getEnglishSiteSettings } from '@/i18n/site-settings'
import { createBreadcrumbSchema, createServiceSchema } from '@/lib/seo'

const services = [
  {
    name: 'Apparel fulfilment',
    description:
      'Apparel warehousing, order fulfilment and systems integration for China operations.',
    path: '/en/apparel-fulfillment',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'Returns inspection',
    description: 'Returns unpacking, inspection, disposition and re-listing workflows for apparel.',
    path: '/en/returns-inspection',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'Garment care',
    description: 'Apparel preparation, care and value-added handling workflows.',
    path: '/en/garment-care',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'Cross-border fulfilment',
    description:
      'Domestic warehousing, inspection, relabelling and repacking for cross-border apparel projects.',
    path: '/en/cross-border-fulfillment',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'South China fulfilment',
    description: 'Apparel warehouse services across Guangzhou, Dongguan, Foshan and Zhaoqing.',
    path: '/en/south-china-fulfillment',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'East China fulfilment',
    description: 'Apparel warehouse services across Shanghai, Kunshan and Hefei.',
    path: '/en/east-china-fulfillment',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'Livestream fulfilment',
    description:
      'Session capacity, inventory coordination, dispatch and returns for livestream commerce.',
    path: '/en/livestream-fulfillment',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
  {
    name: 'Retail distribution',
    description: 'Retail, B2B and store-replenishment distribution workflows for apparel brands.',
    path: '/en/retail-distribution',
    providerName: 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.',
    countryName: 'China',
  },
]
const breadcrumbSchema = createBreadcrumbSchema([
  { name: 'Home', path: '/en' },
  { name: 'Services', path: '/en/services' },
])
const settings = await getEnglishSiteSettings()
---

<EnglishLayout
  title="Apparel supply-chain services"
  description="Explore apparel, cross-border, South China, East China and livestream fulfilment, returns inspection, garment care and retail distribution in China."
  jsonLd={[breadcrumbSchema, ...services.map(createServiceSchema)]}
  siteSettings={settings}
  showFooter={false}
  showFloatingContact={false}
  ><ProductVideoSequence locale="en"
    ><Footer settings={settings} locale="en" slot="footer" /></ProductVideoSequence
  ></EnglishLayout
>
