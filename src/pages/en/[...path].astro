---
import EnglishLayout from '@/components/en/EnglishLayout.astro'

Astro.response.status = 404
---

<EnglishLayout
  title="Page not found"
  description="The requested English page does not exist."
  noIndex
  ><section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-4 py-20">
    <p class="text-sm font-bold uppercase tracking-[.2em] text-orange-600">404</p><h1
      class="mt-3 text-5xl font-black text-[#0A1A33]"
    >
      This English page cannot be found.
    </h1><p class="mt-5 text-lg text-slate-600">
      The link may be outdated or the page is not available in English.
    </p><div class="mt-8 flex gap-3">
      <a href="/en" class="rounded-xl bg-[#0A1A33] px-5 py-3 font-bold text-white">English home</a
      ><a href="/" class="rounded-xl border border-slate-300 px-5 py-3 font-bold">中文首页</a>
    </div>
  </section></EnglishLayout
>
