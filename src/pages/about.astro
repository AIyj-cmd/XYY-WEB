---
import Layout from '@/layouts/Layout.astro'
import PageFAQ from '@/components/PageFAQ.astro'
import AboutHero from '@/components/about/AboutHero.astro'
import AboutHistory from '@/components/about/AboutHistory.astro'
import AboutWarehouseNetwork from '@/components/about/AboutWarehouseNetwork.astro'
import AboutWarehouseRegions from '@/components/about/AboutWarehouseRegions.astro'
import AboutHonors from '@/components/about/AboutHonors.astro'
import { ABOUT_FAQS, ABOUT_HISTORY, groupWarehouses } from '@/data/about'
import { BRAND, HONORS } from '@/lib/brand'
import { CLAIM_TEXT } from '@/lib/claims'
import {
  getAboutContent,
  getAboutHistory,
  getAboutHonors,
  getFaqs,
  getWarehouses,
} from '@/lib/directus'
import { createFaqSchema } from '@/lib/seo'

const honorFallbacks = HONORS.map((title, index) => ({
  title,
  image: `/about/honor/${index + 1}.jpg`,
}))
const aboutFallback = {
  overview: `新亦源供应链总部位于广州，是专注鞋服垂直领域的云仓服务商。公司以鞋服为核心，延伸服务潮玩、美妆、箱包、IT电子、快消、医药、安防、智能家居等行业，围绕鞋服质检中心、鞋服仓配中心和商圈寄件平台“运到”构建一体化服务能力。目前合作品牌${CLAIM_TEXT.partnerBrands}、服务门店${CLAIM_TEXT.servedStores}、覆盖${CLAIM_TEXT.coveredCities}城市、管理SKU ${CLAIM_TEXT.managedSkus}。`,
  heroDescription: `从仓储质检到履约交付，我们为鞋服品牌提前解决出货链路中的复杂问题。\n15年、${CLAIM_TEXT.employeeCount}名员工、${CLAIM_TEXT.warehouseArea}直营仓储，只为一件事：让发货更准确、高效、快捷。`,
}
const [warehouses, faqs, about, history, honors] = await Promise.all([
  getWarehouses(),
  getFaqs('about', ABOUT_FAQS),
  getAboutContent(aboutFallback),
  getAboutHistory(ABOUT_HISTORY),
  getAboutHonors(honorFallbacks),
])
const warehouseGroups = groupWarehouses(warehouses)

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '关于我们', item: `${BRAND.url}/about` },
  ],
}

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${BRAND.url}/#organization`,
  name: BRAND.fullName,
  alternateName: '新亦源',
  url: BRAND.url,
  foundingDate: String(BRAND.founded),
  foundingLocation: { '@type': 'Place', name: '广州' },
  description: BRAND.description,
  telephone: [BRAND.phone.toll],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '果园一路2号',
    addressLocality: '广州市黄埔区',
    addressRegion: '广东省',
    addressCountry: 'CN',
  },
}
const faqSchema = createFaqSchema(faqs)
---

<Layout
  title="关于新亦源｜广州新亦源供应链管理有限公司"
  description={`广州新亦源供应链管理有限公司2011年成立，专注鞋服仓配、退货质检和瑕疵修复，服务${CLAIM_TEXT.partnerBrands}品牌。了解新亦源的发展历程、仓网与服务能力。`}
  jsonLd={[breadcrumbSchema, orgSchema, faqSchema]}
>
  <AboutHero description={about.heroDescription} />

  <section
    class="py-14 bg-white border-b border-gray-100"
    aria-labelledby="company-overview-heading"
  >
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[11px] font-bold text-[#B94718] tracking-[0.35em] uppercase mb-4">
        关于新亦源
      </p>
      <h2 id="company-overview-heading" class="sr-only">公司概述</h2>
      <p class="text-gray-700 leading-[1.9] text-base lg:text-[1.05rem]">{about.overview}</p>
    </div>
  </section>

  <AboutHistory items={history} />
  <AboutWarehouseNetwork />
  <AboutWarehouseRegions southGroups={warehouseGroups.south} eastGroups={warehouseGroups.east} />
  <AboutHonors honors={honors} />
  <PageFAQ heading="关于新亦源的常见问题" items={faqs} />

  <section class="py-14 bg-[#EFF4FF]" aria-labelledby="about-cta-heading">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="about-cta-heading" class="text-2xl lg:text-3xl font-black text-navy-800 mb-4">
        想了解更多合作详情？
      </h2>
      <p class="text-gray-600 mb-6">联系我们的商务团队，获取定制化解决方案</p>
      <a
        href="/contact"
        class="inline-flex items-center px-7 py-3.5 bg-[#B94718] text-white font-bold rounded-xl hover:bg-[#923A13] transition-colors"
      >
        立即联系
      </a>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/about-page'
</script>
