---
import Layout from '@/layouts/Layout.astro'
import PageFAQ from '@/components/PageFAQ.astro'
import { BRAND } from '@/lib/brand'
import { CLAIM_TEXT } from '@/lib/claims'
import { getServices } from '@/lib/directus'

const SERVICES = await getServices()

const SOLUTIONS = [
  {
    id: 'cloud-warehouse',
    index: '01',
    name: '鞋服云仓',
    shortName: '鞋服云仓',
    value: '商品入仓、库存管理与多渠道订单履约',
    problem: '多渠道订单和复杂SKU，需要一套真正懂鞋服的仓配体系',
    fit: ['SKU数量多', '多平台同时销售', '大促波动明显', '需要门店补货'],
    result: '库存、订单和仓内作业统一管理。',
    href: '/xiefu-yuncang',
  },
  {
    id: 'quality-inspection',
    index: '02',
    name: '退货质检与瑕疵修复',
    shortName: '退货质检',
    value: '质检分级、专业修复与二次上架',
    problem: '退货不是终点，关键是让可售商品尽快重新进入库存',
    fit: ['退货率较高', '异常类型复杂', '需要恢复可售库存', '门店退仓较多'],
    result: '从拆包、质检、分级到修复和二次上架。',
    href: '/tuihuo-zhijian',
  },
  {
    id: 'logistics-cloud',
    index: '03',
    name: '物流数字化能力',
    shortName: '数字化能力',
    value: '订单、库存、仓内作业与物流数据协同',
    problem: '平台、仓库和物流数据分散，履约状态难以及时掌握',
    fit: ['ERP数据分散', '需要多仓协同', '履约状态不可视', '需要接口定制'],
    result: '统一订单、库存、仓内与物流数据。',
    href: '#logistics-cloud',
  },
  {
    id: 'yundao-platform',
    index: '04',
    name: '运到智能寄件平台',
    shortName: '智能寄件',
    value: '多承运商、智能路由与门店寄件管理',
    problem: '门店寄件渠道分散、价格不透明，需要统一管理运输资源',
    fit: ['连锁门店寄件', '多承运商管理', '门店调拨退仓', '异常件追踪'],
    result: '统一承运商、路由、轨迹和客服工单。',
    href: '#yundao-platform',
  },
] as const

const LOCAL_NAV = SOLUTIONS.map(({ id, shortName }) => ({ id, label: shortName }))

const serviceSchemas = SOLUTIONS.map((solution) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${BRAND.url}/product#${solution.id}`,
  name: solution.name,
  description: solution.value,
  provider: {
    '@type': 'Organization',
    '@id': `${BRAND.url}/#organization`,
    name: BRAND.fullName,
  },
  areaServed: { '@type': 'Country', name: '中国' },
  url: solution.href.startsWith('/') ? `${BRAND.url}${solution.href}` : `${BRAND.url}/product#${solution.id}`,
}))

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '产品服务', item: `${BRAND.url}/product` },
  ],
}

const WAREHOUSE_GROUPS = [
  {
    index: 'A',
    title: '商品管理',
    items: ['多SKU、款色码管理', 'RFID与电子标签', '日动盘、周抽盘、月实盘'],
  },
  {
    index: 'B',
    title: '订单履约',
    items: ['B2C + B2B + O2O', '智能波次拣货', '峰值弹性产能'],
  },
  {
    index: 'C',
    title: '系统与风控',
    items: ['WMS与ERP对接', '多渠道库存同步', '监控与争议追溯'],
  },
]

const INSPECTION_STEPS = [
  '拆包登记',
  '标准质检',
  'A / B+ / B- / C分级',
  '清洁或修复',
  '品牌标准复检',
  '二次上架 / 退供 / 报废',
]

const DEFECT_CATEGORIES = [
  { name: '外观问题', example: '污渍、色差、破损与穿着痕迹' },
  { name: '面料问题', example: '勾丝、起球、褪色与面料损伤' },
  { name: '缝线问题', example: '开线、跳针、脱线与线头异常' },
  { name: '配件问题', example: '拉链、纽扣、饰品与鞋服附件异常' },
  { name: '工艺问题', example: '整烫、粘合、车缝与成型工艺异常' },
  { name: '吊牌标识', example: '吊牌、洗唛、尺码标识与包装信息异常' },
  { name: '异味问题', example: '仓储、运输或退货环节产生的气味异常' },
]

const DIGITAL_MODULES = [
  ['01', '物流网关', '统一订单和运单数据入口'],
  ['02', '仓储管理 WMS', '管理款色码、库存与波次作业'],
  ['03', '物流管理 LMS', '管理承运商、轨迹与异常状态'],
  ['04', '人效通', '记录作业量、效率与质量'],
  ['05', '发货时效监控', '识别订单节点与超时风险'],
  ['06', '轨迹与签收监控', '跟踪揽收、运输和签收回传'],
] as const

const DIGITAL_FLOW = ['平台订单', '库存同步', '仓内作业', '物流路由', '异常预警', '签收回传']
const DIGITAL_RESULTS = ['多平台订单统一', '多仓库存可视', '异常主动预警', '经营数据报表']
const DIGITAL_CALLOUTS = [
  ['orders', '01', '订单履约', '多平台订单进入统一履约队列'],
  ['inventory', '02', '库存同步', '多仓与多渠道库存状态可视'],
  ['alerts', '03', '异常预警', '超时与异常节点主动提示'],
  ['tracking', '04', '物流轨迹', '揽收、运输与签收状态回传'],
] as const

const YUNDAO_CAPABILITIES = [
  ['多承运商统一接入', '已对接顺丰、京东、EMS等11家主流承运商'],
  ['智能路由与比价', '根据线路、货量、价格和时效匹配寄件方案'],
  ['正逆向寄件协同', '支持门店寄件、调拨、退仓及企业寄件'],
  ['全程服务管理', '支持轨迹查询、异常处理、在线工单和数据报表'],
] as const

const BUNDLES = [
  {
    index: '01',
    name: '成长型电商品牌',
    services: ['鞋服云仓', '物流数字化'],
    fit: ['多平台订单增长', '需要统一库存', '暂时没有复杂退货处理'],
    result: '统一库存与订单履约，支撑业务增长。',
    scene: '天猫、抖音、品牌小程序',
    recommended: false,
  },
  {
    index: '02',
    name: '高退货鞋服品牌',
    services: ['鞋服云仓', '退货质检与修复', '物流数字化'],
    fit: ['直播电商', '女装与鞋类', '退货率和异常率较高'],
    result: '缩短退货商品重新进入可售库存的路径。',
    scene: '直播电商、女装、鞋类',
    recommended: true,
  },
  {
    index: '03',
    name: '连锁门店品牌',
    services: ['鞋服云仓', '物流数字化', '运到智能寄件'],
    fit: ['全国门店', '门店调拨', '门店退仓与多承运商寄件'],
    result: '统一门店补货、调拨、退仓与寄件管理。',
    scene: '全国门店、区域调拨、门店退仓',
    recommended: false,
  },
]

const SERVICE_DIRECTORY = [
  {
    axis: '按区域',
    desc: '根据库存位置和销售半径选择仓网',
    items: [
      ['华南仓网', '/huanan-xiefu-yuncang'],
      ['华东仓网', '/huadong-xiefu-yuncang'],
      ['广州鞋服云仓', '/guangzhou-xiefu-yuncang'],
    ],
  },
  {
    axis: '按渠道',
    desc: '按订单来源和渠道规则匹配履约',
    items: [
      ['直播电商', '/zhibo-cangpei'],
      ['唯品会 JIT / JITX', '/weipinhui-jit-jitx'],
      ['B2B门店仓配', '/b2b-mendian-cangpei'],
    ],
  },
  {
    axis: '按业务',
    desc: '围绕特殊商品与逆向流程组合服务',
    items: [
      ['跨境云仓', '/kuajing-yuncang'],
      ['退货质检', '/tuihuo-zhijian'],
      ['后整修复', '/houzheng-xiufu'],
    ],
  },
] as const

const PRODUCT_FAQS = [
  {
    q: '新亦源鞋服云仓的最小起储量是多少？',
    a: '新亦源没有固定最小起储量门槛，会根据实际货量、SKU复杂度、订单渠道和仓点匹配情况评估。中小品牌可从单品类、单仓点开始合作，再随业务增长逐步扩展。',
  },
  {
    q: '系统如何与品牌现有ERP或OMS对接？',
    a: 'OTD中台及物流网关支持奇门、EDI、API或客户定制接口，可根据现有系统确认字段、授权方式和联调周期。系统使用本身不收费，实施、接口联调和定制开发费用按具体方案确认。',
  },
  {
    q: '大促期间如何提前准备峰值产能？',
    a: '项目团队会结合预测货量提前规划货位、波次、班次、弹性人力和系统压测。实际峰值目标与订单处理SLA会根据品牌预测和资源方案在项目启动阶段确认。',
  },
  {
    q: '如何减少高SKU商品发错尺码或颜色？',
    a: `入库时通过RFID或条码绑定款色码，拣货时使用电子标签或系统指引，发货前逐包扫码复核并比对订单。当前公开发货准确率为${CLAIM_TEXT.shippingAccuracy}。`,
  },
  {
    q: '是否支持退货质检、修复和二次上架？',
    a: `支持。退货商品可进入拆包、质检、分级、修复、复检和处置流程。当前公开口径为退货质检与二次上架${CLAIM_TEXT.returnTurnaround}，具体处理规则按品牌标准和项目范围确认。`,
  },
  {
    q: '物流数字化能力可以解决哪些问题？',
    a: '主要解决订单、库存、仓内作业和物流状态分散的问题。通过物流网关、WMS、LMS和履约监控模块，可统一查看多平台订单、多仓库存、物流轨迹、异常预警与签收回传。',
  },
  {
    q: '运到智能寄件平台适合哪些业务？',
    a: '适合连锁门店寄件、门店调拨、门店退仓、电商平台和企业寄件等场景。平台统一接入多家承运商，并提供路由匹配、轨迹查询、异常处理、在线工单和数据报表。',
  },
  {
    q: '仓储和增值服务费用如何计算？',
    a: '费用通常包含仓储、入出库操作、质检包装、物流和增值服务等项目，具体需要结合商品特性、SKU数量、库存周期、日均订单、退货比例和系统对接范围确认。',
  },
]
---

<Layout
  title="产品服务｜鞋服云仓、退货质检、物流数字化与智能寄件｜新亦源"
  description="新亦源提供鞋服云仓、退货质检与瑕疵修复、物流数字化能力和运到智能寄件平台四项核心解决方案，覆盖商品从入仓、履约到退货处理与再次销售。"
  jsonLd={[breadcrumbSchema, ...serviceSchemas]}
  services={SERVICES}
>
  <div class="product-page">
    <section class="product-hero" aria-labelledby="product-hero-heading">
      <img
        class="product-hero__background"
        src="/w-hanging1.webp"
        alt="新亦源鞋服挂装仓储空间"
        fetchpriority="high"
      />
      <div class="product-hero__overlay" aria-hidden="true"></div>
      <div class="product-shell product-hero__layout">
        <div class="product-hero__copy">
          <p class="eyebrow eyebrow--light">产品服务 / PRODUCT SERVICES</p>
          <h1
            id="product-hero-heading"
            aria-label="一套鞋服供应链能力覆盖商品从入仓到再次销售"
          >
            <span>一套鞋服供应链能力</span>
            <span>覆盖商品从入仓到再次销售</span>
          </h1>
          <p class="product-hero__lead">
            从仓储、质检到系统与物流协同，根据品牌的业务阶段自由组合服务能力。
          </p>
          <div class="hero-actions">
            <a href="/contact" class="button button--orange">获取适配方案 <span aria-hidden="true">→</span></a>
            <a href="#service-overview" class="button button--ghost-light">查看服务地图 <span aria-hidden="true">↓</span></a>
          </div>
          <dl class="hero-proof">
            <div><dt>4项</dt><dd>核心解决方案</dd></div>
            <div><dt>{CLAIM_TEXT.managedSkus}</dt><dd>管理SKU</dd></div>
            <div><dt>{CLAIM_TEXT.partnerBrands}</dt><dd>服务品牌</dd></div>
          </dl>
        </div>

        <div class="lifecycle-map" aria-label="四项核心解决方案关系图">
          <div class="lifecycle-map__core">
            <span>商品生命周期</span>
            <strong>入仓 → 履约 → 退货 → 再售</strong>
          </div>
          <ol>
            {SOLUTIONS.map(({ id, index, name, value }, solutionIndex) => (
              <li>
                <a href={`#${id}`} class:list={{ 'is-active': solutionIndex === 0 }} data-lifecycle-link>
                  <span>{index}</span>
                  <div><strong>{name}</strong><small>{value}</small></div>
                  <i aria-hidden="true">↘</i>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <nav class="product-local-nav" aria-label="产品页章节导航">
      <div class="product-local-nav__inner">
        {LOCAL_NAV.map(({ id, label }) => (
          <a href={`#${id}`} data-section-link={id}>{label}</a>
        ))}
      </div>
    </nav>

    <section id="service-overview" class="section section--soft anchor-section" aria-labelledby="overview-heading">
      <div class="product-shell">
        <header class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">服务选择 / SERVICE SELECTOR</p>
            <h2 id="overview-heading">不同业务问题<br />对应不同解决方案</h2>
          </div>
          <p>先判断当前最需要解决的问题，再决定使用单项服务还是组合方案。四项能力既可独立接入，也能沿商品生命周期连续协同。</p>
        </header>

        <div class="selector-assist">
          <p><strong>四项能力可以独立接入</strong>，也可以根据品牌订单、退货和门店业务组合使用。</p>
          <a href="/contact">不确定该选哪项服务？根据SKU、订单量、退货率和销售渠道快速匹配 <span aria-hidden="true">→</span></a>
        </div>

        <div class="selector-grid">
          {SOLUTIONS.map(({ id, index, name, fit, result }) => (
            <article class:list={['selector-card', `selector-card--${id}`]}>
              <header><span>{index}</span><small>CORE SOLUTION</small></header>
              <h3>{name}</h3>
              <div class="selector-card__visual" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
              <p class="selector-card__label">适合您的情况</p>
              <ul>{fit.map((item) => <li>{item}</li>)}</ul>
              <div class="selector-card__result"><small>解决</small><strong>{result}</strong></div>
              <a href={`#${id}`}>查看方案 <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="cloud-warehouse" class="section warehouse-section product-solution-section anchor-section" data-section-number="01" aria-labelledby="warehouse-heading">
      <div class="product-shell">
        <header class="solution-heading">
          <div class="solution-heading__index"><span>01</span><small>鞋服云仓</small></div>
          <div>
            <p class="eyebrow">APPAREL CLOUD WAREHOUSE</p>
            <h2 id="warehouse-heading">多渠道订单和复杂SKU<br />需要一套真正懂鞋服的仓配体系</h2>
          </div>
          <p>围绕款色码、库存、订单和仓内作业建立一盘货管理，让不同渠道共享库存并保持稳定履约。</p>
        </header>

        <div class="warehouse-stage">
          <img src="/images/services/warehouse-panorama.webp" alt="新亦源鞋服云仓仓内作业现场" loading="lazy" />
          <div class="warehouse-stage__shade" aria-hidden="true"></div>
          <div class="warehouse-stage__caption">
            <span>真实仓内作业现场</span>
            <strong>鞋服仓储 · 分拣 · 履约</strong>
          </div>
          <dl class="warehouse-metrics">
            <div><dt class="count-value" data-count-to="99.99" data-count-decimals="2" data-count-suffix="%">{CLAIM_TEXT.shippingAccuracy}</dt><dd>发货准确率</dd></div>
            <div><dt class="count-value" data-count-to="99.99" data-count-decimals="2" data-count-suffix="%">{CLAIM_TEXT.inventoryAccuracy}</dt><dd>库存准确率</dd></div>
            <div><dt>18:00</dt><dd>截单时间</dd></div>
            <div><dt class="count-value" data-count-to="50" data-count-decimals="0" data-count-suffix="万单/日">{CLAIM_TEXT.singleWarehousePeak}</dt><dd>单仓日峰值</dd></div>
          </dl>
        </div>

        <div class="warehouse-groups">
          {WAREHOUSE_GROUPS.map(({ index, title, items }) => (
            <article>
              <header><span>{index}</span><h3>{title}</h3></header>
              <ul>{items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="solution-links">
          <a href="/xiefu-yuncang" class="text-link">查看鞋服云仓完整方案 <span aria-hidden="true">→</span></a>
          <a href="/cases/ur" class="related-case"><span>相关案例</span> UR｜多渠道库存与订单协同 <i aria-hidden="true">→</i></a>
        </div>
      </div>
    </section>

    <section id="quality-inspection" class="section inspection-section product-solution-section anchor-section" data-section-number="02" aria-labelledby="inspection-heading">
      <div class="product-shell">
        <header class="solution-heading solution-heading--light">
          <div class="solution-heading__index"><span>02</span><small>退货质检</small></div>
          <div>
            <p class="eyebrow">RETURN INSPECTION & REPAIR</p>
            <h2 id="inspection-heading">退货不是终点<br />关键是让可售商品尽快重新进入库存</h2>
          </div>
          <p>从退货拆包、标准质检到分级处置、清洁修复和二次上架，为鞋服品牌建立可追溯的逆向处理体系。</p>
        </header>

        <div class="inspection-layout">
          <figure class="inspection-photo">
            <img src="/images/services/inspection-wide.webp" alt="新亦源退货质检与瑕疵修复作业现场" loading="lazy" />
            <figcaption><span>真实质检作业区</span><strong>拆包核对｜外观检查｜分级处置</strong></figcaption>
          </figure>
          <div class="inspection-facts">
            <div><strong>{CLAIM_TEXT.recognizableAnomalies}</strong><span>异常识别</span></div>
            <div><strong>7大类</strong><span>异常分类</span></div>
            <div><strong>9个</strong><span>修复专区</span></div>
            <div><strong>{CLAIM_TEXT.repairSuccessRate}</strong><span>瑕疵修复成功率</span></div>
          </div>
        </div>

        <ol class="inspection-flow" aria-label="退货质检与修复处理流程">
          {INSPECTION_STEPS.map((step, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>
          ))}
        </ol>

