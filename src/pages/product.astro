    .digital-foundation { grid-template-columns: 1fr; }
    .dashboard-frame img { max-height: none; }
    .digital-callouts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
    .digital-callouts button:nth-child(odd) { padding-right: 1rem; }
    .digital-callouts button:nth-child(even) { padding-left: 1rem; border-left: 1px solid #d6e1ef; }
    .digital-module-nav { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .digital-module-nav span:nth-child(4) { border-top: 1px solid #d6e1ef; border-left: 0; }
    .digital-module-nav span:nth-child(n+5) { border-top: 1px solid #d6e1ef; }
    .yundao-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .yundao-collage { min-height: 36rem; }
  }

  @media (max-width: 760px) {
    .product-shell { width: min(100% - 1.25rem,1180px); }
    .section { padding: 4.5rem 0; }
    .anchor-section { scroll-margin-top: 9rem; }
    .product-hero { padding: 8.5rem 0 4.5rem; }
    .product-hero__layout { grid-template-columns: 1fr; }
    .product-hero h1 { font-size: clamp(2.35rem,11vw,3.3rem); }
    .product-hero h1 span { white-space: normal; }
    .product-hero__lead { font-size: .92rem; }
    .hero-proof dt { font-size: 1.2rem; }
    .hero-proof div { padding-right: .6rem; }
    .hero-proof div + div { padding-left: .7rem; }
    .lifecycle-map { border-radius: 1rem; }
    .product-local-nav { top: 4.75rem; width: calc(100% - 1rem); max-width: none; }
    .product-local-nav__inner { justify-content: flex-start; width: 100%; padding: .25rem; }
    .product-local-nav a { padding: .65rem .75rem; }
    .section-heading--split { grid-template-columns: 1fr; gap: 1.2rem; }
    .section-heading h2, .solution-heading h2 { font-size: 2.2rem; }
    .selector-assist { align-items: flex-start; flex-direction: column; gap: .7rem; }
    .selector-assist a { white-space: normal; }
    .selector-grid { display: flex; gap: .8rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .selector-grid::-webkit-scrollbar { display: none; }
    .selector-card { flex: 0 0 84%; min-height: auto; scroll-snap-align: start; }
    .selector-card h3 { min-height: 0; }
    .selector-card__result { margin-top: 1.5rem; }
    .solution-heading { grid-template-columns: 4.4rem 1fr; gap: 1.2rem; margin-bottom: 2.5rem; }
    .solution-heading > p { grid-column: 1 / -1; }
    .solution-heading__index span { font-size: 1.2rem; }
    .warehouse-stage { min-height: 37rem; }
    .warehouse-stage__caption { top: 1.2rem; left: 1.2rem; }
    .warehouse-metrics { grid-template-columns: repeat(2,minmax(0,1fr)); right: .75rem; bottom: .75rem; left: .75rem; }
    .warehouse-metrics div { padding: 1rem; }
    .warehouse-metrics div:nth-child(3) { border-top: 1px solid rgba(255,255,255,.13); border-left: 0; }
    .warehouse-metrics div:nth-child(4) { border-top: 1px solid rgba(255,255,255,.13); }
    .warehouse-metrics dt { font-size: 1.3rem; }
    .warehouse-groups { grid-template-columns: 1fr; }
    .warehouse-groups article + article { border-top: 1px solid #dce5f1; border-left: 0; }
    .solution-links { align-items: flex-start; flex-direction: column; }
    .inspection-layout { grid-template-columns: 1fr; }
    .inspection-photo, .inspection-facts { grid-column: 1; grid-row: auto; }
    .inspection-photo { min-height: 25rem; }
    .inspection-facts div { min-height: 9rem; }
    .inspection-flow { display: grid; grid-template-columns: 1fr; gap: 0; padding-left: 1rem; }
    .inspection-flow::before, .inspection-flow::after { top: 1rem; bottom: 1rem; left: 1rem; width: 2px; height: auto; transform-origin: top; }
    .inspection-flow::after { transform: scaleY(0); }
    .inspection-section.is-in-view .inspection-flow::after { transform: scaleY(1); }
    .inspection-flow li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; align-items: center; padding: .65rem 0; text-align: left; }
    .inspection-flow span { margin: 0; }
    .defect-panel { grid-template-columns: 1fr; gap: 2rem; margin-top: 3rem; padding-top: 3rem; }
    .digital-callouts { grid-template-columns: 1fr; }
    .digital-callouts button:nth-child(odd), .digital-callouts button:nth-child(even) { padding-right: 0; padding-left: 0; border-left: 0; }
    .digital-module-nav { display: flex; overflow-x: auto; }
    .digital-module-nav span { flex: 0 0 8.5rem; }
    .digital-module-nav span:nth-child(4), .digital-module-nav span:nth-child(n+5) { border-top: 0; }
    .digital-application ol { display: flex; overflow-x: auto; }
    .digital-application ol::before { display: none; }
    .digital-application li { flex: 0 0 7rem; }
    .yundao-collage { min-height: 28rem; }
    .bundle-grid, .directory-grid { grid-template-columns: 1fr; }
    .bundle-grid article { min-height: 25rem; }
    .bundle-grid article.is-recommended { min-height: 25rem; margin: 0; }
    .directory-grid article + article { border-top: 1px solid #cfdbea; border-left: 0; }
    .product-cta__inner { grid-template-columns: 1fr; gap: 2rem; }
    .product-cta__actions { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .button, .selector-card, .bundle-grid article, .yundao-shot, .dashboard-frame, .inspection-flow::after, .inspection-flow span { transition: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const localNavLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-section-link]'))
  const localNav = document.querySelector<HTMLElement>('.product-local-nav')
  const observedSections = localNavLinks
    .map((link) => document.getElementById(link.dataset.sectionLink ?? ''))
    .filter((section): section is HTMLElement => section instanceof HTMLElement)

  const navObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
      if (!visible) return
      localNavLinks.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.sectionLink === visible.target.id)
      })
    },
    { rootMargin: '-28% 0px -58% 0px', threshold: [0.05, 0.25, 0.5] },
  )
  observedSections.forEach((section) => navObserver.observe(section))

  let previousScrollY = window.scrollY
  window.addEventListener('scroll', () => {
    if (!localNav) return
    const currentScrollY = window.scrollY
    const movingDown = currentScrollY > previousScrollY
    localNav.classList.toggle('is-hidden', movingDown && currentScrollY > window.innerHeight)
    previousScrollY = currentScrollY
  }, { passive: true })

  const lifecycleLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-lifecycle-link]'))
  lifecycleLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      lifecycleLinks.forEach((item) => item.classList.toggle('is-active', item === link))
    })
  })
  document.querySelector('.lifecycle-map')?.addEventListener('mouseleave', () => {
    lifecycleLinks.forEach((item, index) => item.classList.toggle('is-active', index === 0))
  })

  const animateCount = (element: HTMLElement) => {
    if (element.dataset.counted === 'true') return
    element.dataset.counted = 'true'
    const target = Number(element.dataset.countTo ?? 0)
    const decimals = Number(element.dataset.countDecimals ?? 0)
    const suffix = element.dataset.countSuffix ?? ''
    if (reduceMotion) {
      element.textContent = `${target.toFixed(decimals)}${suffix}`
      return
    }
    const startTime = performance.now()
    const duration = 1100
    const update = (time: number) => {
      const progress = Math.min((time - startTime) / duration, 1)
      const eased = 1 - Math.pow(1 - progress, 3)
      element.textContent = `${(target * eased).toFixed(decimals)}${suffix}`
      if (progress < 1) requestAnimationFrame(update)
    }
    requestAnimationFrame(update)
  }

  const visualSections = Array.from(document.querySelectorAll<HTMLElement>('.product-solution-section'))
  const visualObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return
      const section = entry.target as HTMLElement
      section.classList.add('is-in-view')
      section.querySelectorAll<HTMLElement>('.count-value').forEach(animateCount)
      visualObserver.unobserve(section)
    })
  }, { threshold: .18 })
  visualSections.forEach((section) => visualObserver.observe(section))

  const digitalFoundation = document.querySelector<HTMLElement>('.digital-foundation')
  document.querySelectorAll<HTMLElement>('[data-digital-focus]').forEach((trigger) => {
    const activate = () => {
      if (digitalFoundation) digitalFoundation.dataset.activeFocus = trigger.dataset.digitalFocus ?? ''
    }
    trigger.addEventListener('mouseenter', activate)
    trigger.addEventListener('focus', activate)
  })
  document.querySelector('.digital-callouts')?.addEventListener('mouseleave', () => {
    if (digitalFoundation) digitalFoundation.dataset.activeFocus = ''
  })

  const lightbox = document.querySelector<HTMLDialogElement>('.image-lightbox')
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img')
  document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return
      lightboxImage.src = trigger.dataset.lightboxSrc ?? ''
      lightboxImage.alt = trigger.dataset.lightboxAlt ?? ''
      lightbox.showModal()
    })
  })
  lightbox?.querySelector('.image-lightbox__close')?.addEventListener('click', () => lightbox.close())
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close()
  })
</script>
