---
import Layout from '@/layouts/Layout.astro'
import PageFAQ from '@/components/PageFAQ.astro'
import { BRAND } from '@/lib/brand'
import { CLAIM_TEXT } from '@/lib/claims'
import { getServices } from '@/lib/directus'

const SERVICES = await getServices()

const serviceSchemas = SERVICES.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${BRAND.url}/product#${s.slug}`,
  name: s.name,
  description: s.description,
  provider: {
    '@type': 'Organization',
    '@id': `${BRAND.url}/#organization`,
    name: BRAND.fullName,
  },
  areaServed: { '@type': 'Country', name: '中国' },
  url: `${BRAND.url}/product#${s.slug}`,
}))

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '产品服务', item: `${BRAND.url}/product` },
  ],
}

const NAV_ITEMS = [
  { id: 'cloud-warehouse', label: '鞋服云仓', en: 'Cloud Warehouse' },
  { id: 'quality-inspection', label: '后整质检修复', en: 'QC & Repair' },
  { id: 'logistics-cloud', label: '数字化能力', en: 'Digital Capability' },
  { id: 'yundao-platform', label: '运到寄件', en: 'YunDao Express' },
]

const SERVICE_HUBS = [
  {
    index: '01',
    name: '鞋服仓配中心',
    role: '库存与订单执行',
    scope: '入仓验收 · RFID建档 · 多渠道仓配',
  },
  {
    index: '02',
    name: '质检修复中心',
    role: '商品状态再判断',
    scope: '退货拆包 · 分级质检 · 后整修复',
  },
  {
    index: '03',
    name: '物流数据中心',
    role: '运输与运营协同',
    scope: 'OTD中台 · 运到平台 · 轨迹监控',
  },
]

const ORCHESTRATION_STEPS = [
  { index: '01', title: '入仓', detail: '收货验收 / SKU建档' },
  { index: '02', title: '质检', detail: '抽检全检 / 状态分级' },
  { index: '03', title: '仓配', detail: '一盘货 / 波次履约' },
  { index: '04', title: '物流', detail: '智能路由 / 轨迹监控' },
  { index: '05', title: '数据', detail: '库存 / 时效 / 人效回流' },
]

const FORWARD_CHAIN = [
  '新品与补货入仓',
  '款色码建档',
  '多渠道库存同步',
  '智能波次拣选',
  CLAIM_TEXT.shippingSla,
  '轨迹与签收监控',
]

const REVERSE_CHAIN = [
  '退货回仓',
  '视频拆包核对',
  'A / B+ / B- / C分级',
  '修复或处置分流',
  `质检与二次上架${CLAIM_TEXT.returnTurnaround}`,
  '可售库存回补',
]

const SCENE_FRAMES = [
  {
    src: '/images/services/warehouse-panorama.webp',
    alt: '新亦源鞋服仓储作业现场',
    eyebrow: 'WAREHOUSE / 01',
    title: '高SKU鞋服仓内现场',
    desc: '货位、款色码和作业波次在同一套仓内节奏中协同。',
    className: 'scene-frame scene-frame--wide',
  },
  {
    src: '/images/services/inspection-wide.webp',
    alt: '新亦源鞋服质检作业现场',
    eyebrow: 'QUALITY / 02',
    title: '质检与商品状态判断',
    desc: '从拆包核对到异常识别，每一步留下可追溯依据。',
    className: 'scene-frame scene-frame--tall',
  },
  {
    src: '/images/services/repair-stitch.webp',
    alt: '新亦源后整缝补修复现场',
    eyebrow: 'REPAIR / 03',
    title: '后整修复工位',
    desc: '让可修复商品经过处理与复检后重回后续流程。',
    className: 'scene-frame scene-frame--half',
  },
  {
    src: '/images/services/global-map.webp',
    alt: '新亦源供应链服务网络示意',
    eyebrow: 'NETWORK / 04',
    title: '区域仓网与线路协同',
    desc: '根据货源、库存与订单分布组织仓点和运输方案。',
    className: 'scene-frame scene-frame--map',
  },
]

const DIGITAL_MODULES = [
  { index: '01', name: '物流网关', desc: '衔接业务系统与承运商，统一订单和运单数据入口。' },
  { index: '02', name: '仓储管理 WMS', desc: '围绕鞋服款色码、库存、波次与复核组织仓内作业。' },
  { index: '03', name: '物流管理 LMS', desc: '统一查看承运商、轨迹、签收与异常处理状态。' },
  { index: '04', name: '人效通', desc: '记录作业量、效率与质量，为排班和峰值准备提供依据。' },
  { index: '05', name: '发货时效监控', desc: '跟踪订单关键节点，对超时风险进行识别和协同。' },
  { index: '06', name: '轨迹与签收监控', desc: '从揽收到签收持续跟踪，异常件进入客服工单流程。' },
]

const SERVICE_DIRECTORY = [
  {
    axis: '区域',
    en: 'REGION',
    items: [
      { label: '广州鞋服云仓', href: '/guangzhou-xiefu-yuncang' },
      { label: '华南鞋服云仓', href: '/huanan-xiefu-yuncang' },
      { label: '华东鞋服云仓', href: '/huadong-xiefu-yuncang' },
    ],
  },
  {
    axis: '渠道',
    en: 'CHANNEL',
    items: [
      { label: 'B2B门店仓配', href: '/b2b-mendian-cangpei' },
      { label: '直播电商仓配', href: '/zhibo-cangpei' },
      { label: '唯品会JIT / JITX', href: '/weipinhui-jit-jitx' },
      { label: '跨境云仓', href: '/kuajing-yuncang' },
    ],
  },
  {
    axis: '品类与逆向',
    en: 'CATEGORY & REVERSE',
    items: [
      { label: '鞋服云仓', href: '/xiefu-yuncang' },
      { label: '服装云仓', href: '/fuzhuang-yuncang' },
      { label: '退货质检', href: '/tuihuo-zhijian' },
      { label: '后整修复', href: '/houzheng-xiufu' },
    ],
  },
]
---

<Layout
  title="鞋服仓配与质检服务｜云仓、退货修复、数字化系统｜新亦源"
  description="新亦源供应链围绕鞋服仓配中心、鞋服质检中心和商圈寄件平台“运到”提供三大核心服务，并以OTD物流服务中台为底座，由物流网关、WMS、LMS、人效通、发货时效监控、轨迹与签收监控六大模块支撑全链路数字化运营。"
  jsonLd={[breadcrumbSchema, ...serviceSchemas]}
  services={SERVICES}
>
  <!-- Hero -->
  <section class="relative py-16 lg:py-28 overflow-hidden" aria-labelledby="product-hero-heading">
    <!-- 背景大图 -->
    <img
      src="/w-flower.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <!-- 遮罩：左深右透，确保文字可读 -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(105deg, rgba(8,20,42,0.95) 0%, rgba(8,20,42,0.80) 40%, rgba(8,20,42,0.50) 70%, rgba(8,20,42,0.25) 100%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-brand-orange font-semibold text-sm tracking-wider uppercase mb-3">产品服务</p>
      <p class="text-[0.8rem] font-bold tracking-[0.05em] text-brand-orange mb-2">新亦源供应链</p>
      <h1
        id="product-hero-heading"
        class="text-4xl lg:text-5xl font-black text-white leading-tight mb-5"
      >
        鞋服仓配、质检修复<br />
        <span class="text-brand-orange">与物流数字化服务</span>
      </h1>
      <p class="text-lg text-navy-100 max-w-2xl leading-relaxed mb-10">
        从入库质检到出库发货，从正向仓配到逆向退货，新亦源以三大核心服务和数字化系统能力支撑鞋服品牌全链路需求。
      </p>
      <!-- 产品快速导航 -->
      <div class="flex flex-wrap gap-3">
        {
          NAV_ITEMS.map(({ id, label }) => (
            <a
              href={`#${id}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/20 text-white/80 hover:border-brand-orange hover:text-brand-orange text-sm font-medium transition-colors"
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 供应链服务编排台 -->
  <section
    id="cloud-warehouse"
    class="orchestration-section scroll-mt-28"
    aria-labelledby="orchestration-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="section-intro section-intro--split">
        <div>
          <p class="section-kicker">SERVICE ORCHESTRATION / 01</p>
          <h2 id="orchestration-heading">不是服务清单，是一套供应链编排台</h2>
        </div>
        <p class="section-lead">
          品牌只需要给出货品、渠道、区域和时效要求，新亦源把仓内、质检、物流与数据能力编排成一条连续作业链。
          三个服务中枢不是彼此割裂的产品，而是围绕同一件商品接力工作。
        </p>
      </header>

      <div class="hub-register" aria-label="三大服务中枢">
        {
          SERVICE_HUBS.map(({ index, name, role, scope }) => (
            <article class="hub-register__item">
              <div class="hub-register__head">
                <span>{index}</span>
                <strong>{name}</strong>
              </div>
              <p>{role}</p>
              <small>{scope}</small>
            </article>
          ))
        }
      </div>

      <div class="orchestration-console">
        <div class="console-meta">
          <span>FULL-CHAIN CONTROL</span>
          <span>从货品进入仓库，到经营数据重新回到决策端</span>
        </div>
        <div class="orchestration-rail" role="list" aria-label="供应链五段编排轨道">
          {
            ORCHESTRATION_STEPS.map(({ index, title, detail }) => (
              <div class="rail-stop" role="listitem">
                <span class="rail-stop__index">{index}</span>
                <span class="rail-stop__node" aria-hidden="true" />
                <strong>{title}</strong>
                <small>{detail}</small>
              </div>
            ))
          }
        </div>
        <div class="console-foot">
          <p>
            <span>履约基准</span>
            <strong>{CLAIM_TEXT.shippingSla}</strong>
          </p>
          <p>
            <span>逆向基准</span>
            <strong>退货质检与二次上架{CLAIM_TEXT.returnTurnaround}</strong>
          </p>
          <p>
            <span>准确率</span>
            <strong>{CLAIM_TEXT.shippingAccuracy}</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 正向与逆向双链 -->
  <section
    id="quality-inspection"
    class="chain-section scroll-mt-28"
    aria-labelledby="dual-chain-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="section-intro">
        <p class="section-kicker">DUAL FLOW / 02</p>
        <h2 id="dual-chain-heading">一条链把货发出去，另一条链把库存价值带回来</h2>
        <p class="section-lead">
          正向履约与逆向退货共用商品档案、库存状态和作业数据，减少“发货是一套系统、退货又是另一套流程”的信息断点。
        </p>
      </header>

      <div class="flow-lanes">
        <article class="flow-lane flow-lane--forward">
          <header>
            <div>
              <span class="flow-lane__index">A</span>
              <h3>正向履约链</h3>
            </div>
            <p>FORWARD FULFILLMENT</p>
          </header>
          <div class="flow-lane__scroll">
            <ol>
              {
                FORWARD_CHAIN.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{item}</strong>
                  </li>
                ))
              }
            </ol>
          </div>
        </article>

        <article class="flow-lane flow-lane--reverse">
          <header>
            <div>
              <span class="flow-lane__index">B</span>
              <h3>逆向价值链</h3>
            </div>
            <p>REVERSE VALUE RECOVERY</p>
          </header>
          <div class="flow-lane__scroll">
            <ol>
              {
                REVERSE_CHAIN.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{item}</strong>
                  </li>
                ))
              }
            </ol>
          </div>
        </article>
      </div>

      <div class="chain-note">
        <span>同一件商品</span>
        <p>订单状态、质检结果、修复记录、库存状态与物流轨迹可以沿链路持续衔接。</p>
      </div>
    </div>
  </section>

  <!-- 真实场景剧场 -->
  <section class="scene-section" aria-labelledby="scene-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="section-intro section-intro--split">
        <div>
          <p class="section-kicker">OPERATION THEATRE / 03</p>
          <h2 id="scene-heading">从仓库全景，到一个针脚的修复现场</h2>
        </div>
        <p class="section-lead">
          页面中的能力最终要落到真实作业现场：货位是否清楚、质检动作是否规范、修复工位是否专业、数据能否回到同一套管理界面。
        </p>
      </header>

      <div class="scene-theatre">
        {
          SCENE_FRAMES.map(({ src, alt, eyebrow, title, desc, className }) => (
            <figure class={className}>
              <img src={src} alt={alt} loading="lazy" />
              <figcaption>
                <span>{eyebrow}</span>
                <strong>{title}</strong>
                <p>{desc}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 数字控制塔 -->
  <section id="logistics-cloud" class="tower-section scroll-mt-28" aria-labelledby="tower-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="section-intro section-intro--split">
        <div>
          <p class="section-kicker">DIGITAL CONTROL TOWER / 04</p>
          <h2 id="tower-heading">让订单、库存、人员与物流处在同一张图上</h2>
        </div>
        <p class="section-lead">
          OTD物流服务中台连接仓内WMS、物流LMS、承运商与运营监控。系统能力不单独悬空展示，而是直接服务每个作业节点。
        </p>
      </header>

      <div class="tower-layout">
        <figure class="device-shell">
          <div class="device-shell__bar">
            <span></span><span></span><span></span>
            <small>XYYS · OPERATIONS DASHBOARD</small>
          </div>
          <div class="device-shell__screen">
            <img
              src="/images/services/operations-dashboard.webp"
              alt="新亦源供应链数字运营控制塔界面"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>实时状态汇集</span>
            <p>多仓库存、订单节点、发货时效与物流轨迹按项目接入范围统一呈现。</p>
          </figcaption>
        </figure>

        <div class="tower-modules" role="list" aria-label="六大数字系统模块">
          {
            DIGITAL_MODULES.map(({ index, name, desc }) => (
              <div class="tower-module" role="listitem">
                <span>{index}</span>
                <strong>{name}</strong>
                <p>{desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="tower-protocol">
        <p><span>承运商</span><strong>已对接顺丰、京东、EMS等11家主流承运商</strong></p>
        <p><span>接口方式</span><strong>可采用奇门、EDI、API或项目定制接口</strong></p>
        <p><span>系统费用</span><strong>不收系统使用费，实施与定制等费用按方案确认</strong></p>
      </div>
    </div>
  </section>

  <!-- 运到与服务目录 -->
  <section
    id="yundao-platform"
    class="directory-section scroll-mt-28"
    aria-labelledby="directory-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="yundao-band">
        <div class="yundao-band__identity">
          <span>产品三 · 商圈物流 O2O</span>
          <h2>运到智能寄件平台</h2>
          <p>把门店寄件、调拨、退仓与多承运商订单放进一个统一入口。</p>
        </div>
        <div class="yundao-band__visual">
          <img src="/w-yundao.webp" alt="运到智能寄件平台界面" loading="lazy" />
        </div>
        <div class="yundao-band__facts">
          <p><strong>11家</strong><span>主流承运商</span></p>
          <p><strong>正向 + 逆向</strong><span>门店寄件场景</span></p>
          <p><strong>实时</strong><span>轨迹与异常工单</span></p>
        </div>
      </div>

      <header class="section-intro section-intro--split directory-heading">
        <div>
          <p class="section-kicker">SERVICE DIRECTORY / 05</p>
          <h2 id="directory-heading">按区域、渠道与品类进入服务目录</h2>
        </div>
        <p class="section-lead">
          同一套能力会因库存位置、销售渠道与商品属性而采用不同编排方式，选择最接近当前业务的入口即可。
        </p>
      </header>

      <dl class="service-directory">
        {
          SERVICE_DIRECTORY.map(({ axis, en, items }) => (
            <div class="directory-row">
              <dt>
                <small>{en}</small>
                <strong>{axis}</strong>
              </dt>
              <dd>
                {items.map(({ label, href }) => (
                  <a href={href}>
                    <span>{label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <PageFAQ
    heading="产品服务常见问题"
    layout="stacked"
    items={[
      {
        q: '新亦源鞋服云仓的最小起储量是多少？',
        a: '新亦源没有固定最小起储量门槛，以实际货量、SKU复杂度和仓点匹配情况为准。中小品牌可从单品类、单仓点开始合作，随业务增长逐步扩展。具体方案建议联系商务团队评估。',
      },
      {
        q: '系统如何与品牌现有ERP/OMS对接？',
        a: '新亦源OTD中台及物流网关可采用奇门、EDI、API或客户定制接口，已对接百胜E3、聚水潭、伯俊、吉客云、丽晶、浪潮、恒康等主流ERP。具体支持范围、授权条件、字段和联调周期由双方确认；不收系统使用费，实施、接口联调、定制开发和其他服务费用按方案确认。',
      },
      {
        q: '大促备战期间，新亦源如何提前锁定峰值产能？',
        a: '新亦源的大促产能锁定分三阶段执行：大促前21天提交货量预测模型，与品牌对齐日发货量目标；大促前14天完成仓内货位扩容、波次排班计划和弹性人力到岗安排；大促前72小时完成最后压测，确认系统稳定和全链路时效。大促期间的订单处理、库存准确和异常处置指标不设置统一口径，由双方根据预测货量和资源方案在项目SLA中确认。',
      },
      {
        q: '鞋服WMS如何防止高SKU货品发错码号或颜色？',
        a: `新亦源通过三重流程管理款色码：入库与上架环节以RFID或条码绑定SKU；拣货环节由电子标签引导，并在识别异常时停止流转；复核台在发货前逐包扫码并比对订单清单。当前公开的发货准确率为${CLAIM_TEXT.shippingAccuracy}。`,
      },
      {
