---
import Layout from '@/layouts/Layout.astro'
import ProductVideoSequence from '@/components/product/ProductVideoSequence.astro'
import { BRAND } from '@/lib/brand'

const serviceSchemas = [
  {
    id: 'foundation',
    name: '基础仓配',
    description: '鞋服商品的入库质检、仓储管理、订单履约与系统平台对接服务。',
    url: '/xiefu-yuncang',
  },
  {
    id: 'returns',
    name: '退货与逆向处理',
    description: '鞋服退货拆包、质检分类、二次上架、退供应商与整批退仓服务。',
    url: '/tuihuo-zhijian',
  },
  {
    id: 'product-care',
    name: '商品整理与增值处理',
    description: '换标、包装、整烫、清洁与轻微瑕疵处理等鞋服商品整理服务。',
    url: '/houzheng-xiufu',
  },
].map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${BRAND.url}/product#${service.id}`,
  name: service.name,
  description: service.description,
  provider: { '@type': 'Organization', '@id': `${BRAND.url}/#organization`, name: BRAND.fullName },
  areaServed: { '@type': 'Country', name: '中国' },
  url: `${BRAND.url}${service.url}`,
}))

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '仓配服务', item: `${BRAND.url}/product` },
  ],
}
---

<Layout
  title="仓配服务｜鞋服仓储、退货处理、商品整理与增值处理｜新亦源"
  description="新亦源为鞋服品牌提供基础仓配、退货与逆向处理、商品整理与增值处理、轻微瑕疵处理等覆盖商品全生命周期的仓配服务。"
  jsonLd={[breadcrumbSchema, ...serviceSchemas]}
  showFooter={false}
  showFloatingContact={false}
>
  <ProductVideoSequence />
</Layout>
