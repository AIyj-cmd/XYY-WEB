  .series-spread li a:hover { color:var(--accent); transform:translateX(2px); }
  .series-spread li a:hover span { opacity:1; transform:none; }

  /* 参考图样式仅用于基础仓配模块，顶部区域与其余服务模块保持不变。 */
  .series-spread--foundation { overflow:hidden; border-radius:0 .9rem .9rem 0; background:#fbfbfa; }
