---
import Layout from '@/layouts/Layout.astro'
import ProductServiceDirectory from '@/components/product/ProductServiceDirectory.astro'
import ProductServiceSeries from '@/components/product/ProductServiceSeries.astro'
import ProductCare from '@/components/product/ProductCare.astro'
import ProductServiceProcess from '@/components/product/ProductServiceProcess.astro'
import ProductAssurance from '@/components/product/ProductAssurance.astro'
import '@/styles/product.css'
import { DIRECTORY_NEEDS } from '@/data/product'
import { BRAND } from '@/lib/brand'

const serviceSchemas = [
  {
    id: 'foundation',
    name: '基础仓配',
    description: '鞋服商品的入库质检、仓储管理、订单履约与系统平台对接服务。',
    url: '/xiefu-yuncang',
  },
  {
    id: 'returns',
    name: '退货与逆向处理',
    description: '鞋服退货拆包、质检分类、二次上架、退供应商与整批退仓服务。',
    url: '/tuihuo-zhijian',
  },
  {
    id: 'product-care',
    name: '商品整理与增值处理',
    description: '换标、包装、整烫、清洁与轻微瑕疵处理等鞋服商品整理服务。',
    url: '/houzheng-xiufu',
  },
].map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${BRAND.url}/product#${service.id}`,
  name: service.name,
  description: service.description,
  provider: { '@type': 'Organization', '@id': `${BRAND.url}/#organization`, name: BRAND.fullName },
  areaServed: { '@type': 'Country', name: '中国' },
  url: `${BRAND.url}${service.url}`,
}))

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '仓配服务', item: `${BRAND.url}/product` },
  ],
}
---

<Layout
  title="仓配服务｜鞋服仓储、退货处理、商品整理与增值处理｜新亦源"
  description="新亦源为鞋服品牌提供基础仓配、退货与逆向处理、商品整理与增值处理、轻微瑕疵处理等覆盖商品全生命周期的仓配服务。"
  jsonLd={[breadcrumbSchema, ...serviceSchemas]}
>
  <div class="warehouse-services-page">
    <section class="warehouse-hero" aria-labelledby="warehouse-hero-heading">
      <figure class="warehouse-hero__visual">
        <picture>
          <source
            media="(min-width: 768px)"
            srcset="/images/services/warehouse-product-1800.webp 1800w"
            sizes="100vw"
          />
          <img
            src="/images/services/warehouse-product-1800.webp"
            srcset="/images/services/warehouse-product-1800.webp 1800w"
            sizes="100vw"
            alt="新亦源鞋服挂装商品仓储现场"
            width="1800"
            height="1350"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
        <figcaption>鞋服商品仓内管理现场</figcaption>
      </figure>
      <div class="warehouse-shell">
        <header class="warehouse-hero__copy">
          <p class="kicker">WAREHOUSING SERVICES</p>
          <h1 id="warehouse-hero-heading">仓配服务</h1>
          <h2>不只是<span>存储和发货</span>。</h2>
          <p>
            新亦源围绕鞋服商品的入库、仓储、履约、退货和整理，提供从基础仓配到精细化商品处理的一体化服务。
          </p>
          <div class="warehouse-hero__actions">
            <a class="primary-link" href="#service-series"
              >浏览全部服务 <span aria-hidden="true">→</span></a
            >
            <a class="secondary-link" href="/contact"
              >咨询仓配方案 <span aria-hidden="true">↗</span></a
            >
          </div>
        </header>
      </div>
    </section>

    <ProductServiceSeries />

    <ProductServiceDirectory needs={DIRECTORY_NEEDS} />

    <ProductCare />

    <ProductServiceProcess />

    <ProductAssurance />

    <section class="warehouse-cta" aria-labelledby="warehouse-cta-heading">
      <div class="warehouse-shell warehouse-cta__inner">
        <div class="warehouse-cta__message" data-reveal="copy">
          <p class="kicker">START A CONVERSATION</p><h2 id="warehouse-cta-heading">
            需要的不只是<br />一个仓库？
          </h2><p>告诉我们你的商品类型、订单规模和当前问题，新亦源将根据实际业务提供仓配建议。</p><a
            class="primary-link"
            href="/contact">提交仓配需求 <span aria-hidden="true">→</span></a
          >
        </div>
        <aside aria-label="沟通前可准备的信息" data-reveal="copy">
          <p>沟通前可准备这 3 类信息</p>
          <ol>
            <li><strong>商品与渠道</strong><span>商品类型 · 主要销售平台</span></li>
            <li><strong>业务规模</strong><span>日均单量 · SKU 与库存规模</span></li>
            <li><strong>处理需求</strong><span>退货处理 · 增值服务</span></li>
          </ol>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@/scripts/product-loader'
</script>
