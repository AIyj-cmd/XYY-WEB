    .section-heading h2,.needs-intro h2,.care-heading h2,.process-heading h2,.assurance-heading h2,.warehouse-cta h2 { font-size:2.65rem; }
    .series-intro { display:block; margin-bottom:3.8rem; }
    .series-intro__copy { padding-bottom:0; }
    .series-intro h2 { font-size:2.75rem; }
    .series-intro__divider { margin-top:1.7rem; }
    .series-intro__explore { margin-top:2.4rem; }
