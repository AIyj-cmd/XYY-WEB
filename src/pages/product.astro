---
import Layout from '@/layouts/Layout.astro'
import { BRAND, SERVICE_FACTS } from '@/lib/brand'
import { getServices } from '@/lib/directus'

const SERVICES = await getServices()

const serviceSchemas = [
  { id: 'foundation', name: '基础仓配', description: '鞋服商品的入库质检、仓储管理、订单履约与系统平台对接服务。', url: '/xiefu-yuncang' },
  { id: 'returns', name: '退货与逆向处理', description: '鞋服退货拆包、质检分类、二次上架、退供应商与整批退仓服务。', url: '/tuihuo-zhijian' },
  { id: 'product-care', name: '商品整理与增值处理', description: '换标、包装、整烫、清洁与轻微瑕疵处理等鞋服商品整理服务。', url: '/houzheng-xiufu' },
].map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${BRAND.url}/product#${service.id}`,
  name: service.name,
  description: service.description,
  provider: { '@type': 'Organization', '@id': `${BRAND.url}/#organization`, name: BRAND.fullName },
  areaServed: { '@type': 'Country', name: '中国' },
  url: `${BRAND.url}${service.url}`,
}))

const SERVICE_SERIES = [
  {
    id: 'foundation', number: '01', eyebrow: 'FOUNDATION FULFILLMENT', title: '基础仓配',
    description: '适合需要稳定完成入库、仓储、拣货、复核、打包和发货的鞋服品牌。',
    steps: null,
    services: [
      ['入库质检', '/tuihuo-zhijian'],
      ['仓储管理', '/product#foundation'],
      ['订单履约', '/xiefu-yuncang'],
      ['系统与平台对接', '/product#assurance'],
    ],
    image: '/images/services/inspection-workbench.webp', alt: '新亦源鞋服入库质检与作业工作台', href: '/xiefu-yuncang', link: '查看基础仓配服务',
  },
  {
    id: 'returns', number: '02', eyebrow: 'RETURNS & REVERSE LOGISTICS', title: '退货与逆向处理',
    description: '退回来的商品，我们进行拆包、验收、分类与评估，并根据商品状态提供二次上架、退供应商或其他处理方案，实现高效、合规的逆向物流闭环。',
    steps: [
      ['退货接收', '与登记'],
      ['商品状态', '判断'],
      ['分类处理', '与决策'],
      ['二次上架或', '退件处理'],
    ],
    services: [
      ['退货接收与质检', '/tuihuo-zhijian'],
      ['二次上架', '/product#returns'],
      ['退回供应商', '/product#returns'],
      ['整批退仓', '/product#returns'],
    ],
    image: '/images/services/return-inspection-operator.jpg', alt: '新亦源工作人员处理鞋服退货商品', href: '/tuihuo-zhijian', link: '查看退货处理服务',
  },
  {
    id: 'care', number: '03', eyebrow: 'PRODUCT CARE', title: '商品整理与增值处理',
    description: '根据商品状态，提供标签更换、包装升级、蒸汽熨烫、外观整理、轻微瑕疵处理及组合加工等精细化服务，提升商品呈现，助力销售转化。',
    steps: null,
    services: [
      ['换标与包装', '/product#product-care'],
      ['熨烫与外观整理', '/product#product-care'],
      ['轻微瑕疵处理', '/product#product-care'],
      ['组合加工', '/product#product-care'],
    ],
    image: '/images/services/quality-inspection-operator.jpg', alt: '新亦源工作人员进行鞋服商品整理与检查', href: '/houzheng-xiufu', link: '查看商品整理与增值处理',
  },
] as const

const BUSINESS_NEEDS = [
  { id: 'inbound', number: '01', title: '新品到仓，需要清点和质检', service: '入库质检', description: '对到货商品进行清点与质检，确保数量准确、质量合格并完成信息登记。', checks: ['到货清点与数量核对', '外观与质量检测', '商品信息登记与系统录入', '异常商品记录与处理'], image: '/images/services/warehouse-panorama.webp', alt: '新亦源鞋服商品入库质检作业区' },
  { id: 'inventory', number: '02', title: 'SKU多，库存容易混乱', service: '仓储管理', description: '按款色码、货位和渠道管理库存，并保持商品状态可查。', checks: ['商品分类与货位管理', '库存状态实时可查', '多SKU精准盘点', '库存异常及时预警'], image: '/images/services/warehouse-shelves.webp', alt: '新亦源多SKU商品分类货位' },
  { id: 'fulfillment', number: '03', title: '订单量波动大，需要稳定履约', service: '订单履约', description: '通过拣货、复核、打包与发运协同，承接日常及大促订单。', checks: ['订单拣货与复核', '打包与发运协同', '多平台订单同步', '出库状态及时回传'], image: '/images/services/warehouse-fulfillment-actual.jpg', alt: '新亦源仓内订单履约作业现场' },
  { id: 'returns', number: '04', title: '退货积压，处理速度跟不上', service: '退货质检与二次上架', description: '将拆包、质检、分类和后续处置拆成清晰的逆向路径。', checks: ['退货拆包与登记', '商品状态快速判断', '可售商品二次上架', '异常商品分流处理'], image: '/images/services/inspection-unpack.webp', alt: '新亦源退货拆包处理现场' },
  { id: 'restock', number: '05', title: '退回商品需要重新整理和上架', service: '二次质检与二次上架', description: '先判断商品状态，再决定整理、复核、上架或其他处置。', checks: ['商品状态复核', '外观整理与复原', '信息更新与重新上架', '处理结果可追溯'], image: '/images/services/inspection-sort.webp', alt: '新亦源服饰质检分类作业现场' },
  { id: 'care', number: '06', title: '商品需要换标、换包装或简单修复', service: '商品整理与增值处理', description: '围绕品牌标准执行标签、包装、外观整理和轻微修复。', checks: ['标签与条码处理', '包装更换与组合', '轻微瑕疵处理', '品牌标准可配置'], image: '/images/services/garment-repair-stitching.jpg', alt: '新亦源服饰轻微瑕疵处理现场' },
  { id: 'transfer', number: '07', title: '过季库存需要退回或转仓', service: '整批退仓', description: '按清点、核验、交接与数据回传要求处理整批商品流转。', checks: ['数量清点与核验', '批次整理与交接', '转仓运输协同', '数据结果回传'], image: '/images/services/warehouse-aisle-202.jpg', alt: '新亦源仓内鞋服库存通道' },
] as const

const DIRECTORY_NEEDS = BUSINESS_NEEDS.slice(0, 6)

const CARE_CATEGORIES = [
  { number: '01', title: '标签处理', description: '换吊牌、洗水标、领标、条码及防伪标签' },
  { number: '02', title: '外观整理', description: '熨烫、除皱、折叠、除尘和简单清洁' },
  { number: '03', title: '包装处理', description: '换袋、换盒、重新包装、赠品及物料放入' },
  { number: '04', title: '轻微修复', description: '剪线头、补扣、简单开线和包装破损处理' },
] as const

const SERVICE_FLOW = [
  ['01', '需求确认', '确认商品类型、处理范围和质量标准。'],
  ['02', '商品到仓', '完成签收、清点和基础信息登记。'],
  ['03', '质检分类', '判断商品进入上架、整理、修复、退回或报废流程。'],
  ['04', '执行处理', '按照品牌标准完成对应操作。'],
  ['05', '结果复核', '复核数量、质量和处理结果。'],
  ['06', '数据反馈', '将处理结果回传并完成后续入库、发货或退回。'],
] as const

const ASSURANCE_POINTS = [
  { value: `${SERVICE_FACTS.inventoryAccuracy}+`, label: '库存准确率', note: '数据准，货位与状态持续管理' },
  { value: SERVICE_FACTS.orderPickupCutoff, label: '日常订单截单时间', note: '以项目约定的订单规则执行' },
  { value: `${SERVICE_FACTS.orderDispatchDeadline}前`, label: '符合条件订单当日发出', note: '具体以合作方案与订单条件为准' },
  { value: '全流程', label: '商品状态可追踪', note: '从入仓到交付，关键节点可追踪' },
] as const

const ASSURANCE_MECHANISMS = [
  { title: '标准流程作业', note: 'SOP规范执行，保持服务一致性', icon: 'standard' },
  { title: '多重质检机制', note: '关键环节质检，降低错误风险', icon: 'check' },
  { title: '系统记录留存', note: '全流程记录可查，追溯可回看', icon: 'record' },
  { title: '异常快速响应', note: '异常识别与处置，及时闭环', icon: 'alert' },
  { title: '持续改进优化', note: '基于数据与反馈，持续迭代', icon: 'improve' },
] as const

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: BRAND.url },
    { '@type': 'ListItem', position: 2, name: '仓配服务', item: `${BRAND.url}/product` },
  ],
}
---

<Layout
  title="仓配服务｜鞋服仓储、退货处理、商品整理与增值处理｜新亦源"
  description="新亦源为鞋服品牌提供基础仓配、退货与逆向处理、商品整理与增值处理、轻微瑕疵处理等覆盖商品全生命周期的仓配服务。"
  jsonLd={[breadcrumbSchema, ...serviceSchemas]}
  services={SERVICES}
>
  <div class="warehouse-services-page">
    <section class="warehouse-hero" aria-labelledby="warehouse-hero-heading">
      <figure class="warehouse-hero__visual" data-reveal="image">
        <img src="/images/services/warehouse-hanging.webp" alt="新亦源鞋服挂装商品仓储现场" width="1800" height="1350" loading="eager" />
        <figcaption>鞋服商品仓内管理现场</figcaption>
      </figure>
      <div class="warehouse-shell">
        <header class="warehouse-hero__copy" data-reveal="copy">
          <p class="kicker">WAREHOUSING SERVICES</p>
          <h1 id="warehouse-hero-heading">仓配服务</h1>
          <h2>不只是<span>存储和发货</span>。</h2>
          <p>新亦源围绕鞋服商品的入库、仓储、履约、退货和整理，提供从基础仓配到精细化商品处理的一体化服务。</p>
          <div class="warehouse-hero__actions">
            <a class="primary-link" href="#service-series">浏览全部服务 <span aria-hidden="true">→</span></a>
            <a class="secondary-link" href="/contact">咨询仓配方案 <span aria-hidden="true">↗</span></a>
          </div>
        </header>
      </div>
    </section>

    <section id="service-series" class="service-series" aria-labelledby="series-heading">
      <div class="warehouse-shell">
        <header class="series-intro">
          <div class="series-intro__copy" data-reveal="copy">
            <p class="kicker">SERVICE SERIES</p>
            <span class="series-intro__rule" aria-hidden="true"></span>
            <h2 id="series-heading">按照商品状态，<br />配置对应的仓配能力<span aria-hidden="true">。</span></h2>
            <div class="series-intro__divider" aria-hidden="true"></div>
            <p>从稳定履约到逆向处理，三组服务对应鞋服商品在仓内最常见的工作状态。</p>
            <a class="series-intro__explore" href="#foundation"><span aria-hidden="true">↓</span>探索完整服务</a>
          </div>
          <div class="series-intro__collage" data-reveal="image">
            <figure class="series-intro__main-image"><img src="/images/services/inspection-wide.webp" alt="新亦源鞋服商品批量质检与分类作业现场" width="1920" height="1080" loading="lazy" /></figure>
            <span class="series-intro__vertical-label">WAREHOUSING &amp; FULFILLMENT</span>
            <span class="series-intro__vertical-mark" aria-hidden="true"></span>
          </div>
        </header>

        <div class="series-list">
          {SERVICE_SERIES.map(({ id, number, eyebrow, title, description, services, steps, image, alt, href, link }, index) => (
            <article id={id} class:list={['series-spread', { 'series-spread--reverse': index === 1, 'series-spread--foundation': index === 0, 'series-spread--returns': id === 'returns', 'series-spread--care': id === 'care' }]}>
              {id === 'care' ? (
                <div class="series-spread__care-gallery">
                  <figure class="series-spread__care-gallery-main" data-reveal="image"><img src="/images/services/repair-ironing.webp" alt="新亦源工作人员进行鞋服整烫与整理" width="1512" height="747" loading="lazy" /><figcaption>商品整理与增值处理</figcaption></figure>
                  <div class="series-spread__care-gallery-thumbs">
                    <figure data-reveal="image"><img src="/images/services/rfid-tag.webp" alt="鞋服标签更换" width="800" height="600" /><figcaption>标签更换</figcaption></figure>
                    <figure data-reveal="image"><img src="/images/services/garment-ironing.jpg" alt="鞋服蒸汽熨烫" width="800" height="600" /><figcaption>蒸汽熨烫</figcaption></figure>
                    <figure data-reveal="image"><img src="/images/services/garment-repair-stitching.jpg" alt="鞋服轻微修补" width="800" height="600" /><figcaption>轻微修补</figcaption></figure>
                    <figure data-reveal="image"><img src="/images/services/garment-repair-finishing.jpg" alt="鞋服精致包装" width="800" height="600" /><figcaption>精致包装</figcaption></figure>
                  </div>
                </div>
              ) : (
                <figure class="series-spread__image" data-reveal="image"><img src={image} alt={alt} width="1920" height="1080" loading="lazy" /><figcaption>{number} / {eyebrow}</figcaption></figure>
              )}
              <div class="series-spread__copy" data-reveal="copy">
                <div class="series-spread__meta"><p class="series-spread__number">{number}</p><p class="series-spread__eyebrow">{eyebrow}</p></div>
                <h3>{title}</h3>
                <p>{description}</p>
                {id === 'returns' && steps && <div class="series-spread__steps">
                  {steps.map(([stepTitle, stepSubtitle], stepIndex) => <div class="series-spread__step"><span>{String(stepIndex + 1).padStart(2, '0')}</span><i aria-hidden="true"></i><strong>{stepTitle}<br />{stepSubtitle}</strong></div>)}
                </div>}
                {id !== 'returns' && <ul>{services.map(([item, itemHref], serviceIndex) => <li><a href={itemHref}>
                  {(index === 0 || id === 'care') && <span class="series-spread__service-icon" aria-hidden="true">
                    {serviceIndex === 0 && <svg viewBox="0 0 24 24" fill="none"><path d="m5 8 7-4 7 4v10l-7 4-7-4V8Z" stroke="currentColor" stroke-width="1.5"/><path d="m5 8 7 4 7-4M12 12v10" stroke="currentColor" stroke-width="1.5"/></svg>}
                    {serviceIndex === 1 && <svg viewBox="0 0 24 24" fill="none"><path d="M4 7.5h16M4 12h16M4 16.5h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M6 4.5h12v15H6z" stroke="currentColor" stroke-width="1.5"/></svg>}
                    {serviceIndex === 2 && <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>}
                    {serviceIndex === 3 && <svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>}
                  </span>}
                  <span>{item}</span><span aria-hidden="true">→</span>
                </a></li>)}</ul>}
                <a href={href} class="secondary-link">{link} <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="service-directory" class="needs-section" aria-labelledby="needs-heading">
      <div class="warehouse-shell needs-layout">
        <header class="needs-intro" data-reveal="copy"><p class="kicker">SERVICE DIRECTORY</p><span class="needs-intro__rule" aria-hidden="true"></span><h2 id="needs-heading">你现在需要<br />解决什么问题？</h2><p>从业务痛点出发，找到对应的仓配服务方案，精准匹配您的需求，让仓储与履约更高效、更安心。</p><div class="needs-intro__watermark" aria-hidden="true"><strong>56</strong><span>FASHION<br />WAREHOUSE<br />EXPERT</span></div></header>
          <div class="needs-directory" data-need-directory>
            <div class="needs-directory__list" role="tablist" aria-label="按业务问题选择服务">
            {DIRECTORY_NEEDS.map(({ id, number, title, service }, index) => <button id={`need-tab-${id}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`need-panel-${id}`} tabindex={index === 0 ? 0 : -1} data-need-tab={id} data-reveal="copy"><span>{number}</span><strong>{title}</strong><em>{service}</em><i aria-hidden="true">→</i></button>)}
          </div>
          <div class="needs-directory__visuals" data-reveal="image">
            {DIRECTORY_NEEDS.map(({ id, service, description, checks, image, alt }, index) => <article id={`need-panel-${id}`} role="tabpanel" aria-labelledby={`need-tab-${id}`} data-need-panel={id} hidden={index !== 0}><figure><img src={image} alt={alt} width="1600" height="1000" loading="lazy" /></figure><div><p class="needs-panel__current">当前服务</p><h3>{service}</h3><p class="needs-panel__description">{description}</p><ul>{checks.map((check) => <li>{check}</li>)}</ul></div></article>)}
          </div>
        </div>
      </div>
    </section>

    <section id="product-care" class="care-section" aria-labelledby="care-heading">
      <div class="warehouse-shell">
        <header class="care-heading" data-reveal="copy"><div><p class="kicker">PRODUCT CARE / 重点能力</p><h2 id="care-heading">商品整理与轻微瑕疵处理</h2></div><p>根据商品状态和品牌标准，完成标签、外观、包装及轻微瑕疵处理。并不是所有退回或存在轻微问题的商品都需要报废，经过判断、整理和修复，部分商品可以重新进入销售流程。</p></header>
        <div class="care-stage">
          <figure class="care-stage__main" data-reveal="image"><img src="/images/services/garment-cleaning.jpg" alt="新亦源工作人员进行服饰表面清洁" width="1707" height="1280" loading="lazy" /><figcaption>表面清洁与商品整理</figcaption></figure>
          <figure class="care-stage__top" data-reveal="image"><img src="/images/services/garment-ironing.jpg" alt="新亦源服饰整烫作业" width="1920" height="1080" loading="lazy" /><figcaption>整烫除皱</figcaption></figure>
          <figure class="care-stage__bottom" data-reveal="image"><img src="/images/services/garment-repair-finishing.jpg" alt="新亦源工作人员进行服饰瑕疵处理" width="960" height="1200" loading="lazy" /><figcaption>轻微瑕疵处理</figcaption></figure>
        </div>
        <div class="care-stage__caption" data-reveal="copy"><p><span>处理边界</span>轻微瑕疵需先完成状态判断，再根据商品材质和品牌标准确认处理方式。</p><a href="/houzheng-xiufu" class="secondary-link">查看后整修复服务 <span aria-hidden="true">→</span></a></div>
        <div class="care-categories">
          {CARE_CATEGORIES.map(({ number, title, description }) => <article data-reveal="copy"><span>{number}</span><h3>{title}</h3><p>{description}</p></article>)}
        </div>
      </div>
    </section>

    <section id="service-process" class="process-section" aria-labelledby="process-heading">
      <div class="warehouse-shell">
        <header class="process-heading" data-reveal="copy"><p class="kicker">HOW WE WORK</p><h2 id="process-heading">服务不是一条固定流水线，<br />而是一套清晰的处理规则。</h2></header>
        <ol class="editorial-process">
          {SERVICE_FLOW.map(([number, title, description]) => <li data-reveal="copy"><span>{number}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section id="assurance" class="assurance-section" aria-labelledby="assurance-heading">
      <div class="warehouse-shell">
        <header class="assurance-heading" data-reveal="copy">
          <div class="assurance-heading__intro">
            <p class="kicker">CAPABILITY & ASSURANCE</p>
            <p>从货品入仓到出库交付，每个环节都有标准、有记录、有反馈。<br />让服务过程透明可视，结果可复核，持续优化，始终如一。</p>
          </div>
          <h2 id="assurance-heading">让服务可以被看见、<br />被复核，也被持续改进。</h2>
        </header>
        <div class="assurance-grid">
