---
import ServiceLanding from '@/layouts/ServiceLanding.astro'
import SouthNetworkSection from '@/components/service/unique/SouthNetworkSection.astro'
import { CLAIM_TEXT } from '@/lib/claims'
---

<ServiceLanding
  title="华南鞋服云仓｜广州、东莞、佛山、肇庆仓网｜新亦源"
  description="新亦源华南鞋服云仓直营仓储30万㎡+，华南多仓布局覆盖广州、东莞、佛山、肇庆，支持B2C、B2B、全渠道库存协同及退货质检，具体启用仓点和线路方案由双方确认。"
  slug="huanan-xiefu-yuncang"
  variant="south-network"
  breadcrumbLabel="华南鞋服云仓"
  eyebrow="华南鞋服云仓 · 珠三角区域仓配"
  h1="华南鞋服云仓：广州、东莞、佛山、肇庆仓网"
  h1sub="华南区域库存与鞋服仓配协同"
  heroDesc="新亦源华南鞋服云仓直营仓储30万㎡+，华南多仓布局覆盖广州、东莞、佛山、肇庆，支持B2C、B2B、全渠道库存协同及退货质检。广州同城最快4小时；广东主要区域参考次日达；华南主要城市次日至两日；具体启用仓点、仓容和到达时效以项目方案及线路SLA为准。"
