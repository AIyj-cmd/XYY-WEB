---
import Layout from '@/layouts/Layout.astro'
import LogisticsDigitalChain from '@/components/digital/LogisticsDigitalChain.astro'
import LogisticsDigitalHero from '@/components/digital/LogisticsDigitalHero.astro'
import LogisticsDigitalModules from '@/components/digital/LogisticsDigitalModules.astro'
import LogisticsDigitalProof from '@/components/digital/LogisticsDigitalProof.astro'
import { createBreadcrumbSchema, createServiceSchema } from '@/lib/seo'
import '@/styles/logistics-digital.css'

const MODULES = [
  ['01', '订单协同', '统一接入平台、门店与企业订单，减少多系统切换。'],
  ['02', '库存状态', '按商品、货位与渠道回看库存和可售状态。'],
  ['03', '仓内作业', '连接收货、上架、拣货、复核、打包与出库节点。'],
  ['04', '物流履约', '汇总运单、轨迹、签收和异常状态，方便跟进。'],
  ['05', '异常闭环', '保留识别、处理和反馈记录，形成可回看的路径。'],
  ['06', '接口配置', '支持奇门、EDI、API及按项目确认的定制接口。'],
] as const

const CHAIN = [
  ['订单进入', '平台、门店与业务系统订单统一进入履约队列。'],
  ['仓内执行', '库存、作业和复核状态随处理过程更新。'],
  ['物流回传', '运单、轨迹、签收和异常结果回到业务链路。'],
] as const

const breadcrumbSchema = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '产品服务', path: '/product' },
  { name: '物流数字化能力', path: '/wuliu-shuzihua' },
])

const serviceSchema = createServiceSchema({
  name: '物流数字化能力',
  description:
    '新亦源以物流服务中台连接订单、库存、仓内作业、物流轨迹与签收数据，为品牌提供可查询、可追溯的履约协同能力。',
  path: '/wuliu-shuzihua',
})
---

<Layout
  title="物流数字化能力｜订单、库存与履约协同"
  description="新亦源以物流服务中台连接订单、库存、仓内作业、物流轨迹与签收数据，为品牌提供可查询、可追溯的履约协同能力。"
  jsonLd={[breadcrumbSchema, serviceSchema]}
>
  <LogisticsDigitalHero />
  <LogisticsDigitalModules modules={MODULES} />
  <LogisticsDigitalChain steps={CHAIN} />
  <LogisticsDigitalProof />
</Layout>
