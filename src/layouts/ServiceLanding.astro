---
import ServiceSignature from '@/components/service/ServiceSignature.astro'
import ServiceLandingHero from '@/components/service/ServiceLandingHero.astro'
import ServiceExperience from '@/components/service/ServiceExperience.astro'
import FootwearPage from '@/components/service/footwear/FootwearPage.astro'
import RedesignServicePage from '@/components/service/redesign/RedesignServicePage.astro'
import { isRedesignPresentation } from '@/components/service/redesign/presentation'
import type { RedesignPresentation } from '@/components/service/redesign/presentation'
import Layout from '@/layouts/Layout.astro'
import { SPECIALTY_LINKS } from '@/data/navigation'
import { getServiceHeroMedia } from '@/data/service-hero-media'
import * as seo from '@/lib/seo'
import { type FaqItem, type ServiceVariant, type StatItem } from '@/data/service'
import { getFaqs, getServicePageContent } from '@/lib/directus'
import type { ServicePageContent } from '@/lib/directus-content-queries'
import { toEastPublicCopy } from '@/components/service/redesign/east-public-copy'
import { toLivePublicCopy } from '@/components/service/redesign/live-public-copy'
import { toSouthPublicCopy } from '@/components/service/redesign/south-public-copy'
import { toB2bPublicCopy } from '@/components/service/redesign/b2b-public-copy'
import { toFootwearPublicCopy } from '@/components/service/footwear/public-copy'
import { translateReviewedService } from '@/i18n/service-sources'
import { ENGLISH_SERVICE_SOURCES } from '@/i18n/service-source-catalog'
import { englishPathFor, type SiteLocale } from '@/i18n/routes'
import { getEnglishSiteSettings } from '@/i18n/site-settings'
interface Props extends ServicePageContent {
  variant: ServiceVariant
  slug: string
  stats: readonly StatItem[]
  faqs: FaqItem[]
  presentation?: 'classic' | 'footwear' | RedesignPresentation
  locale?: SiteLocale
}
const {
  variant,
  title,
  description,
  slug,
  breadcrumbLabel,
  eyebrow,
  h1,
  h1sub,
  heroDesc,
  imgSrc,
  imgAlt,
  stats,
  contentDesc,
  featuresLabel,
  features,
  faqs,
  presentation = 'classic',
  locale = 'zh-CN',
} = Astro.props
const localizedPath = locale === 'en' ? englishPathFor(`/${slug}`) : `/${slug}`
const content = await getServicePageContent(slug, {
  title,
  description,
  breadcrumbLabel,
  eyebrow,
  h1,
  h1sub,
  heroDesc,
  imgSrc,
  imgAlt,
  stats,
  contentDesc,
  featuresLabel,
  features,
})
const displayFaqs = await getFaqs(slug, faqs)
const publicCopy =
  slug === 'huanan-xiefu-yuncang' && presentation === 'south'
    ? toSouthPublicCopy(content, displayFaqs)
    : slug === 'huadong-xiefu-yuncang' && presentation === 'east'
      ? toEastPublicCopy(content, displayFaqs)
      : slug === 'zhibo-cangpei' && presentation === 'live'
        ? toLivePublicCopy(content, displayFaqs)
        : slug === 'b2b-mendian-cangpei' && presentation === 'b2b'
          ? toB2bPublicCopy(content, displayFaqs)
          : slug === 'xiefu-yuncang' && presentation === 'footwear'
            ? toFootwearPublicCopy(content, displayFaqs)
            : undefined
const displayContent = publicCopy?.content ?? content
const publicFaqs = publicCopy?.faqs ?? displayFaqs
const english =
  locale === 'en' && ENGLISH_SERVICE_SOURCES[slug]
    ? translateReviewedService(ENGLISH_SERVICE_SOURCES[slug], content, displayFaqs)
    : undefined
const visibleContent = english?.content ?? displayContent
const visibleFaqs = english?.faqs ?? publicFaqs
const hasVisibleClassicContent = locale !== 'en' || Boolean(visibleContent.h1)
const uniqueClass = ['service-unique', `service-unique--${variant}`]
const breadcrumbSchema = seo.createBreadcrumbSchema([
  { name: locale === 'en' ? 'Home' : '首页', path: locale === 'en' ? '/en' : '/' },
  {
    name: locale === 'en' ? 'Services' : '产品服务',
    path: locale === 'en' ? '/en/services' : '/product',
  },
  { name: visibleContent.breadcrumbLabel, path: localizedPath },
])
const serviceSchema = seo.createServiceSchema({
  name: visibleContent.h1,
  description: visibleContent.description,
  path: localizedPath,
  providerName:
    locale === 'en' ? 'Guangzhou XINYIYUAN Supply Chain Management Co., Ltd.' : undefined,
  countryName: locale === 'en' ? 'China' : undefined,
})
const faqSchema = seo.createFaqSchema(
  presentation === 'classic' && !hasVisibleClassicContent ? [] : visibleFaqs
)
const heroMedia = getServiceHeroMedia(slug)
---

<Layout
  title={visibleContent.title}
  description={visibleContent.description}
  canonical={seo.absoluteUrl(localizedPath)}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
  locale={locale}
  siteSettings={locale === 'en' ? await getEnglishSiteSettings() : undefined}
>
  {
    slug === 'xiefu-yuncang' && presentation === 'footwear' ? (
      <FootwearPage content={visibleContent} faqs={visibleFaqs} {locale} />
    ) : isRedesignPresentation(presentation) ? (
      <RedesignServicePage
        {presentation}
        content={visibleContent}
        faqs={visibleFaqs}
        videoSrc={heroMedia?.src ?? ''}
        poster={heroMedia?.poster ?? content.imgSrc}
        {locale}
      />
    ) : hasVisibleClassicContent ? (
      <>
        <ServiceLandingHero
          eyebrow={visibleContent.eyebrow}
          h1={visibleContent.h1}
          h1sub={visibleContent.h1sub}
          heroDesc={visibleContent.heroDesc}
          imgSrc={visibleContent.imgSrc}
          imgAlt={visibleContent.imgAlt}
          videoSrc={heroMedia?.src}
          poster={heroMedia?.poster}
          {locale}
        />
        <ServiceSignature
          variant={variant}
          contentDesc={visibleContent.contentDesc}
          stats={visibleContent.stats}
          features={visibleContent.features}
          {locale}
        />
        <div class:list={uniqueClass} data-service-reveal="visual">
          <slot name="unique" />
        </div>
        <ServiceExperience
          variant={variant}
          h1={visibleContent.h1}
          breadcrumbLabel={visibleContent.breadcrumbLabel}
          contentDesc={visibleContent.contentDesc}
          featuresLabel={visibleContent.featuresLabel}
          features={visibleContent.features}
          faqs={visibleFaqs}
          useConversionCta={SPECIALTY_LINKS.some(({ href }) => href === `/${slug}`)}
          {locale}
        />
      </>
    ) : null
  }
</Layout>
<script>
  import '@/scripts/service-page'
</script>
<style>
  .service-unique:empty {
    display: none;
  }
</style>
