---
import ServiceSignature from '@/components/service/ServiceSignature.astro'
import ServiceLandingHero from '@/components/service/ServiceLandingHero.astro'
import ServiceExperience from '@/components/service/ServiceExperience.astro'
import Layout from '@/layouts/Layout.astro'
import { SPECIALTY_LINKS } from '@/data/navigation'
import {
  absoluteUrl,
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
} from '@/lib/seo'
import { type FaqItem, type FeatureItem, type ServiceVariant, type StatItem } from '@/data/service'
import { getFaqs, getServicePageContent } from '@/lib/directus'

interface Props {
  variant: ServiceVariant
  title: string
  description: string
  slug: string
  breadcrumbLabel: string
  eyebrow: string
  h1: string
  h1sub: string
  heroDesc: string
  imgSrc: string
  imgAlt: string
  stats: [StatItem, StatItem, StatItem, StatItem]
  contentDesc: string
  featuresLabel: string
  features: FeatureItem[]
  faqs: FaqItem[]
}

const {
  variant,
  title,
  description,
  slug,
  breadcrumbLabel,
  eyebrow,
  h1,
  h1sub,
  heroDesc,
  imgSrc,
  imgAlt,
  stats,
  contentDesc,
  featuresLabel,
  features,
  faqs,
} = Astro.props

const pageUrl = absoluteUrl(`/${slug}`)
const content = await getServicePageContent(slug, {
  title,
  description,
  breadcrumbLabel,
  eyebrow,
  h1,
  h1sub,
  heroDesc,
  imgSrc,
  imgAlt,
  stats,
  contentDesc,
  featuresLabel,
  features,
})
const breadcrumbSchema = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '产品服务', path: '/product' },
  { name: content.breadcrumbLabel, path: `/${slug}` },
])
const serviceSchema = createServiceSchema({
  name: content.h1,
  description: content.description,
  path: `/${slug}`,
})
const displayFaqs = await getFaqs(slug, faqs)
const faqSchema = createFaqSchema(displayFaqs)
const useConversionCta = SPECIALTY_LINKS.some(({ href }) => href === `/${slug}`)
---

<Layout
  title={content.title}
  description={content.description}
  canonical={pageUrl}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <!-- Hero：所有服务页统一保留 -->
  <ServiceLandingHero
    eyebrow={content.eyebrow}
    h1={content.h1}
    h1sub={content.h1sub}
    heroDesc={content.heroDesc}
    imgSrc={content.imgSrc}
    imgAlt={content.imgAlt}
  />

  <ServiceSignature
    variant={variant}
    h1={content.h1}
    contentDesc={content.contentDesc}
    stats={content.stats}
    features={content.features}
  />

  <div class:list={['service-unique', `service-unique--${variant}`]} data-service-reveal="visual">
    <slot name="unique" />
  </div>

  <ServiceExperience
    variant={variant}
    h1={content.h1}
    breadcrumbLabel={content.breadcrumbLabel}
    contentDesc={content.contentDesc}
    featuresLabel={content.featuresLabel}
    features={content.features}
    faqs={displayFaqs}
    {useConversionCta}
  />
</Layout>

<script>
  import '@/scripts/service-page'
</script>

<style>
  .service-unique:empty {
    display: none;
  }
</style>
