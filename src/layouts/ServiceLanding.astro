---
import ServiceSignature from '@/components/service/ServiceSignature.astro'
import ServiceLandingHero from '@/components/service/ServiceLandingHero.astro'
import ServiceExperience from '@/components/service/ServiceExperience.astro'
import Layout from '@/layouts/Layout.astro'
import {
  absoluteUrl,
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
} from '@/lib/seo'
import { type FaqItem, type FeatureItem, type ServiceVariant, type StatItem } from '@/data/service'

interface Props {
  variant: ServiceVariant
  title: string
  description: string
  slug: string
  breadcrumbLabel: string
  eyebrow: string
  h1: string
  h1sub: string
  heroDesc: string
  imgSrc: string
  imgAlt: string
  stats: [StatItem, StatItem, StatItem, StatItem]
  contentDesc: string
  featuresLabel: string
  features: FeatureItem[]
  faqs: FaqItem[]
}

const {
  variant,
  title,
  description,
  slug,
  breadcrumbLabel,
  eyebrow,
  h1,
  h1sub,
  heroDesc,
  imgSrc,
  imgAlt,
  stats,
  contentDesc,
  featuresLabel,
  features,
  faqs,
} = Astro.props

const pageUrl = absoluteUrl(`/${slug}`)
const breadcrumbSchema = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '产品服务', path: '/product' },
  { name: breadcrumbLabel, path: `/${slug}` },
])
const serviceSchema = createServiceSchema({ name: h1, description, path: `/${slug}` })
const faqSchema = createFaqSchema(faqs)
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <!-- Hero：所有服务页统一保留 -->
  <ServiceLandingHero
    eyebrow={eyebrow}
    h1={h1}
    h1sub={h1sub}
    heroDesc={heroDesc}
    imgSrc={imgSrc}
    imgAlt={imgAlt}
  />

  <ServiceSignature
    variant={variant}
    h1={h1}
    contentDesc={contentDesc}
    stats={stats}
    features={features}
  />

  <div class:list={['service-unique', `service-unique--${variant}`]}>
    <slot name="unique" />
  </div>

  <ServiceExperience
    variant={variant}
    h1={h1}
    breadcrumbLabel={breadcrumbLabel}
    contentDesc={contentDesc}
    featuresLabel={featuresLabel}
    features={features}
    faqs={faqs}
  />
</Layout>

<style>
  .service-unique:empty {
    display: none;
  }
</style>
