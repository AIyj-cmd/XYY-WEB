---
import ServiceSignature from '@/components/service/ServiceSignature.astro'
import Layout from '@/layouts/Layout.astro'
import {
  absoluteUrl,
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
} from '@/lib/seo'

interface StatItem {
  stat: string
  label: string
  sub: string
}
interface FeatureItem {
  title: string
  desc: string
}
interface FaqItem {
  q: string
  a: string
}
type ServiceVariant =
  | 'journey'
  | 'showroom'
  | 'guangzhou-hub'
  | 'south-network'
  | 'east-radius'
  | 'store-rhythm'
  | 'global-tower'
  | 'live-command'
  | 'jit-radar'
  | 'evidence-lab'
  | 'repair-workshop'

interface Props {
  variant: ServiceVariant
  title: string
  description: string
  slug: string
  breadcrumbLabel: string
  eyebrow: string
  h1: string
  h1sub: string
  heroDesc: string
  imgSrc: string
  imgAlt: string
  stats: [StatItem, StatItem, StatItem, StatItem]
  contentDesc: string
  featuresLabel: string
  features: FeatureItem[]
  faqs: FaqItem[]
}

const {
  variant,
  title,
  description,
  slug,
  breadcrumbLabel,
  eyebrow,
  h1,
  h1sub,
  heroDesc,
  imgSrc,
  imgAlt,
  stats,
  contentDesc,
  featuresLabel,
  features,
  faqs,
} = Astro.props

const EXPERIENCE_COPY: Record<
  ServiceVariant,
  { detailCode: string; detailTitle: string; faqCode: string; ctaPrompt: string }
> = {
  journey: {
    detailCode: 'OPERATING SYSTEM',
    detailTitle: '沿着货物流，查看每一项作业能力',
    faqCode: 'FLOW NOTES',
    ctaPrompt: '带上 SKU、渠道和订单波峰，我们一起画出仓内履约路线',
  },
  showroom: {
    detailCode: 'CATEGORY NOTES',
    detailTitle: '从品类和存储方式理解服务边界',
    faqCode: 'MATERIAL NOTES',
    ctaPrompt: '带上品类、面料和包装要求，我们一起规划专属仓储空间',
  },
  'guangzhou-hub': {
    detailCode: 'LOCAL DOSSIER',
    detailTitle: '围绕广州仓点拆解本地服务能力',
    faqCode: 'GUANGZHOU FILE',
    ctaPrompt: '告诉我们货源与订单分布，一起确认合适的广州仓点',
  },
  'south-network': {
    detailCode: 'REGIONAL RESOURCES',
    detailTitle: '四类资源如何支撑华南多仓协同',
    faqCode: 'SOUTH NETWORK',
    ctaPrompt: '提供货量与区域分布，我们一起配置华南仓网资源',
  },
  'east-radius': {
    detailCode: 'DELIVERY RADIUS',
    detailTitle: '从库存前置到签收监控的区域能力',
    faqCode: 'EAST COVERAGE',
    ctaPrompt: '带上华东订单热区，我们一起评估库存前置方案',
  },
  'store-rhythm': {
    detailCode: 'STORE OPERATIONS',
    detailTitle: '把门店需求拆进补货作业单',
    faqCode: 'STORE MANUAL',
    ctaPrompt: '提供门店数、补货频率和箱规，我们一起制定补货节奏',
  },
  'global-tower': {
    detailCode: 'ROUTE CONTROL',
    detailTitle: '逐节点说明跨境正向与逆向能力',
    faqCode: 'ROUTE BRIEF',
    ctaPrompt: '告诉我们目的市场与货物流向，一起梳理跨境仓配链路',
  },
  'live-command': {
    detailCode: 'LIVE SIGNALS',
    detailTitle: '围绕直播时间线配置履约资源',
    faqCode: 'COMMAND LOG',
    ctaPrompt: '带上排期、货盘和峰值预估，我们一起做直播履约预案',
  },
  'jit-radar': {
    detailCode: 'RISK CONTROL',
    detailTitle: '把平台履约风险拆到每个作业节点',
    faqCode: 'SLA CHECK',
    ctaPrompt: '提供平台模式与活动计划，我们一起核对 JIT/JITX 履约条件',
  },
  'evidence-lab': {
    detailCode: 'QC EVIDENCE',
    detailTitle: '质检判断、图片证据与处置规则逐项对应',
    faqCode: 'LAB RECORD',
    ctaPrompt: '带上商品与判定标准，我们一起建立退货质检规则',
  },
  'repair-workshop': {
    detailCode: 'REPAIR STATIONS',
    detailTitle: '不同瑕疵进入不同工位',
    faqCode: 'WORKSHOP NOTES',
    ctaPrompt: '提供样品与验收标准，我们一起评估可采用的修复工艺',
  },
}

const experienceCopy = EXPERIENCE_COPY[variant]
const pageUrl = absoluteUrl(`/${slug}`)
const breadcrumbSchema = createBreadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '产品服务', path: '/product' },
  { name: breadcrumbLabel, path: `/${slug}` },
])
const serviceSchema = createServiceSchema({ name: h1, description, path: `/${slug}` })
const faqSchema = createFaqSchema(faqs)
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <!-- Hero：所有服务页统一保留 -->
  <section class="relative py-16 lg:py-28 overflow-hidden" aria-labelledby="lp-h1">
    <img
      src={imgSrc}
      alt={imgAlt}
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(105deg,rgba(8,20,42,.95) 0%,rgba(8,20,42,.80) 40%,rgba(8,20,42,.50) 70%,rgba(8,20,42,.25) 100%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-brand-orange font-semibold text-sm tracking-wider uppercase mb-3">{eyebrow}</p>
      <h1 id="lp-h1" class="text-4xl lg:text-5xl font-black text-white leading-tight mb-2">{h1}</h1>
      <p class="text-brand-orange font-bold text-lg mb-4">{h1sub}</p>
      <p class="text-lg text-navy-100 max-w-2xl leading-relaxed mb-8">{heroDesc}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex items-center px-6 py-3 bg-brand-orange hover:bg-brand-orange-dark text-white font-bold rounded-xl transition-colors text-sm"
        >
          免费获取方案
        </a>
        <a
          href="/product"
          class="inline-flex items-center px-6 py-3 border border-white/30 hover:border-white/60 text-white/80 hover:text-white font-medium rounded-xl transition-colors text-sm"
        >
          查看全部产品
        </a>
      </div>
    </div>
  </section>

  <ServiceSignature
    variant={variant}
    h1={h1}
    contentDesc={contentDesc}
    stats={stats}
    features={features}
  />

  <div class:list={['service-unique', `service-unique--${variant}`]}>
    <slot name="unique" />
  </div>

  <section
    class:list={['service-detail', `service-detail--${variant}`]}
    aria-labelledby="lp-detail-heading"
  >
    <div class="service-detail__inner">
      <header class="service-detail__header">
        <div>
          <p>{experienceCopy.detailCode}</p>
          <span>{featuresLabel}</span>
        </div>
        <h2 id="lp-detail-heading">{experienceCopy.detailTitle}</h2>
      </header>

      <div class="service-detail__layout">
        <aside class="service-detail__brief">
          <p>{contentDesc}</p>
          <nav aria-label="产品服务相关页面">
            <span>继续了解</span>
            <a href="/product">产品服务总览</a>
            <a href="/cases">合作案例</a>
            <a href="/contact">联系商务</a>
          </nav>
        </aside>

        <ol class="service-detail__features">
          {
            features.map(({ title, desc }, index) => (
              <li>
                <span class="service-detail__index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </div>
                <span class="service-detail__marker" aria-hidden="true">
                  ↗
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class:list={['service-faq', `service-faq--${variant}`]} aria-labelledby="lp-faq-heading">
    <div class="service-faq__inner">
      <header class="service-faq__header">
        <p>{experienceCopy.faqCode}</p>
        <h2 id="lp-faq-heading">{breadcrumbLabel}常见问题</h2>
      </header>
      <dl class="service-faq__list">
        {
          faqs.map(({ q, a }, index) => (
            <div>
              <dt>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{q}</strong>
              </dt>
              <dd>{a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class:list={['service-cta', `service-cta--${variant}`]} aria-labelledby="lp-cta-heading">
    <div class="service-cta__inner">
      <div class="service-cta__number" aria-hidden="true">
        {String(Object.keys(EXPERIENCE_COPY).indexOf(variant) + 1).padStart(2, '0')}
      </div>
      <div class="service-cta__copy">
        <p>NEXT STEP · {experienceCopy.detailCode}</p>
        <h2 id="lp-cta-heading">把{h1}变成可执行方案</h2>
        <span>{experienceCopy.ctaPrompt}</span>
      </div>
      <div class="service-cta__actions">
        <a href="/contact">免费获取方案 <span aria-hidden="true">↗</span></a>
        <a href="/cases">查看合作案例 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-unique:empty {
    display: none;
  }

  .service-detail,
  .service-faq,
  .service-cta {
    --ink: #132b50;
    --blue: #144297;
    --signal: #e85d26;
    --line: #dce5f1;
    color: var(--ink);
  }

  .service-detail {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #fff;
  }

  .service-detail__inner,
  .service-faq__inner,
  .service-cta__inner {
    width: min(80rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .service-detail__header {
    display: grid;
    grid-template-columns: minmax(11rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .service-detail__header > div p,
  .service-faq__header > p,
  .service-cta__copy > p {
    margin: 0 0 0.4rem;
    color: var(--signal);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.2em;
  }

  .service-detail__header > div span {
    color: #78889d;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .service-detail__header h2,
  .service-faq__header h2,
  .service-cta__copy h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.3vw, 3.2rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .service-detail__layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .service-detail__brief {
    align-self: start;
  }

  .service-detail__brief > p {
    margin: 0;
    color: #5f7087;
    font-size: 0.94rem;
    line-height: 1.95;
  }

  .service-detail__brief nav {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--ink);
  }

  .service-detail__brief nav span,
  .service-detail__brief nav a {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .service-detail__brief nav span {
    color: #8b98aa;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .service-detail__brief nav a {
    display: flex;
    justify-content: space-between;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .service-detail__brief nav a::after {
    color: var(--signal);
    content: '↗';
  }

  .service-detail__features {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .service-detail__features li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .service-detail__index {
    padding-top: 0.2rem;
    color: var(--signal);
    font-size: 0.66rem;
    font-weight: 900;
  }

  .service-detail__features h3 {
    margin: 0 0 0.45rem;
    font-size: 1rem;
  }

  .service-detail__features p {
    margin: 0;
    color: #65758b;
    font-size: 0.85rem;
    line-height: 1.75;
  }

  .service-detail__marker {
    color: #b2bfce;
    font-size: 0.8rem;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .service-detail__features li:hover .service-detail__marker {
    color: var(--signal);
    transform: translate(0.2rem, -0.2rem);
  }

  .service-detail--showroom .service-detail__layout,
  .service-detail--evidence-lab .service-detail__layout,
  .service-detail--repair-workshop .service-detail__layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .service-detail--showroom .service-detail__brief,
  .service-detail--evidence-lab .service-detail__brief,
  .service-detail--repair-workshop .service-detail__brief {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.6fr);
    gap: clamp(2rem, 8vw, 8rem);
  }

  .service-detail--showroom .service-detail__brief nav,
  .service-detail--evidence-lab .service-detail__brief nav,
  .service-detail--repair-workshop .service-detail__brief nav {
    margin-top: 0;
  }

  .service-detail--showroom .service-detail__features,
  .service-detail--repair-workshop .service-detail__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .service-detail--showroom .service-detail__features li:nth-child(odd),
  .service-detail--repair-workshop .service-detail__features li:nth-child(odd) {
    padding-right: 2rem;
    border-right: 1px solid var(--line);
  }

  .service-detail--showroom .service-detail__features li:nth-child(even),
  .service-detail--repair-workshop .service-detail__features li:nth-child(even) {
    padding-left: 2rem;
  }

  .service-detail--guangzhou-hub .service-detail__features li,
  .service-detail--south-network .service-detail__features li {
    grid-template-columns: 4rem minmax(0, 1fr) 1.5rem;
  }

  .service-detail--guangzhou-hub .service-detail__index::before {
    margin-right: 0.3rem;
    color: #8494a8;
    content: 'GZ';
  }

  .service-detail--south-network .service-detail__index::before {
    margin-right: 0.3rem;
    color: #8494a8;
    content: 'S';
  }

  .service-detail--east-radius {
    background: #f8fafd;
  }

  .service-detail--store-rhythm .service-detail__features li::before,
  .service-detail--live-command .service-detail__features li::before,
  .service-detail--jit-radar .service-detail__features li::before {
    align-self: center;
    width: 0.45rem;
    height: 0.45rem;
    border: 2px solid var(--signal);
    border-radius: 50%;
    content: '';
  }

  .service-detail--store-rhythm .service-detail__features li,
  .service-detail--live-command .service-detail__features li,
  .service-detail--jit-radar .service-detail__features li {
    grid-template-columns: 0.6rem 2.5rem minmax(0, 1fr) 1.5rem;
  }

  .service-detail--global-tower .service-detail__index::after {
    display: block;
    width: 1px;
    height: 2.6rem;
    margin: 0.5rem auto -2.2rem;
    background: linear-gradient(var(--signal), transparent);
    content: '';
  }

  .service-detail--live-command {
    background: radial-gradient(circle at 93% 8%, rgb(3 157 221 / 8%), transparent 20rem), #fff;
  }

  .service-detail--evidence-lab .service-detail__features li {
    grid-template-columns: 4rem minmax(0, 1fr) 1.5rem;
    min-height: 8rem;
  }

  .service-detail--evidence-lab .service-detail__index {
    color: var(--blue);
    font-size: 1.5rem;
  }

  .service-faq {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #f6f8fb;
  }

  .service-faq__header {
    max-width: 64rem;
    padding-bottom: 2.25rem;
    text-align: left;
  }

  .service-faq__header h2 {
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    line-height: 1.2;
  }

  .service-faq__list {
    width: min(64rem, 100%);
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .service-faq__list > div {
    display: block;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .service-faq__list dt {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  .service-faq__list dt span {
    padding-top: 0.15rem;
    color: var(--signal);
    font-size: 0.6875rem;
    line-height: 1.5;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .service-faq__list dt strong {
    font-size: 1rem;
    line-height: 1.65;
    font-weight: 800;
  }

  .service-faq__list dd {
    margin: 0.75rem 0 0 2.75rem;
    color: #617188;
    font-size: 0.875rem;
    line-height: 1.85;
  }

  .service-cta {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    overflow: hidden;
    background: #eaf2fd;
  }

  .service-cta::before {
    position: absolute;
    top: -8rem;
    right: -6rem;
    width: 25rem;
    height: 25rem;
    border: 1px solid rgb(20 66 151 / 10%);
    border-radius: 50%;
    content: '';
    box-shadow:
      0 0 0 5rem rgb(20 66 151 / 3%),
      0 0 0 10rem rgb(20 66 151 / 2%);
  }

  .service-cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .service-cta__number {
    color: rgb(20 66 151 / 16%);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 900;
    line-height: 1;
  }

  .service-cta__copy > span {
    display: block;
    margin-top: 0.7rem;
    color: #617289;
    font-size: 0.84rem;
  }

  .service-cta__actions {
    display: grid;
    min-width: 12rem;
  }

  .service-cta__actions a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid #c4d3e7;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
    text-decoration: none;
  }

  .service-cta__actions a:first-child {
    color: var(--signal);
  }

  .service-cta--showroom,
  .service-cta--repair-workshop {
    background: #f4f1ec;
  }

  .service-cta--guangzhou-hub,
  .service-cta--south-network {
    background: #edf6f4;
  }

  @media (max-width: 860px) {
    .service-detail__header,
    .service-detail__layout,
    .service-cta__inner {
      grid-template-columns: 1fr;
    }

    .service-detail__layout {
      gap: 2.5rem;
    }

    .service-detail--showroom .service-detail__brief,
    .service-detail--evidence-lab .service-detail__brief,
    .service-detail--repair-workshop .service-detail__brief {
      grid-template-columns: 1fr;
    }

    .service-detail--showroom .service-detail__features,
    .service-detail--repair-workshop .service-detail__features {
      grid-template-columns: 1fr;
    }

    .service-detail--showroom .service-detail__features li:nth-child(odd),
    .service-detail--repair-workshop .service-detail__features li:nth-child(odd),
    .service-detail--showroom .service-detail__features li:nth-child(even),
    .service-detail--repair-workshop .service-detail__features li:nth-child(even) {
      padding-right: 0;
      padding-left: 0;
      border-right: 0;
    }

    .service-cta__number {
      display: none;
    }

    .service-cta__actions {
      max-width: 18rem;
    }
  }

  @media (max-width: 640px) {
    .service-detail,
    .service-faq {
      padding: 3.75rem 0;
    }

    .service-detail__inner,
    .service-faq__inner,
    .service-cta__inner {
      width: min(100% - 1.5rem, 80rem);
    }

    .service-detail__features li,
    .service-detail--guangzhou-hub .service-detail__features li,
    .service-detail--south-network .service-detail__features li,
    .service-detail--evidence-lab .service-detail__features li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .service-detail__marker {
      display: none;
    }

    .service-detail--store-rhythm .service-detail__features li,
    .service-detail--live-command .service-detail__features li,
    .service-detail--jit-radar .service-detail__features li {
      grid-template-columns: 0.6rem 2rem minmax(0, 1fr);
    }

    .service-faq__list > div {
      padding: 1.25rem 0;
    }
  }
</style>
