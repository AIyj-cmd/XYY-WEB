---
import { BRAND } from '@/lib/brand'
import { getSiteSettings } from '@/lib/directus'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import DocumentHead from '@/components/layout/DocumentHead.astro'
import FloatingContact from '@/components/layout/FloatingContact.astro'
import { DEFAULT_SITE_SETTINGS } from '@/data/site-settings'
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noIndex?: boolean
  siteSettings?: typeof DEFAULT_SITE_SETTINGS
  showFooter?: boolean
  showFloatingContact?: boolean
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, BRAND.url).href,
  ogImage = `${BRAND.url}/logo.png`,
  jsonLd,
  noIndex = false,
  siteSettings: providedSiteSettings,
  showFooter = true,
  showFloatingContact = true,
} = Astro.props
const siteSettings = providedSiteSettings ?? (await getSiteSettings(DEFAULT_SITE_SETTINGS))
---

<!doctype html>
<html lang="zh-Hans" class="scroll-smooth">
  <head>
    <DocumentHead {title} {description} {canonical} {ogImage} {jsonLd} {noIndex} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <Header />
    <main>
      <slot />
    </main>
    {showFooter && <Footer settings={siteSettings} />}

    {showFloatingContact && <FloatingContact phone={siteSettings.phone} />}
  </body>
</html>
