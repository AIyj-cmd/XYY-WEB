---
import { BRAND } from '@/lib/brand'
import type { Service } from '@/lib/directus'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import DocumentHead from '@/components/layout/DocumentHead.astro'
import FloatingContact from '@/components/layout/FloatingContact.astro'
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noIndex?: boolean
  services?: Service[]
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, BRAND.url).href,
  ogImage = `${BRAND.url}/logo.png`,
  jsonLd,
  noIndex = false,
  services,
} = Astro.props
---

<!doctype html>
<html lang="zh-Hans" class="scroll-smooth">
  <head>
    <DocumentHead {title} {description} {canonical} {ogImage} {jsonLd} {noIndex} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer services={services} />

    <FloatingContact />
  </body>
</html>
