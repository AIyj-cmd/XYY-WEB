    {
      "title": "“饮”领夏日，关怀满载：新亦源夏日消暑行动",
      "source": {
        "pdfPage": 8,
        "printedPage": null,
        "side": "full",
        "bbox": [
          300,
          35,
          520,
          390
        ]
